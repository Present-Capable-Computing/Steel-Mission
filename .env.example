# Steel Mission local development defaults.
# Copy to .env only if your shell or process manager loads dotenv files.

STEEL_MISSION_HOST=127.0.0.1
STEEL_MISSION_PORT=8765
STEEL_MISSION_RUNTIME_PROFILE=dc13.local
STEEL_MISSION_COORDINATOR_PROVIDER=glimmer
STEEL_MISSION_COORDINATOR_ROLE=dc13.coordination-report

# Optional: override the repository and runtime storage roots.
# PRESENT_WORKER_DIR=/path/to/Steel-Mission
# PRESENT_DEV=/path/to/parent/folder
# PRESENT_TASKS_DIR=/path/to/tasks
# PRESENT_LOGS_DIR=/path/to/logs
# PRESENT_MISSIONS_DIR=/path/to/missions
# PRESENT_TEST_RESULTS_DIR=/path/to/test-results
# STEEL_MISSION_DEFAULT_REPO=/path/to/project-under-delivery

# Optional: Claude Code profile.
# STEEL_MISSION_RUNTIME_PROFILE=dc13.claude
# STEEL_MISSION_COORDINATOR_PROVIDER=claude

# Optional: local Ollama/Glimmer profile.
# OLLAMA_HOST=127.0.0.1:11434

# Optional: evidence signing. The default config uses a key outside the repo.
# STEEL_MISSION_SIGNER_KEY=~/.present/control-plane/evidence-signing-key
