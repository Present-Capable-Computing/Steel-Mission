# Steel Mission local development defaults.
# Copy to .env only if your shell or process manager loads dotenv files.

STEEL_MISSION_HOST=127.0.0.1
STEEL_MISSION_PORT=8765
STEEL_MISSION_RUNTIME_PROFILE=dc13.local
STEEL_MISSION_COORDINATOR_PROVIDER=glimmer
STEEL_MISSION_COORDINATOR_ROLE=dc13.coordination-report

# Optional: override the repository and runtime storage roots.
# PRESENT_WORKER_DIR=/path/to/Steel-Mission
# PRESENT_DEV=/path/to/parent/folder
# PRESENT_TASKS_DIR=/path/to/tasks
# PRESENT_LOGS_DIR=/path/to/logs
# PRESENT_MISSIONS_DIR=/path/to/missions
# PRESENT_TEST_RESULTS_DIR=/path/to/test-results
# STEEL_MISSION_DEFAULT_REPO=/path/to/project-under-delivery

# Identity. Local development is loopback-only. Production must also set
# identityBoundary.mode=oidc-required and the complete OIDC provider metadata
# in config/auth-policy.json.
# PRESENT_IDENTITY_MODE=oidc-required
# PRESENT_OIDC_CLIENT_SECRET=
# PRESENT_AUTH_SIGNING_KEY=
# PRESENT_AUTH_SIGNER_ID=customer-auth-session-key
# PRESENT_AUTH_SIGNING_KEY_FILE=/private/path/auth-session-key
# PRESENT_AUTH_AUDIT_LEDGER=/private/path/auth-audit.jsonl
# PRESENT_AUTH_REVOCATION_LEDGER=/private/path/auth-revocations.jsonl

# Private execution. Local mode is for development/tests only. Build the
# included image, switch control-plane policy to `container`, and use docker
# mode for production-eligible isolation.
# PRESENT_PRIVATE_RUNNER_MODE=docker
# PRESENT_PRIVATE_RUNNER_IMAGE=steel-mission-private-runner:alpha
# PRESENT_PRIVATE_RUNNER_NETWORK=none
# PRESENT_PRIVATE_RUNNER_MEMORY=2g
# PRESENT_PRIVATE_RUNNER_CPUS=2
# PRESENT_PRIVATE_RUNNER_PIDS=256
# PRESENT_PRIVATE_RUNNER_SIGNING_KEY=
# PRESENT_PRIVATE_RUNNER_SIGNING_KEY_FILE=/private/path/private-runner-key

# Native workflow adapters. Enable Slack/Jira in Settings after configuring
# credentials. GitHub is enabled by default but ingress/egress remains blocked
# until its secret/token are present.
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# JIRA_API_TOKEN=
# JIRA_WEBHOOK_SECRET=
# JIRA_BASE_URL=https://example.atlassian.net
# STEEL_MISSION_PUBLIC_URL=https://steel-mission.example

# Optional: Claude Code profile.
# STEEL_MISSION_RUNTIME_PROFILE=dc13.claude
# STEEL_MISSION_COORDINATOR_PROVIDER=claude

# Optional: local Ollama/Glimmer profile.
# OLLAMA_HOST=127.0.0.1:11434

# Optional: evidence signing. The default config uses a key outside the repo.
# STEEL_MISSION_SIGNER_KEY=~/.present/control-plane/evidence-signing-key
