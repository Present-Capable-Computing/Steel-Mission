{
  "acceptedAudiences": [
    "present-control-plane"
  ],
  "acceptedIssuers": [
    "present-local-alpha"
  ],
  "enforcementMode": "signed-session-required-for-control-plane",
  "identityBoundary": {
    "allowLoopbackDevelopmentIdentity": true,
    "mode": "development-local"
  },
  "authorization": {
    "preventSelfApproval": true
  },
  "kms": {
    "enabled": false,
    "keyId": "",
    "provider": "customer-managed",
    "requireExternalSigning": false,
    "signCommand": ""
  },
  "oidc": {
    "authorizationEndpoint": "",
    "audience": "present-control-plane",
    "clientId": "",
    "clientSecretEnv": "PRESENT_OIDC_CLIENT_SECRET",
    "enabled": false,
    "issuer": "",
    "jwksCacheSeconds": 300,
    "jwksUrl": "",
    "redirectUri": "",
    "scopes": [
      "openid",
      "profile",
      "email"
    ],
    "tokenEndpoint": ""
  },
  "policyId": "present.control-plane-auth.ga-boundary",
  "producer": "steel-mission-chat auth-control",
  "roleClaims": [
    "present_role",
    "role"
  ],
  "schemaVersion": 1,
  "sessionTtlSeconds": 3600,
  "subjectClaims": [
    "sub",
    "email",
    "preferred_username"
  ]
}
