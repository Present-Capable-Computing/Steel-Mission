#!/bin/sh
set -eu

# Keep GitHub credentials in the process environment. The helper stored in
# the ephemeral HOME contains variable references, never token values.
if [ -n "${GITHUB_TOKEN:-${GH_TOKEN:-}}" ]; then
  git config --global credential.https://github.com.helper \
    '!f() { if [ "$1" = get ]; then printf "username=x-access-token\npassword=%s\n" "${GITHUB_TOKEN:-$GH_TOKEN}"; fi; }; f'
  git config --global credential.https://api.github.com.helper \
    '!f() { if [ "$1" = get ]; then printf "username=x-access-token\npassword=%s\n" "${GITHUB_TOKEN:-$GH_TOKEN}"; fi; }; f'
fi

exec "$@"
