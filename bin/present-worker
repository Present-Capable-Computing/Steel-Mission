COORDINATOR_SNAPSHOT_MAX_MISSIONS = 25
COORDINATOR_SNAPSHOT_DOCUMENT_EXCERPT_CHARS = 12000
COORDINATOR_PROGRESS_MAX_TIMELINE = 12
AGENT_SESSION_STATUS_SCHEMA = "canonical/agent-session-status-v1.json"
AGENT_SESSION_STATUS_FEED_NAME = "agent-session-status.jsonl"
# Advisory chat tasks are reported so the role can see its own footprint, but
# they are by-product, not pipeline state, so they get a small fixed budget
# instead of competing for the task window.
