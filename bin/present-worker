    return Path(configured).expanduser() if configured else ORGANIZATION_REGISTRY_DEFAULT


def _normalize_general_knowledge_registry(payload: object) -> dict:
    payload = payload if isinstance(payload, dict) else {}
    def metadata(item: dict) -> dict:
        return {
            **({"owner": str(item["owner"]).strip()} if item.get("owner") else {}),
            **({"lastReviewedAt": str(item["lastReviewedAt"]).strip()} if item.get("lastReviewedAt") else {}),
            **({"expiresAt": str(item["expiresAt"]).strip()} if item.get("expiresAt") else {}),
            **({"maxAgeDays": item["maxAgeDays"]} if isinstance(item.get("maxAgeDays"), int) else {}),
            "required": item.get("required") is not False,
            "authoritative": item.get("authoritative") is True,
            **({"provenance": item["provenance"]} if isinstance(item.get("provenance"), dict) else {}),
        }
    repositories = []
    for index, item in enumerate(payload.get("repositories", [])):
        if not isinstance(item, dict) or not isinstance(item.get("path"), str) or not item.get("path").strip():
            continue
        repositories.append({
            "name": str(item.get("name") or f"repo-{index + 1}").strip(),
            "path": item["path"].strip(),
            **metadata(item),
            **({"description": str(item["description"]).strip()} if item.get("description") else {}),
        })
    documents = []
    for index, item in enumerate(payload.get("documents", [])):
        if not isinstance(item, dict) or not isinstance(item.get("path"), str) or not item.get("path").strip():
            continue
        documents.append({
            "title": str(item.get("title") or f"document-{index + 1}").strip(),
            "path": item["path"].strip(),
            **metadata(item),
            **({"kind": str(item["kind"]).strip()} if item.get("kind") else {}),
            **({"description": str(item["description"]).strip()} if item.get("description") else {}),
        })
    return {
        "schemaVersion": 1,
        "producedAt": str(payload.get("producedAt") or common.utc_now()),
        "producer": str(payload.get("producer") or "present-worker"),
        "repositories": repositories,
        "documents": documents,
    }


def _load_general_knowledge_registry() -> dict:
    try:
        payload = json.loads(_general_knowledge_registry_path().read_text())
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        payload = {}
    return _normalize_general_knowledge_registry(payload)


def _safe_org_id(value: str, fallback: str = "organization") -> str:
    cleaned = re.sub(r"[^a-z0-9-]+", "-", value.strip().lower()).strip("-")
    return cleaned[:80] or fallback


def _load_active_organization_knowledge_registry() -> dict:
    try:
        payload = json.loads(_organization_registry_path().read_text())
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        payload = {}
    if not isinstance(payload, dict):
        return _normalize_general_knowledge_registry({})
    organizations = [item for item in payload.get("organizations", []) if isinstance(item, dict)]
    active_id = _safe_org_id(str(payload.get("activeOrganizationId") or ""), "")
    selected = next((item for item in organizations if _safe_org_id(str(item.get("id") or ""), "") == active_id), None)
    if selected is None and organizations:
        selected = organizations[0]
    sources = selected.get("knowledgeSources") if isinstance(selected, dict) and isinstance(selected.get("knowledgeSources"), dict) else {}
    return _normalize_general_knowledge_registry(sources)


def _merge_general_knowledge_sources(sources: dict) -> dict:
    merged = {key: (list(value) if isinstance(value, list) else value) for key, value in sources.items()}
    knowledge = _normalize_general_knowledge_registry({})
    for registry_name, source_registry in (
        ("shared-registry", _load_general_knowledge_registry()),
        ("organization-registry", _load_active_organization_knowledge_registry()),
    ):
        for kind in ("repositories", "documents"):
            knowledge[kind].extend([
                {
                    **item,
                    "provenance": {
                        **(item.get("provenance") if isinstance(item.get("provenance"), dict) else {}),
                        "registry": (item.get("provenance") or {}).get("registry") if isinstance(item.get("provenance"), dict) and item.get("provenance", {}).get("registry") else registry_name,
                        "registryProducedAt": (item.get("provenance") or {}).get("registryProducedAt") if isinstance(item.get("provenance"), dict) and item.get("provenance", {}).get("registryProducedAt") else source_registry.get("producedAt") or "",
                        "sourcePath": item.get("path") or "",
                    },
                }
                for item in source_registry.get(kind, []) if isinstance(item, dict)
            ])
    repo_items = [item for item in merged.get("repositoryRoots", []) if isinstance(item, dict)]
    repo_keys = {(item.get("name"), item.get("path")): index for index, item in enumerate(repo_items)}
    merged["repositoryRoots"] = repo_items
    for item in knowledge.get("repositories", []):
        if not isinstance(item, dict):
            continue
        name = item.get("name")
        path = item.get("path")
        if not isinstance(name, str) or not isinstance(path, str):
            continue
        key = (name, path)
        source = {key: item[key] for key in ("owner", "lastReviewedAt", "expiresAt", "maxAgeDays", "required", "authoritative", "provenance") if key in item}
        if key not in repo_keys:
            merged.setdefault("repositoryRoots", []).append({"name": name, "path": path, **source})
            repo_keys[key] = len(merged["repositoryRoots"]) - 1
        else:
            index = repo_keys[key]
            merged["repositoryRoots"][index] = {**source, **merged["repositoryRoots"][index]}
    doc_items = [item for item in merged.get("documentPaths", []) if isinstance(item, dict)]
    doc_keys = {(item.get("title"), item.get("path")): index for index, item in enumerate(doc_items)}
    merged["documentPaths"] = doc_items
    for item in knowledge.get("documents", []):
        if not isinstance(item, dict):
            continue
        title = item.get("title")
        path = item.get("path")
        if not isinstance(title, str) or not isinstance(path, str):
            continue
        key = (title, path)
        source = {key: item[key] for key in ("owner", "lastReviewedAt", "expiresAt", "maxAgeDays", "required", "authoritative", "provenance") if key in item}
        if key not in doc_keys:
            merged.setdefault("documentPaths", []).append({
                "title": title,
                "path": path,
                **source,
                **({"kind": item["kind"]} if item.get("kind") else {}),
            })
            doc_keys[key] = len(merged["documentPaths"]) - 1
        else:
            index = doc_keys[key]
            merged["documentPaths"][index] = {**source, **merged["documentPaths"][index]}
    return merged


def _runtime_path_variables() -> dict[str, str]:
    present_dev = Path(os.environ.get("PRESENT_DEV") or common.PRESENT_DEV)
    tasks_dir = Path(os.environ.get("PRESENT_TASKS_DIR") or common.TASKS_DIR)
    logs_dir = Path(os.environ.get("PRESENT_LOGS_DIR") or common.LOGS_DIR)
    jobs_dir = Path(os.environ.get("PRESENT_JOBS_DIR") or common.JOBS_DIR)
    test_results_dir = Path(os.environ.get("PRESENT_TEST_RESULTS_DIR") or common.TEST_RESULTS_DIR)
    repos_dir = Path(os.environ.get("PRESENT_REPOS_DIR") or common.REPOS_DIR)
    missions_dir = Path(os.environ.get(MISSIONS_DIR_ENV) or os.environ.get(LEGACY_MISSIONS_DIR_ENV) or MISSIONS_DIR_DEFAULT)
    return {
        "WORKER_DIR": str(common.WORKER_DIR),
        # Config files say ${ORG_DIR} rather than a path under the product tree,
        # so an installation redirects its organisation data with one variable
        # instead of editing every runtime profile.
        "ORG_DIR": str(common.ORG_DIR),
        "PRESENT_DEV": str(present_dev),
        "PRESENT_TASKS_DIR": str(tasks_dir),
        "PRESENT_LOGS_DIR": str(logs_dir),
        "PRESENT_JOBS_DIR": str(jobs_dir),
        "PRESENT_TEST_RESULTS_DIR": str(test_results_dir),
        "PRESENT_REPOS_DIR": str(repos_dir),
        "PRESENT_MISSIONS_DIR": str(missions_dir),
    }


def _expand_runtime_profile_value(value: str) -> str:
    variables = _runtime_path_variables()

    def repl(match) -> str:
        key = match.group(1)
        return os.environ.get(key) or variables.get(key) or match.group(0)

    return re.sub(r"\$\{([A-Z0-9_]+)\}", repl, value)


def _expand_runtime_profile_structure(value):
    if isinstance(value, str):
        return _expand_runtime_profile_value(value)
    if isinstance(value, list):
        return [_expand_runtime_profile_structure(item) for item in value]
    if isinstance(value, dict):
        return {key: _expand_runtime_profile_structure(item) for key, item in value.items()}
    return value


def _expand_runtime_profile_sources(sources: dict) -> dict:
    expanded: dict = {}
    for key, value in sources.items():
        if key == "repositoryRoots" and isinstance(value, list):
            expanded[key] = [
                _expand_runtime_profile_structure(item)
                for item in value
                if isinstance(item, dict) and isinstance(item.get("path"), str)
            ]
        elif key == "documentPaths" and isinstance(value, list):
            expanded[key] = [
                _expand_runtime_profile_structure(item)
                for item in value
                if isinstance(item, dict) and isinstance(item.get("path"), str)
            ]
        elif isinstance(value, list):
            expanded[key] = [
                _expand_runtime_profile_structure(item)
                for item in value
                if isinstance(item, str)
            ]
    return expanded


def _runtime_profile_to_snapshot_policy(profile: dict) -> dict:
    policy = {
        "schemaVersion": 1,
        "sourceProfile": profile["snapshotProfile"],
        "includeCollections": list(profile["includeCollections"]),
        "limits": dict(profile["limits"]),
        "taskSelector": dict(profile.get("taskSelector") or {"mode": "latest"}),
        "sources": _expand_runtime_profile_sources(_merge_general_knowledge_sources(profile["sources"])),
    }
    return _validate_coordinator_snapshot_policy(policy, f"runtime profile {profile.get('id')}.snapshotPolicy")


def _runtime_profile_registry_errors(registry: dict) -> list[str]:
    errors = schema_check.validate(registry, "canonical/runtime-profile-registry-v1.json")
    profiles = registry.get("profiles", [])
    if not isinstance(profiles, list):
        return errors
    ids = [profile.get("id") for profile in profiles if isinstance(profile, dict)]
    if len(ids) != len(set(ids)):
        errors.append("$.profiles: duplicate profile id")
    try:
        model_roles = {role["id"] for role in _load_model_role_registry()["roles"]}
    except common.TaskBundleError as exc:
        errors.append(f"$.profiles: cannot validate model roles: {exc}")
        model_roles = set()
    for profile in profiles:
        if not isinstance(profile, dict):
            continue
        profile_id = profile.get("id")
        model_role = profile.get("modelRole")
        if model_roles and model_role not in model_roles:
            errors.append(f"$.profiles[{profile_id}].modelRole: unknown model role {model_role!r}")
        for key in ("defaultFor", "editableBy", "visibilityRoleKeys", "includeCollections", "requiredProviderCapabilities"):
            value = profile.get(key)
            if isinstance(value, list) and len(value) != len(set(value)):
                errors.append(f"$.profiles[{profile_id}].{key}: duplicate item")
        visibility = profile.get("visibilityRoleKeys", [])
        if isinstance(visibility, list) and not set(visibility) <= DOMAIN_CAPABILITY_ROLE_KEYS | {"KD01", "KD02", "KD03"}:
            errors.append(f"$.profiles[{profile_id}].visibilityRoleKeys: unknown domain capability key")
        try:
            _runtime_profile_to_snapshot_policy(profile)
        except common.TaskBundleError as exc:
            errors.append(str(exc))
    return errors


def _load_runtime_profile_registry() -> dict:
    path = _runtime_profile_registry_path()
    try:
        registry = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise common.TaskBundleError(
            f"runtime profile registry could not be read from {path}: {exc.__class__.__name__}"
        ) from exc
    if not isinstance(registry, dict):
        raise common.TaskBundleError("runtime profile registry must be an object")
    errors = _runtime_profile_registry_errors(registry)
    if errors:
        raise common.TaskBundleError(f"runtime profile registry is invalid: {errors[0]}")
    return registry


def _profile_edit_allowed(profile: dict, operator: str) -> bool:
    editable = set(profile.get("editableBy", []))
    if operator in {"owner", "admin", "org-admin"}:
        return True
    if operator in editable:
        return True
    if operator == "user" and "local-user" in editable:
        return True
    if operator == "local-user" and "user" in editable:
        return True
    return False


def _runtime_registry_with_updated_profile(registry: dict, profile: dict, operator: str) -> dict:
    profiles = list(registry.get("profiles", []))
    profile_id = profile.get("id")
    updated = False
    for index, existing in enumerate(profiles):
        if isinstance(existing, dict) and existing.get("id") == profile_id:
            if not _profile_edit_allowed(existing, operator):
                raise common.TaskBundleError(f"operator role {operator!r} cannot edit runtime profile {profile_id!r}")
            profiles[index] = profile
            updated = True
            break
    if not updated and operator not in {"owner", "admin", "publisher", "user", "local-user", "org-admin"}:
        raise common.TaskBundleError(f"operator role {operator!r} cannot create runtime profiles")
    return {**registry, "producedAt": common.utc_now(), "profiles": profiles if updated else [*profiles, profile]}


def _coordinator_profile_from_args(args) -> str:
    profile = getattr(args, "profile", None) or os.environ.get("STEEL_MISSION_RUNTIME_PROFILE")
    provider = getattr(args, "provider", None) or os.environ.get("STEEL_MISSION_COORDINATOR_PROVIDER")
    role = getattr(args, "role", None) or os.environ.get("STEEL_MISSION_COORDINATOR_ROLE")
    if profile:
        return profile
    if provider in PROVIDER_RUNTIME_PROFILES:
        return PROVIDER_RUNTIME_PROFILES[provider]
    return DEFAULT_RUNTIME_PROFILE


def _runtime_profile_summary(profile: dict, *, registry_path: Path, resolved_at: str) -> dict:
    return {
        "schemaVersion": 1,
        "id": profile["id"],
        "label": profile["label"],
        "status": profile["status"],
        "modelRole": profile["modelRole"],
        "modelProvider": profile["modelProvider"],
        "requiredProviderCapabilities": list(profile.get("requiredProviderCapabilities", [])),
        "snapshotProfile": profile["snapshotProfile"],
        "defaultFor": list(profile.get("defaultFor", [])),
        "editableBy": list(profile.get("editableBy", [])),
        "visibilityRoleKeys": list(profile.get("visibilityRoleKeys", [])),
        "registryPath": str(registry_path),
        "registryHash": common.sha256_file(registry_path) or ("0" * 64),
        "resolvedAt": resolved_at,
    }


def _resolve_runtime_profile(
    profile_id: str = DEFAULT_RUNTIME_PROFILE, *, require_ready: bool = True,
    provider_capabilities: dict | None = None,
) -> dict:
    registry = _load_runtime_profile_registry()
    profiles = {profile["id"]: profile for profile in registry["profiles"]}
    if profile_id not in profiles:
        raise common.TaskBundleError(f"unknown runtime profile {profile_id!r}")
    profile = profiles[profile_id]
    if profile.get("status") != "active":
        raise common.TaskBundleError(f"runtime profile {profile_id!r} is disabled")
    resolved_at = common.utc_now()
    model_policy = _resolve_model_policy(
        profile["modelRole"],
        provider_override=profile.get("modelProvider") if profile.get("modelProvider") != "auto" else None,
        provider_capabilities=provider_capabilities,
        require_ready=require_ready,
        required_native_capabilities=profile.get("requiredProviderCapabilities", []),
    )
    snapshot_policy = _runtime_profile_to_snapshot_policy(profile)
    if model_policy.get("snapshotProfile") != profile["snapshotProfile"]:
        model_policy = {**model_policy, "snapshotProfile": profile["snapshotProfile"]}
    payload = {
        "schemaVersion": 1,
        "producedAt": resolved_at,
        "producer": "present-worker runtime-profile-resolve",
        "runtimeProfile": _runtime_profile_summary(
            profile, registry_path=_runtime_profile_registry_path(), resolved_at=resolved_at
        ),
        "modelPolicy": model_policy,
        "snapshotPolicy": snapshot_policy,
    }
    common.validate_with_schema(
        payload,
        "canonical/runtime-profile-resolution-v1.json",
        "runtime profile resolution",
        validation_point="worker-emit",
        artifact_kind="runtime-profile-resolution",
    )
    return payload


def _capability_registry(provider_capabilities: dict, *, git_ready: bool) -> dict[str, dict]:
    claude_ready = provider_capabilities["claude"].get("ready") is True
    codex_ready = provider_capabilities["codex"].get("ready") is True
    glimmer_ready = provider_capabilities["glimmer"].get("ready") is True
    claude_missing = [] if claude_ready else ["claude"]
    codex_missing = [] if codex_ready else ["codex"]
    git_missing = [] if git_ready else ["git"]
    target_both = ["worker", "present-repository"]

    registry = {
        "workflow-dag": _capability_entry(
            "workflow-dag", verb="workflow", provider="worker", authority="orchestration",
            available=True, targets=target_both, input_kinds=["task-contract-v3"],
            output_schemas=[
                "evidence-manifest-v1",
                "handoff-package-v1",
                "imported-artifact-index-v1",
                "redaction-report-v1",
                "task-state-v1",
                "task-cleanup-result-v1",
                "worker-lease-v1",
                "workflow-cancel-v1",
                "context-checkpoint-v1",
                "workflow-admission-v1",
                "workflow-input-context-v1",
                "workflow-result-v1",
            ],
            evidence_roles=["workflow"],
            constraints={"graph": "acyclic", "maxNodes": 32, "maxParallel": 8}, max_parallel=8),
        "plan": _capability_entry(
            "plan", verb="plan", provider="claude", authority="advisory",
            available=claude_ready, missing=claude_missing, targets=target_both,
            input_kinds=["requirement"], output_schemas=["plan-v1"],
            evidence_roles=["advisory-plan"], constraints={"requiresRequirement": True}),
        "code-review": _capability_entry(
            "code-review", verb="review", provider="codex", authority="advisory",
            available=codex_ready, missing=codex_missing, targets=target_both,
            input_kinds=["requirement", "plan", "diff", "commit"], output_schemas=["review-v1"],
            evidence_roles=["advisory-review"], constraints={"requiresRequirement": True}),
        "security-review": _capability_entry(
            "security-review", verb="adversarial", provider="claude", authority="advisory",
            available=claude_ready, missing=claude_missing, targets=target_both,
            input_kinds=["requirement", "plan", "diff", "commit"],
            output_schemas=["adversarial-result-v1"], evidence_roles=["advisory-security"],
            constraints={"requiresRequirement": True}),
        "coordination-report": _capability_entry(
            "coordination-report", verb="coordination-report", provider="claude", authority="advisory-status",
            available=claude_ready or glimmer_ready,
            missing=[] if (claude_ready or glimmer_ready) else ["claude", "glimmer"],
            targets=["worker"],
            input_kinds=[
                "worker-state-snapshot",
                "coordination-report-request-v1",
                "coordination-snapshot-policy-v1",
                "model-role-registry-v1",
                "runtime-profile-registry-v1",
                "runtime-profile-resolution-v1",
            ],
            output_schemas=["context-checkpoint-v1", "coordination-report-v1"], evidence_roles=["advisory-status"],
            constraints={
                "gates": False,
                "defaultProfile": DEFAULT_RUNTIME_PROFILE,
                "profiles": [DEFAULT_RUNTIME_PROFILE, *PROVIDER_RUNTIME_PROFILES.values()],
                "defaultRole": DEFAULT_COORDINATOR_ROLE,
        "roles": [DEFAULT_COORDINATOR_ROLE],
                "providers": {
                    "default": "role-registry",
                    "available": [name for name, ready in (("claude", claude_ready), ("glimmer", glimmer_ready)) if ready],
                },
            }),
        "candidate": _capability_entry(
            "candidate", verb="fix", provider="codex", authority="candidate-change",
            available=codex_ready and git_ready, missing=codex_missing + git_missing,
            targets=["present-repository"], input_kinds=["requirement", "plan", "review-findings"],
            output_schemas=["fix-result-v1"], evidence_roles=["candidate-change"],
            constraints={"requiresRequirement": True, "mutableWorktreeRole": "codex"}),
        "detached-build": _capability_entry(
            "detached-build", verb="build", provider="deterministic-command-runner",
            authority="build-outcome", available=git_ready, missing=git_missing,
            targets=target_both, input_kinds=["task-contract-v2", "task-contract-v3"],
            output_schemas=["build-job-v1", "build-result-v1"],
            evidence_roles=["build-output"], constraints={"argvOnly": True, "detached": True}),
        "deterministic-verify": _capability_entry(
            "deterministic-verify", verb="verify", provider="deterministic-verifier",
            authority="acceptance", available=git_ready, missing=git_missing,
            targets=target_both, input_kinds=["task-contract-v1", "task-contract-v2", "task-contract-v3"],
            output_schemas=["verification-v1"], evidence_roles=["deterministic-acceptance"],
            constraints={"argvOnly": True, "onlyPassAuthority": True}),
    }
    registry["review"] = {**registry["code-review"], "id": "review"}
    registry["adversarial"] = {**registry["security-review"], "id": "adversarial"}
    registry["fix"] = {**registry["candidate"], "id": "fix"}
    registry["build"] = {**registry["detached-build"], "id": "build"}
    registry["verify"] = {**registry["deterministic-verify"], "id": "verify"}
    if glimmer_ready:
        registry["glimmer"] = _capability_entry(
            "glimmer", verb="glimmer", provider="glimmer", authority="local-inference",
            available=True, targets=["worker"], input_kinds=["prompt"],
            output_schemas=[], evidence_roles=["local-inference"],
            constraints={"localhostOnly": True, "optional": True})
    return dict(sorted(registry.items()))


def _tool_permissions(entry: dict) -> dict:
    authority = str(entry.get("authority") or "")
    provider = str(entry.get("provider") or "")
    verb = str(entry.get("verb") or "")
    return {
        "filesystem": "write" if verb in {"build", "fix", "workflow", "verify"} else "read",
        "network": "provider" if provider in {"claude", "codex", "glimmer"} else "none",
        "worktreeMutation": verb == "fix",
        "canGateAcceptance": authority == "acceptance",
    }


def _tool_contract_registry() -> dict:
    git_ready = common.which("git") is not None
    provider_capabilities = {
        "claude": claude_adapter.status(),
        "codex": codex_adapter.status(),
        "glimmer": glimmer_adapter.status(),
    }
    capability_registry = _capability_registry(provider_capabilities, git_ready=git_ready)
    worker_id = _worker_identity()["id"]
    contracts = []
    for capability_id, entry in capability_registry.items():
        if not isinstance(entry, dict):
            continue
        authority = str(entry.get("authority") or "")
        contracts.append({
            "capabilityId": capability_id,
            "agentId": f"{entry.get('provider', 'worker')}:{capability_id}",
            "toolId": str(entry.get("verb") or capability_id),
            "provider": str(entry.get("provider") or "worker"),
            "authority": authority,
            "available": entry.get("available") is True,
            "missing": entry.get("missing", []) if isinstance(entry.get("missing"), list) else [],
            "permissions": _tool_permissions(entry),
            "inputKinds": entry.get("inputKinds", []) if isinstance(entry.get("inputKinds"), list) else [],
            "outputSchemas": entry.get("outputSchemas", []) if isinstance(entry.get("outputSchemas"), list) else [],
            "evidenceRoles": entry.get("evidenceRoles", []) if isinstance(entry.get("evidenceRoles"), list) else [],
            "constraints": entry.get("constraints", {}) if isinstance(entry.get("constraints"), dict) else {},
            "deterministicAcceptanceAuthority": authority == "acceptance",
        })
    payload = {
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-worker tool contracts",
        "workerId": worker_id,
        "contracts": sorted(contracts, key=lambda item: item["capabilityId"]),
    }
    common.validate_with_schema(
        payload,
        "canonical/agent-tool-contract-registry-v1.json",
        "agent tool contract registry",
        validation_point="worker-emit",
        artifact_kind="agent-tool-contract-registry",
    )
    return payload


def cmd_tool_contracts(_args) -> int:
    return emit(_tool_contract_registry())


def cmd_model_roles(_args) -> int:
    registry = _load_model_role_registry()
    return emit_schema(registry, "canonical/model-role-registry-v1.json", "model role registry")


def cmd_model_role_save(args) -> int:
    try:
        operator = _operator_role(args)
        if operator not in {"owner", "admin", "org-admin"}:
            raise common.TaskBundleError("only owner/admin can manage model bindings")
        role = _read_stdin_object("model role")
        registry = _role_registry_with_updated_role(_load_model_role_registry(), role)
        errors = _model_role_registry_errors(registry)
        if errors:
            raise common.TaskBundleError(f"model role registry is invalid: {errors[0]}")
        _write_registry_json(_model_role_registry_path(), registry)
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    return emit_schema(registry, "canonical/model-role-registry-v1.json", "model role registry")


def cmd_model_role_delete(args) -> int:
    try:
        operator = _operator_role(args)
        if operator not in {"owner", "admin", "org-admin"}:
            raise common.TaskBundleError("only owner/admin can manage model bindings")
        role_id = args.role
        runtime_registry = _load_runtime_profile_registry()
        in_use = [profile["id"] for profile in runtime_registry.get("profiles", [])
                  if isinstance(profile, dict) and profile.get("modelRole") == role_id]
        if in_use and not args.force:
            raise common.TaskBundleError(
                f"model role {role_id!r} is used by runtime profiles: {', '.join(sorted(in_use))}"
            )
        registry = _load_model_role_registry()
        roles = [role for role in registry.get("roles", [])
                 if not (isinstance(role, dict) and role.get("id") == role_id)]
        if len(roles) == len(registry.get("roles", [])):
            raise common.TaskBundleError(f"unknown model role {role_id!r}")
        models = []
        for model in registry.get("models", []):
            if isinstance(model, dict):
                models.append({**model, "roles": [item for item in model.get("roles", []) if item != role_id]})
            else:
                models.append(model)
        registry = {**registry, "producedAt": common.utc_now(), "roles": roles, "models": models}
        errors = _model_role_registry_errors(registry)
        if errors:
            raise common.TaskBundleError(f"model role registry is invalid: {errors[0]}")
        _write_registry_json(_model_role_registry_path(), registry)
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    return emit_schema(registry, "canonical/model-role-registry-v1.json", "model role registry")


def cmd_model_role_resolve(args) -> int:
    try:
        policy = _resolve_model_policy(
            args.role,
            provider_override=args.provider,
            require_ready=not args.ignore_readiness,
        )
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    return emit(policy, exit_code=EXIT_OK)


def cmd_runtime_profiles(_args) -> int:
    registry = _load_runtime_profile_registry()
    return emit_schema(registry, "canonical/runtime-profile-registry-v1.json", "runtime profile registry")


def cmd_runtime_profile_validate(_args) -> int:
    try:
        profile = _read_stdin_object("runtime profile")
        registry = _load_runtime_profile_registry()
        if not profile:
            errors = _runtime_profile_registry_errors(registry)
            if errors:
                raise common.TaskBundleError(f"runtime profile registry is invalid: {errors[0]}")
            return emit({"status": "OK", "profiles": len(registry.get("profiles", []))}, exit_code=EXIT_OK)
        registry = _runtime_registry_with_updated_profile(registry, profile, "org-admin")
        errors = _runtime_profile_registry_errors(registry)
        if errors:
            raise common.TaskBundleError(f"runtime profile registry is invalid: {errors[0]}")
        _runtime_profile_to_snapshot_policy(profile)
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    return emit({"status": "OK", "profile": profile}, exit_code=EXIT_OK)


def cmd_runtime_profile_save(args) -> int:
    try:
        operator = _operator_role(args)
        profile = _read_stdin_object("runtime profile")
        registry = _runtime_registry_with_updated_profile(_load_runtime_profile_registry(), profile, operator)
        errors = _runtime_profile_registry_errors(registry)
        if errors:
            raise common.TaskBundleError(f"runtime profile registry is invalid: {errors[0]}")
        _write_registry_json(_runtime_profile_registry_path(), registry)
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    return emit_schema(registry, "canonical/runtime-profile-registry-v1.json", "runtime profile registry")


def cmd_runtime_profile_clone(args) -> int:
    try:
        operator = _operator_role(args)
        registry = _load_runtime_profile_registry()
        profiles = {profile["id"]: profile for profile in registry.get("profiles", []) if isinstance(profile, dict)}
        if args.source not in profiles:
            raise common.TaskBundleError(f"unknown runtime profile {args.source!r}")
        if args.new_id in profiles:
            raise common.TaskBundleError(f"runtime profile {args.new_id!r} already exists")
        source = profiles[args.source]
        if not _profile_edit_allowed(source, operator):
            raise common.TaskBundleError(f"operator role {operator!r} cannot clone runtime profile {args.source!r}")
        profile = {
            **source,
            "id": args.new_id,
            "label": args.label or f"{source.get('label', args.source)} Copy",
            "defaultFor": [],
        }
        registry = _runtime_registry_with_updated_profile(registry, profile, operator)
        errors = _runtime_profile_registry_errors(registry)
        if errors:
            raise common.TaskBundleError(f"runtime profile registry is invalid: {errors[0]}")
        _write_registry_json(_runtime_profile_registry_path(), registry)
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    return emit_schema(registry, "canonical/runtime-profile-registry-v1.json", "runtime profile registry")


def cmd_runtime_profile_resolve(args) -> int:
    try:
        resolution = _resolve_runtime_profile(args.profile, require_ready=not args.ignore_readiness)
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    return emit_schema(
        resolution,
        "canonical/runtime-profile-resolution-v1.json",
        "runtime profile resolution",
    )


def cmd_status(_args) -> int:
    git_ready = common.which("git") is not None
    provider_capabilities = {
        "claude": claude_adapter.status(),
        "codex": codex_adapter.status(),
        "glimmer": glimmer_adapter.status(),
    }
    capability_registry = _capability_registry(provider_capabilities, git_ready=git_ready)
    required_providers = ("claude", "codex")
    capabilities = ["coordination-report", "detached-build", "verification", "workflow-dag"]
    missing = []
    if git_ready:
        capabilities.append("git")
    else:
        missing.append("git")
    for name in required_providers:
        provider_status = provider_capabilities[name]
        if provider_status.get("ready") is True:
            capabilities.append(name)
        else:
            missing.append(name)
    if provider_capabilities["glimmer"].get("ready") is True:
        capabilities.append("glimmer")
    payload = {
        "schemaVersion": 1,
        "classification": "READY" if not missing else "PARTIAL",
        "producedAt": common.utc_now(),
        "producer": "present-worker status",
        "mock": False,
        "provenance": {"source": "worker", "host": platform.node()},
        "reachable": True,
        "schemaRegistryHash": common.schema_registry_hash(),
        "capabilities": sorted(capabilities),
        "missing": sorted(missing),
        "attempt": 1,
        "detail": {
            "protocolVersion": PROTOCOL_VERSION,
            "schemaAuthority": common.SCHEMA_AUTHORITY,
            "workerVersion": WORKER_VERSION,
            "workerIdentity": _worker_identity(),
            "providers": provider_capabilities,
            "schemaRegistry": _schema_registry_ref(),
            "capabilityRegistry": capability_registry,
            "policyPackRegistry": {
                "schema": "policy-pack-registry-v1",
                "path": str(common.POLICY_PACK_REGISTRY_PATH),
                "sha256": common.sha256_file(common.POLICY_PACK_REGISTRY_PATH),
            },
            "buildJobs": _job_summaries(),
            "optionalProviders": ["glimmer"],
            "deprecatedVerbs": ["specialist"],
            "advisoryVerbs": ["coordination-report"],
            "workflowVerbs": ["workflow", "workflow-cancel"],
            "lifecycleVerbs": ["worker-lease", "task-state", "task-cleanup"],
        },
    }
    print(json.dumps(payload, indent=2, sort_keys=True))
    return EXIT_OK


def cmd_doctor(_args) -> int:
    eprint("present-worker doctor: running system checks...")
    checks = {}
    ok = True
    for binary in ("git", "jq", "python3", "ollama", "claude", "codex"):
        found = common.which(binary) is not None
        checks[binary] = {"installed": found, "path": common.which(binary)}
        if binary in ("git", "python3") and not found:
            ok = False
    release_checks = {
        "steel_mission_tree": common.WORKER_DIR.exists(),
        "schemas": (common.WORKER_DIR / "schemas").exists(),
        "starter_company": common.ORG_DIR.exists(),
        "steel_mission_chat": (common.WORKER_DIR / "steel-mission-chat").exists(),
        "config": common.CONFIG_DIR.exists(),
    }
    for name, exists in release_checks.items():
        checks[name] = {"exists": exists}
        if not exists:
            ok = False
    for directory in (common.REPOS_DIR, common.WORKTREES_DIR, common.TASKS_DIR, common.LOGS_DIR, common.JOBS_DIR, common.TEST_RESULTS_DIR):
        checks[str(directory)] = {"exists": directory.exists(), "required": False}
    checks["default_repo"] = {
        "path": str(common.DEFAULT_REPO), "exists": common.DEFAULT_REPO.exists(),
        "head": common.git_rev_parse(common.DEFAULT_REPO) if common.DEFAULT_REPO.exists() else None,
    }
    if not common.DEFAULT_REPO.exists():
        ok = False
    checks["memory"] = glimmer_adapter.memory_check()
    payload = {
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-worker doctor",
        "schemaAuthority": common.SCHEMA_AUTHORITY,
        "schemaRegistryHash": common.schema_registry_hash(),
        "ok": ok,
        "checks": checks,
    }
    common.validate_with_schema(payload, "canonical/worker-doctor-v1.json", "worker doctor",
                                validation_point="worker-emit", artifact_kind="worker-doctor")
    print(json.dumps(payload, indent=2, sort_keys=True))
    eprint(f"present-worker doctor: {'OK' if ok else 'PROBLEMS FOUND'}")
    return EXIT_OK if ok else EXIT_PROTOCOL_ERROR


def cmd_version(_args) -> int:
    return emit_schema({
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-worker version",
        "name": "present-worker",
        "version": WORKER_VERSION,
        "protocolVersion": PROTOCOL_VERSION,
        "schemaAuthority": common.SCHEMA_AUTHORITY,
        "schemaRegistryHash": common.schema_registry_hash(),
    }, "canonical/worker-version-v1.json", "worker version", exit_code=EXIT_OK)


def cmd_glimmer_start(_args) -> int:
    return emit_schema(glimmer_adapter.start(), "canonical/worker-glimmer-response-v1.json", "worker glimmer")


def cmd_glimmer_stop(_args) -> int:
    return emit_schema(glimmer_adapter.stop(), "canonical/worker-glimmer-response-v1.json", "worker glimmer")


def cmd_glimmer_status(_args) -> int:
    return emit_schema(glimmer_adapter.status(), "canonical/worker-glimmer-response-v1.json", "worker glimmer",
                       exit_code=EXIT_OK)


def cmd_cleanup(args) -> int:
    candidates = []
    for path in sorted(common.WORKTREES_DIR.glob("*")):
        if path.is_dir():
            candidates.append({"type": "worktree", "path": str(path)})
    for path in sorted(common.TEST_RESULTS_DIR.glob("*")):
        candidates.append({"type": "test-result", "path": str(path)})
    for path in sorted(common.JOBS_DIR.glob("*")):
        candidates.append({"type": "job", "path": str(path)})
    if args.force and not args.dry_run:
        removed = []
        for candidate in candidates:
            path = Path(candidate["path"])
            if candidate["type"] == "worktree":
                common.run(["git", "-C", str(common.DEFAULT_REPO), "worktree", "remove", "--force", str(path)], timeout=30)
            elif path.is_dir():
                subprocess.run(["rm", "-rf", str(path)], check=False, env=common.execution_env())
            else:
                path.unlink(missing_ok=True)
            removed.append(candidate)
        return emit_schema({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-worker cleanup",
            "dryRun": False,
            "removed": removed,
        }, "canonical/worker-cleanup-v1.json", "worker cleanup", exit_code=EXIT_OK)
    return emit_schema({
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-worker cleanup",
        "dryRun": True,
        "candidates": candidates,
    }, "canonical/worker-cleanup-v1.json", "worker cleanup", exit_code=EXIT_OK)


def _worktree_path(task_id: str, role: str) -> Path:
    return common.WORKTREES_DIR / f"{task_id}-{role}"


def _default_task_contract(task_id: str) -> dict:
    return {
        "schemaVersion": 1, "taskId": task_id, "producedAt": common.utc_now(),
        "producer": "present-worker mock fixture", "provenance": {"source": "control-plain"},
        "verification": {"target": "worker", "commands": [{
            "name": "mock-placeholder", "argv": ["/usr/bin/true"], "expectedExitCode": 0, "timeoutSeconds": 10,
        }]},
    }


def _load_or_synthesize_contract(task_id: str, mocked: bool) -> dict | None:
    return common.load_task_contract(task_id) or (_default_task_contract(task_id) if mocked else None)


def _ensure_worktree(task_id: str, role: str, base_commit: str) -> tuple[Path, dict | None]:
    path = _worktree_path(task_id, role)
    existing = common.run(["git", "-C", str(common.DEFAULT_REPO), "worktree", "list", "--porcelain"], timeout=15)
    if str(path) in existing.stdout:
        return path, {"status": "BLOCKED", "reason": f"worktree already exists for {task_id}/{role}: {path}", "retryable": False}
    result = common.run(["git", "-C", str(common.DEFAULT_REPO), "worktree", "add", "--detach", str(path), base_commit], timeout=60)
    if result.returncode != 0:
        return path, {"status": "BLOCKED", "reason": result.stderr.strip()[-1000:], "retryable": False}
    return path, None


def _latest_stage_output_commit(task_id: str, stage: str) -> str | None:
    path = common.stage_log_path(task_id)
    if not path.exists():
        return None
    latest = None
    for line in path.read_text().splitlines():
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if record.get("stage") == stage and record.get("output_commit"):
            latest = record["output_commit"]
    return latest


def _artifact_plan_text(task_id: str) -> str:
    plan = common.load_task_artifact(task_id, "plan")
    return json.dumps(plan, sort_keys=True) if plan else ""


WORKFLOW_INPUTS_ENV = "PRESENT_WORKFLOW_INPUTS_PATH"
WORKFLOW_INPUT_EXCERPT_CHARS = 6000
WORKFLOW_INPUT_CONTEXT_MAX_CHARS = 24000
CONTEXT_CHECKPOINT_MAX_FACTS = 24
CONTEXT_CHECKPOINT_PROGRESS_TOKEN_STEP = 2000


def _workflow_inputs_dir(task_id: str) -> Path:
    return common.TASKS_DIR / task_id / "workflow-inputs"


def _workflow_input_context_paths(task_id: str) -> list[Path]:
    root = _workflow_inputs_dir(task_id)
    if not root.exists():
        return []
    return sorted(path for path in root.glob("*.json") if path.is_file())


def _write_workflow_input_context(task_id: str, node_id: str, resolved_inputs: dict | None) -> Path | None:
    if not isinstance(resolved_inputs, dict) or not resolved_inputs:
        return None
    path = _workflow_inputs_dir(task_id) / f"{node_id}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "schemaVersion": 1,
        "taskId": task_id,
        "nodeId": node_id,
        "producedAt": common.utc_now(),
        "producer": "present-worker workflow input resolver",
        "resolvedInputs": resolved_inputs,
    }
    common.validate_with_schema(
        payload,
        "canonical/workflow-input-context-v1.json",
        "workflow input context",
        validation_point="worker-write",
        artifact_kind="workflow-input-context",
        artifact_stage="workflow-inputs",
        task_id=task_id,
        log_failure=True,
    )
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)
    return path


def _workflow_input_context_from_env() -> dict | None:
    value = os.environ.get(WORKFLOW_INPUTS_ENV)
    if not value:
        return None
    path = Path(value)
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(payload, dict) or not isinstance(payload.get("resolvedInputs"), dict):
        return None
    return payload


def _workflow_input_context_text(context: dict | None = None) -> str:
    payload = context or _workflow_input_context_from_env()
    if not isinstance(payload, dict):
        return ""
    resolved = payload.get("resolvedInputs") if isinstance(payload.get("resolvedInputs"), dict) else {}
    artifacts = resolved.get("artifacts") if isinstance(resolved.get("artifacts"), list) else []
    if not artifacts:
        return ""
    sections = ["WORKFLOW INPUT ARTIFACTS"]
    used = len(sections[0])
    for artifact in artifacts:
        if not isinstance(artifact, dict):
            continue
        local_path = artifact.get("localPath")
        source_path = artifact.get("path")
        header = (
            f"- sourceNode={artifact.get('nodeId', '')} kind={artifact.get('kind', '')} "
            f"sha256={artifact.get('sha256', '')}\n"
            f"  sourcePath={source_path or ''}\n"
            f"  localPath={local_path or ''}"
        )
        excerpt = ""
        if isinstance(local_path, str):
            path = Path(local_path)
            if path.exists() and path.is_file() and common.sha256_file(path) == artifact.get("sha256"):
                excerpt = path.read_text(errors="replace")[:WORKFLOW_INPUT_EXCERPT_CHARS]
        block = header + (f"\n  excerpt:\n{excerpt}" if excerpt else "")
        if used + len(block) > WORKFLOW_INPUT_CONTEXT_MAX_CHARS:
            sections.append("- input context truncated")
            break
        sections.append(block)
        used += len(block)
    return "\n".join(sections)


def _context_checkpoint_evidence_refs(task_id: str, snapshot: dict | None = None) -> list[dict]:
    refs: list[dict] = []
    for ref in _task_state_worker_input_refs(task_id):
        refs.append({key: value for key, value in ref.items() if key in {"kind", "path", "sha256", "taskId", "workflowRunId"}})
    if isinstance(snapshot, dict):
        for workflow in snapshot.get("distributedWorkflows", []) if isinstance(snapshot.get("distributedWorkflows"), list) else []:
            if not isinstance(workflow, dict):
                continue
            task = workflow.get("taskId") if isinstance(workflow.get("taskId"), str) else None
            run_id = workflow.get("workflowRunId") if isinstance(workflow.get("workflowRunId"), str) else None
            broker = workflow.get("brokerArtifacts") if isinstance(workflow.get("brokerArtifacts"), dict) else {}
            root = broker.get("root") if isinstance(broker.get("root"), str) else None
            for name in broker.get("present", []) if isinstance(broker.get("present"), list) else []:
                if not isinstance(name, str) or not root:
                    continue
                path = Path(root) / name
                item = {"kind": f"broker-{name.removesuffix('.json')}", "path": str(path)}
                if path.is_file():
                    digest = common.sha256_file(path)
                    if digest:
                        item["sha256"] = digest
                if task:
                    item["taskId"] = task
                if run_id:
                    item["workflowRunId"] = run_id
                refs.append(item)
    seen = set()
    unique = []
    for ref in refs:
        key = (ref.get("kind"), ref.get("path"))
        if key in seen:
            continue
        seen.add(key)
        unique.append(ref)
    return unique[:32]


def _context_checkpoint_retained_facts(requirement: str, snapshot: dict | None) -> list[dict]:
    facts: list[dict] = []
    subject = _coordinator_progress_subject(requirement) if requirement else "the active task"
    facts.append({"kind": "question", "text": f"Current question: {subject}", "source": "requirement"})
    if isinstance(snapshot, dict):
        repositories = snapshot.get("repositoryCommits", [])
        for repo in repositories if isinstance(repositories, list) else []:
            if not isinstance(repo, dict):
                continue
            commit = _short_commit(repo.get("commit"))
            name = repo.get("name")
            if commit and name:
                facts.append({
                    "kind": "repository-commit",
                    "text": f"{name} commit {commit}",
                    "source": "worker-state-snapshot",
                })
        for collection in snapshot.get("snapshotCollections", []) if isinstance(snapshot.get("snapshotCollections"), list) else []:
            if not isinstance(collection, dict):
                continue
            name = collection.get("name")
            returned = collection.get("returned")
            total = collection.get("totalAvailable")
            if isinstance(name, str) and isinstance(returned, int) and isinstance(total, int):
                facts.append({
                    "kind": "snapshot-collection",
                    "text": f"Snapshot retained {returned} of {total} {name}.",
                    "source": "worker-state-snapshot",
                })
        for workflow in snapshot.get("distributedWorkflows", []) if isinstance(snapshot.get("distributedWorkflows"), list) else []:
            if not isinstance(workflow, dict):
                continue
            task = workflow.get("taskId", "unknown")
            status = workflow.get("status", "unknown")
            decision = workflow.get("acceptanceDecision", "unknown")
            facts.append({
                "kind": "distributed-workflow",
                "text": f"{task} is {status}; acceptance decision {decision}.",
                "source": str(workflow.get("source") or "broker-state"),
            })
        for mission in snapshot.get("missions", []) if isinstance(snapshot.get("missions"), list) else []:
            if not isinstance(mission, dict):
                continue
            mission_id = mission.get("missionId", "unknown")
            state = mission.get("state", "unknown")
            task = mission.get("taskId", "unknown")
            facts.append({
                "kind": "mission",
                "text": f"{mission_id} for {task} is {state}; latest phase: {mission.get('lastPhase', 'unknown')}.",
                "source": str(mission.get("source") or "mission-control"),
            })
        for issue in snapshot.get("brokerStateIssues", []) if isinstance(snapshot.get("brokerStateIssues"), list) else []:
            if isinstance(issue, dict):
                facts.append({
                    "kind": "broker-state-issue",
                    "text": str(issue.get("error") or issue.get("reason") or issue)[:600],
                    "source": str(issue.get("path") or "broker-state"),
                })
    return facts[:CONTEXT_CHECKPOINT_MAX_FACTS]


def _context_checkpoint_dropped_details(snapshot: dict | None) -> list[dict]:
    dropped = []
    if not isinstance(snapshot, dict):
        return dropped
    for collection in snapshot.get("snapshotCollections", []) if isinstance(snapshot.get("snapshotCollections"), list) else []:
        if not isinstance(collection, dict):
            continue
        omitted = collection.get("omittedFromSnapshot")
        name = collection.get("name")
        if isinstance(omitted, int) and omitted > 0 and isinstance(name, str):
            dropped.append({
                "kind": name,
                "count": omitted,
                "reason": f"{omitted} {name} omitted by snapshot limit; refer to canonical task/broker state for full detail.",
            })
    return dropped


def _context_checkpoint_payload(task_id: str, *, reason: str, stage: str, requirement: str = "",
                                snapshot: dict | None = None, current_state: dict | None = None,
                                next_action: str = "", mocked: bool = False,
                                resume_from_checkpoint_id: str | None = None) -> dict:
    produced_at = common.utc_now()
    current = {"phase": "checkpointed"}
    if isinstance(current_state, dict):
        current.update({key: value for key, value in current_state.items() if value not in (None, "", [], {})})
    facts = _context_checkpoint_retained_facts(requirement, snapshot)
    dropped = _context_checkpoint_dropped_details(snapshot)
    used_chars = len(json.dumps({"facts": facts, "dropped": dropped}, sort_keys=True))
    checkpoint_basis = {
        "taskId": task_id,
        "reason": reason,
        "stage": stage,
        "producedAt": produced_at,
        "currentState": current,
    }
    payload = {
        **common.canonical_envelope(task_id, "present-worker context checkpoint", mocked=mocked),
        "producedAt": produced_at,
        "checkpointId": "cc-" + common.canonical_hash(checkpoint_basis)[:24],
        "reason": reason,
        "stage": stage,
        "currentState": current,
        "retainedFacts": facts,
        "droppedDetails": dropped,
        "evidenceRefs": _context_checkpoint_evidence_refs(task_id, snapshot),
        "contextBudget": {
            "maxChars": WORKFLOW_INPUT_CONTEXT_MAX_CHARS,
            "usedChars": used_chars,
            "truncated": bool(dropped) or used_chars > WORKFLOW_INPUT_CONTEXT_MAX_CHARS,
            "maxArtifactExcerptChars": WORKFLOW_INPUT_EXCERPT_CHARS,
        },
        "nextAction": next_action or "Continue from retained facts and evidence refs; do not infer omitted details.",
    }
    if resume_from_checkpoint_id:
        payload["resumeFromCheckpointId"] = resume_from_checkpoint_id
    return payload


def _write_context_checkpoint(task_id: str, *, reason: str, stage: str, requirement: str = "",
                              snapshot: dict | None = None, current_state: dict | None = None,
                              next_action: str = "", mocked: bool = False,
                              resume_from_checkpoint_id: str | None = None) -> dict:
    payload = _context_checkpoint_payload(
        task_id,
        reason=reason,
        stage=stage,
        requirement=requirement,
        snapshot=snapshot,
        current_state=current_state,
        next_action=next_action,
        mocked=mocked,
        resume_from_checkpoint_id=resume_from_checkpoint_id,
    )
    common.write_task_artifact(task_id, "context-checkpoint", payload)
    return payload


def _safe_write_context_checkpoint(*args, **kwargs) -> dict | None:
    try:
        return _write_context_checkpoint(*args, **kwargs)
    except Exception:
        return None


def _requirement_gate(task_id: str, stage: str, role: str, mocked: bool) -> dict | None:
    """Refuse to hand an unstated requirement to a live model.

    Only the generative verbs are gated. A mock run invokes no model, and a
    mock result can never become production evidence, so it is left alone.
    """
    if mocked:
        return None
    defect = common.requirement_defect(task_id)
    if defect is None:
        return None
    result = common.requirement_missing(task_id, defect)
    common.record_stage(task_id, stage, result, role=role)
    return result


def cmd_plan(args) -> int:
    mocked = args.mock
    contract = _load_or_synthesize_contract(args.task_id, mocked)
    if contract is None:
        return emit({"status": "BLOCKED", "reason": "missing task contract", "retryable": False})
    refusal = _requirement_gate(args.task_id, "plan", "claude", mocked)
    if refusal:
        return emit(refusal)
    requirement = common.load_requirement(args.task_id) or f"synthetic requirement for {args.task_id}"
    result = claude_adapter.plan(args.task_id, "mock" if mocked else "live", requirement)
    if result.get("schemaVersion") == 1:
        common.write_task_artifact(args.task_id, "plan", result)
    common.record_stage(args.task_id, "plan", result, role="claude")
    return emit(result)


def _build_receipt(task_id: str, state: str, *, pid: int | None = None, started_at: str | None = None) -> dict:
    receipt = {
        **common.canonical_envelope(task_id, "present-worker build", mocked=False),
        "jobId": f"{task_id}-build", "state": state, "pollAfterSeconds": 5,
    }
    if pid:
        receipt["pid"] = pid
    if started_at:
        receipt["startedAt"] = started_at
    return receipt


def _build_result(task_id: str, outcome: str, *, exit_code: int, duration: float, log_path: Path, commit: str | None = None) -> dict:
    excerpt = ""
    if log_path.exists():
        excerpt = log_path.read_text(errors="replace")[-4000:]
    artifacts = []
    digest = common.sha256_file(log_path)
    if digest:
        artifacts.append({"path": str(log_path), "sha256": digest})
    return {
        **common.canonical_envelope(task_id, "present-worker build", mocked=False, commit=commit),
        "outcome": outcome, "exitCode": exit_code, "durationSeconds": round(duration, 3),
        "artifacts": artifacts, "logExcerpt": excerpt,
    }


def _run_build_job(task_id: str) -> int:
    started_clock = time.monotonic()
    started_at = common.utc_now()
    job = common.job_dir(task_id, "build")
    job.mkdir(parents=True, exist_ok=True)
    log_path = job / "build.log"
    common.write_job_document(task_id, "build", "status", {
        "jobId": f"{task_id}-build", "taskId": task_id, "state": "RUNNING", "startedAt": started_at,
    })
    contract = common.load_task_contract(task_id)
    outcome, actual_exit, commit = "INFRASTRUCTURE_FAILURE", 30, None
    try:
        if not contract or contract.get("schemaVersion") not in {2, 3} or not isinstance(contract.get("build"), dict):
            raise common.TaskBundleError("detached build requires task-contract-v2/v3 with build commands")
        spec = contract["build"]
        if spec["target"] == "present-repository":
            commit = common.git_rev_parse(common.DEFAULT_REPO) or ""
            cwd, error = _ensure_worktree(task_id, "build", commit)
            if error:
                raise RuntimeError(error["reason"])
        else:
            cwd = common.WORKER_DIR
            # The commit recorded must be the commit of the tree the build ran
            # in. Recording the corpus HEAD here put the wrong commit into the
            # artifacts whose only purpose is provenance.
            commit = common.git_rev_parse(common.WORKER_DIR)
        outcome, actual_exit = "SUCCEEDED", 0
        with log_path.open("a", encoding="utf-8") as log:
            for command in spec["commands"]:
                log.write(f"\n=== {command['name']} ===\n")
                log.flush()
                proc = subprocess.Popen(
                    command["argv"], cwd=cwd, stdout=log, stderr=subprocess.STDOUT,
                    text=True, env=common.execution_env(), start_new_session=False,
                )
                try:
                    actual_exit = proc.wait(timeout=command["timeoutSeconds"])
                except subprocess.TimeoutExpired:
                    proc.send_signal(signal.SIGTERM)
                    try:
                        proc.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                        proc.wait()
                    actual_exit = 124
                log.write(f"\nexit={actual_exit} expected={command['expectedExitCode']}\n")
                log.flush()
                if actual_exit != command["expectedExitCode"]:
                    outcome = "BUILD_FAILED"
                    break
    except Exception as exc:  # noqa: BLE001
        with log_path.open("a", encoding="utf-8") as log:
            log.write(f"infrastructure error: {exc}\n")
        outcome, actual_exit = "INFRASTRUCTURE_FAILURE", 30
    result = _build_result(task_id, outcome, exit_code=actual_exit,
                           duration=time.monotonic() - started_clock, log_path=log_path, commit=commit)
    common.write_job_document(task_id, "build", "result", result)
    common.write_task_artifact(task_id, "build", result)
    common.write_job_document(task_id, "build", "status", {
        "jobId": f"{task_id}-build", "taskId": task_id, "state": "COMPLETED",
        "startedAt": started_at, "finishedAt": common.utc_now(), "outcome": outcome,
    })
    common.record_stage(task_id, "build", result, role="detached-command-runner", output_commit=commit)
    return EXIT_OK


def _pid_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def cmd_build(args) -> int:
    if args.mock:
        result = {
            **common.canonical_envelope(args.task_id, "present-worker build", mocked=True),
            "outcome": "SUCCEEDED", "exitCode": 0, "durationSeconds": 0,
            "artifacts": [], "logExcerpt": "mock build; no command ran",
        }
        common.write_task_artifact(args.task_id, "build", result)
        common.record_stage(args.task_id, "build", result, role="detached-command-runner")
        return emit(result)

    result = common.load_job_document(args.task_id, "build", "result")
    if result:
        code = EXIT_OK if result.get("outcome") == "SUCCEEDED" else (
            EXIT_VERIFICATION_FAIL if result.get("outcome") == "BUILD_FAILED" else EXIT_PROTOCOL_ERROR
        )
        return emit(result, exit_code=code)

    status = common.load_job_document(args.task_id, "build", "status")
    process = common.load_job_document(args.task_id, "build", "process")
    if status and status.get("state") in {"QUEUED", "RUNNING"}:
        pid = process.get("pid") if process else None
        if isinstance(pid, int) and _pid_running(pid):
            return emit(_build_receipt(args.task_id, status["state"], pid=pid, started_at=status.get("startedAt")))
        log_path = common.job_dir(args.task_id, "build") / "build.log"
        failed = _build_result(args.task_id, "INFRASTRUCTURE_FAILURE", exit_code=30, duration=0,
                               log_path=log_path)
        common.write_job_document(args.task_id, "build", "result", failed)
        return emit(failed, exit_code=EXIT_PROTOCOL_ERROR)

    contract = common.load_task_contract(args.task_id)
    if not contract or contract.get("schemaVersion") not in {2, 3} or not contract.get("build"):
        return emit({"status": "BLOCKED", "reason": "build requires task-contract-v2/v3", "retryable": False})
    queued_at = common.utc_now()
    common.write_job_document(args.task_id, "build", "status", {
        "jobId": f"{args.task_id}-build", "taskId": args.task_id, "state": "QUEUED", "startedAt": queued_at,
    })
    log_path = common.job_dir(args.task_id, "build") / "runner.log"
    with log_path.open("a", encoding="utf-8") as log:
        proc = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_run-build", args.task_id],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, env=common.execution_env(),
            start_new_session=True, close_fds=True,
        )
    common.write_job_document(args.task_id, "build", "process", {"pid": proc.pid})
    return emit(_build_receipt(args.task_id, "QUEUED", pid=proc.pid, started_at=queued_at))


def cmd_review(args) -> int:
    contract = _load_or_synthesize_contract(args.task_id, args.mock)
    if contract is None:
        return emit({"status": "BLOCKED", "reason": "missing task contract", "retryable": False})
    refusal = _requirement_gate(args.task_id, "review", "codex", args.mock)
    if refusal:
        return emit(refusal)
    commit = _latest_stage_output_commit(args.task_id, "build") or common.git_rev_parse(common.DEFAULT_REPO) or ""
    worktree = _worktree_path(args.task_id, "build")
    diff = ""
    if worktree.exists():
        diff = common.run(["git", "-C", str(worktree), "diff", commit], timeout=30).stdout[-60000:]
    input_context = _workflow_input_context_text()
    result = codex_adapter.review(
        args.task_id, "mock" if args.mock else "live", common.load_requirement(args.task_id),
        _artifact_plan_text(args.task_id), commit, diff, "", input_context=input_context,
    )
    if result.get("schemaVersion") == 1:
        common.write_task_artifact(args.task_id, "review", result)
    common.record_stage(args.task_id, "review", result, role="codex", reviewed_commit=commit)
    return emit(result)


def _fix_target_refusal(task_id: str, contract: dict) -> dict | None:
    """Refuse a fix whose contract names a tree the fix stage cannot produce.

    The fix stage produces worktrees of repos/Present only. When the contract
    names the worker checkout, the honest answer is that the capability does
    not exist -- not a silent write to the corpus, which is what happened on
    2026-08-16. The refusal is keyed on 'worker' specifically: broadening it
    would break the corpus fix path, which is the one that does work.
    """
    if (contract.get("verification") or {}).get("target") != "worker":
        return None
    return {
        "status": "BLOCKED", "task_id": task_id, "retryable": False,
        "reason": ("contract target 'worker' names the worker checkout, which is not a mutable "
                   "fix target; the fix stage produces worktrees of repos/Present only. Fixing "
                   "worker code through this verb is not an implemented capability and needs a "
                   "contract target ratified by the Mini as schema authority."),
    }


def cmd_fix(args) -> int:
    contract = _load_or_synthesize_contract(args.task_id, args.mock)
    if contract is None:
        return emit({"status": "BLOCKED", "reason": "missing task contract", "retryable": False})
    refusal = _requirement_gate(args.task_id, "fix", "codex", args.mock)
    if refusal:
        return emit(refusal)
    if not args.mock:
        result = _fix_target_refusal(args.task_id, contract)
        if result:
            common.record_stage(args.task_id, "fix", result, role="codex")
            return emit(result)
        authenticated, auth_meta = codex_adapter.authenticated()
        if not authenticated:
            result = codex_adapter.credential_refusal(auth_meta)
            common.record_stage(args.task_id, "fix", result, role="codex")
            return emit(result)
    base_commit = _latest_stage_output_commit(args.task_id, "build") or common.git_rev_parse(common.DEFAULT_REPO) or ""
    worktree, error = _ensure_worktree(args.task_id, "codex", base_commit)
    if error:
        common.record_stage(args.task_id, "fix", error, role="codex")
        return emit(error)
    review = common.load_task_artifact(args.task_id, "review") or {}
    input_context = _workflow_input_context_text()
    result = codex_adapter.fix(
        args.task_id, "mock" if args.mock else "live", common.load_requirement(args.task_id),
        _artifact_plan_text(args.task_id), base_commit, review.get("findings", []), [], worktree,
        input_context=input_context,
    )
    output_commit = result.get("provenance", {}).get("commit", base_commit)
    if result.get("schemaVersion") == 1:
        common.write_task_artifact(args.task_id, "fix", result)
    common.record_stage(args.task_id, "fix", result, role="codex", input_commit=base_commit, output_commit=output_commit)
    return emit(result)


def cmd_adversarial(args) -> int:
    contract = _load_or_synthesize_contract(args.task_id, args.mock)
    if contract is None:
        return emit({"status": "BLOCKED", "reason": "missing task contract", "retryable": False})
    refusal = _requirement_gate(args.task_id, "adversarial", "claude", args.mock)
    if refusal:
        return emit(refusal)
    commit = (_latest_stage_output_commit(args.task_id, "fix") or
              _latest_stage_output_commit(args.task_id, "build") or common.git_rev_parse(common.DEFAULT_REPO) or "")
    worktree = _worktree_path(args.task_id, "codex")
    if not worktree.exists():
        worktree = _worktree_path(args.task_id, "build")
    diff = common.run(["git", "-C", str(worktree), "show", "--stat", "--oneline", commit], timeout=30).stdout[-60000:] if worktree.exists() else ""
    input_context = _workflow_input_context_text()
    result = claude_adapter.adversarial(
        args.task_id, "mock" if args.mock else "live", common.load_requirement(args.task_id),
        _artifact_plan_text(args.task_id), commit, diff, input_context=input_context,
    )
    if result.get("schemaVersion") == 1:
        common.write_task_artifact(args.task_id, "adversarial", result)
    common.record_stage(args.task_id, "adversarial", result, role="claude", reviewed_commit=commit)
    return emit(result)


# The DC13 Delivery Coordinator manifest in the starter company checkout.
# Read-only identity source for coordination-report; an unreadable or incomplete
# manifest fails closed before any report is produced.
