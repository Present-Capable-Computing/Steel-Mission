EXIT_OK = 0
EXIT_CREDENTIAL_MISSING = 10
EXIT_VERIFICATION_FAIL = 20
EXIT_PROTOCOL_ERROR = 30


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def _schema_registry_ref() -> dict:
    return {
        "schema": "schema-registry-v1",
        "path": str(common.SCHEMA_REGISTRY_PATH),
        "hash": common.schema_registry_hash(),
    }


def _schema_registry_hash_field() -> dict:
    try:
        return {"schemaRegistryHash": common.schema_registry_hash()}
    except common.TaskBundleError:
        return {}


def _protocol_error_payload(reason: str, *, retryable: bool = False,
                            validation_error: dict | None = None) -> dict:
    return {
        "status": "PROTOCOL_ERROR",
        "reason": reason,
        "retryable": retryable,
        **_schema_registry_hash_field(),
        **({"schemaValidation": validation_error} if validation_error else {}),
    }


def _payload_exit_code(payload: dict) -> int:
    status = payload.get("status") or payload.get("result")
    outcome = payload.get("outcome")
    if status == "CREDENTIAL_MISSING":
        return EXIT_CREDENTIAL_MISSING
    if status in ("FAIL", "INCONCLUSIVE") or outcome == "BUILD_FAILED":
        return EXIT_VERIFICATION_FAIL
    if status in ("OK", "MOCK", "PASS", "READY", "STOPPED"):
        return EXIT_OK
    if payload.get("schemaVersion") == 1 and payload.get("producedAt") and payload.get("producer"):
        return EXIT_OK
    return EXIT_PROTOCOL_ERROR


def emit(payload: dict, *, exit_code: int | None = None) -> int:
    code = _payload_exit_code(payload) if exit_code is None else exit_code
    print(json.dumps(payload, indent=2, sort_keys=True), file=sys.stdout if code == EXIT_OK else sys.stderr)
    return code


def emit_schema(payload: dict, schema_name: str, label: str, *, exit_code: int | None = None) -> int:
    common.validate_with_schema(
        payload,
        schema_name,
        label,
        validation_point="worker-emit",
        artifact_kind=label,
    )
    return emit(payload, exit_code=exit_code)


class ContractArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        print(json.dumps(_protocol_error_payload(message), indent=2), file=sys.stderr)
        raise SystemExit(EXIT_PROTOCOL_ERROR)


def _job_summaries() -> list[dict]:
    return _job_summaries_for_paths(_job_status_paths()[-COORDINATOR_SNAPSHOT_MAX_BUILD_JOBS:])


def _worker_identity() -> dict:
    host = platform.node()
    return {
        "id": os.environ.get("PRESENT_WORKER_ID") or f"macbook-local:{host}",
        "kind": os.environ.get("PRESENT_WORKER_KIND", "macbook-local"),
        "executionSurface": os.environ.get("PRESENT_WORKER_SURFACE", "darwin-local"),
        "host": host,
        "trustLevel": os.environ.get("PRESENT_WORKER_TRUST_LEVEL", "local-user-trusted"),
        "protocolVersion": PROTOCOL_VERSION,
        "workerVersion": WORKER_VERSION,
        "resourceLimits": {
            "maxWorkflowParallel": 8,
            "maxWorkflowNodes": 32,
            "maxBuildTimeoutSeconds": 86400,
            "maxVerificationTimeoutSeconds": 900,
        },
        "labels": ["local", "macbook", platform.machine()],
    }


def _capability_entry(
    capability_id: str, *, verb: str, provider: str, authority: str,
    available: bool, missing: list[str] | None = None,
    targets: list[str] | None = None, input_kinds: list[str] | None = None,
    output_schemas: list[str] | None = None, evidence_roles: list[str] | None = None,
    constraints: dict | None = None, max_parallel: int = 1,
) -> dict:
    return {
        "id": capability_id,
        "verb": verb,
        "provider": provider,
        "authority": authority,
        "available": available,
        "missing": sorted(missing or []),
        "targets": targets or [],
        "inputKinds": input_kinds or [],
        "outputSchemas": output_schemas or [],
        "evidenceRoles": evidence_roles or [],
        "constraints": constraints or {},
        "maxParallel": max_parallel,
    }


def _model_role_registry_path() -> Path:
    configured = os.environ.get(MODEL_ROLE_REGISTRY_ENV)
    return Path(configured).expanduser() if configured else MODEL_ROLE_REGISTRY_DEFAULT


def _model_role_registry_errors(registry: dict) -> list[str]:
    errors = schema_check.validate(registry, "canonical/model-role-registry-v1.json")
    models = registry.get("models", [])
    roles = registry.get("roles", [])
    if not isinstance(models, list) or not isinstance(roles, list):
        return errors

    model_ids = [model.get("id") for model in models if isinstance(model, dict)]
    role_ids = [role.get("id") for role in roles if isinstance(role, dict)]
    if len(model_ids) != len(set(model_ids)):
        errors.append("$.models: duplicate model id")
    if len(role_ids) != len(set(role_ids)):
        errors.append("$.roles: duplicate role id")
    model_id_set = {model_id for model_id in model_ids if isinstance(model_id, str)}
    role_id_set = {role_id for role_id in role_ids if isinstance(role_id, str)}
    model_roles = {
        model.get("id"): set(model.get("roles", []))
        for model in models
        if isinstance(model, dict) and isinstance(model.get("id"), str)
    }
    for model in models:
        if not isinstance(model, dict):
            continue
        for role_id in model.get("roles", []):
            if role_id not in role_id_set:
                errors.append(f"$.models[{model.get('id')}].roles: unknown role {role_id!r}")
    for role in roles:
        if not isinstance(role, dict):
            continue
        role_id = role.get("id")
        candidates = [role.get("primaryModel"), *(role.get("fallbackModels") or [])]
        if len(candidates) != len(set(candidates)):
            errors.append(f"$.roles[{role_id}].fallbackModels: duplicate model")
        for model_id in candidates:
            if model_id not in model_id_set:
                errors.append(f"$.roles[{role_id}]: unknown model {model_id!r}")
                continue
            if role_id not in model_roles.get(model_id, set()):
                errors.append(f"$.roles[{role_id}]: model {model_id!r} does not advertise role")
    return errors


def _load_model_role_registry() -> dict:
    path = _model_role_registry_path()
    try:
        registry = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise common.TaskBundleError(
            f"model role registry could not be read from {path}: {exc.__class__.__name__}"
        ) from exc
    if not isinstance(registry, dict):
        raise common.TaskBundleError("model role registry must be an object")
    errors = _model_role_registry_errors(registry)
    if errors:
        raise common.TaskBundleError(f"model role registry is invalid: {errors[0]}")
    return registry


def _write_registry_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        os.replace(tmp, path)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def _read_stdin_object(label: str) -> dict:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as exc:
        raise common.TaskBundleError(f"{label} is not valid JSON: {exc}") from exc
    if not isinstance(payload, dict):
        raise common.TaskBundleError(f"{label} must be a JSON object")
    return payload


def _operator_role(args) -> str:
    operator = getattr(args, "operator_role", None) or "local-user"
    if operator not in PROFILE_OPERATOR_ROLES:
        raise common.TaskBundleError(f"unknown operator role {operator!r}")
    return operator


def _role_registry_with_updated_role(registry: dict, role: dict) -> dict:
    roles = list(registry.get("roles", []))
    role_id = role.get("id")
    updated = False
    for index, existing in enumerate(roles):
        if isinstance(existing, dict) and existing.get("id") == role_id:
            roles[index] = {**existing, **role}
            updated = True
            break
    if not updated:
        roles.append(role)

    advertised = {role.get("primaryModel"), *role.get("fallbackModels", [])}
    models = []
    for model in registry.get("models", []):
        if not isinstance(model, dict):
            models.append(model)
            continue
        model_roles = list(model.get("roles", []))
        if model.get("id") in advertised and role_id not in model_roles:
            model_roles.append(role_id)
        models.append({**model, "roles": model_roles})
    return {**registry, "producedAt": common.utc_now(), "roles": roles, "models": models}


def _provider_ready(provider: str, provider_capabilities: dict | None = None) -> bool:
    capabilities = provider_capabilities
    if capabilities is None:
        capabilities = {
            "claude": claude_adapter.status(),
            "codex": codex_adapter.status(),
            "glimmer": glimmer_adapter.status(),
        }
    status = capabilities.get(provider, {}) if isinstance(capabilities, dict) else {}
    return isinstance(status, dict) and status.get("ready") is True


def _resolve_model_policy(
    role_id: str = DEFAULT_COORDINATOR_ROLE, *, provider_override: str | None = None,
    provider_capabilities: dict | None = None, require_ready: bool = True,
    required_native_capabilities: list[str] | None = None,
) -> dict:
    registry = _load_model_role_registry()
    registry_path = _model_role_registry_path()
    roles = {role["id"]: role for role in registry["roles"]}
    models = {model["id"]: model for model in registry["models"]}
    if role_id not in roles:
        raise common.TaskBundleError(f"unknown model role {role_id!r}")
    role = roles[role_id]
    candidate_ids = [role["primaryModel"], *role.get("fallbackModels", [])]
    if provider_override:
        candidate_ids = [
            model_id for model_id in candidate_ids
            if models[model_id]["provider"] == provider_override
        ]
        if not candidate_ids:
            raise common.TaskBundleError(
                f"model role {role_id!r} has no candidate for provider {provider_override!r}"
            )
    required_native = set(required_native_capabilities or [])
    if required_native:
        capable_ids = [
            model_id for model_id in candidate_ids
            if required_native <= set(models[model_id].get("nativeCapabilities", []))
        ]
        if not capable_ids:
            advertised = {
                model_id: sorted(models[model_id].get("nativeCapabilities", []))
                for model_id in candidate_ids
            }
            raise common.TaskBundleError(
                f"model role {role_id!r} has no candidate with required provider-native capabilities "
                f"{sorted(required_native)}; advertised={advertised}"
            )
        candidate_ids = capable_ids
    selected = candidate_ids[0]
    if require_ready:
        for model_id in candidate_ids:
            provider = models[model_id]["provider"]
            if _provider_ready(provider, provider_capabilities):
                selected = model_id
                break
    model = models[selected]
    policy = {
        "schemaVersion": 1,
        "role": role_id,
        "selectedModel": selected,
        "provider": model["provider"],
        "transport": model["transport"],
        "snapshotProfile": role["snapshotProfile"],
        "capabilityMode": "provider-native-with-governance-envelope",
        "nativeCapabilities": sorted(model.get("nativeCapabilities", [])),
        "requiredProviderCapabilities": sorted(required_native),
        "governanceCapabilities": sorted(role.get("governanceCapabilities", [])),
        "registryPath": str(registry_path),
        "resolvedAt": common.utc_now(),
    }
    if provider_override:
        policy["fallbackReason"] = "provider-override"
    elif selected != role["primaryModel"]:
        policy["fallbackReason"] = "primary-unavailable"
    return policy


def _coordinator_role_from_args(args) -> tuple[str, str | None]:
    role = getattr(args, "role", None) or os.environ.get("STEEL_MISSION_COORDINATOR_ROLE")
    provider = getattr(args, "provider", None) or os.environ.get("STEEL_MISSION_COORDINATOR_PROVIDER")
    return role or DEFAULT_COORDINATOR_ROLE, provider if provider in PROVIDER_RUNTIME_PROFILES else None


