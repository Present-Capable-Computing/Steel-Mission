def _failed_probe(reason: str) -> dict:
    """Pack identity that could not be established, stated as such.

    The authority ruled (protocol-2.1-coordination-report, 2026-08-17) that a
    pack-identity failure is a successful transport of an honest advisory
    failure report -- never guessed identity, and not automatically a protocol
    error. Exit 30 stays reserved for transport corruption, malformed input, or
    an inability to construct a schema-valid failure report at all.
    """
    return {"probe": "failed", "reason": reason}


def _coordinator_pack_identity() -> dict:
    try:
        doc = json.loads(COORDINATOR_PACK_MANIFEST.read_text())
    except (OSError, json.JSONDecodeError, UnicodeDecodeError) as exc:
        return _failed_probe(
            f"pack manifest could not be read ({exc.__class__.__name__}); "
            "no pack-scoped state was classified")
    package_id = doc.get("package_id")
    corpus_generation = doc.get("corpus_generation")
    current_through = doc.get("current_through")
    missing = []
    if not isinstance(package_id, str) or not package_id.strip():
        missing.append("package_id")
    if not isinstance(corpus_generation, int) or isinstance(corpus_generation, bool):
        missing.append("corpus_generation")
    if not isinstance(current_through, str) or not current_through.strip():
        missing.append("current_through")
    # The manifest hash is still computed, because a manifest that cannot be
    # hashed is not readable and that must fail the probe. It is not reported:
    # the authority's packIdentity is additionalProperties:false and permits
    # only probe, packageId, corpusGeneration, currentThrough and reason.
    if not common.sha256_file(COORDINATOR_PACK_MANIFEST):
        missing.append("manifest_sha256")
    if missing:
        return _failed_probe(
            f"pack manifest is incomplete ({', '.join(sorted(missing))}); "
            "no pack-scoped state was classified")
    return {"probe": "ok",
            "packageId": package_id,
            "corpusGeneration": corpus_generation,
            "currentThrough": current_through}


COMMIT_ABBREV = 12
STAGE_REASON_MAX_CHARS = 200


def _task_contract_facts(task_dir: Path) -> dict:
    """Facts about a task drawn from its own contract.

    An unreadable or absent contract yields an empty result, which keeps the
    task in the pipeline population -- the safe direction, since a task is
    only demoted to advisory on positive evidence that it is one.
    """
    try:
        contract = json.loads((task_dir / "contract.json").read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(contract, dict):
        return {}
    verification = contract.get("verification")
    verification = verification if isinstance(verification, dict) else {}
    return {"producer": contract.get("producer"),
            "verificationTarget": verification.get("target")}


def _task_producer(task_dir: Path) -> str | None:
    """Who minted this task, per its own contract. None when unestablished."""
    return _task_contract_facts(task_dir).get("producer")


def _coordinator_snapshot_policy_errors(policy: dict) -> list[str]:
    errors = schema_check.validate(policy, "canonical/coordination-snapshot-policy-v1.json")
    include = policy.get("includeCollections", [])
    if isinstance(include, list) and len(set(include)) != len(include):
        errors.append("$.includeCollections: duplicate collection")
    task_selector = policy.get("taskSelector", {})
    if isinstance(task_selector, dict):
        task_ids = task_selector.get("taskIds", [])
        if isinstance(task_ids, list) and len(set(task_ids)) != len(task_ids):
            errors.append("$.taskSelector.taskIds: duplicate task id")
    sources = policy.get("sources", {})
    if isinstance(include, list) and isinstance(sources, dict):
        required_roots = {
            "tasks": "taskRoots",
            "advisoryTasks": "taskRoots",
            "buildJobs": "buildJobRoots",
            "verifyResults": "verifyResultRoots",
            "distributedWorkflows": "brokerStatePaths",
            "missions": "missionRoots",
        }
        for collection in include:
            source_key = required_roots.get(collection)
            roots = sources.get(source_key) if source_key else None
            if isinstance(roots, list) and not roots:
                errors.append(f"$.sources.{source_key}: required when {collection!r} is included")
    return errors


def _validate_coordinator_snapshot_policy(policy: Any, label: str) -> dict:
    if not isinstance(policy, dict):
        raise common.TaskBundleError(f"{label} must be an object")
    errors = _coordinator_snapshot_policy_errors(policy)
    if errors:
        raise common.TaskBundleError(f"{label} is invalid: {errors[0]}")
    return policy


def _validate_coordinator_model_policy(policy: Any, label: str) -> dict:
    if not isinstance(policy, dict):
        raise common.TaskBundleError(f"{label} must be an object")
    errors = schema_check.validate(
        {
            "schemaVersion": 1,
            "taskId": "DEV-000000",
            "producedAt": "2026-08-18T00:00:00Z",
            "producer": "model-policy-validator",
            "provenance": {"source": "worker-local-advisory-client"},
            "verb": "coordination-report",
            "advisory": True,
            "verificationAuthority": False,
            "modelPolicy": policy,
            "snapshotPolicy": DEFAULT_COORDINATOR_SNAPSHOT_POLICY,
        },
        "canonical/coordination-report-request-v1.json",
    )
    policy_errors = [error for error in errors if ".modelPolicy" in error]
    if policy_errors:
        raise common.TaskBundleError(f"{label} is invalid: {policy_errors[0]}")
    return policy


def _validate_coordinator_runtime_profile(profile: Any, label: str) -> dict:
    if not isinstance(profile, dict):
        raise common.TaskBundleError(f"{label} must be an object")
    errors = schema_check.validate(
        {
            "schemaVersion": 1,
            "taskId": "DEV-000000",
            "producedAt": "2026-08-18T00:00:00Z",
            "producer": "runtime-profile-validator",
            "provenance": {"source": "worker-local-advisory-client"},
            "verb": "coordination-report",
            "advisory": True,
            "verificationAuthority": False,
            "runtimeProfile": profile,
            "modelPolicy": {
                "schemaVersion": 1,
                "role": profile.get("modelRole", DEFAULT_COORDINATOR_ROLE),
                "selectedModel": "qwen2.5-coder:14b",
                "provider": "glimmer",
                "transport": "ollama",
                "snapshotProfile": profile.get("snapshotProfile", "worker-local-default"),
            },
            "snapshotPolicy": DEFAULT_COORDINATOR_SNAPSHOT_POLICY,
        },
        "canonical/coordination-report-request-v1.json",
    )
    profile_errors = [error for error in errors if ".runtimeProfile" in error]
    if profile_errors:
        raise common.TaskBundleError(f"{label} is invalid: {profile_errors[0]}")
    return profile


def _effective_coordinator_snapshot_policy(task_id: str, contract: dict | None = None) -> dict:
    if not isinstance(contract, dict):
        raise common.TaskBundleError("coordination-report requires a task contract with snapshotPolicy")
    policy = contract.get("snapshotPolicy")
    if policy is None:
        raise common.TaskBundleError("coordination-report contract must attach snapshotPolicy")
    return _validate_coordinator_snapshot_policy(policy, "contract.snapshotPolicy")


def _effective_coordinator_runtime_profile(args, contract: dict | None = None) -> dict | None:
    profile_id = _coordinator_profile_from_args(args)
    profile = contract.get("runtimeProfile") if isinstance(contract, dict) else None
    if profile is None:
        if getattr(args, "profile", None):
            return _resolve_runtime_profile(profile_id, require_ready=not getattr(args, "mock", False))["runtimeProfile"]
        return None
    profile = _validate_coordinator_runtime_profile(profile, "contract.runtimeProfile")
    if getattr(args, "profile", None) and profile.get("id") != getattr(args, "profile"):
        raise common.TaskBundleError(
            f"contract.runtimeProfile.id {profile.get('id')!r} does not match --profile {getattr(args, 'profile')!r}"
        )
    return profile


def _effective_coordinator_model_policy(args, contract: dict | None = None) -> dict:
    profile_id = _coordinator_profile_from_args(args)
    role, provider_override = _coordinator_role_from_args(args)
    policy = contract.get("modelPolicy") if isinstance(contract, dict) else None
    if policy is None:
        if getattr(args, "profile", None):
            return _resolve_runtime_profile(
                profile_id,
                require_ready=not getattr(args, "mock", False),
            )["modelPolicy"]
        return _resolve_model_policy(
            role,
            provider_override=provider_override,
            require_ready=not getattr(args, "mock", False),
        )
    policy = _validate_coordinator_model_policy(policy, "contract.modelPolicy")
    if getattr(args, "role", None) and policy.get("role") != getattr(args, "role"):
        raise common.TaskBundleError(
            f"contract.modelPolicy.role {policy.get('role')!r} does not match --role {getattr(args, 'role')!r}"
        )
    if provider_override and policy.get("provider") != provider_override:
        raise common.TaskBundleError(
            f"contract.modelPolicy.provider {policy.get('provider')!r} does not match provider {provider_override!r}"
        )
    return policy


def _short_commit(value: Any) -> str | None:
    return str(value)[:COMMIT_ABBREV] if value else None


def _tail(items: list[Any], limit: int) -> list[Any]:
    if limit <= 0:
        return []
    return items[-limit:]


def _policy_source_paths(policy: dict, key: str) -> list[Path]:
    sources = policy.get("sources", {})
    values = sources.get(key, []) if isinstance(sources, dict) else []
    paths = [Path(value).expanduser() for value in values if isinstance(value, str) and value]
    return _unique_paths(paths)


def _coordinator_task_dirs(policy: dict) -> list[Path]:
    dirs: list[Path] = []
    for root in _policy_source_paths(policy, "taskRoots"):
        if root.is_dir() and TASK_ID_RE.fullmatch(root.name):
            dirs.append(root)
        elif root.is_dir():
            dirs.extend(d for d in root.glob("DEV-??????") if d.is_dir())
    return sorted(_unique_paths(dirs), key=lambda d: (d.name, str(d)))


def _coordinator_stage_log_paths(task_id: str, log_roots: list[Path]) -> list[Path]:
    paths: list[Path] = []
    for root in log_roots:
        if root.is_file() and root.name == f"{task_id}.jsonl":
            paths.append(root)
        elif root.is_dir():
            paths.append(root / f"{task_id}.jsonl")
    return [path for path in _unique_paths(paths) if path.exists()]


def _coordinator_task_summary(task_dir: Path, log_roots: list[Path]) -> dict:
    task_id = task_dir.name
    summary: dict = {"taskId": task_id, "artifacts": sorted(
        p.parent.name for p in task_dir.glob("*/*.json") if p.stem == p.parent.name)}
    target = _task_contract_facts(task_dir).get("verificationTarget")
    if target:
        # Carried because it is what a commit on this task means: a verify
        # commit is the HEAD of the tree under test, and that tree is the
        # worker repo or the Present repo depending on this target. Without
        # it, comparing a fix's output commit against a verify commit invents
        # mismatches across two different repositories.
        summary["verificationTarget"] = target
    stages: dict[str, dict] = {}
    for log_path in _coordinator_stage_log_paths(task_id, log_roots):
        for line in log_path.read_text().splitlines():
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            stage = {key: record[key] for key in (
                "timestamp", "status", "outcome", "verdict", "result", "mock") if key in record}
            # Commit lineage was written by the pipeline all along and dropped
            # here, so no report could bind a PASS to the commit it ran
            # against -- the exact bar CLAUDE.md sets for "done", and the
            # exact gap a fabricated fix exploited on 2026-08-16.
            for source, key in (("input_commit", "inputCommitShort"),
                                ("output_commit", "outputCommitShort")):
                short = _short_commit(record.get(source))
                if short:
                    stage[key] = short
            # Why a stage refused. Without it a bare CREDENTIAL_MISSING or
            # REQUIREMENT_MISSING is unexplainable from the snapshot alone.
            if record.get("reason"):
                stage["reason"] = str(record["reason"])[:STAGE_REASON_MAX_CHARS]
            stages[record.get("stage", "?")] = stage
    summary["lastStageRecords"] = stages
    return summary


def _snapshot_collection(name: str, total: int, returned: int, *, enabled: bool = True) -> dict:
    return {
        "name": name,
        "enabled": enabled,
        "totalAvailable": total,
        "returned": returned,
        "omittedFromSnapshot": max(0, total - returned),
    }


def _job_status_paths(policy: dict | None = None) -> list[Path]:
    if policy is None:
        roots = [common.JOBS_DIR]
    else:
        roots = _policy_source_paths(policy, "buildJobRoots")
    paths: list[Path] = []
    for root in roots:
        if root.is_file() and root.name == "status.json":
            paths.append(root)
        elif root.is_dir():
            paths.extend(root.glob("DEV-??????-build/status.json"))
    return sorted(_unique_paths(paths))


def _job_summaries_for_paths(paths: list[Path]) -> list[dict]:
    summaries = []
    for path in paths:
        try:
            doc = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            summaries.append({"file": path.name, "error": "unreadable"})
            continue
        summaries.append({key: doc[key] for key in ("jobId", "taskId", "state", "startedAt", "finishedAt", "outcome") if key in doc})
    return summaries


def _verify_result_summaries(policy: dict | None, limit: int, task_ids: set[str] | None = None) -> tuple[list[dict], int]:
    roots = [common.TEST_RESULTS_DIR] if policy is None else _policy_source_paths(policy, "verifyResultRoots")
    paths: list[Path] = []
    for root in roots:
        if root.is_file() and root.name.endswith("-verify.json"):
            paths.append(root)
        elif root.is_dir():
            paths.extend(root.glob("DEV-??????-verify.json"))
    paths = sorted(_unique_paths(paths))
    if task_ids is not None:
        paths = [path for path in paths if path.name.removesuffix("-verify.json") in task_ids]
    verify_results = []
    for path in _tail(paths, limit):
        try:
            doc = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            verify_results.append({"file": path.name, "error": "unreadable"})
            continue
        summary = {key: doc[key] for key in ("taskId", "result", "mock", "producedAt") if key in doc}
        # A bare INCONCLUSIVE is uninterpretable: the aggregate is documented
        # (PASS/FAIL/INCONCLUSIVE) but which check produced it was dropped
        # here, so the role could only report the enum and not the reason.
        # Carry the per-check verdicts; the `detail` blobs stay out, they are
        # argv/output dumps and would dominate the prompt.
        checks = doc.get("checks")
        if isinstance(checks, list):
            summary["checks"] = [
                {key: check[key] for key in ("name", "passed") if key in check}
                for check in checks if isinstance(check, dict)
            ]
        for key in ("counts", "diagnostics"):
            if key in doc:
                summary[key] = doc[key]
        # The tree HEAD this verification actually ran against, so a PASS can
        # be bound to a commit instead of floating free.
        provenance = doc.get("provenance")
        commit = _short_commit((provenance or {}).get("commit") if isinstance(provenance, dict) else None)
        if commit:
            summary["commitShort"] = commit
        task_id = doc.get("taskId")
        target = _task_contract_facts(common.TASKS_DIR / task_id).get("verificationTarget") if task_id else None
        if target:
            summary["verificationTarget"] = target
        verify_results.append(summary)
    return verify_results, len(paths)


def _unique_paths(paths: list[Path]) -> list[Path]:
    seen: set[str] = set()
    unique = []
    for path in paths:
        key = str(path.expanduser())
        if key in seen:
            continue
        seen.add(key)
        unique.append(path.expanduser())
    return unique


def _broker_state_candidate_paths(policy: dict | None = None) -> list[Path]:
    paths: list[Path] = []
    policy = policy or DEFAULT_COORDINATOR_SNAPSHOT_POLICY
    limits = policy.get("limits", {})
    limit = limits.get("brokerStateSources", COORDINATOR_SNAPSHOT_MAX_BROKER_STATE_SOURCES)
    for path in _policy_source_paths(policy, "brokerStatePaths"):
        if path.is_dir():
            paths.extend([path / "broker-state.json", path / "state.json"])
        else:
            paths.append(path)
    return _unique_paths(paths)[:limit]


def _load_broker_state(path: Path) -> dict:
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return {"source": str(path), "error": f"unreadable broker state: {exc}"}
    if not isinstance(payload, dict):
        return {"source": str(path), "error": "broker state is not a JSON object"}
    return {"source": str(path), "state": payload}


def _coordinator_repository_commits(policy: dict) -> list[dict]:
    repositories = policy.get("sources", {}).get("repositoryRoots", [])
    summaries = []
    for item in repositories if isinstance(repositories, list) else []:
        if not isinstance(item, dict):
            continue
        name = item.get("name")
        path = item.get("path")
        if not isinstance(name, str) or not isinstance(path, str):
            continue
        root = Path(path).expanduser()
        summaries.append({
            "name": name,
            "path": str(root),
            "commit": common.git_rev_parse(root),
            **{key: item[key] for key in ("owner", "lastReviewedAt", "expiresAt", "required", "authoritative", "provenance") if key in item},
        })
    return summaries


def _coordinator_document_knowledge(policy: dict, limit: int) -> tuple[list[dict], int]:
    documents = policy.get("sources", {}).get("documentPaths", [])
    if not isinstance(documents, list):
        return [], 0
    summaries = []
    for item in documents[:limit]:
        if not isinstance(item, dict):
            continue
        path_value = item.get("path")
        if not isinstance(path_value, str) or not path_value.strip():
            continue
        path = Path(path_value).expanduser()
        summary = {
            "title": str(item.get("title") or path.name),
            "path": str(path),
            **{key: item[key] for key in ("owner", "lastReviewedAt", "expiresAt", "required", "authoritative", "provenance") if key in item},
            **({"kind": str(item["kind"])} if item.get("kind") else {}),
        }
        try:
            stat = path.stat()
        except OSError as exc:
            summaries.append({**summary, "available": False, "reason": f"unreadable: {exc.__class__.__name__}"})
            continue
        summary["available"] = True
        summary["bytes"] = stat.st_size
        try:
            text = path.read_text(errors="replace")
        except OSError as exc:
            summaries.append({**summary, "reason": f"content unreadable: {exc.__class__.__name__}"})
            continue
        except UnicodeDecodeError:
            summaries.append({**summary, "reason": "content is not text-decodable"})
            continue
        excerpt = text[:COORDINATOR_SNAPSHOT_DOCUMENT_EXCERPT_CHARS]
        summaries.append({
            **summary,
            "excerpt": excerpt,
            "truncated": len(text) > len(excerpt),
        })
    return summaries, len(documents)


def _mission_record_paths(policy: dict) -> list[Path]:
    paths: list[Path] = []
    for root in _policy_source_paths(policy, "missionRoots"):
        if root.is_file() and root.name == "mission.json":
            paths.append(root)
        elif root.is_dir() and root.name.startswith("ms-") and (root / "mission.json").is_file():
            paths.append(root / "mission.json")
        elif root.is_dir():
            paths.extend(root.glob("ms-*/mission.json"))
    return sorted(_unique_paths(paths))


def _read_mission_audit(path: Path, limit: int) -> list[dict]:
    audit_path = path.parent / "audit.jsonl"
    if not audit_path.exists() or limit <= 0:
        return []
    rows: list[dict] = []
    try:
        for line in audit_path.read_text(errors="replace").splitlines():
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(event, dict):
                continue
            rows.append({
                key: event[key] for key in (
                    "auditId", "missionId", "taskId", "jobId", "producedAt",
                    "actor", "operatorRole", "action", "summary", "artifactRefs",
                ) if key in event
            })
    except OSError:
        return [{"error": "mission audit unreadable", "path": str(audit_path)}]
    return _tail(rows, limit)


def _mission_summaries(
    policy: dict,
    limit: int,
    task_ids: set[str] | None = None,
) -> tuple[list[dict], int, int]:
    audit_limit = policy.get("limits", {}).get("operatorAudit", COORDINATOR_SNAPSHOT_MAX_OPERATOR_AUDIT)
    paths = _mission_record_paths(policy)
    summaries: list[dict] = []
    for path in paths:
        try:
            doc = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            summaries.append({"path": str(path), "error": "unreadable mission record"})
            continue
        if not isinstance(doc, dict):
            summaries.append({"path": str(path), "error": "mission record is not an object"})
            continue
        task_id = doc.get("taskId")
        if task_ids is not None and task_id not in task_ids:
            continue
        snapshot_summary = doc.get("snapshotPolicySummary") if isinstance(doc.get("snapshotPolicySummary"), dict) else {}
        progress = doc.get("progress") if isinstance(doc.get("progress"), dict) else {}
        decision_request = doc.get("decisionRequest") if isinstance(doc.get("decisionRequest"), dict) else None
        nodes = [
            {
                key: node[key] for key in (
                    "nodeId", "title", "kind", "capability", "state", "requiresApproval", "resultSummary"
                ) if key in node
            }
            for node in doc.get("nodes", [])
            if isinstance(node, dict)
        ]
        evidence = [
            {
                key: item[key] for key in (
                    "evidenceId", "nodeId", "kind", "sha256", "producedAt", "summary"
                ) if key in item
            }
            for item in doc.get("evidenceLedger", [])
            if isinstance(item, dict)
        ]
        mission = {
            "missionId": doc.get("missionId"),
            "jobId": doc.get("jobId"),
            "taskId": task_id,
            "state": doc.get("state"),
            "currentNodeId": doc.get("currentNodeId"),
            "operatorRole": doc.get("operatorRole"),
            "missionKind": doc.get("missionKind"),
            "templateId": doc.get("templateId"),
            "templateTitle": doc.get("templateTitle"),
            "objective": doc.get("objective"),
            "profile": doc.get("profile"),
            "createdAt": doc.get("createdAt"),
            "startedAt": doc.get("startedAt"),
            "updatedAt": doc.get("updatedAt"),
            "completedAt": doc.get("completedAt"),
            "durationSeconds": doc.get("durationSeconds"),
            "restartCount": doc.get("restartCount"),
            "followUpCount": doc.get("followUpCount"),
            "lastPhase": doc.get("lastPhase") or progress.get("phase"),
            "model": (doc.get("modelPolicy") or {}).get("selectedModel") if isinstance(doc.get("modelPolicy"), dict) else None,
            "provider": (doc.get("modelPolicy") or {}).get("provider") if isinstance(doc.get("modelPolicy"), dict) else None,
            "snapshotPolicyHash": snapshot_summary.get("policyHash"),
            "snapshotCollections": doc.get("snapshotCollections", []),
            "nodes": nodes,
            "evidenceLedger": evidence[-8:],
            "evidenceCount": len(evidence),
            "auditCount": doc.get("auditCount"),
            "recentAudit": _read_mission_audit(path, audit_limit),
            "decisionRequest": decision_request,
            "source": str(path),
        }
        summaries.append({key: value for key, value in mission.items() if value not in (None, "", [], {})})
    summaries.sort(key=lambda item: (
        item.get("state") in {"waiting_for_decision", "waiting_for_approval"},
        str(item.get("updatedAt", "")),
        str(item.get("missionId", "")),
    ))
    attention_total = 0
    for item in summaries:
        if item.get("state") == "waiting_for_decision":
            attention_total += 1
        elif item.get("state") == "waiting_for_approval":
            waiting_nodes = [
                node for node in item.get("nodes", [])
                if isinstance(node, dict) and node.get("state") == "waiting_for_approval"
            ]
            attention_total += max(1, len(waiting_nodes))
    return _tail(summaries, limit), len(paths), attention_total


def _agent_session_status_feed_paths(policy: dict) -> list[Path]:
    paths: list[Path] = []
    for root in _policy_source_paths(policy, "missionRoots"):
        if root.is_file() and root.name != "mission.json":
            paths.append(root)
        elif root.is_dir():
            paths.append(root / AGENT_SESSION_STATUS_FEED_NAME)
    return [path for path in _unique_paths(paths) if path.exists()]


def _agent_session_status_records(policy: dict) -> tuple[list[dict], list[dict]]:
    latest: dict[str, dict] = {}
    issues: list[dict] = []
    for path in _agent_session_status_feed_paths(policy):
        try:
            lines = path.read_text().splitlines()
        except (OSError, UnicodeError) as exc:
            issues.append({"source": str(path), "reason": f"status feed unreadable: {exc}"})
            continue
        for line_number, line in enumerate(lines, start=1):
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError as exc:
                issues.append({
                    "source": str(path),
                    "line": line_number,
                    "reason": f"invalid JSON: {exc.msg}",
                })
                continue
            if not isinstance(record, dict):
                issues.append({
                    "source": str(path),
                    "line": line_number,
                    "reason": "status feed entry is not an object",
                })
                continue
            errors = schema_check.validate(record, AGENT_SESSION_STATUS_SCHEMA)
            if errors:
                issues.append({
                    "source": str(path),
                    "line": line_number,
                    "reason": "; ".join(errors),
                })
                continue
            session_id = record["sessionId"]
            current = latest.get(session_id)
            if current is None or record["sequence"] > current["sequence"]:
                latest[session_id] = {**record, "source": str(path)}
    records = sorted(
        latest.values(),
        key=lambda item: (str(item.get("producedAt", "")), str(item.get("sessionId", ""))),
    )
    return records, issues


def _mission_pending_decisions(missions: list[dict]) -> list[dict]:
    pending: list[dict] = []
    for mission in missions:
        state = mission.get("state")
        mission_id = str(mission.get("missionId") or "unknown mission")
        subject = str(mission.get("objective") or mission_id)
        if state == "waiting_for_decision":
            request = mission.get("decisionRequest") if isinstance(mission.get("decisionRequest"), dict) else {}
            pending.append({
                "attentionId": str(request.get("id") or f"{mission_id}:decision"),
                "kind": "escalated-mission",
                "missionId": mission.get("missionId"),
                "taskId": mission.get("taskId"),
                "subject": subject,
                "question": str(request.get("question") or f"A decision is required for {subject}."),
                "requestedAt": request.get("requestedAt") or mission.get("updatedAt"),
                "source": mission.get("source"),
            })
        if state == "waiting_for_approval":
            waiting_nodes = [
                node for node in mission.get("nodes", [])
                if isinstance(node, dict) and node.get("state") == "waiting_for_approval"
            ]
            if not waiting_nodes:
                waiting_nodes = [{"nodeId": mission.get("currentNodeId"), "title": "Mission approval"}]
            for node in waiting_nodes:
                title = str(node.get("title") or node.get("nodeId") or "Mission approval")
                pending.append({
                    "attentionId": f"{mission_id}:approval:{node.get('nodeId') or 'current'}",
                    "kind": "mission-approval",
                    "missionId": mission.get("missionId"),
                    "taskId": mission.get("taskId"),
                    "subject": subject,
                    "question": f"Approval is required for {title}.",
                    "requestedAt": node.get("waitingSince") or mission.get("updatedAt"),
                    "source": mission.get("source"),
                })
    return pending


def _session_pending_decisions(records: list[dict]) -> list[dict]:
    pending: list[dict] = []
    kind_names = {
        "blocked": "blocked-session",
        "plan-unclean": "escalated-session",
        "approval": "session-approval",
    }
    for record in records:
        request = record.get("pendingDecision")
        if record.get("state") != "waiting-on-person" or not isinstance(request, dict):
            continue
        issue = record.get("issue") if isinstance(record.get("issue"), dict) else {}
        subject = f"{issue.get('repository') or 'unknown repository'} #{issue.get('number') or '?'}"
        pending.append({
            "attentionId": str(request.get("decisionId") or f"{record['sessionId']}:decision"),
            "kind": kind_names.get(str(request.get("kind")), "session-decision"),
            "missionId": record.get("missionId"),
            "sessionId": record.get("sessionId"),
            "issue": issue,
            "stage": record.get("stage"),
            "subject": subject,
            "question": str(request.get("question") or f"A decision is required for {subject}."),
            "requestedAt": request.get("requestedAt") or record.get("producedAt"),
            "url": request.get("url"),
            "source": record.get("source"),
        })
    return pending


def _pending_decision_summary(items: list[dict], omitted: int, issues: list[dict]) -> str:
    if not items:
        if omitted or issues:
            reasons = []
            if omitted:
                reasons.append(f"{omitted} pending item(s) were outside the snapshot limit")
            if issues:
                reasons.append(f"{len(issues)} pending-decision source error(s) remain")
            reason_text = " and ".join(reasons)
            return f"No pending decision was established from the returned records; {reason_text}."
        return "Nothing currently needs the Person."
    descriptions = [
        f"{item.get('subject') or item.get('attentionId')}: {item.get('question')}"
        for item in items
    ]
    qualifications = []
    if omitted:
        qualifications.append(f"{omitted} additional pending item(s) were omitted by the snapshot limit")
    if issues:
        qualifications.append(f"{len(issues)} pending-decision source error(s) remain")
    qualification = f" Limits: {'; '.join(qualifications)}." if qualifications else ""
    return f"{len(items)} current item(s) need the Person: {'; '.join(descriptions)}{qualification}"


def _status_counts(items: list[dict], *keys: str) -> dict[str, int]:
    counts: dict[str, int] = {}
    for item in items:
        if not isinstance(item, dict):
            continue
        value = None
        for key in keys:
            if isinstance(item.get(key), str):
                value = item[key]
                break
        if value:
            counts[value] = counts.get(value, 0) + 1
    return dict(sorted(counts.items()))


def _short_hash(value: Any) -> str | None:
    text = str(value) if value else ""
    return text[:COMMIT_ABBREV] if re.fullmatch(r"[a-f0-9]{64}", text) else None


def _broker_artifact_summary(store_root: Any, task_id: str, artifact_limit: int) -> dict:
    if not isinstance(store_root, str) or not store_root:
        return {"checked": False, "reason": "broker artifact storeRoot missing"}
    root = Path(store_root) / "_broker" / task_id
    expected = [
        "workflow-dag.json",
        "workflow.json",
        "attempt-replay.json",
        "artifact-provenance.json",
        "evidence-graph.json",
        "evidence-manifest.json",
        "redaction-report.json",
        "acceptance-manifest.json",
        "handoff-package.json",
        "integrity-ledger.json",
    ]
    present = [name for name in expected if (root / name).is_file()]
    missing = [name for name in expected if name not in present]
    summary: dict = {
        "checked": True,
        "root": str(root),
        "present": present[:artifact_limit],
        "missing": missing[:artifact_limit],
    }
    for filename, key in (
        ("evidence-graph.json", "evidenceGraph"),
        ("acceptance-manifest.json", "acceptanceManifest"),
        ("redaction-report.json", "redactionReport"),
    ):
        path = root / filename
        if not path.is_file():
            continue
        try:
            doc = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            summary[key] = {"error": "unreadable"}
            continue
        if key == "evidenceGraph":
            summary[key] = {
                "gateDecision": doc.get("gateDecision"),
                "redactionStatus": doc.get("redactionStatus"),
                "evidenceNodes": len(doc.get("nodes", [])) if isinstance(doc.get("nodes"), list) else 0,
            }
        elif key == "acceptanceManifest":
            summary[key] = {k: doc[k] for k in ("decision", "reason") if k in doc}
        elif key == "redactionReport":
            summary[key] = {k: doc[k] for k in ("status", "secretFindings", "redactedArtifacts") if k in doc}
    return summary


def _distributed_workflow_summary(task_id: str, record: dict, source: str,
                                  audit: list[dict], events: list[dict], policy: dict) -> dict:
    limits = policy.get("limits", {})
    audit_limit = limits.get("operatorAudit", COORDINATOR_SNAPSHOT_MAX_OPERATOR_AUDIT)
    artifact_limit = limits.get("brokerArtifacts", COORDINATOR_SNAPSHOT_MAX_BROKER_ARTIFACTS)
    distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    node_records = [
        item.get("record") if isinstance(item, dict) and isinstance(item.get("record"), dict) else item
        for item in nodes.values() if isinstance(item, dict)
    ]
    dispatches = distributed.get("nodeDispatches") if isinstance(distributed.get("nodeDispatches"), list) else []
    artifacts = distributed.get("artifactStore") if isinstance(distributed.get("artifactStore"), list) else []
    checkpoints = distributed.get("contextCheckpoints") if isinstance(distributed.get("contextCheckpoints"), list) else []
    replay = distributed.get("replayReport") if isinstance(distributed.get("replayReport"), dict) else {}
    acceptance = distributed.get("acceptanceManifest") if isinstance(distributed.get("acceptanceManifest"), dict) else {}
    task_audit = [
        {key: item[key] for key in ("action", "operatorRole", "workerId", "reason", "producedAt") if key in item}
        for item in audit if isinstance(item, dict) and item.get("taskId") == task_id
    ]
    task_events = [
        {key: item[key] for key in ("type", "workerId", "nodeId", "reason", "producedAt") if key in item}
        for item in events if isinstance(item, dict) and item.get("taskId") == task_id
    ]
    quarantined = sorted({
        str(item.get("workerId"))
        for item in [*task_audit, *task_events]
        if item.get("workerId") and (
            item.get("action") == "quarantine-worker" or item.get("type") == "worker-quarantined")
    })
    summary = {
        "source": source,
        "taskId": task_id,
        "status": record.get("status"),
        "workflowRunId": record.get("workflowRunId"),
        "selectedWorker": record.get("selectedWorker"),
        "updatedAt": record.get("updatedAt"),
        "terminalAt": record.get("terminalAt"),
        "workflowId": distributed.get("workflowId"),
        "contractHashShort": _short_hash(record.get("contractHash") or distributed.get("contractHash")),
        "nodeCount": len(nodes),
        "nodeStatusCounts": _status_counts(node_records, "status"),
        "dispatchStatusCounts": _status_counts(dispatches, "status"),
        "artifactStatusCounts": _status_counts(artifacts, "status"),
        "contextCheckpointCount": len(checkpoints),
        "acceptanceDecision": acceptance.get("decision"),
        "acceptanceReason": acceptance.get("reason"),
        "replay": {
            "reusedNodes": replay.get("reusedNodes", []),
            "freshNodes": replay.get("freshNodes", []),
            "invalidatedNodes": replay.get("invalidatedNodes", []),
            "skippedNodes": replay.get("skippedNodes", []),
        },
        "cancelledNodes": distributed.get("cancelledNodes", []),
        "quarantinedWorkers": quarantined,
        "recentOperatorAudit": _tail(task_audit, audit_limit),
        "recentEvents": _tail(task_events, audit_limit),
        "brokerArtifacts": _broker_artifact_summary(distributed.get("storeRoot"), task_id, artifact_limit),
    }
    return {key: value for key, value in summary.items() if value not in (None, [], {})}


def _distributed_workflow_summaries(policy: dict, task_ids: set[str] | None = None) -> tuple[list[dict], int, list[dict]]:
    summaries: list[dict] = []
    issues: list[dict] = []
    limit = policy.get("limits", {}).get("distributedWorkflows", COORDINATOR_SNAPSHOT_MAX_DISTRIBUTED_WORKFLOWS)
    for path in _broker_state_candidate_paths(policy):
        if not path.exists():
            continue
        loaded = _load_broker_state(path)
        if "error" in loaded:
            issues.append(loaded)
            continue
        state = loaded["state"]
        tasks = state.get("tasks") if isinstance(state.get("tasks"), dict) else {}
        audit = state.get("operatorAuditLog") if isinstance(state.get("operatorAuditLog"), list) else []
        events = state.get("events") if isinstance(state.get("events"), list) else []
        if not tasks:
            continue
        for task_id, record in tasks.items():
            if not isinstance(task_id, str) or not isinstance(record, dict):
                continue
            if task_ids is not None and task_id not in task_ids:
                continue
            if isinstance(record.get("distributed"), dict) or str(record.get("status", "")).startswith("DISTRIBUTED"):
                summaries.append(_distributed_workflow_summary(task_id, record, str(path), audit, events, policy))
    summaries.sort(key=lambda item: (str(item.get("updatedAt", "")), str(item.get("taskId", ""))))
    return _tail(summaries, limit), len(summaries), issues


def _coordinator_state_snapshot(policy: dict) -> dict:
    """Deterministically gather the worker-visible state for a coordination-report run.

    This is the entire retrievable surface handed to the model: whatever is
    not gathered here is, by construction, UNKNOWN / UNVERIFIED in the report.
    """
    policy = _validate_coordinator_snapshot_policy(policy, "cos snapshot policy")
    include = set(policy.get("includeCollections", COORDINATOR_SNAPSHOT_COLLECTIONS))
    limits = policy.get("limits", {})
    selector = policy.get("taskSelector", {})
    selector_task_ids = set(selector.get("taskIds", [])) if selector.get("mode") == "explicit" else None
    log_roots = _policy_source_paths(policy, "logRoots")
    all_dirs = _coordinator_task_dirs(policy) if {"tasks", "advisoryTasks"} & include else []
    if selector_task_ids is not None:
        all_dirs = [d for d in all_dirs if d.name in selector_task_ids]
    # The chat mints a task per question, and those ids sort above the pipeline
    # range, so an unpartitioned tail let advisory by-product crowd out the
    # pipeline state this report exists to describe -- 16 of 30 slots on
    # 2026-08-17, worsening with every question asked. Partition rather than
    # drop: both populations stay disclosed in snapshotCollections.
    advisory_dirs = [d for d in all_dirs if _task_producer(d) == common.ADVISORY_TASK_PRODUCER]
    advisory_names = {d.name for d in advisory_dirs}
    task_dirs = [d for d in all_dirs if d.name not in advisory_names]
    task_limit = limits.get("tasks", COORDINATOR_SNAPSHOT_MAX_TASKS)
    advisory_limit = limits.get("advisoryTasks", COORDINATOR_SNAPSHOT_MAX_ADVISORY_TASKS)
    build_job_limit = limits.get("buildJobs", COORDINATOR_SNAPSHOT_MAX_BUILD_JOBS)
    verify_limit = limits.get("verifyResults", COORDINATOR_SNAPSHOT_MAX_VERIFY_RESULTS)
    tasks = [_coordinator_task_summary(d, log_roots) for d in _tail(task_dirs, task_limit)] if "tasks" in include else []
    task_omitted = max(0, len(task_dirs) - len(tasks))
    advisory_tasks = (
        [_coordinator_task_summary(d, log_roots) for d in _tail(advisory_dirs, advisory_limit)]
        if "advisoryTasks" in include else []
    )
    advisory_omitted = max(0, len(advisory_dirs) - len(advisory_tasks))
    job_paths = []
    if "buildJobs" in include:
        job_paths = _job_status_paths(policy)
        if selector_task_ids is not None:
            job_paths = [path for path in job_paths if path.parent.name.removesuffix("-build") in selector_task_ids]
    build_jobs = _job_summaries_for_paths(_tail(job_paths, build_job_limit))
    build_jobs_omitted = max(0, len(job_paths) - len(build_jobs))
    if "verifyResults" in include:
        verify_results, verify_total = _verify_result_summaries(policy, verify_limit, selector_task_ids)
    else:
        verify_results, verify_total = [], 0
    verify_omitted = max(0, verify_total - len(verify_results))
    if "distributedWorkflows" in include:
        distributed_workflows, distributed_total, broker_state_issues = _distributed_workflow_summaries(
            policy, selector_task_ids)
    else:
        distributed_workflows, distributed_total, broker_state_issues = [], 0, []
    distributed_omitted = max(0, distributed_total - len(distributed_workflows))
    if "generalDocuments" in include:
        general_documents, general_document_total = _coordinator_document_knowledge(
            policy, limits.get("generalDocuments", COORDINATOR_SNAPSHOT_MAX_GENERAL_DOCUMENTS))
    else:
        general_documents, general_document_total = [], 0
    general_documents_omitted = max(0, general_document_total - len(general_documents))
    if "missions" in include:
        missions, mission_total, mission_attention_total = _mission_summaries(
            policy, limits.get("missions", COORDINATOR_SNAPSHOT_MAX_MISSIONS), selector_task_ids)
        session_statuses, pending_decision_source_issues = _agent_session_status_records(policy)
    else:
        missions, mission_total, mission_attention_total = [], 0, 0
        session_statuses = []
        pending_decision_source_issues = [{
            "source": "snapshotPolicy",
            "reason": "missions collection is disabled, so pending-decision state was not checked",
        }]
    missions_omitted = max(0, mission_total - len(missions))
    mission_pending = _mission_pending_decisions(missions)
    session_pending = _session_pending_decisions(session_statuses)
    all_pending = sorted(
        [*mission_pending, *session_pending],
        key=lambda item: (str(item.get("requestedAt", "")), str(item.get("attentionId", ""))),
    )
    pending_limit = limits.get("missions", COORDINATOR_SNAPSHOT_MAX_MISSIONS)
    pending_decisions = _tail(all_pending, pending_limit)
    mission_pending_omitted = max(0, mission_attention_total - len(mission_pending))
    pending_decisions_omitted = max(
        0,
        len(all_pending) + mission_pending_omitted - len(pending_decisions),
    )
    source_exclusions = [
        {"collection": name, "reason": "disabled by snapshotPolicy"}
        for name in COORDINATOR_SNAPSHOT_COLLECTIONS if name not in include
    ]
    return {
        "generatedAt": common.utc_now(),
        "snapshotPolicy": policy,
        "repositoryCommits": _coordinator_repository_commits(policy),
        "snapshotCollections": [
            _snapshot_collection("tasks", len(task_dirs), len(tasks), enabled="tasks" in include),
            _snapshot_collection("advisoryTasks", len(advisory_dirs), len(advisory_tasks),
                                 enabled="advisoryTasks" in include),
            _snapshot_collection("buildJobs", len(job_paths), len(build_jobs), enabled="buildJobs" in include),
            _snapshot_collection("verifyResults", verify_total, len(verify_results),
                                 enabled="verifyResults" in include),
            _snapshot_collection("distributedWorkflows", distributed_total, len(distributed_workflows),
                                 enabled="distributedWorkflows" in include),
            _snapshot_collection("generalDocuments", general_document_total, len(general_documents),
                                 enabled="generalDocuments" in include),
            _snapshot_collection("missions", mission_total, len(missions), enabled="missions" in include),
        ],
        "sourceExclusions": source_exclusions,
        "tasks": tasks,
        "tasksOmittedFromSnapshot": task_omitted,
        "advisoryTasks": advisory_tasks,
        "advisoryTasksOmittedFromSnapshot": advisory_omitted,
        "buildJobs": build_jobs,
        "buildJobsOmittedFromSnapshot": build_jobs_omitted,
        "verifyResults": verify_results,
        "verifyResultsOmittedFromSnapshot": verify_omitted,
        "distributedWorkflows": distributed_workflows,
        "distributedWorkflowsOmittedFromSnapshot": distributed_omitted,
        "generalDocuments": general_documents,
        "generalDocumentsOmittedFromSnapshot": general_documents_omitted,
        "missions": missions,
        "missionsOmittedFromSnapshot": missions_omitted,
        "pendingDecisions": pending_decisions,
        "pendingDecisionsOmittedFromSnapshot": pending_decisions_omitted,
        "pendingDecisionSummary": _pending_decision_summary(
            pending_decisions,
            pending_decisions_omitted,
            pending_decision_source_issues,
        ),
        "pendingDecisionSourceIssues": pending_decision_source_issues,
        "brokerStateIssues": broker_state_issues,
    }


def _coordinator_progress_subject(requirement: str, limit: int = 120) -> str:
    text = " ".join((requirement or "").split())
    if not text:
        return "the status question"
    if len(text) > limit:
        text = f"{text[:limit - 3].rstrip()}..."
    return f'"{text}"'


def _coordinator_progress_collection_name(name: str) -> str:
    words = []
    current = ""
    for char in name:
        if char.isupper() and current:
            words.append(current)
            current = char.lower()
        else:
            current += char.lower()
    if current:
        words.append(current)
    return " ".join(words)


def _coordinator_join_phrases(parts: list[str]) -> str:
    if len(parts) <= 1:
        return "".join(parts)
    if len(parts) == 2:
        return f"{parts[0]} and {parts[1]}"
    return f"{', '.join(parts[:-1])}, and {parts[-1]}"


def _coordinator_progress_scope(snapshot: dict) -> str:
    collections = snapshot.get("snapshotCollections") or []
    parts = []
    for item in collections:
        name = item.get("name")
        returned = item.get("returned")
        total = item.get("totalAvailable")
        if name is not None and returned is not None and total is not None:
            parts.append(f"{returned} of {total} {_coordinator_progress_collection_name(str(name))}")
    if not parts:
        return "the selected worker records"
    return _coordinator_join_phrases(parts)


def _coordinator_progress_writer(task_id: str, requirement: str = "", snapshot: dict | None = None, *,
                         provider: str = "claude", model: str | None = None):
    """Publish live progress so a caller can tell working from hung.

    The model reports nothing until it finishes, so a waiting caller used to
    have only elapsed time. Streaming gives real phases and a running thinking
    count. Written to the task directory rather than returned, because the run
    is still in flight when this matters. Best-effort throughout: progress is
    cosmetic and must never be able to fail the run producing it.
    """
    path = common.TASKS_DIR / task_id / "progress.json"
    subject = _coordinator_progress_subject(requirement)
    scope = _coordinator_progress_scope(snapshot or {})
    started_epoch = time.time()
    provider_label = "Glimmer" if provider == "glimmer" else "Claude"
    active_model = model or (glimmer_adapter.DEFAULT_MODEL if provider == "glimmer" else claude_adapter.COORDINATOR_MODEL)
    transport_label = "Claude process" if provider == "claude" else "Glimmer request"

    def timeline_event(label: str, detail: str = "", **fields) -> dict:
        event = {
            "elapsedSeconds": round(time.time() - started_epoch, 3),
            "at": common.utc_now(),
            "label": label,
        }
        if detail:
            event["detail"] = detail
        event.update({key: value for key, value in fields.items() if value not in (None, "", [], {})})
        return event

    state = {
        "phase": f"Starting {provider_label} for {subject}",
        "provider": provider,
        "providerLabel": provider_label,
        "model": active_model,
        "thinkingTokens": 0,
        "events": 0,
        "startedAt": common.utc_now(),
        "elapsedSeconds": 0,
        "distributedWorkflows": (snapshot or {}).get("distributedWorkflows", [])[:4],
        "timeline": [],
    }

    def publish() -> None:
        state["updatedAt"] = common.utc_now()
        state["elapsedSeconds"] = round(time.time() - started_epoch, 3)
        try:
            path.write_text(json.dumps(state, sort_keys=True))
        except OSError:
            pass

    def append_timeline(label: str, detail: str = "", **fields) -> None:
        timeline = state.setdefault("timeline", [])
        if timeline and timeline[-1].get("label") == label:
            timeline[-1] = timeline_event(label, detail, **fields)
        else:
            timeline.append(timeline_event(label, detail, **fields))
        del timeline[:-COORDINATOR_PROGRESS_MAX_TIMELINE]

    last_checkpoint_tokens = {"value": 0}

    def current_checkpoint_state() -> dict:
        current = {
            "phase": state.get("phase", "coordination-report progress"),
            "elapsedSeconds": round(time.time() - started_epoch, 3),
            "thinkingTokens": int(state.get("thinkingTokens") or 0),
            "eventCount": int(state.get("events") or 0),
        }
        if isinstance(state.get("latestEventType"), str):
            current["latestEventType"] = state["latestEventType"]
        if isinstance(state.get("latestEventSubtype"), str):
            current["latestEventSubtype"] = state["latestEventSubtype"]
        return current

    def write_checkpoint(reason: str, next_action: str) -> None:
        checkpoint = _safe_write_context_checkpoint(
            task_id,
            reason=reason,
            stage="coordination-report",
            requirement=requirement,
            snapshot=snapshot,
            current_state=current_checkpoint_state(),
            next_action=next_action,
            mocked=False,
        )
        if checkpoint:
            append_timeline(
                "Context checkpoint",
                "Retained compact context for continuation and replay.",
                checkpointId=checkpoint["checkpointId"],
                checkpointPath=str(common.task_artifact_path(task_id, "context-checkpoint")),
            )

    append_timeline("Snapshot ready", f"Prepared {scope} for {subject}")
    write_checkpoint("snapshot-prepared", "Start advisory coordination reconciliation from the retained snapshot facts.")
    publish()

    def on_event(event: dict) -> None:
        state["events"] += 1
        kind, subtype = event.get("type"), event.get("subtype")
        if isinstance(event.get("pid"), int):
            state["modelPid"] = event["pid"]
        if isinstance(event.get("pgid"), int):
            state["modelPgid"] = event["pgid"]
        if "firstEventAt" not in state:
            state["firstEventAt"] = common.utc_now()
            state["firstEventSeconds"] = round(time.time() - started_epoch, 3)
        state["latestEventType"] = kind
        if subtype:
            state["latestEventSubtype"] = subtype
        if subtype == "thinking_tokens":
            state["phase"] = f"Reconciling {scope} for {subject}"
            state["thinkingTokens"] = event.get("estimated_tokens") or state["thinkingTokens"]
            if "firstThinkingTokenAt" not in state:
                state["firstThinkingTokenAt"] = common.utc_now()
                state["firstThinkingTokenSeconds"] = round(time.time() - started_epoch, 3)
                append_timeline("Thinking started", f"Model began reconciling {scope}", tokens=state["thinkingTokens"])
                last_checkpoint_tokens["value"] = int(state["thinkingTokens"] or 0)
                write_checkpoint("stream-progress", "Continue from the current thinking phase and retained snapshot facts.")
            else:
                append_timeline("Thinking update", f"Still reconciling {scope}", tokens=state["thinkingTokens"])
                tokens = int(state["thinkingTokens"] or 0)
                if tokens - last_checkpoint_tokens["value"] >= CONTEXT_CHECKPOINT_PROGRESS_TOKEN_STEP:
                    last_checkpoint_tokens["value"] = tokens
                    write_checkpoint(
                        "context-budget",
                        "Continue from the latest compact context; preserve evidence refs and unresolved facts.",
                    )
        elif subtype == "init":
            state["phase"] = f"Model stream opened for {subject}"
            append_timeline("Model stream opened", "Connection established; waiting for model events")
        elif subtype == "process_started":
            state["phase"] = f"Model process started for {subject}"
            append_timeline("Model process started", f"{transport_label} is running; waiting for stream events")
        elif subtype == "api_retry":
            state["phase"] = f"Provider retrying the model request for {subject}"
            append_timeline("Provider retry", f"{provider_label} reported a retry; waiting for the next stream event")
        elif subtype == "glimmer_request_started":
            state["phase"] = f"Glimmer request started for {subject}"
            append_timeline("Glimmer request started", f"Glimmer model {active_model} is loaded; waiting for stream chunks")
        elif kind == "assistant":
            state["phase"] = f"Writing findings from {scope} for {subject}"
            if "firstAssistantAt" not in state:
                state["firstAssistantAt"] = common.utc_now()
                state["firstAssistantSeconds"] = round(time.time() - started_epoch, 3)
                append_timeline("Writing findings", f"Assistant output started from {scope}")
                write_checkpoint("stream-progress", "Finish writing the advisory report from retained facts.")
            else:
                append_timeline("Writing update", "Assistant output is still arriving")
        elif kind == "result":
            state["phase"] = f"Finalizing the reconciled report for {subject}"
            state["resultAt"] = common.utc_now()
            state["resultSeconds"] = round(time.time() - started_epoch, 3)
            append_timeline("Result received", "Structured report returned; final validation is running")
        else:
            append_timeline("Stream event", f"{kind or 'unknown'} event received", subtype=subtype)
        publish()

    return on_event


def cmd_coordinator_report(args) -> int:
    contract = _load_or_synthesize_contract(args.task_id, args.mock)
    if contract is None:
        return emit({"status": "BLOCKED", "reason": "missing task contract", "retryable": False})
    try:
        runtime_profile = _effective_coordinator_runtime_profile(args, contract)
        model_policy = _effective_coordinator_model_policy(args, contract)
    except common.TaskBundleError as exc:
        return emit(_protocol_error_payload(str(exc)), exit_code=EXIT_PROTOCOL_ERROR)
    if runtime_profile and runtime_profile.get("modelRole") != model_policy.get("role"):
        return emit(_protocol_error_payload(
            f"contract.runtimeProfile.modelRole {runtime_profile.get('modelRole')!r} "
            f"does not match contract.modelPolicy.role {model_policy.get('role')!r}"
        ), exit_code=EXIT_PROTOCOL_ERROR)
    provider = model_policy["provider"]
    refusal = _requirement_gate(args.task_id, "coordination-report", provider, args.mock)
    if refusal:
        return emit(refusal)
    pack_identity = _coordinator_pack_identity()
    snapshot = {} if args.mock else _coordinator_state_snapshot(_effective_coordinator_snapshot_policy(args.task_id, contract))
    requirement = common.load_requirement(args.task_id)
    timeout = getattr(args, "timeout_seconds", None) or claude_adapter.COORDINATOR_TIMEOUT_SECONDS
    progress_model = model_policy["selectedModel"]
    progress = None if args.mock else _coordinator_progress_writer(
        args.task_id, requirement, snapshot, provider=provider, model=progress_model
    )
    if provider == "glimmer":
        result = glimmer_adapter.coordinator_report(
            args.task_id, "mock" if args.mock else "live",
            requirement, snapshot, pack_identity,
            timeout=timeout,
            progress=progress,
        )
        role = "glimmer"
    else:
        result = claude_adapter.coordinator_report(
            args.task_id, "mock" if args.mock else "live",
            requirement, snapshot, pack_identity,
            timeout=timeout,
            progress=progress,
        )
        role = "claude"
    if result.get("schemaVersion") == 1:
        common.write_task_artifact(args.task_id, "coordination-report", result)
    common.record_stage(args.task_id, "coordination-report", result, role=role)
    return emit(result)


WORKFLOW_CAPABILITY_VERBS = {
    "plan": "plan",
    "build": "build",
    "detached-build": "build",
    "candidate": "fix",
    "candidate-fix": "fix",
    "fix": "fix",
    "code-review": "review",
    "review": "review",
    "security-review": "adversarial",
    "adversarial": "adversarial",
    "deterministic-verify": "verify",
    "verify": "verify",
    "coordination-report": "coordination-report",
}
WORKFLOW_FINAL_NODE_STATUSES = {"SUCCEEDED", "FAILED", "BLOCKED", "WAITING"}


def _canonical_hash(value: dict) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def _workflow_identity(task_id: str, contract: dict) -> tuple[str, str, str]:
    workflow_id = contract["workflow"].get("workflowId") or task_id
    contract_hash = _canonical_hash(contract)
    run_seed = f"{task_id}|{workflow_id}|{contract_hash}"
    return workflow_id, contract_hash, "wr-" + hashlib.sha256(run_seed.encode()).hexdigest()[:24]


def _workflow_node_contract_hash(node: dict) -> str:
    normalized = {
        "id": node["id"],
        "capability": node["capability"],
        "dependsOn": node["dependsOn"],
        "policy": _workflow_node_policy(node),
    }
    if isinstance(node.get("inputs"), dict):
        normalized["inputs"] = node["inputs"]
    if isinstance(node.get("outputs"), dict):
        normalized["outputs"] = node["outputs"]
    return _canonical_hash(normalized)


def _workflow_registry_for_admission(mocked: bool) -> dict[str, dict]:
    provider_capabilities = {
        "claude": claude_adapter.status(),
        "codex": codex_adapter.status(),
        "glimmer": glimmer_adapter.status(),
    }
    registry = _capability_registry(provider_capabilities, git_ready=common.which("git") is not None)
    if not mocked:
        return registry
    return {
        capability_id: {**entry, "available": True, "missing": []}
        for capability_id, entry in registry.items()
    }


def _workflow_previous_result(task_id: str) -> dict:
    previous = common.load_task_artifact(task_id, "workflow") or {}
    return previous if isinstance(previous, dict) else {}


def _workflow_artifacts_still_valid(record: dict) -> bool:
    for artifact in record.get("artifacts", []):
        if not isinstance(artifact, dict) or not artifact.get("path") or not artifact.get("sha256"):
            return False
        path = Path(artifact["path"])
        if common.sha256_file(path) != artifact["sha256"]:
            return False
    return True


def _workflow_reusable_nodes(task_id: str, contract: dict, run_id: str,
                             contract_hash: str) -> tuple[dict[str, dict], str | None]:
    previous = _workflow_previous_result(task_id)
    if not previous:
        return {}, None
    previous_hash = previous.get("contractHash")
    previous_run_id = previous.get("workflowRunId")
    if previous_hash != contract_hash or previous_run_id != run_id:
        raise common.TaskBundleError(
            "staged workflow contract hash differs from the existing workflow run for this task")
    nodes = previous.get("nodes") if isinstance(previous, dict) else None
    if not isinstance(nodes, list):
        return {}, previous_run_id if isinstance(previous_run_id, str) else None
    current_hashes = {node["id"]: _workflow_node_contract_hash(node) for node in contract["workflow"]["nodes"]}
    return {
        str(node.get("id")): node
        for node in nodes
        if (
            isinstance(node, dict)
            and node.get("status") == "SUCCEEDED"
            and node.get("nodeContractHash") == current_hashes.get(str(node.get("id")))
            and _workflow_artifacts_still_valid(node)
        )
    }, previous_run_id if isinstance(previous_run_id, str) else None


def _workflow_refuse_changed_contract(task_id: str, run_id: str, contract_hash: str) -> None:
    previous = _workflow_previous_result(task_id)
    if not previous:
        return
    if previous.get("contractHash") != contract_hash or previous.get("workflowRunId") != run_id:
        raise common.TaskBundleError(
            "staged workflow contract hash differs from the existing workflow run for this task")


def _workflow_artifact_for(task_id: str, verb: str, payload: dict) -> dict | None:
    if verb == "verify":
        path = common.TEST_RESULTS_DIR / f"{task_id}-verify.json"
        kind = "verification"
    elif verb == "build" and payload.get("state") in {"QUEUED", "RUNNING"}:
        path = common.job_dir(task_id, "build") / "status.json"
        kind = "build-job"
    else:
        path = common.task_artifact_path(task_id, verb)
        kind = verb
    if not path.exists():
        return None
    artifact: dict = {"kind": kind, "path": str(path)}
    digest = common.sha256_file(path)
    if digest:
        artifact["sha256"] = digest
    return artifact


def _workflow_evidence_id(task_id: str, workflow_id: str, node_id: str, artifact: dict) -> str:
    identity = "|".join([
        task_id,
        workflow_id,
        node_id,
        str(artifact.get("kind") or artifact.get("artifactKind") or ""),
        str(artifact.get("path") or ""),
        str(artifact.get("sha256") or ""),
    ])
    return "ev-" + hashlib.sha256(identity.encode()).hexdigest()[:24]


def _workflow_node_by_id(nodes: list[dict]) -> dict[str, dict]:
    return {node["id"]: node for node in nodes if isinstance(node, dict) and isinstance(node.get("id"), str)}


def _workflow_evidence_item(task_id: str, workflow_id: str, node: dict, artifact: dict, *,
                            mocked: bool, accepted_by: list[str] | None = None) -> dict:
    outputs = node.get("outputs") if isinstance(node.get("outputs"), dict) else {}
    payload = node.get("payload") if isinstance(node.get("payload"), dict) else {}
    artifact_kind = str(artifact.get("kind") or artifact.get("artifactKind") or "other")
    gate_eligible = (
        not mocked
        and node.get("verb") == "verify"
        and artifact_kind == "verification"
        and outputs.get("evidenceRole") == "deterministic-acceptance"
        and payload.get("result") == "PASS"
    )
    resolved = node.get("resolvedInputs") if isinstance(node.get("resolvedInputs"), dict) else {}
    upstream = []
    if isinstance(resolved.get("commit"), dict):
        upstream.append(resolved["commit"]["nodeId"])
    upstream += [item["nodeId"] for item in resolved.get("artifacts", []) if isinstance(item, dict)]
    item = {
        "id": _workflow_evidence_id(task_id, workflow_id, node["id"], artifact),
        "nodeId": node["id"],
        "capability": node["capability"],
        "artifactKind": artifact_kind,
        "kind": artifact_kind,
        "path": artifact["path"],
        "sha256": artifact["sha256"],
        "mock": mocked,
        "gateEligible": gate_eligible,
        "producedAt": node.get("finishedAt") or common.utc_now(),
        "upstreamNodeIds": sorted(set(upstream)),
    }
    if outputs.get("schema"):
        item["schema"] = outputs["schema"]
    if outputs.get("evidenceRole"):
        item["evidenceRole"] = outputs["evidenceRole"]
    if accepted_by:
        item["acceptedBy"] = sorted(set(accepted_by))
    return item


def _workflow_accepted_evidence(task_id: str, workflow_id: str, verifier_node: dict, *, mocked: bool,
                                results: dict[str, dict]) -> list[dict]:
    inputs = verifier_node.get("inputs") if isinstance(verifier_node.get("inputs"), dict) else {}
    accepted = []
    for node_id in inputs.get("artifactsFrom", []):
        source = results.get(node_id)
        if not isinstance(source, dict):
            continue
        for artifact in source.get("artifacts", []):
            if not isinstance(artifact, dict) or not artifact.get("sha256"):
                continue
            item = _workflow_evidence_item(task_id, workflow_id, source, artifact, mocked=mocked)
            accepted.append({
                "id": item["id"],
                "nodeId": item["nodeId"],
                "path": item["path"],
                "sha256": item["sha256"],
                **({"schema": item["schema"]} if item.get("schema") else {}),
                **({"evidenceRole": item["evidenceRole"]} if item.get("evidenceRole") else {}),
            })
    return accepted


def _accepted_imported_evidence(task_id: str, workflow_id: str, resolved: dict) -> list[dict]:
    accepted = []
    for artifact in resolved.get("artifacts", []):
        if not isinstance(artifact, dict) or not artifact.get("sha256"):
            continue
        source_artifact = {
            "kind": artifact.get("kind", "imported"),
            "path": artifact.get("path") or artifact.get("localPath"),
            "sha256": artifact["sha256"],
        }
        accepted.append({
            "id": _workflow_evidence_id(task_id, workflow_id, str(artifact.get("nodeId", "")), source_artifact),
            "nodeId": artifact["nodeId"],
            "path": source_artifact["path"],
            "sha256": artifact["sha256"],
            **({"localPath": artifact["localPath"]} if artifact.get("localPath") else {}),
        })
    return accepted


def _attach_imported_accepted_evidence(task_id: str, workflow_id: str, record: dict, resolved: dict | None) -> None:
    if record.get("verb") != "verify" or not isinstance(record.get("payload"), dict) or not isinstance(resolved, dict):
        return
    accepted = _accepted_imported_evidence(task_id, workflow_id, resolved)
    if not accepted:
        return
    record["payload"]["acceptedEvidence"] = accepted
    common.write_verify_result(task_id, record["payload"])
    artifact = _workflow_artifact_for(task_id, "verify", record["payload"])
    if artifact:
        record["artifacts"] = [artifact]


def _attach_workflow_accepted_evidence(task_id: str, workflow_id: str, record: dict, *, mocked: bool,
                                       spec: dict, results: dict[str, dict]) -> None:
    if record.get("verb") != "verify" or not isinstance(record.get("payload"), dict):
        return
    accepted = _workflow_accepted_evidence(task_id, workflow_id, spec, mocked=mocked, results=results)
    if not accepted:
        return
    record["payload"]["acceptedEvidence"] = accepted
    common.write_verify_result(task_id, record["payload"])
    artifact = _workflow_artifact_for(task_id, "verify", record["payload"])
    if artifact:
        record["artifacts"] = [artifact]


def _workflow_node_status(exit_code: int, payload: dict) -> str:
    if payload.get("state") in {"QUEUED", "RUNNING"}:
        return "WAITING"
    if exit_code == EXIT_OK:
        return "SUCCEEDED"
    if exit_code == EXIT_VERIFICATION_FAIL:
        return "FAILED"
    return "BLOCKED"


def _workflow_node_policy(node: dict) -> dict:
    policy = node.get("policy") if isinstance(node.get("policy"), dict) else {}
    required = policy.get("required", True)
    blocks_on = policy.get("blocksOn")
    if blocks_on is None:
        blocks_on = ["FAILED", "BLOCKED"] if required else []
    return {
        "required": required,
        "blocksOn": blocks_on,
        "timeoutSeconds": policy.get("timeoutSeconds", 900),
    }


def _workflow_admission_schedule(nodes: list[dict], max_parallel: int) -> dict[str, int]:
    completed: set[str] = set()
    planned: dict[str, int] = {}
    batch = 1
    while len(completed) < len(nodes):
        ready = [
            node for node in nodes
            if node["id"] not in completed and all(dep in completed for dep in node["dependsOn"])
        ]
        if not ready:
            break
        for node in ready[:max_parallel]:
            planned[node["id"]] = batch
            completed.add(node["id"])
        batch += 1
    return planned


def _workflow_policy_pack_result(contract: dict, records: list[dict]) -> dict | None:
    policy_pack = contract.get("policyPack")
    required_capabilities = policy_pack.get("requiredCapabilities", [])
    forbidden_capabilities = policy_pack.get("forbiddenCapabilities", [])
    required_evidence_roles = policy_pack.get("requiredEvidenceRoles", [])
    min_verifier_count = policy_pack.get("minVerifierCount", 0)
    risk_class = policy_pack.get("riskClass", "normal")
    capabilities = {record["capability"] for record in records}
    policy_eligible_capabilities = {
        record["capability"] for record in records
        if record["decision"] != "REJECTED"
    }
    policy_eligible_roles = {
        record.get("outputs", {}).get("evidenceRole")
        for record in records
        if record["decision"] != "REJECTED" and isinstance(record.get("outputs"), dict)
    }
    policy_eligible_verifiers = [
        record for record in records
        if record["decision"] != "REJECTED" and record["capability"] in {"deterministic-verify", "verify"}
    ]
    violations = []
    for capability in required_capabilities:
        if capability not in policy_eligible_capabilities:
            violations.append(f"required capability {capability!r} is absent or rejected")
    for capability in sorted(set(forbidden_capabilities) & capabilities):
        violations.append(f"forbidden capability {capability!r} is present")
    for role in required_evidence_roles:
        if role not in policy_eligible_roles:
            violations.append(f"required evidence role {role!r} is absent or rejected")
    if len(policy_eligible_verifiers) < min_verifier_count:
        violations.append(
            f"requires at least {min_verifier_count} non-rejected verifier node(s), found {len(policy_eligible_verifiers)}")
    if risk_class in {"high", "critical"} and not ({"security-review", "adversarial"} & policy_eligible_capabilities):
        violations.append(f"{risk_class} risk requires a non-rejected security-review or adversarial capability")

    required_role_producers = {
        record["id"] for record in records
        if record["decision"] != "REJECTED"
        and isinstance(record.get("outputs"), dict)
        and record["outputs"].get("evidenceRole") in required_evidence_roles
        and record["capability"] not in {"deterministic-verify", "verify"}
    }
    if required_role_producers:
        consumed_by_verifier = set()
        for verifier in policy_eligible_verifiers:
            inputs = verifier.get("inputs") if isinstance(verifier.get("inputs"), dict) else {}
            consumed_by_verifier.update(inputs.get("artifactsFrom", []))
        missing_consumption = sorted(required_role_producers - consumed_by_verifier)
        if missing_consumption:
            violations.append(
                "required evidence is not consumed by an admitted verifier: " + ", ".join(missing_consumption))

    return {
        "id": policy_pack["id"],
        "version": policy_pack["version"],
        "registryHash": policy_pack["registryHash"],
        "riskClass": risk_class,
        "status": "SATISFIED" if not violations else "REJECTED",
        "violations": violations,
        "requiredCapabilities": required_capabilities,
        "requiredEvidenceRoles": required_evidence_roles,
        "forbiddenCapabilities": forbidden_capabilities,
        "minVerifierCount": min_verifier_count,
    }


def _handoff_artifact_ref(path: Path, *, kind: str, status: str | None = None,
                          gate_eligible: bool | None = None) -> dict:
    ref = {"kind": kind, "path": str(path)}
    digest = common.sha256_file(path)
    if digest:
        ref["sha256"] = digest
    if status is not None:
        ref["status"] = status
    if gate_eligible is not None:
        ref["gateEligible"] = gate_eligible
    return ref


SECRET_PATTERNS = [
    ("openai-api-key", re.compile(r"sk-[A-Za-z0-9_-]{20,}")),
    ("aws-access-key", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("github-token", re.compile(r"gh[pousr]_[A-Za-z0-9_]{20,}")),
    ("private-key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    (
        "named-secret",
        re.compile(
            r"(?i)(api[_-]?key|access[_-]?token|auth[_-]?token|secret|password)"
            r"\s*[:=]\s*['\"]?[A-Za-z0-9_./+=-]{12,}"
        ),
    ),
]


def _secret_scan_excerpt(text: str, start: int, end: int) -> str:
    excerpt = text[max(0, start - 12):min(len(text), end + 12)]
    return re.sub(r"[A-Za-z0-9_./+=-]", "*", excerpt)


def _redaction_report(task_id: str, mocked: bool, contract: dict, artifacts: list[dict]) -> dict:
    _workflow_id, contract_hash, run_id = _workflow_identity(task_id, contract)
    findings = []
    scanned = []
    for artifact in artifacts:
        path_value = artifact.get("path") if isinstance(artifact, dict) else None
        if not isinstance(path_value, str):
            continue
        path = Path(path_value)
        if not path.exists() or not path.is_file():
            continue
        size = path.stat().st_size
        scanned.append({"path": str(path), "sha256": common.sha256_file(path), "sizeBytes": size})
        if size > 1024 * 1024:
            findings.append({
                "path": str(path),
                "pattern": "scan-limit",
                "severity": "REVIEW",
                "excerpt": "artifact exceeded 1MiB scan limit",
            })
            continue
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        for name, pattern in SECRET_PATTERNS:
            for match in pattern.finditer(text):
                findings.append({
                    "path": str(path),
                    "pattern": name,
                    "severity": "BLOCK",
                    "excerpt": _secret_scan_excerpt(text, match.start(), match.end()),
                })
                break
    status = "REDACTION_REQUIRED" if any(item["severity"] == "BLOCK" for item in findings) else (
        "REVIEW_REQUIRED" if findings else "CLEAN")
    return {
        **common.canonical_envelope(task_id, "present-worker redaction scanner", mocked=mocked),
        "status": status,
        "workflowRunId": run_id,
        "contractHash": contract_hash,
        "exportable": status == "CLEAN",
        "scannedArtifacts": scanned,
        "findings": findings,
    }


def _workflow_gate_decision(workflow_result: dict, evidence_manifest: dict) -> tuple[str, str]:
    workflow_status = workflow_result.get("status")
    gate_verify_results = [
        node.get("payload", {}).get("result")
        for node in workflow_result.get("nodes", [])
        if (
            isinstance(node, dict)
            and node.get("verb") == "verify"
            and isinstance(node.get("payload"), dict)
            and isinstance(node.get("outputs"), dict)
            and node["outputs"].get("evidenceRole") == "deterministic-acceptance"
            and node.get("policy", {}).get("required", True) is True
        )
    ]
    if workflow_status in {"BLOCKED", "WAITING"}:
        return "BLOCKED", f"workflow status is {workflow_status}"
    if any(result == "FAIL" for result in gate_verify_results) or workflow_status == "FAILED":
        return "FAIL", "a deterministic verifier failed or blocked required workflow completion"
    if evidence_manifest.get("gateEligible") is True:
        return "PASS", "gate-eligible deterministic acceptance evidence is present"
    if any(result == "INCONCLUSIVE" for result in gate_verify_results):
        return "INCONCLUSIVE", "a deterministic verifier was inconclusive"
    return "INCONCLUSIVE", "no gate-eligible deterministic acceptance evidence is present"


def _workflow_handoff_package(task_id: str, mocked: bool, contract: dict,
                              admission: dict, workflow_result: dict,
                              evidence_manifest: dict, redaction_report: dict,
                              execution_lease: dict | None = None) -> dict:
    verification_evidence = [
        {
            "id": item["id"],
            "nodeId": item["nodeId"],
            "path": item["path"],
            "sha256": item["sha256"],
            "gateEligible": item["gateEligible"],
            **({"schema": item["schema"]} if item.get("schema") else {}),
            **({"evidenceRole": item["evidenceRole"]} if item.get("evidenceRole") else {}),
        }
        for item in evidence_manifest.get("artifacts", [])
        if item.get("evidenceRole") == "deterministic-acceptance"
    ]
    gate_decision, gate_reason = _workflow_gate_decision(workflow_result, evidence_manifest)
    policy_pack = contract["policyPack"]
    _workflow_id, contract_hash, run_id = _workflow_identity(task_id, contract)
    return {
        **common.canonical_envelope(task_id, "present-worker handoff package", mocked=mocked),
        "workflowId": workflow_result["workflowId"],
        "workflowRunId": run_id,
        "contractHash": contract_hash,
        "policyPack": {
            "id": policy_pack["id"],
            "version": policy_pack["version"],
            "registryHash": policy_pack["registryHash"],
            "riskClass": policy_pack["riskClass"],
            "status": admission["policyPack"]["status"],
        },
        "admissionArtifact": _handoff_artifact_ref(
            common.task_artifact_path(task_id, "workflow-admission"),
            kind="workflow-admission",
            status=admission["status"]),
        "workflowArtifact": _handoff_artifact_ref(
            common.task_artifact_path(task_id, "workflow"),
            kind="workflow",
            status=workflow_result["status"]),
        "evidenceManifest": _handoff_artifact_ref(
            common.task_artifact_path(task_id, "evidence-manifest"),
            kind="evidence-manifest",
            gate_eligible=bool(evidence_manifest.get("gateEligible"))),
        "redactionReport": _handoff_artifact_ref(
            common.task_artifact_path(task_id, "redaction-report"),
            kind="redaction-report",
            status=redaction_report["status"]),
        "exportable": redaction_report.get("exportable") is True,
        **({"executionLease": _lease_ref(execution_lease)} if execution_lease else {}),
        "verificationEvidence": verification_evidence,
        "gateDecision": gate_decision,
        "gateReason": gate_reason,
        "persistRecommendations": [
            {
                "target": "workflow_admissions",
                "artifact": "admissionArtifact",
                "purpose": "audit admission, scheduling, capability, and policy-pack verdicts",
            },
            {
                "target": "workflow_runs",
                "artifact": "workflowArtifact",
                "purpose": "audit node execution status, payloads, and resolved inputs",
            },
            {
                "target": "evidence_index",
                "artifact": "evidenceManifest",
                "purpose": "index normalized evidence IDs, hashes, upstream links, and verifier acceptance",
            },
            {
                "target": "gates",
                "artifact": "handoff-package",
                "purpose": "persist the deterministic gate decision and reason",
            },
            {
                "target": "artifact_exports",
                "artifact": "redactionReport",
                "purpose": "block export of artifacts that contain secrets or require manual redaction",
            },
        ],
    }


def _require_handoff_ref_integrity(ref: dict, label: str) -> None:
    path_value = ref.get("path") if isinstance(ref, dict) else None
    digest = ref.get("sha256") if isinstance(ref, dict) else None
    if not isinstance(path_value, str) or not Path(path_value).is_file():
        raise common.TaskBundleError(f"{label} does not point to an existing artifact")
    if digest != common.sha256_file(Path(path_value)):
        raise common.TaskBundleError(f"{label} sha256 does not match artifact bytes")


def _validate_workflow_handoff_consistency(workflow_result: dict, evidence_manifest: dict,
                                           redaction_report: dict, handoff_package: dict) -> None:
    expected = {
        "taskId": workflow_result.get("taskId"),
        "workflowRunId": workflow_result.get("workflowRunId"),
        "contractHash": workflow_result.get("contractHash"),
    }
    for label, payload in (
        ("evidence manifest", evidence_manifest),
        ("redaction report", redaction_report),
        ("handoff package", handoff_package),
    ):
        for key, value in expected.items():
            if payload.get(key) != value:
                raise common.TaskBundleError(f"{label} {key} differs from workflow")
    if handoff_package.get("workflowId") != workflow_result.get("workflowId"):
        raise common.TaskBundleError("handoff package workflowId differs from workflow")
    if evidence_manifest.get("workflowId") != workflow_result.get("workflowId"):
        raise common.TaskBundleError("evidence manifest workflowId differs from workflow")
    for key in ("admissionArtifact", "workflowArtifact", "evidenceManifest", "redactionReport"):
        _require_handoff_ref_integrity(handoff_package.get(key, {}), f"handoff {key}")
    evidence_ids = {
        item.get("id")
        for item in evidence_manifest.get("artifacts", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    for item in handoff_package.get("verificationEvidence", []):
        if isinstance(item, dict) and item.get("id") not in evidence_ids:
            raise common.TaskBundleError("handoff verificationEvidence references unknown evidence")
    for item in evidence_manifest.get("artifacts", []):
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            continue
        path = Path(item["path"])
        if path.exists() and item.get("sha256") != common.sha256_file(path):
            raise common.TaskBundleError(f"evidence artifact {item.get('id', '<unknown>')} sha256 differs from disk")


def _task_state_artifact_ref(task_id: str, stage: str, kind: str) -> tuple[dict | None, dict | None]:
    path = common.task_artifact_path(task_id, stage)
    if not path.exists():
        return None, None
    payload = common.load_task_artifact(task_id, stage)
    ref = {"name": stage, "kind": kind, "path": str(path)}
    digest = common.sha256_file(path)
    if digest:
        ref["sha256"] = digest
    if isinstance(payload, dict):
        status = payload.get("status") or payload.get("gateDecision")
        if isinstance(status, str):
            ref["status"] = status
        if "gateEligible" in payload:
            ref["gateEligible"] = bool(payload["gateEligible"])
        if isinstance(payload.get("workflowRunId"), str):
            ref["workflowRunId"] = payload["workflowRunId"]
        if isinstance(payload.get("contractHash"), str):
            ref["contractHash"] = payload["contractHash"]
    return ref, payload


def _path_artifact_ref(name: str, kind: str, path: Path) -> dict | None:
    if not path.exists() or not path.is_file():
        return None
    digest = common.sha256_file(path)
    if not digest:
        return None
    return {"name": name, "kind": kind, "path": str(path), "sha256": digest}


def _task_state_worker_input_refs(task_id: str) -> list[dict]:
    refs = []
    index_ref = _path_artifact_ref("imported-artifacts-index", "imported-artifacts-index",
                                   _imported_artifact_index_path(task_id))
    if index_ref:
        refs.append(index_ref)
    for path in _workflow_input_context_paths(task_id):
        ref = _path_artifact_ref(path.stem, "workflow-input-context", path)
        if ref:
            refs.append(ref)
    return refs


def _task_state_log_tail(task_id: str, limit: int = 8) -> list[dict]:
    path = common.LOGS_DIR / f"{task_id}.jsonl"
    if not path.exists():
        return []
    entries = []
    for line in path.read_text().splitlines()[-limit:]:
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(entry, dict):
            slim = {
                "stage": str(entry.get("stage", "")),
                "timestamp": str(entry.get("timestamp") or entry.get("producedAt") or ""),
            }
            status = entry.get("status") or entry.get("result") or entry.get("outcome") or entry.get("state")
            if isinstance(status, str):
                slim["status"] = status
            entries.append(slim)
    return entries


def _task_state_build_jobs(task_id: str) -> list[dict]:
    status_path = common.job_dir(task_id, "build") / "status.json"
    return _job_summaries_for_paths([status_path]) if status_path.exists() else []


def _task_state_payload(task_id: str) -> dict:
    contract = common.load_task_contract(task_id)
    contract_hash = _canonical_hash(contract) if isinstance(contract, dict) else None
    workflow_id = None
    workflow_run_id = None
    if isinstance(contract, dict) and contract.get("schemaVersion") == 3 and isinstance(contract.get("workflow"), dict):
        workflow_id, contract_hash, workflow_run_id = _workflow_identity(task_id, contract)

    artifact_specs = [
        ("workflow-admission", "workflow-admission"),
        ("workflow", "workflow"),
        ("evidence-manifest", "evidence-manifest"),
        ("redaction-report", "redaction-report"),
        ("handoff-package", "handoff-package"),
        ("worker-lease", "worker-lease"),
        ("workflow-cancel", "workflow-cancel"),
        ("context-checkpoint", "context-checkpoint"),
        ("task-cleanup", "task-cleanup"),
    ]
    artifacts = []
    payloads: dict[str, dict] = {}
    warnings = []
    for stage, kind in artifact_specs:
        ref, payload = _task_state_artifact_ref(task_id, stage, kind)
        if ref:
            artifacts.append(ref)
        if isinstance(payload, dict):
            payloads[stage] = payload
    artifacts.extend(_task_state_worker_input_refs(task_id))

    for stage, payload in payloads.items():
        artifact_hash = payload.get("contractHash")
        if contract_hash and artifact_hash and artifact_hash != contract_hash:
            warnings.append(f"{stage} contractHash differs from staged contract")
        artifact_run_id = payload.get("workflowRunId")
        if workflow_run_id and artifact_run_id and artifact_run_id != workflow_run_id:
            warnings.append(f"{stage} workflowRunId differs from staged contract")
    if "workflow" in payloads and "handoff-package" not in payloads:
        warnings.append("workflow artifact exists but handoff package is missing")
    if "handoff-package" in payloads and "evidence-manifest" not in payloads:
        warnings.append("handoff package exists but evidence manifest is missing")
    if "handoff-package" in payloads and "redaction-report" not in payloads:
        warnings.append("handoff package exists but redaction report is missing")

    workflow_payload = payloads.get("workflow", {})
    nodes = []
    for node in workflow_payload.get("nodes", []) if isinstance(workflow_payload.get("nodes"), list) else []:
        if not isinstance(node, dict):
            continue
        nodes.append({
            "id": str(node.get("id", "")),
            "capability": str(node.get("capability", "")),
            "status": str(node.get("status", "")),
            **({"nodeContractHash": node["nodeContractHash"]} if isinstance(node.get("nodeContractHash"), str) else {}),
            "reusable": (
                node.get("status") == "SUCCEEDED"
                and isinstance(node.get("nodeContractHash"), str)
                and _workflow_artifacts_still_valid(node)
            ),
        })

    handoff = payloads.get("handoff-package", {})
    if warnings:
        status = "INCONSISTENT"
    elif "workflow-cancel" in payloads:
        status = "CANCELLED"
    elif handoff:
        status = "COMPLETE"
    elif artifacts or contract:
        status = "PARTIAL"
    else:
        status = "EMPTY"

    result = {
        **common.canonical_envelope(task_id, "present-worker task state", mocked=False),
        "status": status,
        "contractPresent": contract is not None,
        "artifacts": artifacts,
        "nodes": nodes,
        "activeBuildJobs": _task_state_build_jobs(task_id),
        "lastStageLog": _task_state_log_tail(task_id),
        "warnings": warnings,
    }
    if contract_hash:
        result["contractHash"] = contract_hash
    if workflow_id:
        result["workflowId"] = workflow_id
    if workflow_run_id:
        result["workflowRunId"] = workflow_run_id
    if isinstance(handoff.get("gateDecision"), str):
        result["gateDecision"] = handoff["gateDecision"]
    if isinstance(handoff.get("gateReason"), str):
        result["gateReason"] = handoff["gateReason"]
    worker_lease = payloads.get("worker-lease")
    if isinstance(worker_lease, dict):
        result["workerLease"] = _lease_ref(worker_lease)
    return result


def cmd_task_state(args) -> int:
    return emit(_task_state_payload(args.task_id), exit_code=EXIT_OK)


def _progress_state(task_id: str) -> dict:
    path = common.TASKS_DIR / task_id / "progress.json"
    if not path.exists():
        return {}
    try:
        progress = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(progress, dict):
        return {}
    current = {
        "phase": str(progress.get("phase") or "progress checkpoint"),
        "elapsedSeconds": progress.get("elapsedSeconds", 0),
        "thinkingTokens": int(progress.get("thinkingTokens") or 0),
        "eventCount": int(progress.get("events") or 0),
    }
    if isinstance(progress.get("latestEventType"), str):
        current["latestEventType"] = progress["latestEventType"]
    if isinstance(progress.get("latestEventSubtype"), str):
        current["latestEventSubtype"] = progress["latestEventSubtype"]
    return current


def cmd_context_checkpoint(args) -> int:
    requirement = common.load_requirement(args.task_id)
    snapshot = {}
    if not args.no_snapshot and not args.mock:
        if not args.snapshot_policy:
            raise common.TaskBundleError("context-checkpoint snapshot requires --snapshot-policy")
        try:
            policy = json.loads(Path(args.snapshot_policy).read_text())
        except (OSError, json.JSONDecodeError, UnicodeDecodeError) as exc:
            raise common.TaskBundleError(f"context-checkpoint snapshot policy could not be read: {exc}") from exc
        snapshot = _coordinator_state_snapshot(policy)
    current = _progress_state(args.task_id)
    if args.phase:
        current["phase"] = args.phase
    current.setdefault("phase", f"checkpointed {args.stage}")
    checkpoint = _write_context_checkpoint(
        args.task_id,
        reason=args.reason,
        stage=args.stage,
        requirement=requirement,
        snapshot=snapshot,
        current_state=current,
        next_action=args.next_action,
        mocked=args.mock,
        resume_from_checkpoint_id=args.resume_from_checkpoint_id,
    )
    common.record_stage(args.task_id, "context-checkpoint", checkpoint, role="context-checkpointer")
    return emit(checkpoint)


def _utc_parse(value: str) -> datetime.datetime | None:
    try:
        return datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None


def _utc_from_now(seconds: int) -> str:
    expires = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=seconds)
    return expires.strftime("%Y-%m-%dT%H:%M:%SZ")


def _load_worker_lease(task_id: str) -> dict | None:
    return common.load_task_artifact(task_id, "worker-lease")


def _lease_is_active(lease: dict | None) -> bool:
    if not isinstance(lease, dict) or lease.get("status") != "ACTIVE":
        return False
    expires_at = _utc_parse(lease.get("expiresAt", ""))
    if expires_at is None:
        return False
    return expires_at > datetime.datetime.now(datetime.timezone.utc)


def _lease_ref(lease: dict) -> dict:
    status = lease.get("status", "EXPIRED")
    if status == "ACTIVE" and not _lease_is_active(lease):
        status = "EXPIRED"
    return {
        "leaseId": lease["leaseId"],
        "workerId": lease["worker"]["id"],
        "workerKind": lease["worker"]["kind"],
        "status": status,
        "contractHash": lease["contractHash"],
        "acquiredAt": lease["acquiredAt"],
        "expiresAt": lease["expiresAt"],
        "ttlSeconds": lease["ttlSeconds"],
    }


def _write_worker_lease(task_id: str, lease: dict) -> dict:
    common.write_task_artifact(task_id, "worker-lease", lease)
    common.record_stage(task_id, "worker-lease", lease, role="worker-lease")
    return lease


def _new_worker_lease(task_id: str, contract_hash: str, ttl_seconds: int, *, reason: str) -> dict:
    acquired_at = common.utc_now()
    worker = _worker_identity()
    lease_id = "wl-" + hashlib.sha256(
        "|".join([task_id, worker["id"], contract_hash, acquired_at]).encode()
    ).hexdigest()[:24]
    return {
        **common.canonical_envelope(task_id, "present-worker worker lease", mocked=False),
        "status": "ACTIVE",
        "leaseId": lease_id,
        "contractHash": contract_hash,
        "worker": worker,
        "acquiredAt": acquired_at,
        "expiresAt": _utc_from_now(ttl_seconds),
        "ttlSeconds": ttl_seconds,
        "reason": reason,
        "renewalCount": 0,
    }


def _acquire_worker_lease(task_id: str, contract_hash: str, ttl_seconds: int, *, reason: str) -> dict:
    current = _load_worker_lease(task_id)
    worker_id = _worker_identity()["id"]
    if _lease_is_active(current):
        if current["worker"]["id"] == worker_id and current["contractHash"] == contract_hash:
            return current
        raise common.TaskBundleError(
            f"task has active lease {current['leaseId']} held by {current['worker']['id']}")
    return _write_worker_lease(task_id, _new_worker_lease(task_id, contract_hash, ttl_seconds, reason=reason))


def _require_worker_lease(task_id: str, contract_hash: str, lease_id: str) -> dict:
    lease = _load_worker_lease(task_id)
    worker_id = _worker_identity()["id"]
    if not _lease_is_active(lease):
        raise common.TaskBundleError("worker lease is absent or expired")
    if lease.get("leaseId") != lease_id:
        raise common.TaskBundleError("worker lease id does not match the active lease")
    if lease.get("contractHash") != contract_hash:
        raise common.TaskBundleError("worker lease contractHash does not match the staged contract")
    if lease.get("worker", {}).get("id") != worker_id:
        raise common.TaskBundleError("worker lease is held by a different worker")
    return lease


def _renew_worker_lease(task_id: str, lease_id: str, ttl_seconds: int) -> dict:
    current = _load_worker_lease(task_id)
    if not isinstance(current, dict):
        raise common.TaskBundleError("worker lease is absent")
    lease = _require_worker_lease(task_id, current.get("contractHash", ""), lease_id)
    renewed = {
        **lease,
        "producedAt": common.utc_now(),
        "expiresAt": _utc_from_now(ttl_seconds),
        "ttlSeconds": ttl_seconds,
        "renewalCount": int(lease.get("renewalCount", 0)) + 1,
    }
    return _write_worker_lease(task_id, renewed)


def _release_worker_lease(task_id: str, lease_id: str, *, reason: str) -> dict:
    lease = _load_worker_lease(task_id)
    if not isinstance(lease, dict) or lease.get("leaseId") != lease_id:
        raise common.TaskBundleError("worker lease id does not match the active lease")
    if lease.get("worker", {}).get("id") != _worker_identity()["id"]:
        raise common.TaskBundleError("worker lease is held by a different worker")
    released = {
        **lease,
        "producedAt": common.utc_now(),
        "status": "RELEASED",
        "releasedAt": common.utc_now(),
        "releaseReason": reason,
    }
    return _write_worker_lease(task_id, released)


def cmd_worker_lease(args) -> int:
    if args.acquire:
        lease = _acquire_worker_lease(
            args.task_id, args.contract_hash, args.ttl_seconds,
            reason=args.reason or "control-plain lease acquire")
    elif args.renew:
        lease = _renew_worker_lease(args.task_id, args.lease_id, args.ttl_seconds)
    elif args.release:
        lease = _release_worker_lease(
            args.task_id, args.lease_id, reason=args.reason or "control-plain lease release")
    else:
        raise common.TaskBundleError("worker-lease requires --acquire, --renew, or --release")
    return emit(lease, exit_code=EXIT_OK)


def _exportable_artifact_path(task_id: str, kind: str) -> Path:
    if kind == "verification":
        return common.TEST_RESULTS_DIR / f"{task_id}-verify.json"
    if kind == "build-job":
        return common.job_dir(task_id, "build") / "status.json"
    return common.task_artifact_path(task_id, kind)


def cmd_artifact_export(args) -> int:
    path = _exportable_artifact_path(args.task_id, args.kind)
    if not path.exists() or not path.is_file():
        raise common.TaskBundleError(f"artifact {args.kind!r} is not available for export")
    digest = common.sha256_file(path)
    if args.sha256 and digest != args.sha256:
        raise common.TaskBundleError("artifact export sha256 does not match the requested digest")
    content = base64.b64encode(path.read_bytes()).decode("ascii")
    return emit_schema({
        **common.canonical_envelope(args.task_id, "present-worker artifact export", mocked=False),
        "status": "EXPORTED",
        "kind": args.kind,
        "sha256": digest,
        "encoding": "base64",
        "content": content,
    }, "canonical/worker-artifact-export-v1.json", "worker artifact export", exit_code=EXIT_OK)


def _imported_artifact_dir(task_id: str) -> Path:
    return common.TASKS_DIR / task_id / "imported-artifacts"


def _imported_artifact_index_path(task_id: str) -> Path:
    return _imported_artifact_dir(task_id) / "index.json"


def _load_imported_artifact_index(task_id: str) -> list[dict]:
    path = _imported_artifact_index_path(task_id)
    if not path.exists():
        return []
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return []
    items = payload.get("artifacts") if isinstance(payload, dict) else None
    return [item for item in items if isinstance(item, dict)] if isinstance(items, list) else []


def _write_imported_artifact_index(task_id: str, artifacts: list[dict]) -> None:
    path = _imported_artifact_index_path(task_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-worker artifact import index",
        "artifacts": artifacts,
    }
    common.validate_with_schema(
        payload,
        "canonical/imported-artifact-index-v1.json",
        "imported artifact index",
        validation_point="worker-write",
        artifact_kind="imported-artifact-index",
        artifact_stage="imported-artifacts",
        task_id=task_id,
        log_failure=True,
    )
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def _record_imported_artifact(task_id: str, item: dict) -> None:
    artifacts = _load_imported_artifact_index(task_id)
    identity = (item.get("sourceNodeId"), item.get("kind"), item.get("sha256"))
    replaced = False
    for index, existing in enumerate(artifacts):
        if (existing.get("sourceNodeId"), existing.get("kind"), existing.get("sha256")) == identity:
            artifacts[index] = item
            replaced = True
            break
    if not replaced:
        artifacts.append(item)
    _write_imported_artifact_index(task_id, artifacts)


def cmd_artifact_import(args) -> int:
    raw = sys.stdin.buffer.read(common.MAX_BUNDLE_BYTES + 1)
    if len(raw) > common.MAX_BUNDLE_BYTES:
        raise common.TaskBundleError(f"artifact import exceeds {common.MAX_BUNDLE_BYTES} bytes")
    try:
        payload = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise common.TaskBundleError(f"artifact import is not valid JSON: {exc}") from exc
    if not isinstance(payload, dict) or payload.get("taskId") != args.task_id:
        raise common.TaskBundleError("artifact import identity does not match the invocation")
    kind = payload.get("kind")
    digest = payload.get("sha256")
    content = payload.get("content")
    if not isinstance(kind, str) or ARTIFACT_KIND_RE.fullmatch(kind) is None:
        raise common.TaskBundleError("artifact import kind is invalid")
    if not isinstance(digest, str) or not SHA256_RE.fullmatch(digest):
        raise common.TaskBundleError("artifact import sha256 must be a sha256 hex digest")
    if payload.get("encoding") != "base64" or not isinstance(content, str):
        raise common.TaskBundleError("artifact import requires base64 content")
    data = base64.b64decode(content, validate=True)
    actual = hashlib.sha256(data).hexdigest()
    if actual != digest:
        raise common.TaskBundleError("artifact import content hash does not match sha256")
    source_node_id = payload.get("sourceNodeId")
    source_path = payload.get("sourcePath")
    path = _imported_artifact_dir(args.task_id) / digest
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_bytes(data)
    tmp.replace(path)
    result = {
        **common.canonical_envelope(args.task_id, "present-worker artifact import", mocked=False),
        "status": "IMPORTED",
        "kind": kind,
        "sha256": digest,
        "path": str(path),
        **({"sourceNodeId": source_node_id} if isinstance(source_node_id, str) and source_node_id else {}),
        **({"sourcePath": source_path} if isinstance(source_path, str) and source_path else {}),
    }
    _record_imported_artifact(args.task_id, {
        "kind": kind,
        "sha256": digest,
        "path": str(path),
        "localPath": str(path),
        **({"sourceNodeId": source_node_id} if isinstance(source_node_id, str) and source_node_id else {}),
        **({"sourcePath": source_path} if isinstance(source_path, str) and source_path else {}),
        "importedAt": result["producedAt"],
    })
    common.record_stage(args.task_id, "artifact-import", result, role="artifact-transfer")
    return emit_schema(result, "canonical/worker-artifact-import-v1.json", "worker artifact import",
                       exit_code=EXIT_OK)


def _task_handoff_ref(task_id: str) -> dict | None:
    path = common.task_artifact_path(task_id, "handoff-package")
    if not path.exists():
        return None
    payload = common.load_task_artifact(task_id, "handoff-package") or {}
    return {"path": str(path), "sha256": common.sha256_file(path), "payload": payload}


def _terminate_process_group(pid: int) -> tuple[bool, str]:
    if not _pid_running(pid):
        return False, "process is not running"
    try:
        os.killpg(pid, signal.SIGTERM)
        return True, "sent SIGTERM to process group"
    except ProcessLookupError:
        return False, "process group is not running"
    except PermissionError:
        return False, "permission denied"
    except OSError:
        try:
            os.kill(pid, signal.SIGTERM)
            return True, "sent SIGTERM to process"
        except OSError as exc:
            return False, str(exc)


def cmd_workflow_cancel(args) -> int:
    cancelled_jobs = []
    status = common.load_job_document(args.task_id, "build", "status")
    process = common.load_job_document(args.task_id, "build", "process")
    pid = process.get("pid") if isinstance(process, dict) else None
    if isinstance(status, dict) and status.get("state") in {"QUEUED", "RUNNING"} and isinstance(pid, int):
        signalled, reason = _terminate_process_group(pid)
        cancelled_jobs.append({
            "jobId": status.get("jobId", f"{args.task_id}-build"),
            "pid": pid,
            "signalled": signalled,
            "reason": reason,
        })
        common.write_job_document(args.task_id, "build", "status", {
            **status,
            "state": "CANCELLED",
            "finishedAt": common.utc_now(),
            "cancelledBy": "control-plain",
        })
    result = {
        **common.canonical_envelope(args.task_id, "present-worker workflow cancel", mocked=False),
        "status": "CANCELLED" if cancelled_jobs else "NO_ACTIVE_WORK",
        "cancelledJobs": cancelled_jobs,
        "reason": args.reason or "control-plain cancellation requested",
    }
    common.write_task_artifact(args.task_id, "workflow-cancel", result)
    common.record_stage(args.task_id, "workflow-cancel", result, role="workflow-lifecycle")
    return emit(result, exit_code=EXIT_OK)


def _cleanup_candidate_paths(task_id: str) -> list[dict]:
    candidates = []
    for role in ("glimmer", "build", "codex", "muse"):
        path = common.WORKTREES_DIR / f"{task_id}-{role}"
        if path.exists():
            candidates.append({"kind": "worktree", "role": role, "path": str(path)})
    build_job = common.job_dir(task_id, "build")
    if build_job.exists():
        candidates.append({"kind": "job", "role": "build", "path": str(build_job)})
    verify_result = common.TEST_RESULTS_DIR / f"{task_id}-verify.json"
    if verify_result.exists():
        candidates.append({"kind": "test-result", "path": str(verify_result)})
    log_path = common.LOGS_DIR / f"{task_id}.jsonl"
    if log_path.exists():
        candidates.append({"kind": "stage-log", "path": str(log_path)})
    return candidates


def _remove_cleanup_candidate(candidate: dict) -> dict:
    path = Path(candidate["path"])
    deleted = {**candidate, "removed": False}
    if not path.exists():
        deleted["removed"] = True
        return deleted
    try:
        if candidate.get("kind") == "worktree" and common.DEFAULT_REPO.exists():
            result = common.run(
                ["git", "-C", str(common.DEFAULT_REPO), "worktree", "remove", "--force", str(path)],
                timeout=30,
            )
            if result.returncode != 0 and path.exists():
                shutil.rmtree(path)
        elif path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink()
        deleted["removed"] = True
    except Exception as exc:  # noqa: BLE001
        deleted["error"] = str(exc)
    return deleted


def _task_cleanup_result(task_id: str, args, *, status: str, reason: str,
                         candidates: list[dict], deleted: list[dict]) -> dict:
    state = _task_state_payload(task_id)
    handoff = _task_handoff_ref(task_id)
    retained = [{"kind": "canonical-task-artifacts", "path": str(common.TASKS_DIR / task_id)}]
    for stage, kind in (
        ("evidence-manifest", "evidence-manifest"),
        ("redaction-report", "redaction-report"),
        ("context-checkpoint", "context-checkpoint"),
    ):
        ref, _payload = _task_state_artifact_ref(task_id, stage, kind)
        if ref:
            retained.append({"kind": kind, "path": ref["path"], "sha256": ref.get("sha256")})
    index_ref = _path_artifact_ref("imported-artifacts-index", "imported-artifacts-index",
                                   _imported_artifact_index_path(task_id))
    if index_ref:
        retained.append({"kind": "imported-artifacts-index", "path": index_ref["path"], "sha256": index_ref["sha256"]})
    if _workflow_inputs_dir(task_id).exists():
        retained.append({"kind": "workflow-inputs", "path": str(_workflow_inputs_dir(task_id))})
    for path in _workflow_input_context_paths(task_id):
        digest = common.sha256_file(path)
        if digest:
            retained.append({"kind": "workflow-input-context", "path": str(path), "sha256": digest})
    if handoff:
        retained.append({"kind": "handoff-package", "path": handoff["path"], "sha256": handoff["sha256"]})
    return {
        **common.canonical_envelope(task_id, "present-worker task cleanup", mocked=False),
        "status": status,
        "reason": reason,
        "dryRun": bool(args.dry_run and not args.force),
        "retentionPolicy": {
            "delete": ["worktrees", "jobs", "test-results", "stage-log"],
            "retain": [
                "canonical-task-artifacts",
                "handoff-package",
                "evidence-manifest",
                "redaction-report",
                "context-checkpoint",
                "imported-artifacts-index",
                "workflow-inputs",
                "workflow-input-context",
            ],
        },
        "stateStatus": state["status"],
        "contractHash": state.get("contractHash"),
        "handoffSha256": handoff.get("sha256") if handoff else None,
        "candidates": candidates,
        "deleted": deleted,
        "retained": retained,
    }


def cmd_task_cleanup(args) -> int:
    state = _task_state_payload(args.task_id)
    candidates = _cleanup_candidate_paths(args.task_id)
    handoff = _task_handoff_ref(args.task_id)
    expected_contract = state.get("contractHash")
    expected_handoff = handoff.get("sha256") if handoff else None

    if args.force:
        if not expected_contract or args.contract_hash != expected_contract:
            result = _task_cleanup_result(
                args.task_id, args, status="BLOCKED",
                reason="force cleanup requires the current contract hash",
                candidates=candidates, deleted=[])
            return emit(result, exit_code=EXIT_PROTOCOL_ERROR)
        if not expected_handoff or args.handoff_sha256 != expected_handoff:
            result = _task_cleanup_result(
                args.task_id, args, status="BLOCKED",
                reason="force cleanup requires the current handoff sha256",
                candidates=candidates, deleted=[])
            return emit(result, exit_code=EXIT_PROTOCOL_ERROR)
        if state["status"] not in {"COMPLETE", "CANCELLED"} and not args.abandoned:
            result = _task_cleanup_result(
                args.task_id, args, status="BLOCKED",
                reason="cleanup requires COMPLETE/CANCELLED state or --abandoned",
                candidates=candidates, deleted=[])
            return emit(result, exit_code=EXIT_PROTOCOL_ERROR)
        deleted = [_remove_cleanup_candidate(candidate) for candidate in candidates]
        result = _task_cleanup_result(
            args.task_id, args, status="CLEANED", reason="retention policy applied",
            candidates=candidates, deleted=deleted)
        common.write_task_artifact(args.task_id, "task-cleanup", result)
        common.record_stage(args.task_id, "task-cleanup", result, role="worker-retention")
        return emit(result, exit_code=EXIT_OK)

    result = _task_cleanup_result(
        args.task_id, args, status="DRY_RUN", reason="retention policy preview",
        candidates=candidates, deleted=[])
    return emit(result, exit_code=EXIT_OK)


def _workflow_admission_result(task_id: str, mocked: bool, contract: dict) -> dict:
    workflow = contract["workflow"]
    workflow_id, contract_hash, run_id = _workflow_identity(task_id, contract)
    nodes = workflow["nodes"]
    node_specs = _workflow_node_by_id(nodes)
    max_parallel = workflow.get("maxParallel", 1)
    registry = _workflow_registry_for_admission(mocked)
    planned = _workflow_admission_schedule(nodes, max_parallel)
    decisions: dict[str, str] = {}
    admitted_nodes: list[str] = []
    records = []
    missing_capabilities: dict[str, list[str]] = {}

    for node in nodes:
        capability = node["capability"]
        entry = registry.get(capability)
        policy = _workflow_node_policy(node)
        reasons: list[str] = []
        own_decision = "ADMITTED"
        if entry is None:
            own_decision = "REJECTED"
            reasons.append(f"capability {capability!r} is not advertised by worker status")
        else:
            if entry.get("available") is not True:
                own_decision = "WAITING_FOR_CAPABILITY"
                missing = entry.get("missing") if isinstance(entry.get("missing"), list) else []
                missing_capabilities[capability] = sorted(str(item) for item in missing)
                reasons.append(
                    f"capability {capability!r} is waiting for {', '.join(missing) if missing else 'a prerequisite'}")
            outputs = node.get("outputs") if isinstance(node.get("outputs"), dict) else {}
            output_schemas = entry.get("outputSchemas", []) if isinstance(entry, dict) else []
            evidence_roles = entry.get("evidenceRoles", []) if isinstance(entry, dict) else []
            if outputs.get("schema") and outputs["schema"] not in output_schemas:
                own_decision = "REJECTED"
                reasons.append(
                    f"output schema {outputs['schema']!r} is not emitted by capability {capability!r}")
            if outputs.get("evidenceRole") and outputs["evidenceRole"] not in evidence_roles:
                own_decision = "REJECTED"
                reasons.append(
                    f"evidence role {outputs['evidenceRole']!r} is not emitted by capability {capability!r}")

        unmet_dependencies = [dep for dep in node["dependsOn"] if decisions.get(dep) != "ADMITTED"]
        if unmet_dependencies:
            dep_decisions = {decisions.get(dep) for dep in unmet_dependencies}
            if dep_decisions <= {"WAITING_FOR_CAPABILITY"} and own_decision != "REJECTED":
                own_decision = "WAITING_FOR_CAPABILITY"
            else:
                own_decision = "REJECTED"
            reasons.append(f"depends on non-admitted nodes: {', '.join(unmet_dependencies)}")

        inputs = node.get("inputs") if isinstance(node.get("inputs"), dict) else {}
        artifact_refs = inputs.get("artifactsFrom", []) if isinstance(inputs.get("artifactsFrom", []), list) else []
        if policy["required"] and capability in {"deterministic-verify", "verify"} and node["dependsOn"]:
            missing_refs = sorted(set(node["dependsOn"]) - set(artifact_refs))
            if missing_refs:
                own_decision = "REJECTED"
                reasons.append(
                    f"required verifier does not consume artifacts from dependencies: {', '.join(missing_refs)}")
            for ref in artifact_refs:
                source_outputs = node_specs.get(ref, {}).get("outputs")
                if not isinstance(source_outputs, dict) or not source_outputs.get("schema") or not source_outputs.get("evidenceRole"):
                    own_decision = "REJECTED"
                    reasons.append(f"required verifier input {ref!r} does not declare schema and evidenceRole")

        decisions[node["id"]] = own_decision
        if own_decision == "ADMITTED":
            admitted_nodes.append(node["id"])

        record = {
            "id": node["id"],
            "capability": capability,
            "verb": WORKFLOW_CAPABILITY_VERBS[capability],
            "dependsOn": node["dependsOn"],
            "nodeContractHash": _workflow_node_contract_hash(node),
            "policy": policy,
            "decision": own_decision,
            "reasons": reasons,
        }
        if isinstance(node.get("inputs"), dict):
            record["inputs"] = node["inputs"]
        if isinstance(node.get("outputs"), dict):
            record["outputs"] = node["outputs"]
        if entry:
            record["registry"] = {
                "id": entry["id"],
                "verb": entry["verb"],
                "provider": entry["provider"],
                "authority": entry["authority"],
                "available": entry["available"],
                "missing": entry["missing"],
                "maxParallel": entry["maxParallel"],
            }
        if own_decision == "ADMITTED" and node["id"] in planned:
            record["plannedBatch"] = planned[node["id"]]
        records.append(record)

    required_issues = [
        record for record in records
        if record["decision"] != "ADMITTED" and record["policy"]["required"]
    ]
    optional_issues = [
        record for record in records
        if record["decision"] != "ADMITTED" and not record["policy"]["required"]
    ]
    policy_pack_result = _workflow_policy_pack_result(contract, records)
    if any(record["decision"] == "REJECTED" for record in required_issues):
        status = "REJECTED"
    elif policy_pack_result and policy_pack_result["status"] == "REJECTED":
        status = "REJECTED"
    elif any(record["decision"] == "WAITING_FOR_CAPABILITY" for record in required_issues):
        status = "WAITING_FOR_CAPABILITY"
    elif optional_issues:
        status = "PARTIAL"
    else:
        status = "ADMITTED"

    schedule = [
        {"batch": batch, "nodeIds": [node_id for node_id, planned_batch in planned.items() if planned_batch == batch
                                     and node_id in admitted_nodes]}
        for batch in sorted(set(planned.values()))
    ]
    schedule = [batch for batch in schedule if batch["nodeIds"]]
    result = {
        **common.canonical_envelope(task_id, "present-worker workflow admission", mocked=mocked),
        "status": status,
        "workflowId": workflow_id,
        "workflowRunId": run_id,
        "contractHash": contract_hash,
        "maxParallel": max_parallel,
        "nodes": records,
        "schedule": schedule,
        "missingCapabilities": [
            {"capability": capability, "missing": missing}
            for capability, missing in sorted(missing_capabilities.items())
        ],
        "advisoryNote": (
            "Admission validates the control-plain-authored workflow against the worker capability "
            "registry and records a schedule; it does not execute nodes or grant verification authority."
        ),
    }
    result["policyPack"] = policy_pack_result
    return result


def _imported_artifact_matches(item: dict, source_node_id: str, artifact: dict | None = None) -> bool:
    if item.get("sourceNodeId") != source_node_id:
        return False
    if artifact is None:
        return True
    if artifact.get("sha256") and item.get("sha256") != artifact.get("sha256"):
        return False
    if artifact.get("kind") and item.get("kind") != artifact.get("kind"):
        return False
    return True


def _resolve_imported_artifact(task_id: str, source_node_id: str, artifact: dict | None = None) -> dict | None:
    for item in _load_imported_artifact_index(task_id):
        if not _imported_artifact_matches(item, source_node_id, artifact):
            continue
        local_path = item.get("localPath") or item.get("path")
        digest = item.get("sha256")
        if not isinstance(local_path, str) or not isinstance(digest, str):
            continue
        path = Path(local_path)
        if common.sha256_file(path) != digest:
            continue
        return item
    return None


def _resolved_artifact_input(task_id: str, source_node_id: str, artifact: dict | None) -> dict | None:
    imported = _resolve_imported_artifact(task_id, source_node_id, artifact)
    if artifact is None and imported is None:
        return None
    result = {"nodeId": source_node_id}
    if artifact is not None:
        result.update(artifact)
    if imported is not None:
        result.setdefault("kind", imported.get("kind", "imported"))
        result.setdefault("path", imported.get("sourcePath") or imported.get("path"))
        result.setdefault("sha256", imported.get("sha256"))
        result["localPath"] = imported.get("localPath") or imported.get("path")
    if "path" not in result and imported is not None:
        result["path"] = imported.get("path")
    return result if result.get("kind") and result.get("path") else None


def _workflow_resolved_inputs(task_id: str, node: dict, results: dict[str, dict]) -> dict | None:
    inputs = node.get("inputs")
    if not isinstance(inputs, dict):
        return None
    resolved_inputs: dict = {}
    commit_from = inputs.get("commitFrom")
    if commit_from:
        source = results.get(commit_from, {})
        payload = source.get("payload") if isinstance(source.get("payload"), dict) else {}
        provenance = payload.get("provenance") if isinstance(payload.get("provenance"), dict) else {}
        commit = provenance.get("commit")
        resolved_inputs["commit"] = {"nodeId": commit_from, **({"commit": commit} if commit else {})}
    resolved_artifacts = []
    for node_id in inputs.get("artifactsFrom", []):
        source_artifacts = results.get(node_id, {}).get("artifacts", [])
        if source_artifacts:
            for artifact in source_artifacts:
                resolved_artifact = _resolved_artifact_input(task_id, node_id, artifact)
                if resolved_artifact:
                    resolved_artifacts.append(resolved_artifact)
        else:
            for imported in _load_imported_artifact_index(task_id):
                if imported.get("sourceNodeId") == node_id:
                    local_path = imported.get("localPath") or imported.get("path")
                    digest = imported.get("sha256")
                    if isinstance(local_path, str) and isinstance(digest, str) and common.sha256_file(Path(local_path)) == digest:
                        resolved_artifacts.append({
                            "nodeId": node_id,
                            "kind": imported.get("kind", "imported"),
                            "path": imported.get("sourcePath") or imported.get("path"),
                            "sha256": digest,
                            "localPath": local_path,
                        })
    if resolved_artifacts:
        resolved_inputs["artifacts"] = resolved_artifacts
    return resolved_inputs


def _run_workflow_node(task_id: str, node: dict, *, mocked: bool, resolved_inputs: dict | None = None) -> dict:
    capability = node["capability"]
    verb = WORKFLOW_CAPABILITY_VERBS[capability]
    command = [sys.executable, str(Path(__file__).resolve()), verb, task_id]
    if mocked:
        command.append("--mock")
    policy = _workflow_node_policy(node)
    started = common.utc_now()
    env = common.execution_env()
    input_context_path = _write_workflow_input_context(task_id, node["id"], resolved_inputs)
    if input_context_path is not None:
        env[WORKFLOW_INPUTS_ENV] = str(input_context_path)
    _safe_write_context_checkpoint(
        task_id,
        reason="snapshot-prepared",
        stage=f"workflow-node:{node['id']}",
        requirement=common.load_requirement(task_id),
        snapshot=None,
        current_state={"phase": f"Executing workflow node {node['id']}", "eventCount": 0},
        next_action=f"Run {verb} for workflow node {node['id']} using resolved input artifacts.",
        mocked=mocked,
    )
    try:
        result = subprocess.run(
            command, capture_output=True, text=True, timeout=policy["timeoutSeconds"], env=env)
        payload_text = result.stdout if result.returncode == EXIT_OK else result.stderr
        try:
            payload = json.loads(payload_text)
        except json.JSONDecodeError:
            payload = {"status": "PROTOCOL_ERROR", "reason": payload_text.strip()[-1000:], "retryable": False}
        exit_code = result.returncode
        status = _workflow_node_status(exit_code, payload)
    except subprocess.TimeoutExpired:
        exit_code = EXIT_PROTOCOL_ERROR
        status = "BLOCKED"
        payload = {
            "status": "PROTOCOL_ERROR",
            "reason": f"workflow node {node['id']} exceeded {policy['timeoutSeconds']}s",
            "retryable": True,
        }
    record = {
        "id": node["id"],
        "capability": capability,
        "verb": verb,
        "dependsOn": node["dependsOn"],
        "nodeContractHash": _workflow_node_contract_hash(node),
        "policy": policy,
        "status": status,
        "exitCode": exit_code,
        "startedAt": started,
        "finishedAt": common.utc_now(),
        "payload": payload,
    }
    if isinstance(node.get("inputs"), dict):
        record["inputs"] = node["inputs"]
    if isinstance(node.get("outputs"), dict):
        record["outputs"] = node["outputs"]
    artifact = _workflow_artifact_for(task_id, verb, payload)
    if artifact:
        record["artifacts"] = [artifact]
    return record


def cmd_workflow_node(args) -> int:
    contract = common.load_task_contract(args.task_id)
    if contract is None:
        return emit({"status": "BLOCKED", "reason": "missing workflow contract", "retryable": False},
                    exit_code=EXIT_PROTOCOL_ERROR)
    contract = common.validate_workflow_contract(contract, args.task_id)
    _workflow_id, contract_hash, _run_id = _workflow_identity(args.task_id, contract)
    _require_worker_lease(args.task_id, contract_hash, args.lease_id)
    nodes = _workflow_node_by_id(contract["workflow"]["nodes"])
    node = nodes.get(args.node_id)
    if node is None:
        raise common.TaskBundleError(f"workflow node {args.node_id!r} is not in the staged contract")
    resolved = _workflow_resolved_inputs(args.task_id, node, {})
    record = _run_workflow_node(args.task_id, node, mocked=args.mock, resolved_inputs=resolved)
    if resolved:
        record["resolvedInputs"] = resolved
        _attach_imported_accepted_evidence(args.task_id, contract["workflow"].get("workflowId") or args.task_id,
                                           record, resolved)
    common.write_task_artifact(args.task_id, f"workflow-node-{args.node_id}", record)
    common.record_stage(args.task_id, f"workflow-node-{args.node_id}", record, role="workflow-node-runner")
    return emit(record, exit_code=EXIT_OK if record["status"] in {"SUCCEEDED", "WAITING"} else EXIT_PROTOCOL_ERROR)


def _workflow_topological_ready(nodes: list[dict], completed: set[str], terminal: set[str]) -> list[dict]:
    return [
        node for node in nodes
        if node["id"] not in terminal and all(dep in completed for dep in node["dependsOn"])
    ]


def _workflow_evidence_items(task_id: str, mocked: bool, contract: dict, nodes: list[dict]) -> list[dict]:
    workflow = contract["workflow"]
    workflow_id = workflow.get("workflowId") or task_id
    accepted_by: dict[str, list[str]] = {}
    for node in nodes:
        payload = node.get("payload") if isinstance(node.get("payload"), dict) else {}
        if node.get("verb") != "verify" or not isinstance(payload.get("acceptedEvidence"), list):
            continue
        for item in payload["acceptedEvidence"]:
            if isinstance(item, dict) and isinstance(item.get("id"), str):
                accepted_by.setdefault(item["id"], []).append(node["id"])

    evidence = []
    for node in nodes:
        for artifact in node.get("artifacts", []):
            if isinstance(artifact, dict) and artifact.get("sha256"):
                item = _workflow_evidence_item(
                    task_id, workflow_id, node, artifact, mocked=mocked,
                    accepted_by=accepted_by.get(_workflow_evidence_id(task_id, workflow_id, node["id"], artifact)))
                evidence.append(item)
    return evidence


def _workflow_evidence_manifest(task_id: str, mocked: bool, contract: dict, nodes: list[dict]) -> dict:
    evidence = _workflow_evidence_items(task_id, mocked, contract, nodes)
    contains_mock = mocked or any(item["mock"] for item in evidence)
    workflow_id, contract_hash, run_id = _workflow_identity(task_id, contract)
    return {
        **common.canonical_envelope(task_id, "present-worker evidence manifest", mocked=mocked),
        "workflowId": workflow_id,
        "workflowRunId": run_id,
        "contractHash": contract_hash,
        "gateEligible": (not contains_mock) and any(item["gateEligible"] for item in evidence),
        "containsMock": contains_mock,
        "artifacts": evidence,
    }


def _workflow_result(task_id: str, mocked: bool, contract: dict, nodes: list[dict], status: str, *,
                     fresh_nodes: list[str], reused_nodes: list[str],
                     resumed_from_run_id: str | None = None,
                     execution_lease: dict | None = None) -> dict:
    workflow = contract["workflow"]
    workflow_id, contract_hash, run_id = _workflow_identity(task_id, contract)
    result = {
        **common.canonical_envelope(task_id, "present-worker workflow", mocked=mocked),
        "status": status,
        "workflowId": workflow_id,
        "workflowRunId": run_id,
        "contractHash": contract_hash,
        "maxParallel": workflow.get("maxParallel", 1),
        "freshNodes": fresh_nodes,
        "reusedNodes": reused_nodes,
        "nodes": nodes,
        "evidence": _workflow_evidence_items(task_id, mocked, contract, nodes),
        "advisoryNote": (
            "Workflow orchestration is control-plain-authored. Node agents may produce advisory "
            "or candidate artifacts, but only deterministic verify can produce production PASS evidence."
        ),
    }
    if resumed_from_run_id:
        result["resumedFromRunId"] = resumed_from_run_id
    if execution_lease:
        result["executionLease"] = _lease_ref(execution_lease)
    return result


def cmd_workflow(args) -> int:
    mocked = args.mock
    contract = common.load_task_contract(args.task_id)
    if contract is None:
        return emit({"status": "BLOCKED", "reason": "missing workflow contract", "retryable": False})
    contract = common.validate_workflow_contract(contract, args.task_id)
    workflow_id, contract_hash, run_id = _workflow_identity(args.task_id, contract)
    _workflow_refuse_changed_contract(args.task_id, run_id, contract_hash)
    if getattr(args, "admit_only", False):
        result = _workflow_admission_result(args.task_id, mocked, contract)
        common.write_task_artifact(args.task_id, "workflow-admission", result)
        common.record_stage(args.task_id, "workflow-admission", result, role="workflow-admission")
        exit_code = EXIT_PROTOCOL_ERROR if result["status"] == "REJECTED" else EXIT_OK
        return emit(result, exit_code=exit_code)
    workflow = contract["workflow"]
    admission = _workflow_admission_result(args.task_id, mocked, contract)
    common.write_task_artifact(args.task_id, "workflow-admission", admission)
    common.record_stage(args.task_id, "workflow-admission", admission, role="workflow-admission")
    if admission["status"] not in {"ADMITTED", "PARTIAL"}:
        exit_code = EXIT_OK if admission["status"] == "WAITING_FOR_CAPABILITY" else EXIT_PROTOCOL_ERROR
        return emit(admission, exit_code=exit_code)
    execution_lease = (
        _require_worker_lease(args.task_id, contract_hash, args.lease_id)
        if getattr(args, "lease_id", "")
        else _acquire_worker_lease(
            args.task_id, contract_hash, args.lease_ttl_seconds,
            reason="workflow execution auto-lease")
    )
    auto_lease = not bool(getattr(args, "lease_id", ""))
    nodes = workflow["nodes"]
    previous, resumed_from_run_id = _workflow_reusable_nodes(args.task_id, contract, run_id, contract_hash)
    results: dict[str, dict] = {
        node_id: node for node_id, node in previous.items()
        if node.get("status") == "SUCCEEDED"
    }
    reused_nodes = sorted(results)
    fresh_nodes: list[str] = []
    completed = set(results)
    terminal = set(results)
    max_parallel = workflow.get("maxParallel", 1)
    status = "SUCCEEDED"

    while len(terminal) < len(nodes):
        ready = _workflow_topological_ready(nodes, completed, terminal)
        if not ready:
            status = "BLOCKED"
            break
        with concurrent.futures.ThreadPoolExecutor(max_workers=max_parallel) as pool:
            futures = {
                pool.submit(
                    _run_workflow_node,
                    args.task_id,
                    node,
                    mocked=mocked,
                    resolved_inputs=_workflow_resolved_inputs(args.task_id, node, results),
                ): node
                for node in ready[:max_parallel]
            }
            for future in concurrent.futures.as_completed(futures):
                record = future.result()
                resolved = _workflow_resolved_inputs(args.task_id, futures[future], results)
                if resolved:
                    record["resolvedInputs"] = resolved
                _attach_workflow_accepted_evidence(
                    args.task_id, workflow.get("workflowId") or args.task_id, record,
                    mocked=mocked, spec=futures[future], results=results)
                results[record["id"]] = record
                terminal.add(record["id"])
                fresh_nodes.append(record["id"])
                policy = record.get("policy") if isinstance(record.get("policy"), dict) else _workflow_node_policy({})
                if record["status"] == "WAITING":
                    status = "WAITING"
                elif record["status"] in set(policy.get("blocksOn") or []):
                    status = "FAILED" if record["status"] == "FAILED" else "BLOCKED"
                else:
                    completed.add(record["id"])
        if status != "SUCCEEDED":
            break

    ordered = [results[node["id"]] for node in nodes if node["id"] in results]
    if status == "SUCCEEDED" and len(completed) != len(nodes):
        status = "BLOCKED"
    result = _workflow_result(
        args.task_id, mocked, contract, ordered, status,
        fresh_nodes=fresh_nodes,
        reused_nodes=reused_nodes,
        resumed_from_run_id=resumed_from_run_id if reused_nodes else None,
        execution_lease=execution_lease)
    evidence_manifest = _workflow_evidence_manifest(args.task_id, mocked, contract, ordered)
    common.write_task_artifact(args.task_id, "workflow", result)
    common.write_task_artifact(args.task_id, "evidence-manifest", evidence_manifest)
    redaction_inputs = [
        {"path": str(common.task_artifact_path(args.task_id, "workflow-admission"))},
        {"path": str(common.task_artifact_path(args.task_id, "workflow"))},
        {"path": str(common.task_artifact_path(args.task_id, "evidence-manifest"))},
        {"path": str(common.task_artifact_path(args.task_id, "context-checkpoint"))},
        {"path": str(_imported_artifact_index_path(args.task_id))},
        *({"path": str(path)} for path in _workflow_input_context_paths(args.task_id)),
        *evidence_manifest.get("artifacts", []),
    ]
    redaction_report = _redaction_report(args.task_id, mocked, contract, redaction_inputs)
    common.write_task_artifact(args.task_id, "redaction-report", redaction_report)
    handoff_package = _workflow_handoff_package(
        args.task_id, mocked, contract, admission, result, evidence_manifest, redaction_report, execution_lease)
    _validate_workflow_handoff_consistency(result, evidence_manifest, redaction_report, handoff_package)
    common.write_task_artifact(args.task_id, "handoff-package", handoff_package)
    common.record_stage(args.task_id, "evidence-manifest", evidence_manifest, role="workflow-evidence-normalizer")
    common.record_stage(args.task_id, "redaction-report", redaction_report, role="artifact-redaction-scanner")
    common.record_stage(args.task_id, "handoff-package", handoff_package, role="workflow-handoff")
    common.record_stage(args.task_id, "workflow", result, role="workflow-dag-runner")
    if auto_lease and status != "WAITING":
        _release_worker_lease(args.task_id, execution_lease["leaseId"], reason="workflow execution completed")
    exit_code = EXIT_OK if status in {"SUCCEEDED", "WAITING"} else (
        EXIT_VERIFICATION_FAIL if status == "FAILED" else EXIT_PROTOCOL_ERROR
    )
    return emit(result, exit_code=exit_code)


def cmd_specialist(args) -> int:
    result = {
        "status": "DEPRECATED", "task_id": args.task_id, "verb": "specialist",
        "reason": "SPEC-01 resolved: no responsibility distinct from plan, review, fix, or adversarial",
        "retryable": False,
    }
    common.record_stage(args.task_id, "specialist", result)
    return emit(result, exit_code=EXIT_PROTOCOL_ERROR)


def _verification_tree(task_id: str, target: str) -> tuple[Path, str | None]:
    """Resolve the tree that actually holds the commit under test.

    A fix writes its commit into worktrees/<task-id>-codex. Verifying the base
    checkout instead reports on a tree that does not contain the work, which is
    how a fabricated fix went unexamined on 2026-08-16. If the produced commit
    cannot be located, that is INCONCLUSIVE -- never a quiet fallback to the
    base tree, which would reproduce the defect with better logging.
    """
    base = common.WORKER_DIR if target == "worker" else common.DEFAULT_REPO
    produced = _latest_stage_output_commit(task_id, "fix")
    if not produced or produced == common.git_rev_parse(base):
        return base, None
    worktree = _worktree_path(task_id, "codex")
    if worktree.exists() and common.git_rev_parse(worktree) == produced:
        return worktree, None
    return base, (f"fix recorded produced commit {produced[:12]} for {task_id}, but no worktree holds it; "
                  "verifying the base tree would report on work that is not under test")


def cmd_verify(args) -> int:
    contract = _load_or_synthesize_contract(args.task_id, args.mock)
    if contract is None:
        result = verifier.inconclusive(args.task_id, reason="missing task contract", commit="", mocked=False)
    else:
        tree, unreachable = _verification_tree(args.task_id, (contract.get("verification") or {}).get("target", "worker"))
        if unreachable and not args.mock:
            result = verifier.inconclusive(args.task_id, reason=unreachable, commit="", mocked=False)
        else:
            result = verifier.verify_contract(
                args.task_id, contract, mocked=args.mock, tree=tree,
                input_context=_workflow_input_context_from_env())
    common.record_stage(args.task_id, "verify", result)
    common.write_verify_result(args.task_id, result)
    if args.mock:
        return emit(result, exit_code=EXIT_OK)
    return emit(result, exit_code=EXIT_OK if result.get("result") == "PASS" and result.get("mock") is False else EXIT_VERIFICATION_FAIL)


def build_parser() -> argparse.ArgumentParser:
    parser = ContractArgumentParser(prog="present-worker")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("tool-contracts").set_defaults(func=cmd_tool_contracts)
    sub.add_parser("doctor").set_defaults(func=cmd_doctor)
    sub.add_parser("version").set_defaults(func=cmd_version)
    glimmer = sub.add_parser("glimmer")
    glimmer_sub = glimmer.add_subparsers(dest="glimmer_command", required=True)
    glimmer_sub.add_parser("start").set_defaults(func=cmd_glimmer_start)
    glimmer_sub.add_parser("stop").set_defaults(func=cmd_glimmer_stop)
    glimmer_sub.add_parser("status").set_defaults(func=cmd_glimmer_status)
    cleanup = sub.add_parser("cleanup")
    cleanup.add_argument("--dry-run", action="store_true", default=True)
    cleanup.add_argument("--force", action="store_true", default=False)
    cleanup.set_defaults(func=cmd_cleanup)
    internal = sub.add_parser("_run-build")
    internal.add_argument("task_id")
    internal.set_defaults(func=lambda args: _run_build_job(args.task_id))
    task_state = sub.add_parser("task-state")
    task_state.add_argument("task_id")
    task_state.set_defaults(func=cmd_task_state)
    checkpoint = sub.add_parser("context-checkpoint")
    checkpoint.add_argument("task_id")
    checkpoint.add_argument("--stage", default="coordination-report")
    checkpoint.add_argument(
        "--reason",
        choices=["snapshot-prepared", "stream-progress", "context-budget", "manual", "resume"],
        default="manual",
    )
    checkpoint.add_argument("--phase", default="")
    checkpoint.add_argument("--next-action", default="")
    checkpoint.add_argument("--resume-from-checkpoint-id", default=None)
    checkpoint.add_argument("--no-snapshot", action="store_true", default=False)
    checkpoint.add_argument("--snapshot-policy", default="")
    checkpoint.add_argument("--mock", action="store_true", default=False)
    checkpoint.set_defaults(func=cmd_context_checkpoint)
    workflow_cancel = sub.add_parser("workflow-cancel")
    workflow_cancel.add_argument("task_id")
    workflow_cancel.add_argument("--reason", default="")
    workflow_cancel.set_defaults(func=cmd_workflow_cancel)
    task_cleanup = sub.add_parser("task-cleanup")
    task_cleanup.add_argument("task_id")
    task_cleanup.add_argument("--dry-run", action="store_true", default=True)
    task_cleanup.add_argument("--force", action="store_true", default=False)
    task_cleanup.add_argument("--contract-hash", default="")
    task_cleanup.add_argument("--handoff-sha256", default="")
    task_cleanup.add_argument("--abandoned", action="store_true", default=False)
    task_cleanup.set_defaults(func=cmd_task_cleanup)
    worker_lease = sub.add_parser("worker-lease")
    worker_lease.add_argument("task_id")
    action = worker_lease.add_mutually_exclusive_group(required=True)
    action.add_argument("--acquire", action="store_true", default=False)
    action.add_argument("--renew", action="store_true", default=False)
    action.add_argument("--release", action="store_true", default=False)
    worker_lease.add_argument("--contract-hash", default="")
    worker_lease.add_argument("--lease-id", default="")
    worker_lease.add_argument("--ttl-seconds", type=int, default=3600)
    worker_lease.add_argument("--reason", default="")
    worker_lease.set_defaults(func=cmd_worker_lease)
    artifact_export = sub.add_parser("artifact-export")
    artifact_export.add_argument("task_id")
    artifact_export.add_argument("kind")
    artifact_export.add_argument("--sha256", default="")
    artifact_export.set_defaults(func=cmd_artifact_export)
    artifact_import = sub.add_parser("artifact-import")
    artifact_import.add_argument("task_id")
    artifact_import.set_defaults(func=cmd_artifact_import)
    model_roles = sub.add_parser("model-roles")
    model_roles.set_defaults(func=cmd_model_roles)
    model_role_save = sub.add_parser("model-role-save")
    model_role_save.add_argument("--operator-role", default="local-user")
    model_role_save.set_defaults(func=cmd_model_role_save)
    model_role_delete = sub.add_parser("model-role-delete")
    model_role_delete.add_argument("role")
    model_role_delete.add_argument("--operator-role", default="local-user")
    model_role_delete.add_argument("--force", action="store_true", default=False)
    model_role_delete.set_defaults(func=cmd_model_role_delete)
    model_role_resolve = sub.add_parser("model-role-resolve")
    model_role_resolve.add_argument("role", nargs="?", default=os.environ.get("STEEL_MISSION_COORDINATOR_ROLE", DEFAULT_COORDINATOR_ROLE))
    model_role_resolve.add_argument("--provider", choices=["claude", "glimmer"], default=None)
    model_role_resolve.add_argument("--ignore-readiness", action="store_true", default=False)
    model_role_resolve.set_defaults(func=cmd_model_role_resolve)
    runtime_profiles = sub.add_parser("runtime-profiles")
    runtime_profiles.set_defaults(func=cmd_runtime_profiles)
    runtime_profile_validate = sub.add_parser("runtime-profile-validate")
    runtime_profile_validate.set_defaults(func=cmd_runtime_profile_validate)
    runtime_profile_save = sub.add_parser("runtime-profile-save")
    runtime_profile_save.add_argument("--operator-role", default="local-user")
    runtime_profile_save.set_defaults(func=cmd_runtime_profile_save)
    runtime_profile_clone = sub.add_parser("runtime-profile-clone")
    runtime_profile_clone.add_argument("source")
    runtime_profile_clone.add_argument("new_id")
    runtime_profile_clone.add_argument("--label", default="")
    runtime_profile_clone.add_argument("--operator-role", default="local-user")
    runtime_profile_clone.set_defaults(func=cmd_runtime_profile_clone)
    runtime_profile_resolve = sub.add_parser("runtime-profile-resolve")
    runtime_profile_resolve.add_argument(
        "profile",
        nargs="?",
        default=os.environ.get("STEEL_MISSION_RUNTIME_PROFILE", DEFAULT_RUNTIME_PROFILE),
    )
    runtime_profile_resolve.add_argument("--ignore-readiness", action="store_true", default=False)
    runtime_profile_resolve.set_defaults(func=cmd_runtime_profile_resolve)
    workflow_node = sub.add_parser("workflow-node")
    workflow_node.add_argument("task_id")
    workflow_node.add_argument("node_id")
    workflow_node.add_argument("--lease-id", required=True)
    workflow_node.add_argument("--mock", action="store_true", default=False)
    workflow_node.set_defaults(func=cmd_workflow_node)
    for name, func in (("plan", cmd_plan), ("specialist", cmd_specialist), ("build", cmd_build),
                       ("review", cmd_review), ("fix", cmd_fix), ("adversarial", cmd_adversarial),
                       ("verify", cmd_verify), ("coordination-report", cmd_coordinator_report), ("workflow", cmd_workflow)):
        command = sub.add_parser(name)
        command.add_argument("task_id")
        command.add_argument("--mock", action="store_true", default=False)
        # One caller-supplied budget governs the model call, so a caller that
        # imposes its own deadline can make the inner call give up first and
        # return a clean error instead of being killed with nothing recorded.
        command.add_argument("--timeout-seconds", type=int, default=None)
        if name == "workflow":
            command.add_argument("--admit-only", action="store_true", default=False)
            command.add_argument("--lease-id", default="")
            command.add_argument("--lease-ttl-seconds", type=int, default=3600)
        if name == "coordination-report":
            command.add_argument(
                "--provider",
                choices=["claude", "glimmer"],
                default=None,
                help="Compatibility override; prefer --role for new callers.",
            )
            command.add_argument("--role", default=os.environ.get("STEEL_MISSION_COORDINATOR_ROLE"))
            command.add_argument("--profile", default=os.environ.get("STEEL_MISSION_RUNTIME_PROFILE"))
        command.set_defaults(func=func)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        if hasattr(args, "task_id") and not TASK_ID_RE.fullmatch(args.task_id):
            raise common.TaskBundleError("task id must match DEV-NNNNNN")
        if hasattr(args, "lease_id") and args.lease_id and not LEASE_ID_RE.fullmatch(args.lease_id):
            raise common.TaskBundleError("lease id must match wl-<24 hex chars>")
        if hasattr(args, "contract_hash") and args.contract_hash and not SHA256_RE.fullmatch(args.contract_hash):
            raise common.TaskBundleError("contract hash must be a sha256 hex digest")
        if hasattr(args, "node_id") and re.fullmatch(common.WORKFLOW_NODE_ID_RE, args.node_id) is None:
            raise common.TaskBundleError(f"workflow node id must match {common.WORKFLOW_NODE_ID_RE}")
        if hasattr(args, "kind") and ARTIFACT_KIND_RE.fullmatch(args.kind) is None:
            raise common.TaskBundleError("artifact kind is invalid")
        if hasattr(args, "sha256") and args.sha256 and not SHA256_RE.fullmatch(args.sha256):
            raise common.TaskBundleError("artifact sha256 must be a sha256 hex digest")
        if hasattr(args, "ttl_seconds") and not 30 <= args.ttl_seconds <= 86400:
            raise common.TaskBundleError("lease ttl must be 30..86400 seconds")
        if hasattr(args, "lease_ttl_seconds") and not 30 <= args.lease_ttl_seconds <= 86400:
            raise common.TaskBundleError("workflow lease ttl must be 30..86400 seconds")
        if args.command == "worker-lease":
            if args.acquire and not args.contract_hash:
                raise common.TaskBundleError("worker-lease --acquire requires --contract-hash")
            if (args.renew or args.release) and not args.lease_id:
                raise common.TaskBundleError("worker-lease --renew/--release require --lease-id")
        if args.command in {
            "plan", "specialist", "build", "review", "fix", "adversarial", "verify", "coordination-report",
            "workflow", "workflow-node",
        }:
            common.receive_task_bundle(args.task_id, args.command)
        return args.func(args)
    except common.TaskBundleError as exc:
        print(json.dumps(_protocol_error_payload(
            str(exc),
            validation_error=exc.report if isinstance(exc, common.SchemaValidationError) else None,
        ), indent=2), file=sys.stderr)
        return EXIT_PROTOCOL_ERROR
    except Exception as exc:  # noqa: BLE001
        print(json.dumps(_protocol_error_payload(f"unhandled worker error: {exc}", retryable=True), indent=2),
              file=sys.stderr)
        eprint(f"present-worker: unhandled error: {exc!r}")
        return EXIT_PROTOCOL_ERROR


if __name__ == "__main__":
    sys.exit(main())
