def cmd_capability_drift(args) -> int:
    try:
        pool = _load_pool(args.pool)
        drift = []
        for worker in pool.get("workers", []):
            if not isinstance(worker, dict):
                continue
            previous = worker.get("status") if isinstance(worker.get("status"), dict) else {}
            code, current, error, _stdout, _stderr = _invoke_worker(worker, ["status"], timeout=30)
            worker_id = str(worker.get("id") or previous.get("detail", {}).get("workerIdentity", {}).get("id") or "<unknown>")
            if code != 0 or not current:
                drift.append({"workerId": worker_id, "status": "UNREACHABLE", "reason": error.get("reason", "status failed")})
                continue
            old_caps = set((previous.get("detail", {}).get("capabilityRegistry", {}) or {}).keys())
            new_caps = set((current.get("detail", {}).get("capabilityRegistry", {}) or {}).keys())
            old_identity = previous.get("detail", {}).get("workerIdentity", {}) if isinstance(previous.get("detail"), dict) else {}
            new_identity = current.get("detail", {}).get("workerIdentity", {}) if isinstance(current.get("detail"), dict) else {}
            changes = {
                "addedCapabilities": sorted(new_caps - old_caps),
                "removedCapabilities": sorted(old_caps - new_caps),
                "protocolChanged": previous.get("detail", {}).get("protocolVersion") != current.get("detail", {}).get("protocolVersion")
                if isinstance(previous.get("detail"), dict) and isinstance(current.get("detail"), dict) else False,
                "trustChanged": old_identity.get("trustLevel") != new_identity.get("trustLevel"),
            }
            drift.append({
                "workerId": worker_id,
                "status": "DRIFT" if any(bool(value) for value in changes.values()) else "STABLE",
                **changes,
            })
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "CAPABILITY_DRIFT",
            "workers": drift,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_lease_timeline(args) -> int:
    try:
        state = _load_query_state(args.state)
        events = []
        for event in _query_events(state, args.task_id):
            if event.get("type") in {
                "distributed-node-dispatch", "distributed-node-release", "distributed-lease-rejected",
                "renew", "release", "failover-leased", "recover-applied", "recovery-action-applied",
            }:
                events.append(event)
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "LEASE_TIMELINE",
            "events": events,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _snapshot_export(state: dict[str, Any], pool: dict[str, Any] | None,
                     provisioners: list[dict[str, Any]]) -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker state export",
        "schemaRegistryHash": common.schema_registry_hash(),
        "state": state,
        "workerPool": pool or {},
        "provisioners": provisioners,
    }


def cmd_state_export(args) -> int:
    try:
        state = _load_query_state(args.state)
        pool = _load_pool(args.pool) if args.pool else None
        provisioners = _load_provisioner_registry(args.provisioner_registry) if args.provisioner_registry else []
        payload = _snapshot_export(state, pool, provisioners)
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            args.output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "STATE_EXPORTED",
            "output": str(args.output) if args.output else "",
            "snapshot": payload if not args.output else {},
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_state_import_validate(args) -> int:
    try:
        payload = json.loads(args.input.read_text())
        if not isinstance(payload, dict):
            raise common.TaskBundleError("state import must be a JSON object")
        state = payload.get("state")
        if not isinstance(state, dict):
            raise common.TaskBundleError("state import lacks state object")
        _validate_distributed_state_blocks(state)
        common.validate_with_schema(
            state, "canonical/broker-state-v1.json", "broker state import",
            validation_point="broker-state-import", artifact_kind="broker-state")
        pool_errors = []
        pool = payload.get("workerPool")
        if isinstance(pool, dict) and pool:
            try:
                common.validate_with_schema(
                    pool, "canonical/worker-pool-registry-v1.json", "worker pool import",
                    validation_point="broker-pool-import", artifact_kind="worker-pool-registry")
            except common.SchemaValidationError as exc:
                pool_errors = exc.report.get("errors", [])
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "STATE_IMPORT_VALIDATED",
            "ok": not pool_errors,
            "taskCount": len(state.get("tasks", {})) if isinstance(state.get("tasks"), dict) else 0,
            "poolErrors": pool_errors,
        }, exit_code=EXIT_OK if not pool_errors else EXIT_PROTOCOL_ERROR)
    except (OSError, json.JSONDecodeError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_compaction_replay(args) -> int:
    try:
        state = _load_query_state(args.state)
        distributed = _task_distributed(state, args.task_id)
        store_root = args.artifact_store or Path(str(distributed.get("storeRoot") or _artifact_store_root(args)))
        task_dir = store_root / "_broker" / args.task_id
        artifacts = {}
        for name in ("workflow-dag", "attempt-replay", "artifact-provenance", "evidence-graph", "acceptance-manifest"):
            path = task_dir / f"{name}.json"
            if path.exists():
                artifacts[name] = json.loads(path.read_text())
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "COMPACTION_REPLAY",
            "compactionSummary": distributed.get("compactionSummary", {}),
            "restoredArtifacts": sorted(artifacts),
            "workflow": _workflow_query_summary(args.task_id, _task_record(state, args.task_id) or {}),
            "artifacts": artifacts,
        })
    except (OSError, json.JSONDecodeError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_chaos_matrix(args) -> int:
    cases = [
        {"id": "lock-timeout", "surface": "external-lock", "expectedRecovery": "retry-node"},
        {"id": "worker-timeout", "surface": "worker-command", "expectedRecovery": "recover-node-lease"},
        {"id": "artifact-import-failure", "surface": "artifact-transfer", "expectedRecovery": "reimport-artifact"},
        {"id": "provision-failure", "surface": "provisioner", "expectedRecovery": "release-reservation"},
        {"id": "partial-retry", "surface": "workflow-node", "expectedRecovery": "idempotent-replay"},
    ]
    return _emit({
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker",
        **_schema_registry_hash_field(),
        "status": "CHAOS_MATRIX",
        "cases": cases,
        "command": "run-distributed --lock-command/--node-retries with fixture workers",
    })


def _stress_nodes(width: int) -> list[dict[str, Any]]:
    nodes: list[dict[str, Any]] = []
    for index in range(width):
        nodes.append({
            "id": f"plan{index}",
            "capability": "plan",
            "dependsOn": [],
            "outputs": {"schema": "plan-v1", "evidenceRole": "advisory-plan"},
        })
    nodes.append({
        "id": "verify",
        "capability": "deterministic-verify",
        "dependsOn": [node["id"] for node in nodes],
        "inputs": {"artifactsFrom": [node["id"] for node in nodes]},
        "outputs": {"schema": "verification-v1", "evidenceRole": "deterministic-acceptance"},
    })
    return nodes


def cmd_stress_distributed(args) -> int:
    try:
        width = max(1, min(args.width, 16))
        bundle = json.loads(_demo_workflow_bundle(args.task_id))
        bundle["contract"]["workflow"]["nodes"] = _stress_nodes(width)
        bundle["contract"]["workflow"]["maxParallel"] = min(max(1, args.max_parallel), width)
        argv = [
            sys.executable, str(Path(__file__).resolve()), "run-distributed", args.task_id,
            "--pool", str(args.pool), "--state", str(args.state), "--artifact-store", str(_artifact_store_root(args)),
            "--ttl-seconds", str(args.ttl_seconds), "--node-retries", str(args.node_retries), "--mock",
        ]
        _append_cli_option(argv, "--provisioner-registry", getattr(args, "provisioner_registry", None))
        result = subprocess.run(argv, input=json.dumps(bundle), capture_output=True, text=True, timeout=args.timeout_seconds)
        payload = _parse_json(result.stdout) or _parse_json(result.stderr)
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "STRESS_DISTRIBUTED_COMPLETE" if result.returncode == 0 else "STRESS_DISTRIBUTED_FAILED",
            "width": width,
            "maxParallel": bundle["contract"]["workflow"]["maxParallel"],
            "run": payload,
        }, exit_code=EXIT_OK if result.returncode == 0 else EXIT_PROTOCOL_ERROR)
    except (subprocess.SubprocessError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_runbook_generate(args) -> int:
    commands = [
        "state-location", "workflow-status", "workflow-history", "workflow-dag", "worker-status",
        "lease-timeline", "acceptance-status", "acceptance-gate", "provisioner-status",
        "provisioner-replay", "capability-drift", "state-export", "state-import-validate",
        "compaction-replay", "chaos-matrix", "stress-distributed", "demo-distributed",
        "quarantine-worker", "unquarantine-worker", "refresh-scheduler",
    ]
    body = [
        "# Present Control Plain Broker Runbook",
        "",
        f"Generated: {common.utc_now()}",
        "",
        "## Operator Flow",
        "",
        "1. Inspect worker health with `worker-status` and `capability-drift`.",
        "2. Inspect workflow state with `workflow-status`, `workflow-history`, and `workflow-dag`.",
        "3. Inspect acceptance with `acceptance-status` and enforce with `acceptance-gate --require-pass`.",
        "4. Use `lease-timeline` before recovery or cancellation decisions.",
        "5. Export state before destructive maintenance with `state-export`.",
        "",
        "## Commands",
        "",
        *[f"- `{command}`" for command in commands],
        "",
        "## Multiple Broker Windows",
        "",
        "Use `create-broker-window --name NAME --port PORT` to create a window manifest. "
        "Each manifest pins state, pool, artifact store, and launch URL so several broker-facing windows can coexist.",
        "",
    ]
    text = "\n".join(body)
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(text)
    return _emit({
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker",
        **_schema_registry_hash_field(),
        "status": "RUNBOOK_GENERATED",
        "output": str(args.output) if args.output else "",
        "markdown": "" if args.output else text,
    })


def cmd_create_broker_window(args) -> int:
    try:
        if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}", args.name):
            raise common.TaskBundleError("broker window name must be alphanumeric plus dot, underscore, or dash")
        root = args.window_dir or DEFAULT_BROKER_WINDOW_DIR
        root.mkdir(parents=True, exist_ok=True)
        manifest = {
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            "name": args.name,
            "state": str(args.state or CANONICAL_BROKER_STATE_PATH),
            "pool": str(args.pool) if args.pool else "",
            "artifactStore": str(args.artifact_store) if args.artifact_store else "",
            "port": args.port,
            "url": f"http://127.0.0.1:{args.port}/",
            "launchCommand": [
                str(WORKER_DIR / "bin" / "present-broker-server"),
                "--port", str(args.port),
                "--state", str(args.state or CANONICAL_BROKER_STATE_PATH),
                *([] if args.pool is None else ["--pool", str(args.pool)]),
                *([] if args.artifact_store is None else ["--artifact-store", str(args.artifact_store)]),
            ],
        }
        path = root / f"{args.name}.json"
        path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "BROKER_WINDOW_CREATED",
            "path": str(path),
            "window": manifest,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _demo_workflow_bundle(task_id: str) -> str:
    pack_id = "present-default-change"
    version = 1
    policy_pack = common.policy_pack_registry_entry(pack_id, version)
    if policy_pack is None:
        raise common.TaskBundleError(f"policy pack {pack_id}@{version} is not in the registry")
    now = common.utc_now()
    bundle = {
        "schemaVersion": 1,
        "taskId": task_id,
        "task": {
            "schemaVersion": 1,
            "taskId": task_id,
            "title": "distributed broker demo",
            "state": "VERIFYING",
            "createdAt": now,
        },
        "requirement": "Run a two-node distributed broker demo.",
        "contract": {
            "schemaVersion": 3,
            "taskId": task_id,
            "producedAt": now,
            "producer": "present-lease-broker demo",
            "provenance": {"source": "control-plain"},
            "verification": {
                "target": "worker",
                "commands": [{
                    "name": "demo-noop",
                    "argv": ["/usr/bin/true"],
                    "expectedExitCode": 0,
                    "timeoutSeconds": 10,
                }],
            },
            "workflow": {
                "workflowId": f"{task_id}-demo-workflow",
                "maxParallel": 2,
                "nodes": [
                    {
                        "id": "plan",
                        "capability": "plan",
                        "dependsOn": [],
                        "outputs": {"schema": "plan-v1", "evidenceRole": "advisory-plan"},
                    },
                    {
                        "id": "verify",
                        "capability": "deterministic-verify",
                        "dependsOn": ["plan"],
                        "inputs": {"artifactsFrom": ["plan"]},
                        "outputs": {"schema": "verification-v1", "evidenceRole": "deterministic-acceptance"},
                    },
                ],
            },
            "policyPack": {**policy_pack, "registryHash": common.policy_pack_registry_hash(pack_id, version)},
        },
    }
    return json.dumps(bundle)


def cmd_demo_distributed(args) -> int:
    try:
        store_root = _artifact_store_root(args)
        bundle_text = _demo_workflow_bundle(args.task_id)
        argv = [
            sys.executable,
            str(Path(__file__).resolve()),
            "run-distributed",
            args.task_id,
            "--pool",
            str(args.pool),
            "--state",
            str(args.state),
            "--artifact-store",
            str(store_root),
            "--artifact-store-kind",
            _artifact_store_kind(args),
            "--ttl-seconds",
            str(args.ttl_seconds),
            "--node-retries",
            str(args.node_retries),
            "--heartbeat-interval-seconds",
            str(args.heartbeat_interval_seconds),
        ]
        for command in getattr(args, "provision_command", []) or []:
            argv.extend(["--provision-command", *command])
        _append_cli_option(argv, "--provisioner-registry", getattr(args, "provisioner_registry", None))
        if args.mock:
            argv.append("--mock")
        result = subprocess.run(argv, input=bundle_text, capture_output=True, text=True, timeout=args.timeout_seconds)
        run_payload = _parse_json(result.stdout) or _parse_json(result.stderr)
        state = _load_query_state(args.state)
        workflow = _workflow_query_summary(args.task_id, _task_record(state, args.task_id) or {})
        acceptance = {}
        if result.returncode == 0:
            acceptance_args = argparse.Namespace(
                task_id=args.task_id,
                state=args.state,
                artifact_store=store_root,
                require_ready=False,
            )
            record = _task_record(state, args.task_id)
            distributed = record.get("distributed") if isinstance(record, dict) and isinstance(record.get("distributed"), dict) else {}
            acceptance = distributed.get("acceptanceManifest") if isinstance(distributed.get("acceptanceManifest"), dict) else {}
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "DEMO_DISTRIBUTED_COMPLETE" if result.returncode == 0 else "DEMO_DISTRIBUTED_FAILED",
            "run": run_payload,
            "workflowStatus": workflow,
            "acceptanceManifest": acceptance,
            "artifactStore": str(store_root),
        }, exit_code=EXIT_OK if result.returncode == 0 else EXIT_PROTOCOL_ERROR)
    except (subprocess.SubprocessError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _normalize_distributed(distributed: dict[str, Any]) -> dict[str, Any]:
    allowed = {
        "schemaVersion", "taskId", "producedAt", "producer", "updatedAt", "workflowId", "contractHash",
        "storeRoot", "placements", "artifactTransferManifest", "nodes", "nodeDispatches", "artifactStore",
        "importedArtifacts", "attemptLedger", "handoffSha256", "pendingRecoveryIdempotencyKey",
        "workflowDag", "replayReport", "acceptanceManifest", "cancelledNodes", "artifactStoreAdapter",
        "compactionSummary", "contextCheckpoints", "toolContracts", "contractChecks", "narrativeEvents",
    }
    normalized = {key: value for key, value in distributed.items() if key in allowed}
    normalized.setdefault("schemaVersion", 1)
    normalized.setdefault("producedAt", common.utc_now())
    normalized.setdefault("producer", "present-lease-broker distributed state")
    normalized.setdefault("updatedAt", common.utc_now())
    normalized.setdefault("placements", [])
    normalized.setdefault("artifactTransferManifest", {})
    normalized.setdefault("nodes", {})
    normalized.setdefault("nodeDispatches", [])
    normalized.setdefault("artifactStore", [])
    normalized.setdefault("importedArtifacts", [])
    normalized.setdefault("contextCheckpoints", [])
    normalized.setdefault("attemptLedger", [])
    normalized.setdefault("toolContracts", {})
    normalized.setdefault("contractChecks", [])
    normalized.setdefault("narrativeEvents", [])
    return normalized


def _normalize_state_document(raw: dict[str, Any], *, strict: bool = False) -> tuple[dict[str, Any], list[str]]:
    changed: list[str] = []
    now = common.utc_now()
    allowed_top = {
        "schemaVersion", "producedAt", "producer", "updatedAt", "tasks", "events",
        "recoveryLedger", "operatorAuditLog", "provisionerReplay",
    }
    unknown_top = sorted(set(raw) - allowed_top)
    if strict and unknown_top:
        raise common.TaskBundleError(f"broker state has unknown top-level fields: {', '.join(unknown_top)}")
    normalized = {
        "schemaVersion": 1,
        "producedAt": raw.get("producedAt") if isinstance(raw.get("producedAt"), str) else now,
        "producer": raw.get("producer") if isinstance(raw.get("producer"), str) else "present-lease-broker",
        "updatedAt": now,
        "tasks": raw.get("tasks") if isinstance(raw.get("tasks"), dict) else {},
        "events": raw.get("events") if isinstance(raw.get("events"), list) else [],
        "recoveryLedger": raw.get("recoveryLedger") if isinstance(raw.get("recoveryLedger"), list) else [],
        "operatorAuditLog": raw.get("operatorAuditLog") if isinstance(raw.get("operatorAuditLog"), list) else [],
        "provisionerReplay": raw.get("provisionerReplay") if isinstance(raw.get("provisionerReplay"), list) else [],
    }
    for key in unknown_top:
        changed.append(f"removed top-level field {key}")
    for task_id, record in list(normalized["tasks"].items()):
        if not isinstance(record, dict):
            del normalized["tasks"][task_id]
            changed.append(f"removed malformed task {task_id}")
            continue
        allowed = {
            "taskId", "status", "contractHash", "workflowRunId", "selectedWorker", "leaseId",
            "lastHeartbeatAt", "terminalAt", "updatedAt", "distributed", "attempts",
        }
        unknown_task = sorted(set(record) - allowed)
        if strict and unknown_task:
            raise common.TaskBundleError(
                f"broker task {task_id} has unknown fields: {', '.join(unknown_task)}")
        for key in unknown_task:
            record.pop(key, None)
            changed.append(f"removed task field {task_id}.{key}")
        record.setdefault("taskId", task_id)
        record.setdefault("attempts", [])
        record.setdefault("selectedWorker", "")
        record.setdefault("updatedAt", now)
        if isinstance(record.get("distributed"), dict):
            record["distributed"] = _normalize_distributed(record["distributed"])
    return normalized, changed


def cmd_normalize_state(args) -> int:
    try:
        raw = json.loads(args.state.read_text())
        if not isinstance(raw, dict):
            raise common.TaskBundleError("broker state must be a JSON object")
        normalized, changes = _normalize_state_document(raw, strict=args.strict)
        common.validate_with_schema(
            normalized,
            "canonical/broker-state-v1.json",
            "broker state",
            validation_point="broker-state-normalize",
            artifact_kind="broker-state",
        )
        if not args.dry_run:
            _write_state(args.state, normalized)
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "STATE_NORMALIZED",
            "dryRun": args.dry_run,
            "changes": changes,
        })
    except (OSError, json.JSONDecodeError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_provision_cleanup(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        terminal_tasks = {
            task_id for task_id, record in (state or {}).get("tasks", {}).items()
            if isinstance(record, dict) and record.get("status") in {
                "COMPLETE", "CANCELLED", "FAILED", "INCONSISTENT", "DISTRIBUTED_COMPLETE", "DISTRIBUTED_FAILED"
            }
        }
        cleanup_ids = []
        for worker in pool.get("workers", []):
            if not isinstance(worker, dict):
                continue
            lifecycle = worker.get("lifecycle") if isinstance(worker.get("lifecycle"), dict) else {}
            if lifecycle.get("retireAfterTask") is True and isinstance(worker.get("id"), str):
                cleanup_ids.append(worker["id"])
        reports = []
        if not args.dry_run:
            reports = _deprovision_workers(
                pool, args, args.task_id, cleanup_ids, state, reason="provision cleanup reconciliation")
            if reports:
                _write_pool(args.pool, pool)
                _write_state(args.state, state)
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "PROVISION_CLEANUP_COMPLETE",
            "workers": cleanup_ids,
            "provisioning": reports,
            "terminalTasks": sorted(terminal_tasks),
            "dryRun": args.dry_run,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_quarantine_worker(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        worker = _worker_by_id(pool, args.worker_id)
        if worker is None:
            raise common.TaskBundleError(f"worker {args.worker_id!r} is not in the pool")
        worker["quarantine"] = {
            "active": True,
            "reason": args.reason,
            "failureCount": int(worker.get("health", {}).get("recentFailures", 0)) if isinstance(worker.get("health"), dict) else 0,
            "producedAt": common.utc_now(),
        }
        _append_operator_audit(
            state, args.task_id, "quarantine-worker",
            operator_role=args.operator_role, workerId=args.worker_id, reason=args.reason)
        _append_event(state, args.task_id, "worker-quarantined", workerId=args.worker_id, reason=args.reason)
        _write_pool(args.pool, pool)
        _write_state(args.state, state)
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "WORKER_QUARANTINED",
            "workerId": args.worker_id,
            "reason": args.reason,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_unquarantine_worker(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        worker = _worker_by_id(pool, args.worker_id)
        if worker is None:
            raise common.TaskBundleError(f"worker {args.worker_id!r} is not in the pool")
        if not isinstance(worker.get("quarantine"), dict) or worker["quarantine"].get("active") is not True:
            raise common.TaskBundleError(f"worker {args.worker_id!r} is not actively quarantined")
        produced = _utc_parse(worker["quarantine"].get("producedAt", ""))
        if produced is not None and args.min_quarantine_seconds > 0:
            age = (datetime.datetime.now(datetime.timezone.utc) - produced).total_seconds()
            if age < args.min_quarantine_seconds:
                raise common.TaskBundleError("worker quarantine cooldown has not elapsed")
        if not args.skip_healthcheck:
            code, status, error, _stdout, _stderr = _invoke_worker(worker, ["status"], timeout=30)
            if code != 0 or not status:
                raise common.TaskBundleError(error.get("reason") or "worker status failed during quarantine release")
            _validate_worker_status(status, args.worker_id)
            if _worker_id(worker, status) != args.worker_id:
                raise common.TaskBundleError("worker status identity differs during quarantine release")
            worker["status"] = status
            worker["lastSeenAt"] = status.get("producedAt") or common.utc_now()
            worker["statusAttestation"] = _status_attestation(status)
        mismatch = _attestation_mismatch(worker, worker.get("status") if isinstance(worker.get("status"), dict) else {})
        if mismatch and not args.skip_attestation:
            raise common.TaskBundleError(f"worker attestation does not match during quarantine release: {mismatch}")
        worker["quarantine"] = {
            "active": False,
            "reason": args.reason,
            "failureCount": 0,
            "producedAt": common.utc_now(),
            "releasedAt": common.utc_now(),
        }
        health = worker.setdefault("health", {})
        if isinstance(health, dict):
            health["recentFailures"] = 0
        _append_operator_audit(
            state, args.task_id, "unquarantine-worker",
            operator_role=args.operator_role, workerId=args.worker_id, reason=args.reason)
        _append_event(state, args.task_id, "worker-unquarantined", workerId=args.worker_id, reason=args.reason)
        _write_pool(args.pool, pool)
        _write_state(args.state, state)
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "WORKER_UNQUARANTINED",
            "workerId": args.worker_id,
            "reason": args.reason,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_refresh_scheduler(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        iterations = max(1, args.iterations)
        reports = []
        for index in range(iterations):
            refreshed = _refresh_pool_workers(pool)
            reports.append({
                "iteration": index + 1,
                "producedAt": common.utc_now(),
                "workers": refreshed,
            })
            _append_event(state, args.task_id, "refresh-scheduler", iteration=index + 1)
            if index + 1 < iterations and args.interval_seconds > 0:
                time.sleep(args.interval_seconds)
        if not args.dry_run:
            _write_pool(args.pool, pool)
            _write_state(args.state, state)
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "REFRESH_SCHEDULER_COMPLETE",
            "dryRun": args.dry_run,
            "iterations": reports,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_schema_gate(args) -> int:
    try:
        registry = common.load_schema_registry()
        registered = {
            str(item.get("schemaFile"))
            for item in registry.get("schemas", [])
            if isinstance(item, dict) and isinstance(item.get("schemaFile"), str)
        }
        canonical = {path.name for path in (WORKER_DIR / "schemas" / "canonical").glob("*.json")}
        missing_registry = sorted(canonical - registered)
        fixture_reports = []
        fixtures_root = WORKER_DIR / "schemas" / "fixtures"
        for folder, expect_valid in (("valid", True), ("invalid", False)):
            for path in sorted((fixtures_root / folder).glob("*.json")):
                schema_name = path.name.split(".", 1)[0] + ".json"
                errors = schema_check.validate(json.loads(path.read_text()), f"canonical/{schema_name}")
                ok = not errors
                if ok != expect_valid:
                    fixture_reports.append({
                        "path": str(path),
                        "expected": "valid" if expect_valid else "invalid",
                        "errors": errors,
                    })
        status = "SCHEMA_GATE_COMPLETE"
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": status,
            "missingRegistryEntries": missing_registry,
            "fixtureFailures": fixture_reports,
            "ok": not missing_registry and not fixture_reports,
        }, exit_code=EXIT_OK if not missing_registry and not fixture_reports else EXIT_PROTOCOL_ERROR)
    except (OSError, json.JSONDecodeError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_gc(args) -> int:
    try:
        state = _load_state(args.state)
        if state is None:
            raise common.TaskBundleError("gc requires broker state")
        cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=args.older_than_seconds)
        removed_tasks = []
        for task_id, record in list(state.get("tasks", {}).items()):
            if not isinstance(record, dict) or record.get("status") not in {
                "COMPLETE", "CANCELLED", "FAILED", "INCONSISTENT", "DISTRIBUTED_COMPLETE", "DISTRIBUTED_FAILED"
            }:
                continue
            terminal = _utc_parse(record.get("terminalAt", ""))
            if terminal and terminal < cutoff:
                removed_tasks.append(task_id)
                del state["tasks"][task_id]
        kept_events = []
        removed_events = 0
        for event in state.get("events", []):
            produced = _utc_parse(event.get("producedAt", "")) if isinstance(event, dict) else None
            if produced and produced < cutoff and event.get("taskId") in removed_tasks:
                removed_events += 1
            else:
                kept_events.append(event)
        state["events"] = kept_events
        _write_state(args.state, state)
        return _emit({"schemaVersion": 1, "producedAt": common.utc_now(), "producer": "present-lease-broker",
                      **_schema_registry_hash_field(),
                      "status": "GC_COMPLETE", "removedTasks": removed_tasks, "removedEvents": removed_events})
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _referenced_artifact_paths(state: dict[str, Any]) -> set[Path]:
    paths: set[Path] = set()
    broker_artifact_names = (
        "workflow-dag.json",
        "workflow-admission.json",
        "workflow.json",
        "evidence-manifest.json",
        "evidence-graph.json",
        "redaction-report.json",
        "attempt-replay.json",
        "artifact-provenance.json",
        "acceptance-manifest.json",
        "handoff-package.json",
        "integrity-ledger.json",
    )
    for record in state.get("tasks", {}).values():
        if not isinstance(record, dict):
            continue
        distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
        for artifact in distributed.get("artifactStore", []) if isinstance(distributed.get("artifactStore"), list) else []:
            if isinstance(artifact, dict) and isinstance(artifact.get("contentAddressedPath"), str):
                paths.add(Path(artifact["contentAddressedPath"]).resolve())
        task_id = record.get("taskId")
        store_root = distributed.get("storeRoot")
        if isinstance(task_id, str) and isinstance(store_root, str):
            broker_dir = Path(store_root) / "_broker" / task_id
            for name in broker_artifact_names:
                paths.add((broker_dir / name).resolve())
    return paths


def _compact_state(state: dict[str, Any], cutoff: datetime.datetime) -> tuple[list[str], int]:
    removed_tasks = []
    for task_id, record in list(state.get("tasks", {}).items()):
        if not isinstance(record, dict) or record.get("status") not in {
            "COMPLETE", "CANCELLED", "FAILED", "INCONSISTENT", "DISTRIBUTED_COMPLETE", "DISTRIBUTED_FAILED"
        }:
            continue
        terminal = _utc_parse(record.get("terminalAt", ""))
        if terminal and terminal < cutoff:
            removed_tasks.append(task_id)
            del state["tasks"][task_id]
    kept_events = []
    removed_events = 0
    for event in state.get("events", []):
        produced = _utc_parse(event.get("producedAt", "")) if isinstance(event, dict) else None
        if produced and produced < cutoff and event.get("taskId") in removed_tasks:
            removed_events += 1
        else:
            kept_events.append(event)
    state["events"] = kept_events
    return removed_tasks, removed_events


def _compact_state_v2(state: dict[str, Any], cutoff: datetime.datetime) -> tuple[list[str], int]:
    compacted_tasks = []
    terminal_statuses = {
        "COMPLETE", "CANCELLED", "FAILED", "INCONSISTENT", "DISTRIBUTED_COMPLETE", "DISTRIBUTED_FAILED"
    }
    for task_id, record in list(state.get("tasks", {}).items()):
        if not isinstance(record, dict) or record.get("status") not in terminal_statuses:
            continue
        terminal = _utc_parse(record.get("terminalAt", ""))
        if not terminal or terminal >= cutoff:
            continue
        distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else None
        if distributed is None:
            compacted_tasks.append(task_id)
            del state["tasks"][task_id]
            continue
        counts = _distributed_counts(distributed)
        distributed["compactionSummary"] = {
            "schemaVersion": 1,
            "compactedAt": common.utc_now(),
            "mode": "broker-state-compaction-v2",
            "beforeCounts": counts,
            "preservedFields": [
                "workflowId",
                "contractHash",
                "storeRoot",
                "placements",
                "workflowDag",
                "replayReport",
                "acceptanceManifest",
                "handoffSha256",
                "artifactStoreAdapter",
                "contextCheckpoints",
            ],
        }
        distributed["nodes"] = {}
        distributed["nodeDispatches"] = []
        distributed["artifactStore"] = []
        distributed["importedArtifacts"] = []
        distributed["updatedAt"] = common.utc_now()
        compacted_tasks.append(task_id)
    kept_events = []
    compacted_set = set(compacted_tasks)
    removed_events = 0
    for event in state.get("events", []):
        produced = _utc_parse(event.get("producedAt", "")) if isinstance(event, dict) else None
        if produced and produced < cutoff and event.get("taskId") in compacted_set:
            removed_events += 1
        else:
            kept_events.append(event)
    state["events"] = kept_events
    return compacted_tasks, removed_events


def _compact_artifacts(root: Path, cutoff: datetime.datetime, referenced: set[Path], *, dry_run: bool) -> tuple[list[str], list[str]]:
    candidates: list[str] = []
    removed: list[str] = []
    if not root.exists():
        return candidates, removed
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        resolved = path.resolve()
        if resolved in referenced:
            continue
        modified = datetime.datetime.fromtimestamp(path.stat().st_mtime, tz=datetime.timezone.utc)
        if modified >= cutoff:
            continue
        candidates.append(str(path))
        if not dry_run:
            path.unlink()
            removed.append(str(path))
    if not dry_run:
        for path in sorted(root.rglob("*"), reverse=True):
            if path.is_dir():
                try:
                    path.rmdir()
                except OSError:
                    pass
    return candidates, removed


def cmd_compact(args) -> int:
    try:
        state = _load_state(args.state)
        if state is None:
            raise common.TaskBundleError("compact requires broker state")
        cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=args.older_than_seconds)
        state_copy = json.loads(json.dumps(state))
        v2 = bool(getattr(args, "v2", False))
        removed_tasks, removed_events = (
            _compact_state_v2(state_copy, cutoff) if v2 else _compact_state(state_copy, cutoff)
        )
        referenced = _referenced_artifact_paths(state_copy)
        artifact_candidates, artifact_removed = _compact_artifacts(
            args.artifact_store, cutoff, referenced, dry_run=args.dry_run)
        if not args.dry_run:
            _write_state(args.state, state_copy)
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "COMPACTED",
            "mode": "broker-state-compaction-v2" if v2 else "delete-terminal-state-v1",
            "dryRun": args.dry_run,
            "removedTasks": [] if (args.dry_run or v2) else removed_tasks,
            "candidateTasks": removed_tasks,
            "compactedTasks": removed_tasks if (v2 and not args.dry_run) else [],
            "removedEvents": removed_events if not args.dry_run else 0,
            "candidateEvents": removed_events,
            "artifactStore": str(args.artifact_store),
            "artifactCandidates": artifact_candidates,
            "removedArtifacts": artifact_removed,
            "retainedArtifactCount": len(referenced),
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


class BrokerArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        _error(message, retryable=False)
        raise SystemExit(EXIT_PROTOCOL_ERROR)


def build_parser() -> argparse.ArgumentParser:
