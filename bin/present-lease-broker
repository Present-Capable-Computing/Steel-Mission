#!/usr/bin/env python3
"""Control-plain lease broker for capability-addressed Present workers."""
from __future__ import annotations

import argparse
import base64
import concurrent.futures
import copy
import datetime
import hashlib
import json
import re
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Any

WORKER_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(WORKER_DIR))

from adapters import common, schema_check  # noqa: E402

BROKER_VERSION = "1.0.0"
MIN_PROTOCOL = (2, 10)
TASK_ID_RE = re.compile(r"^DEV-[0-9]{6}$")
LEASE_ID_RE = re.compile(r"^wl-[a-f0-9]{24}$")
SHA256_RE = re.compile(r"^[a-f0-9]{64}$")
BROKER_EVENT_TYPES_PATH = WORKER_DIR / "schemas" / "broker-event-types.json"
RECOVERY_ACTIONS = {
    "retry-node",
    "reimport-artifact",
    "rematerialize-artifact",
    "recover-node-lease",
    "cancel-subgraph",
    "failover-lease",
    "cancel-workflow",
    "retire-worker",
    "mark-inconsistent",
}
RECOVERY_REOPEN_ACTIONS = {
    "retry-node",
    "reimport-artifact",
    "rematerialize-artifact",
    "recover-node-lease",
    "failover-lease",
}
COST_CLASS_SCORE = {"local": 0, "test": 0, "free": 0, "low": 1, "standard": 2, "medium": 2, "high": 3}
RECOVERY_AUTH_POLICY_PATH = WORKER_DIR / "schemas" / "recovery-authorization-policy.json"
_RECOVERY_AUTHORIZATION: dict[str, str] | None = None
WORKER_FAULT_QUARANTINE_THRESHOLD = 2
CANONICAL_BROKER_STATE_PATH = common.PRESENT_DEV / "broker-state.json"
DEFAULT_PROVISIONER_REGISTRY_PATH = WORKER_DIR / "schemas" / "provisioners.json"
DEFAULT_BROKER_WINDOW_DIR = common.PRESENT_DEV / "control-plain-windows"

EXIT_OK = 0
EXIT_PROTOCOL_ERROR = 30

_EVENT_TYPE_REGISTRY: dict[str, set[str]] | None = None


def _parse_json(text: str) -> dict[str, Any]:
    try:
        value = json.loads(text)
    except json.JSONDecodeError:
        return {}
    return value if isinstance(value, dict) else {}


def _emit(payload: dict[str, Any], *, exit_code: int = EXIT_OK) -> int:
    _validate_broker_response(payload)
    print(json.dumps(payload, indent=2, sort_keys=True), file=sys.stdout if exit_code == EXIT_OK else sys.stderr)
    return exit_code


def _schema_registry_hash_field() -> dict[str, str]:
    try:
        return {"schemaRegistryHash": common.schema_registry_hash()}
    except common.TaskBundleError:
        return {}


def _error(reason: str, *, retryable: bool = False,
           validation_error: dict[str, Any] | None = None) -> int:
    return _emit({
        "status": "BROKER_BLOCKED",
        "reason": reason,
        "retryable": retryable,
        **_schema_registry_hash_field(),
        **({"schemaValidation": validation_error} if validation_error else {}),
    }, exit_code=EXIT_PROTOCOL_ERROR)


def _utc_parse(value: str) -> datetime.datetime | None:
    try:
        return datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None


def _elapsed_ms(start: float) -> int:
    return max(0, int((time.monotonic() - start) * 1000))


def _protocol_tuple(value: str) -> tuple[int, int]:
    match = re.fullmatch(r"(\d+)\.(\d+)", value or "")
    if not match:
        return (0, 0)
    return int(match.group(1)), int(match.group(2))


def _validate_worker_status(status: dict[str, Any], worker_label: str) -> None:
    common.validate_with_schema(
        status,
        "canonical/worker-status-v1.json",
        f"worker status {worker_label}",
        validation_point="broker-worker-status-admission",
        artifact_kind="worker-status",
    )


def _validate_pool_worker_statuses(pool: dict[str, Any]) -> None:
    for index, worker in enumerate(pool.get("workers", [])):
        if not isinstance(worker, dict):
            continue
        status = worker.get("status")
        if isinstance(status, dict):
            _validate_worker_status(status, str(worker.get("id") or f"workers[{index}]"))


def _load_pool(path: Path) -> dict[str, Any]:
    try:
        pool = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise common.TaskBundleError(f"worker pool registry is unavailable: {exc}") from exc
    if not isinstance(pool, dict):
        raise common.TaskBundleError("worker pool registry must be a JSON object")
    common.validate_with_schema(
        pool,
        "canonical/worker-pool-registry-v1.json",
        "worker pool registry",
        validation_point="broker-pool-admission",
        artifact_kind="worker-pool-registry",
    )
    _validate_pool_worker_statuses(pool)
    return pool


def _write_pool(path: Path, pool: dict[str, Any]) -> None:
    pool = json.loads(json.dumps(pool))
    for worker in pool.get("workers", []) if isinstance(pool.get("workers"), list) else []:
        if isinstance(worker, dict):
            for key in list(worker):
                if key.startswith("_"):
                    worker.pop(key, None)
    pool["updatedAt"] = common.utc_now()
    common.validate_with_schema(
        pool,
        "canonical/worker-pool-registry-v1.json",
        "worker pool registry",
        validation_point="broker-pool-write",
        artifact_kind="worker-pool-registry",
    )
    _validate_pool_worker_statuses(pool)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(pool, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def _empty_state() -> dict[str, Any]:
    now = common.utc_now()
    return {
        "schemaVersion": 1,
        "producedAt": now,
        "producer": "present-lease-broker",
        "updatedAt": now,
        "tasks": {},
        "events": [],
        "recoveryLedger": [],
        "operatorAuditLog": [],
        "provisionerReplay": [],
    }


def _load_state(path: Path | None) -> dict[str, Any] | None:
    if path is None:
        return None
    if not path.exists():
        return _empty_state()
    try:
        state = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise common.TaskBundleError(f"broker state is unavailable: {exc}") from exc
    if not isinstance(state, dict):
        raise common.TaskBundleError("broker state must be a JSON object")
    _validate_distributed_state_blocks(state)
    common.validate_with_schema(
        state,
        "canonical/broker-state-v1.json",
        "broker state",
        validation_point="broker-state-admission",
        artifact_kind="broker-state",
    )
    return state


def _write_state(path: Path | None, state: dict[str, Any] | None) -> None:
    if path is None or state is None:
        return
    state["updatedAt"] = common.utc_now()
    _validate_distributed_state_blocks(state)
    common.validate_with_schema(
        state,
        "canonical/broker-state-v1.json",
        "broker state",
        validation_point="broker-state-write",
        artifact_kind="broker-state",
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def _load_query_state(path: Path | None) -> dict[str, Any]:
    return _load_state(path or CANONICAL_BROKER_STATE_PATH) or _empty_state()


def _state_path_label(path: Path | None) -> str:
    return str(path or CANONICAL_BROKER_STATE_PATH)


def _require_schema(payload: dict[str, Any], schema_name: str, label: str) -> None:
    task_id = payload.get("taskId") if isinstance(payload.get("taskId"), str) else None
    common.validate_with_schema(
        payload,
        schema_name,
        label,
        validation_point="broker-schema-boundary",
        artifact_kind=label,
        task_id=task_id,
        log_failure=bool(task_id),
    )


def _admission_report(task_id: str, candidates: list[dict[str, Any]]) -> dict[str, Any]:
    admitted = [item for item in candidates if item.get("eligible") is True]
    rejected = [item for item in candidates if item.get("eligible") is not True]
    report = {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker",
        "status": "ADMITTED" if admitted else "REJECTED",
        "candidateCount": len(candidates),
        "admittedCount": len(admitted),
        "rejectedCount": len(rejected),
        "candidates": candidates,
    }
    _require_schema(report, "canonical/admission-report-v1.json", "admission-report")
    return report


def _load_event_type_registry() -> dict[str, set[str]]:
    global _EVENT_TYPE_REGISTRY
    if _EVENT_TYPE_REGISTRY is not None:
        return _EVENT_TYPE_REGISTRY
    try:
        payload = json.loads(BROKER_EVENT_TYPES_PATH.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise common.TaskBundleError(f"broker event type registry is unavailable: {exc}") from exc
    if not isinstance(payload, dict):
        raise common.TaskBundleError("broker event type registry must be a JSON object")
    _require_schema(payload, "canonical/broker-event-type-registry-v1.json", "broker-event-type-registry")
    registry: dict[str, set[str]] = {}
    for item in payload["eventTypes"]:
        registry[item["type"]] = set(item.get("requiredFields", []))
    _EVENT_TYPE_REGISTRY = registry
    return registry


def _load_recovery_authorization() -> dict[str, str]:
    global _RECOVERY_AUTHORIZATION
    if _RECOVERY_AUTHORIZATION is not None:
        return _RECOVERY_AUTHORIZATION
    try:
        payload = json.loads(RECOVERY_AUTH_POLICY_PATH.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise common.TaskBundleError(f"recovery authorization policy is unavailable: {exc}") from exc
    if not isinstance(payload, dict):
        raise common.TaskBundleError("recovery authorization policy must be a JSON object")
    _require_schema(payload, "canonical/recovery-authorization-policy-v1.json", "recovery-authorization-policy")
    _RECOVERY_AUTHORIZATION = {
        item["action"]: item["minimumRole"]
        for item in payload["rules"]
        if isinstance(item, dict)
    }
    return _RECOVERY_AUTHORIZATION


def _validate_distributed_state_blocks(state: dict[str, Any]) -> None:
    tasks = state.get("tasks")
    if not isinstance(tasks, dict):
        return
    for task_id, record in tasks.items():
        if not isinstance(record, dict) or "distributed" not in record:
            continue
        distributed = record.get("distributed")
        if not isinstance(distributed, dict):
            raise common.TaskBundleError(f"broker-state.distributed for {task_id} must be an object")
        _require_schema(
            distributed,
            "canonical/broker-distributed-state-v1.json",
            f"broker-state.distributed for {task_id}",
        )


def _validate_distributed_artifacts(payload: dict[str, Any]) -> None:
    _require_schema(payload, "canonical/broker-distributed-artifacts-v1.json", "distributedArtifacts")
    _require_schema(payload["workflowDag"], "canonical/workflow-dag-v1.json",
                    "distributedArtifacts.workflowDag")
    _require_schema(payload["admission"], "canonical/broker-workflow-admission-compact-v1.json",
                    "distributedArtifacts.admission")
    _require_schema(payload["evidenceManifest"], "canonical/evidence-manifest-v1.json",
                    "distributedArtifacts.evidenceManifest")
    _require_schema(payload["evidenceGraph"], "canonical/evidence-graph-v1.json",
                    "distributedArtifacts.evidenceGraph")
    _require_schema(payload["redactionReport"], "canonical/redaction-report-v1.json",
                    "distributedArtifacts.redactionReport")
    _require_schema(payload["replayReport"], "canonical/distributed-replay-report-v1.json",
                    "distributedArtifacts.replayReport")
    _require_schema(payload["artifactProvenance"], "canonical/artifact-provenance-chain-v1.json",
                    "distributedArtifacts.artifactProvenance")
    _require_schema(payload["acceptanceManifest"], "canonical/acceptance-manifest-v1.json",
                    "distributedArtifacts.acceptanceManifest")
    _require_schema(payload["handoffPackage"], "canonical/handoff-package-v1.json",
                    "distributedArtifacts.handoffPackage")


def _broker_response_schema_names(payload: dict[str, Any]) -> list[str]:
    status = payload.get("status")
    names = ["canonical/broker-response-v1.json"]
    if status == "BROKER_BLOCKED":
        names.append("canonical/broker-response-error-v1.json")
    elif status in {"SELECTED", "NO_ELIGIBLE_WORKER", "NO_NODE_PLACEMENT"}:
        names.append("canonical/broker-response-select-v1.json")
    elif status in {"DISTRIBUTED_WORKFLOW_DISPATCHED", "DISTRIBUTED_WORKFLOW_FAILED"}:
        names.append("canonical/broker-response-run-distributed-v1.json")
    elif status == "IDEMPOTENT_REPLAY":
        names.append("canonical/broker-response-replay-v1.json")
    elif status in {"LEASE_RENEWED", "LEASE_RELEASED"}:
        names.append("canonical/broker-response-lease-v1.json")
    elif status in {
        "RUNNING", "WAITING", "COMPLETE", "CANCELLED", "FAILED", "INCONSISTENT",
        "WORKER_UNREACHABLE", "LEASE_EXPIRED", "FAILOVER_LEASED",
    }:
        names.append("canonical/broker-response-reconcile-v1.json")
    elif status == "GC_COMPLETE":
        names.append("canonical/broker-response-gc-v1.json")
    elif status == "COMPACTED":
        names.append("canonical/broker-response-compact-v1.json")
    elif status in {
        "REFRESHED", "PROVISIONED", "NO_WORKERS_PROVISIONED",
        "WORKER_RETIRED", "WORKER_RETIRE_FAILED", "PROVISION_CLEANUP_COMPLETE",
        "WORKER_QUARANTINED", "WORKER_UNQUARANTINED", "REFRESH_SCHEDULER_COMPLETE",
        "SCHEMA_GATE_COMPLETE", "STATE_LOCATION", "WORKFLOW_STATUS", "WORKFLOW_HISTORY",
        "WORKER_STATUS", "AUDIT_LOG", "ACCEPTANCE_STATUS", "DEMO_DISTRIBUTED_COMPLETE",
        "DEMO_DISTRIBUTED_FAILED", "WORKFLOW_DAG", "JOB_NARRATIVE", "EVIDENCE_QUERY", "ACCEPTANCE_GATE", "PROVISIONER_STATUS",
        "PROVISIONER_REPLAY", "CAPABILITY_DRIFT", "LEASE_TIMELINE", "STATE_EXPORTED",
        "STATE_IMPORT_VALIDATED", "COMPACTION_REPLAY", "CHAOS_MATRIX", "STRESS_DISTRIBUTED_COMPLETE",
        "STRESS_DISTRIBUTED_FAILED", "RUNBOOK_GENERATED", "BROKER_WINDOW_CREATED",
    }:
        names.append("canonical/broker-response-refresh-v1.json")
    elif status in {"RECOVERY_PLAN", "RECOVERY_APPLIED", "RECOVERY_BLOCKED"}:
        names.append("canonical/broker-response-recover-v1.json")
    elif status in {"RECOVERY_RUN_COMPLETE", "RECOVERY_RUN_FAILED", "RECOVERY_RUN_BLOCKED"}:
        names.append("canonical/broker-response-recover-run-v1.json")
    elif status == "ARTIFACT_AUDIT_COMPLETE":
        names.append("canonical/broker-response-artifact-audit-v1.json")
    elif status == "STATE_NORMALIZED":
        names.append("canonical/broker-response-normalize-state-v1.json")
    return names


def _validate_broker_response(payload: dict[str, Any]) -> None:
    for schema_name in _broker_response_schema_names(payload):
        _require_schema(payload, schema_name, f"broker response {payload.get('status', '<missing>')}")


def _event_id(task_id: str, event_type: str, produced_at: str) -> str:
    return "be-" + common.canonical_hash({"taskId": task_id, "type": event_type, "producedAt": produced_at})[:24]


def _append_event(state: dict[str, Any] | None, task_id: str, event_type: str, **data: Any) -> None:
    if state is None:
        return
    registry = _load_event_type_registry()
    if event_type not in registry:
        raise common.TaskBundleError(f"broker event type {event_type!r} is not registered")
    missing = sorted(field for field in registry[event_type] if field not in data)
    if missing:
        raise common.TaskBundleError(f"broker event type {event_type!r} missing fields: {', '.join(missing)}")
    produced_at = common.utc_now()
    event = {
        "eventId": _event_id(task_id, event_type, produced_at),
        "taskId": task_id,
        "type": event_type,
        "producedAt": produced_at,
        **data,
    }
    common.validate_with_schema(
        event,
        "canonical/broker-event-v1.json",
        "broker event",
        validation_point="broker-state-write",
        artifact_kind="broker-event",
        task_id=task_id,
    )
    state.setdefault("events", []).append(event)


def _append_distributed_narrative(record: dict[str, Any] | None, *, actor_kind: str, actor_id: str,
                                  action: str, target: str, human_text: str, **fields: Any) -> None:
    distributed = _distributed_record(record, record.get("taskId") if isinstance(record, dict) else None)
    if distributed is None:
        return
    _narrative_event(
        distributed.setdefault("narrativeEvents", []),
        at=common.utc_now(),
        actor_kind=actor_kind,
        actor_id=actor_id,
        action=action,
        target=target,
        human_text=human_text,
        **fields,
    )


def _append_operator_audit(state: dict[str, Any] | None, task_id: str, action: str,
                           *, operator_role: str = "system", **data: Any) -> None:
    if state is None:
        return
    produced_at = common.utc_now()
    entry = {
        "auditId": "oa-" + common.canonical_hash({
            "taskId": task_id,
            "action": action,
            "operatorRole": operator_role,
            "producedAt": produced_at,
            **data,
        })[:24],
        "taskId": task_id,
        "action": action,
        "operatorRole": operator_role,
        "producedAt": produced_at,
        **data,
    }
    state.setdefault("operatorAuditLog", []).append(entry)


def _append_provisioner_replay(state: dict[str, Any] | None, task_id: str, provisioner_id: str,
                               action: str, request: dict[str, Any], response: dict[str, Any],
                               exit_code: int) -> None:
    if state is None:
        return
    produced_at = common.utc_now()
    state.setdefault("provisionerReplay", []).append({
        "replayId": "pr-" + common.canonical_hash({
            "taskId": task_id,
            "provisionerId": provisioner_id,
            "action": action,
            "request": request,
            "response": response,
            "exitCode": exit_code,
            "producedAt": produced_at,
        })[:24],
        "taskId": task_id,
        "provisionerId": provisioner_id,
        "action": action,
        "producedAt": produced_at,
        "exitCode": exit_code,
        "request": request,
        "response": response,
    })


def _task_record(state: dict[str, Any] | None, task_id: str) -> dict[str, Any] | None:
    if state is None:
        return None
    record = state.setdefault("tasks", {}).get(task_id)
    return record if isinstance(record, dict) else None


def _upsert_task_record(state: dict[str, Any] | None, task_id: str, **fields: Any) -> dict[str, Any] | None:
    if state is None:
        return None
    tasks = state.setdefault("tasks", {})
    record = tasks.setdefault(task_id, {
        "taskId": task_id,
        "status": fields.get("status", "SELECTED"),
        "contractHash": fields["contractHash"],
        "selectedWorker": fields.get("selectedWorker", ""),
        "attempts": [],
        "updatedAt": common.utc_now(),
    })
    record.update({key: value for key, value in fields.items() if value is not None})
    record["updatedAt"] = common.utc_now()
    return record


def _active_leases_by_worker(state: dict[str, Any] | None) -> dict[str, int]:
    active: dict[str, int] = {}
    if state is None:
        return active
    for record in state.get("tasks", {}).values():
        if not isinstance(record, dict):
            continue
        if record.get("status") in {"SELECTED", "LEASED", "DISPATCHED", "RUNNING", "WAITING", "FAILOVER_LEASED"}:
            worker = record.get("selectedWorker")
            if isinstance(worker, str) and worker:
                active[worker] = active.get(worker, 0) + 1
    return active


def _worker_command(worker: dict[str, Any]) -> list[str]:
    transport = worker.get("transport") if isinstance(worker.get("transport"), dict) else {}
    command = transport.get("command") or worker.get("command")
    if not isinstance(command, list) or not command or any(not isinstance(item, str) or not item for item in command):
        raise common.TaskBundleError("worker entry command must be a non-empty argv array")
    return command


def _worker_env(worker: dict[str, Any]) -> dict[str, str]:
    transport = worker.get("transport") if isinstance(worker.get("transport"), dict) else {}
    env = common.execution_env()
    for source in (worker.get("env"), transport.get("env")):
        if isinstance(source, dict):
            env.update({str(key): str(value) for key, value in source.items()})
    return env


def _worker_argv(worker: dict[str, Any], args: list[str]) -> list[str]:
    return [*_worker_command(worker), *args]


def _worker_transport_kind(worker: dict[str, Any]) -> str:
    transport = worker.get("transport") if isinstance(worker.get("transport"), dict) else {}
    return str(transport.get("kind") or "local")


def _status_attestation(status: dict[str, Any]) -> dict[str, Any]:
    detail = status.get("detail") if isinstance(status.get("detail"), dict) else {}
    identity = detail.get("workerIdentity") if isinstance(detail.get("workerIdentity"), dict) else {}
    registry = detail.get("capabilityRegistry") if isinstance(detail.get("capabilityRegistry"), dict) else {}
    payload = {
        "protocolVersion": detail.get("protocolVersion"),
        "workerVersion": detail.get("workerVersion"),
        "schemaAuthority": detail.get("schemaAuthority"),
        "providers": detail.get("providers"),
        "workerIdentity": identity,
        "capabilities": sorted(status.get("capabilities", [])) if isinstance(status.get("capabilities"), list) else [],
        "capabilityRegistry": registry,
    }
    return {
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "algorithm": "sha256",
        "hash": common.canonical_hash(payload),
    }


def _attestation_mismatch(worker: dict[str, Any], status: dict[str, Any]) -> str | None:
    attestation = worker.get("statusAttestation")
    if not isinstance(attestation, dict) or not isinstance(attestation.get("hash"), str):
        return None
    actual = _status_attestation(status)["hash"]
    if actual != attestation["hash"]:
        return "worker capability attestation does not match current status"
    return None


def _failure_class(reason: str, status: str | None = None) -> str:
    text = f"{status or ''} {reason}".lower()
    if "auth" in text or "credential" in text or "permission" in text:
        return "auth"
    if "quota" in text or "rate" in text:
        return "quota"
    if "capacity" in text or "slot" in text or "reserved" in text:
        return "capacity"
    if "image" in text or "pull" in text:
        return "image-pull"
    if "timeout" in text or "timed out" in text or "boot" in text:
        return "boot-timeout"
    if "health" in text or "status" in text:
        return "healthcheck-failed"
    return "protocol"


def _external_command(command: list[str], payload: dict[str, Any], *, timeout: int) -> tuple[int, dict[str, Any], str]:
    if not command or any(not isinstance(item, str) or not item for item in command):
        raise common.TaskBundleError("external command must be a non-empty argv array")
    try:
        result = subprocess.run(
            command,
            input=json.dumps(payload, sort_keys=True),
            capture_output=True,
            text=True,
            timeout=timeout,
            env=common.execution_env(),
        )
    except subprocess.TimeoutExpired as exc:
        return EXIT_PROTOCOL_ERROR, {
            "status": "FAILED",
            "reason": f"external command timed out after {timeout}s",
            "retryable": True,
        }, exc.stderr or ""
    response = _parse_json(result.stdout) or _parse_json(result.stderr)
    return result.returncode, response, result.stderr


def _invoke_worker(worker: dict[str, Any], args: list[str], *, input_text: str | None = None,
                   timeout: int = 120) -> tuple[int, dict[str, Any], dict[str, Any], str, str]:
    transport = worker.get("transport") if isinstance(worker.get("transport"), dict) else {}
    timeout = int(transport.get("timeoutSeconds") or timeout)
    command = _worker_argv(worker, args)
    try:
        result = subprocess.run(command, input=input_text, capture_output=True, text=True, timeout=timeout,
                                env=_worker_env(worker))
    except subprocess.TimeoutExpired as exc:
        return (
            EXIT_PROTOCOL_ERROR,
            {},
            {
                "status": "BROKER_BLOCKED",
                "reason": f"worker command timed out after {timeout}s",
                "retryable": True,
            },
            exc.stdout or "",
            exc.stderr or "",
        )
    return result.returncode, _parse_json(result.stdout), _parse_json(result.stderr), result.stdout, result.stderr


def _invoke_worker_with_heartbeat(worker: dict[str, Any], args: list[str], *, input_text: str | None,
                                  timeout: int, task_id: str, lease_id: str,
                                  ttl_seconds: int, heartbeat_interval_seconds: int) -> tuple[
                                      int, dict[str, Any], dict[str, Any], str, str, list[dict[str, Any]]
                                  ]:
    if heartbeat_interval_seconds <= 0:
        code, stdout_payload, stderr_payload, stdout, stderr = _invoke_worker(
            worker, args, input_text=input_text, timeout=timeout)
        return code, stdout_payload, stderr_payload, stdout, stderr, []
    renewals: list[dict[str, Any]] = []
    stop = threading.Event()

    def renew_loop() -> None:
        while not stop.wait(heartbeat_interval_seconds):
            code, renewed, error, _stdout, _stderr = _invoke_worker(
                worker,
                ["worker-lease", task_id, "--renew", "--lease-id", lease_id, "--ttl-seconds", str(ttl_seconds)],
                timeout=30,
            )
            renewals.append({
                "status": "RENEWED" if code == 0 else "FAILED",
                **({"leaseId": renewed.get("leaseId"), "renewalCount": renewed.get("renewalCount")}
                   if code == 0 else {"reason": error.get("reason", "lease renew failed")}),
                "producedAt": common.utc_now(),
            })

    thread = threading.Thread(target=renew_loop, daemon=True)
    thread.start()
    try:
        result = subprocess.run(
            _worker_argv(worker, args),
            input=input_text,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=_worker_env(worker),
        )
        return result.returncode, _parse_json(result.stdout), _parse_json(result.stderr), result.stdout, result.stderr, renewals
    except subprocess.TimeoutExpired as exc:
        return (
            EXIT_PROTOCOL_ERROR,
            {},
            {
                "status": "BROKER_BLOCKED",
                "reason": f"worker command timed out after {timeout}s",
                "retryable": True,
            },
            exc.stdout or "",
            exc.stderr or "",
            renewals,
        )
    finally:
        stop.set()
        thread.join(timeout=1)


def _merge_workers(pool: dict[str, Any], workers: list[dict[str, Any]]) -> list[str]:
    added_or_updated = []
    by_id = {
        worker.get("id"): index
        for index, worker in enumerate(pool.get("workers", []))
        if isinstance(worker, dict) and isinstance(worker.get("id"), str)
    }
    for worker in workers:
        if not isinstance(worker, dict) or not isinstance(worker.get("id"), str):
            continue
        if worker["id"] in by_id:
            pool["workers"][by_id[worker["id"]]] = worker
        else:
            pool.setdefault("workers", []).append(worker)
        added_or_updated.append(worker["id"])
    return added_or_updated


def _remove_workers(pool: dict[str, Any], worker_ids: set[str]) -> None:
    pool["workers"] = [
        worker for worker in pool.get("workers", [])
        if not (isinstance(worker, dict) and worker.get("id") in worker_ids)
    ]
    pool["updatedAt"] = common.utc_now()


def _healthcheck_provisioned_workers(pool: dict[str, Any], worker_ids: list[str]) -> list[dict[str, Any]]:
    reports: list[dict[str, Any]] = []
    failed: set[str] = set()
    for worker_id in worker_ids:
        worker = next(
            (item for item in pool.get("workers", []) if isinstance(item, dict) and item.get("id") == worker_id),
            None,
        )
        if worker is None:
            failed.add(worker_id)
            reports.append({"workerId": worker_id, "status": "FAILED", "failureClass": "healthcheck-failed",
                            "reason": "provisioned worker was not inserted into pool"})
            continue
        try:
            code, status, error, _stdout, _stderr = _invoke_worker(worker, ["status"], timeout=30)
            if code != 0 or not status:
                reason = error.get("reason") or error.get("error") or "worker status failed"
                raise common.TaskBundleError(str(reason))
            _validate_worker_status(status, worker_id)
            if _worker_id(worker, status) != worker_id:
                raise common.TaskBundleError("worker status identity differs from provisioned worker id")
            worker["status"] = status
            worker["lastSeenAt"] = status.get("producedAt") or common.utc_now()
            worker["statusAttestation"] = _status_attestation(status)
            reports.append({
                "workerId": worker_id,
                "status": "READY",
                "statusAttestation": worker["statusAttestation"],
            })
        except common.TaskBundleError as exc:
            failed.add(worker_id)
            reports.append({
                "workerId": worker_id,
                "status": "FAILED",
                "failureClass": "healthcheck-failed",
                "reason": str(exc),
            })
    if failed:
        _remove_workers(pool, failed)
    return reports


def _record_worker_fault(pool: dict[str, Any], state: dict[str, Any] | None, task_id: str,
                         worker_id: str, reason: str) -> None:
    worker = next(
        (item for item in pool.get("workers", []) if isinstance(item, dict) and item.get("id") == worker_id),
        None,
    )
    if worker is None:
        return
    health = worker.setdefault("health", {})
    health["recentFailures"] = int(health.get("recentFailures") or 0) + 1
    if health["recentFailures"] >= WORKER_FAULT_QUARANTINE_THRESHOLD:
        worker["quarantine"] = {
            "active": True,
            "reason": reason,
            "failureCount": health["recentFailures"],
            "producedAt": common.utc_now(),
        }
        _append_operator_audit(state, task_id, "quarantine-worker", workerId=worker_id, reason=reason)
        _append_event(state, task_id, "worker-quarantined", workerId=worker_id, reason=reason)


def _load_provisioner_registry(path: Path | None) -> list[dict[str, Any]]:
    if path is None:
        return []
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise common.TaskBundleError(f"provisioner registry is unavailable: {exc}") from exc
    if not isinstance(payload, dict):
        raise common.TaskBundleError("provisioner registry must be a JSON object")
    common.validate_with_schema(
        payload,
        "canonical/provisioner-registry-v1.json",
        "provisioner registry",
        validation_point="broker-provisioner-registry-admission",
        artifact_kind="provisioner-registry",
    )
    return [item for item in payload.get("provisioners", []) if isinstance(item, dict)]


def _provisioner_commands(pool: dict[str, Any], args) -> list[tuple[str, list[str], int]]:
    commands = []
    for index, command in enumerate(getattr(args, "provision_command", []) or []):
        commands.append((f"cli-{index + 1}", command, getattr(args, "provision_timeout_seconds", 120)))
    registry_provisioners = _load_provisioner_registry(getattr(args, "provisioner_registry", None))
    configured = [
        *(pool.get("provisioners", []) if isinstance(pool.get("provisioners"), list) else []),
        *registry_provisioners,
    ]
    for provisioner in configured:
        if not isinstance(provisioner, dict):
            continue
        command = provisioner.get("command")
        if isinstance(command, list):
            commands.append((
                str(provisioner.get("id") or f"registry-{len(commands) + 1}"),
                command,
                int(provisioner.get("timeoutSeconds") or getattr(args, "provision_timeout_seconds", 120)),
            ))
    return commands


def _provisioner_discovery_score(discovery: dict[str, Any], policy_pack: dict[str, Any],
                                 max_parallel: int) -> int:
    if discovery.get("status") != "DISCOVERED" or discovery.get("canProvision") is not True:
        return -1_000_000
    score = 10_000
    trust_levels = discovery.get("trustLevels") if isinstance(discovery.get("trustLevels"), list) else []
    risk = policy_pack.get("riskClass") if isinstance(policy_pack.get("riskClass"), str) else "normal"
    if risk in {"high", "critical"} and "secure-enterprise" not in trust_levels:
        score -= 5_000
    startup = discovery.get("estimatedStartupSeconds")
    if isinstance(startup, int):
        score -= min(startup, 3600)
    cost = str(discovery.get("costClass") or "standard").lower()
    score -= COST_CLASS_SCORE.get(cost, 2) * 100
    worker_kinds = discovery.get("workerKinds") if isinstance(discovery.get("workerKinds"), list) else []
    score += min(len(worker_kinds), max_parallel) * 10
    return score


def _run_provisioners(pool: dict[str, Any], args, task_id: str, contract: dict[str, Any],
                      contract_hash: str, state: dict[str, Any] | None) -> list[dict[str, Any]]:
    commands = _provisioner_commands(pool, args)
    if not commands:
        return []
    required_capabilities, max_parallel, policy_pack = _contract_requirements(contract)
    reports = []
    discovery_request = {
        "schemaVersion": 1,
        "action": "discover",
        "taskId": task_id,
        "contractHash": contract_hash,
        "requiredCapabilities": sorted(required_capabilities),
        "maxParallel": max_parallel,
        "policyPack": policy_pack,
        "existingWorkers": [
            {"id": worker.get("id"), "transport": _worker_transport_kind(worker)}
            for worker in pool.get("workers", []) if isinstance(worker, dict)
        ],
    }
    common.validate_with_schema(
        discovery_request,
        "canonical/broker-provision-discovery-request-v1.json",
        "broker provision discovery request",
        validation_point="broker-provision-discovery-request",
        artifact_kind="broker-provision-discovery-request",
        task_id=task_id,
    )
    reserve_request = {
        **discovery_request,
        "action": "reserve",
    }
    common.validate_with_schema(
        reserve_request,
        "canonical/broker-provision-reservation-request-v1.json",
        "broker provision reservation request",
        validation_point="broker-provision-reservation-request",
        artifact_kind="broker-provision-reservation-request",
        task_id=task_id,
    )
    request = {
        **discovery_request,
        "action": "provision",
        "existingWorkers": [
            {"id": worker.get("id"), "transport": _worker_transport_kind(worker)}
            for worker in pool.get("workers", []) if isinstance(worker, dict)
        ],
    }
    common.validate_with_schema(
        request,
        "canonical/broker-provision-request-v1.json",
        "broker provision request",
        validation_point="broker-provision-request",
        artifact_kind="broker-provision-request",
        task_id=task_id,
    )
    discovered: list[dict[str, Any]] = []
    for provisioner_id, command, timeout in commands:
        discovery_code, discovery_response, discovery_stderr = _external_command(
            command, discovery_request, timeout=timeout)
        if not discovery_response:
            discovery_response = {
                "schemaVersion": 1,
                "status": "FAILED",
                "canProvision": False,
                "workerKinds": [],
                "trustLevels": [],
                "supportedProviders": [],
                "reason": discovery_stderr.strip() or "provisioner returned no discovery JSON",
            }
        _append_provisioner_replay(
            state, task_id, provisioner_id, "discover", discovery_request, discovery_response, discovery_code)
        common.validate_with_schema(
            discovery_response,
            "canonical/broker-provision-discovery-response-v1.json",
            "broker provision discovery response",
            validation_point="broker-provision-discovery-response",
            artifact_kind="broker-provision-discovery-response",
            task_id=task_id,
        )
        discovery = {
            "status": discovery_response["status"],
            "canProvision": bool(discovery_response.get("canProvision")),
            "workerKinds": discovery_response.get("workerKinds", []),
            "trustLevels": discovery_response.get("trustLevels", []),
            "supportedProviders": discovery_response.get("supportedProviders", []),
            "estimatedStartupSeconds": discovery_response.get("estimatedStartupSeconds"),
            "costClass": discovery_response.get("costClass"),
            **({"reason": discovery_response.get("reason") or discovery_stderr.strip()}
               if discovery_code != 0 or not discovery_response.get("canProvision") else {}),
        }
        _append_event(state, task_id, "provision-discovery", provisionerId=provisioner_id,
                      status=discovery["status"], canProvision=discovery["canProvision"])
        if discovery_code != 0 or discovery_response["status"] != "DISCOVERED" or not discovery_response.get("canProvision"):
            report = {
                "id": provisioner_id,
                "status": "SKIPPED" if discovery_code == 0 else "FAILED",
                "workers": [],
                "discovery": discovery,
                "selection": {"selected": False, "score": _provisioner_discovery_score(discovery, policy_pack, max_parallel)},
                **({"reason": discovery.get("reason") or "provisioner cannot satisfy requirements"}),
                "failureClass": _failure_class(discovery.get("reason") or "provisioner cannot satisfy requirements",
                                               discovery.get("status")),
            }
            reports.append(report)
            _append_event(state, task_id, "provision", provisionerId=provisioner_id,
                          status=report["status"], workers=[])
            continue
        discovered.append({
            "id": provisioner_id,
            "command": command,
            "timeout": timeout,
            "discovery": discovery,
            "score": _provisioner_discovery_score(discovery, policy_pack, max_parallel),
        })
    selected_id = None
    if discovered:
        selected = max(discovered, key=lambda item: (item["score"], item["id"]))
        selected_id = selected["id"]
    for item in discovered:
        provisioner_id = item["id"]
        command = item["command"]
        timeout = item["timeout"]
        discovery = item["discovery"]
        if provisioner_id != selected_id and not getattr(args, "provision_all", False):
            reports.append({
                "id": provisioner_id,
                "status": "SKIPPED",
                "workers": [],
                "discovery": discovery,
                "selection": {"selected": False, "score": item["score"], "reason": "lower ranked provisioner"},
                "reason": "lower ranked provisioner",
            })
            _append_event(state, task_id, "provision", provisionerId=provisioner_id,
                          status="SKIPPED", workers=[])
            continue
        reserve_code, reserve_response, reserve_stderr = _external_command(command, reserve_request, timeout=timeout)
        if not reserve_response:
            reserve_response = {
                "status": "FAILED",
                "reason": reserve_stderr.strip() or "provisioner returned no reservation JSON",
                "retryable": True,
            }
        _append_provisioner_replay(
            state, task_id, provisioner_id, "reserve", reserve_request, reserve_response, reserve_code)
        common.validate_with_schema(
            reserve_response,
            "canonical/broker-provision-reservation-response-v1.json",
            "broker provision reservation response",
            validation_point="broker-provision-reservation-response",
            artifact_kind="broker-provision-reservation-response",
            task_id=task_id,
        )
        if reserve_code != 0 or reserve_response.get("status") != "RESERVED":
            report = {
                "id": provisioner_id,
                "status": "FAILED",
                "workers": [],
                "discovery": discovery,
                "reservation": reserve_response,
                "selection": {"selected": True, "score": item["score"], "reason": "highest ranked provisioner"},
                "reason": reserve_response.get("reason") or reserve_stderr.strip() or "capacity reservation failed",
                "failureClass": _failure_class(
                    reserve_response.get("reason") or reserve_stderr.strip() or "capacity reservation failed",
                    reserve_response.get("status")),
            }
            reports.append(report)
            _append_event(state, task_id, "provision-reservation", provisionerId=provisioner_id,
                          status=reserve_response.get("status", "FAILED"))
            _append_event(state, task_id, "provision", provisionerId=provisioner_id,
                          status="FAILED", workers=[])
            continue
        _append_event(state, task_id, "provision-reservation", provisionerId=provisioner_id,
                      status=reserve_response["status"])
        code, response, stderr = _external_command(command, request, timeout=timeout)
        if not response:
            response = {"status": "FAILED", "reason": stderr.strip() or "provisioner returned no JSON"}
        _append_provisioner_replay(
            state, task_id, provisioner_id, "provision", request, response, code)
        common.validate_with_schema(
            response,
            "canonical/broker-provision-response-v1.json",
            "broker provision response",
            validation_point="broker-provision-response",
            artifact_kind="broker-provision-response",
            task_id=task_id,
        )
        status = response.get("status") or ("PROVISIONED" if code == 0 else "FAILED")
        workers = response.get("workers") if isinstance(response.get("workers"), list) else []
        merged = _merge_workers(pool, workers) if code == 0 else []
        health_checks: list[dict[str, Any]] = []
        if code == 0 and status == "PROVISIONED" and merged:
            health_checks = _healthcheck_provisioned_workers(pool, merged)
            healthy = [item["workerId"] for item in health_checks if item.get("status") == "READY"]
            if not healthy:
                status = "FAILED"
                merged = []
            else:
                merged = healthy
        reservation_release = {}
        if code != 0 or status != "PROVISIONED" or not merged:
            release_request = {
                **reserve_request,
                "action": "release-reservation",
                "reservationId": reserve_response.get("reservationId", ""),
            }
            common.validate_with_schema(
                release_request,
                "canonical/broker-provision-reservation-request-v1.json",
                "broker provision reservation release request",
                validation_point="broker-provision-reservation-request",
                artifact_kind="broker-provision-reservation-request",
                task_id=task_id,
            )
            _release_code, reservation_release, _release_stderr = _external_command(
                command, release_request, timeout=timeout)
            _append_provisioner_replay(
                state, task_id, provisioner_id, "release-reservation",
                release_request, reservation_release, _release_code)
        report = {
            "id": provisioner_id,
            "status": status,
            "workers": merged,
            "discovery": discovery,
            "reservation": reserve_response,
            **({"healthChecks": health_checks} if health_checks else {}),
            **({"reservationRelease": reservation_release} if reservation_release else {}),
            "selection": {"selected": True, "score": item["score"], "reason": "highest ranked provisioner"},
            **({"reason": response.get("reason") or stderr.strip() or "provisioned workers failed healthcheck"}
               if code != 0 or status != "PROVISIONED" else {}),
            **({"failureClass": _failure_class(
                response.get("reason") or stderr.strip() or "provisioned workers failed healthcheck", status)}
               if code != 0 or status != "PROVISIONED" else {}),
        }
        reports.append(report)
        _append_event(state, task_id, "provision", provisionerId=provisioner_id,
                      status=status, workers=merged)
    if reports:
        pool["updatedAt"] = common.utc_now()
    return reports


def _deprovision_request(task_id: str, worker_id: str, reason: str) -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "action": "deprovision",
        "taskId": task_id,
        "workerId": worker_id,
        "reason": reason,
        "producedAt": common.utc_now(),
    }


def _remove_worker(pool: dict[str, Any], worker_id: str) -> bool:
    workers = pool.get("workers")
    if not isinstance(workers, list):
        return False
    kept = [worker for worker in workers if not (isinstance(worker, dict) and worker.get("id") == worker_id)]
    removed = len(kept) != len(workers)
    if removed:
        pool["workers"] = kept
        pool["updatedAt"] = common.utc_now()
    return removed


def _deprovision_worker(pool: dict[str, Any], args, task_id: str, worker_id: str,
                        state: dict[str, Any] | None, *, reason: str) -> dict[str, Any]:
    worker = next(
        (item for item in pool.get("workers", []) if isinstance(item, dict) and item.get("id") == worker_id),
        None,
    )
    if worker is None:
        return {"workerId": worker_id, "status": "NOT_FOUND"}
    lifecycle = worker.get("lifecycle") if isinstance(worker.get("lifecycle"), dict) else {}
    command = lifecycle.get("deprovisionCommand")
    if not isinstance(command, list) or not command:
        return {"workerId": worker_id, "status": "NO_DEPROVISION_HOOK"}
    timeout = int(lifecycle.get("timeoutSeconds") or getattr(args, "deprovision_timeout_seconds", 120))
    code, response, stderr = _external_command(command, _deprovision_request(task_id, worker_id, reason), timeout=timeout)
    status = response.get("status") or ("DEPROVISIONED" if code == 0 else "FAILED")
    removed = False
    if code == 0 and status in {"DEPROVISIONED", "RETIRED", "REMOVED"}:
        removed = _remove_worker(pool, worker_id)
    report = {
        "workerId": worker_id,
        "status": status,
        "removedFromPool": removed,
        **({"reason": response.get("reason") or stderr.strip()} if code != 0 else {}),
    }
    _append_event(state, task_id, "deprovision", workerId=worker_id, status=status, removedFromPool=removed)
    return report


def _deprovision_workers(pool: dict[str, Any], args, task_id: str, worker_ids: list[str],
                         state: dict[str, Any] | None, *, reason: str) -> list[dict[str, Any]]:
    reports = []
    seen: set[str] = set()
    for worker_id in worker_ids:
        if worker_id in seen:
            continue
        seen.add(worker_id)
        report = _deprovision_worker(pool, args, task_id, worker_id, state, reason=reason)
        if report["status"] != "NO_DEPROVISION_HOOK":
            reports.append(report)
    return reports


def _lock_request(args, action: str, task_id: str, contract_hash: str, node_id: str,
                  worker_id: str, lease_id: str | None = None) -> dict[str, Any]:
    command = getattr(args, "lock_command", None)
    if not command:
        return {"status": "NOT_CONFIGURED"}
    request = {
        "schemaVersion": 1,
        "action": action,
        "taskId": task_id,
        "contractHash": contract_hash,
        "nodeId": node_id,
        "workerId": worker_id,
        "ttlSeconds": getattr(args, "ttl_seconds", 3600),
        "producedAt": common.utc_now(),
    }
    if lease_id:
        request["leaseId"] = lease_id
    common.validate_with_schema(
        request,
        "canonical/broker-lock-request-v1.json",
        "broker lock request",
        validation_point="broker-lock-request",
        artifact_kind="broker-lock-request",
        task_id=task_id,
    )
    try:
        code, response, stderr = _external_command(command, request, timeout=getattr(args, "lock_timeout_seconds", 30))
    except (subprocess.SubprocessError, common.TaskBundleError) as exc:
        return {"status": "FAILED", "reason": str(exc), "retryable": True}
    if code != 0 and "status" not in response:
        response = {"status": "FAILED", "reason": stderr.strip() or "external lock command failed", "retryable": True}
    common.validate_with_schema(
        response,
        "canonical/broker-lock-response-v1.json",
        "broker lock response",
        validation_point="broker-lock-response",
        artifact_kind="broker-lock-response",
        task_id=task_id,
    )
    return response


def _status_for_worker(worker: dict[str, Any]) -> dict[str, Any]:
    status = worker.get("status")
    if isinstance(status, dict):
        _validate_worker_status(status, str(worker.get("id") or "<configured>"))
        return status
    code, stdout_payload, stderr_payload, _stdout, _stderr = _invoke_worker(worker, ["status"], timeout=30)
    if code != 0 or not stdout_payload:
        reason = stderr_payload.get("reason") or stderr_payload.get("error") or "worker status failed"
        raise common.TaskBundleError(f"worker {worker.get('id', '<unknown>')} status unavailable: {reason}")
    _validate_worker_status(stdout_payload, str(worker.get("id") or "<live>"))
    return stdout_payload


def _tool_contracts_for_worker(worker: dict[str, Any]) -> dict[str, Any]:
    cached = worker.get("_resolvedToolContracts")
    if isinstance(cached, dict):
        return cached
    code, stdout_payload, stderr_payload, _stdout, _stderr = _invoke_worker(worker, ["tool-contracts"], timeout=30)
    if code != 0 or not stdout_payload:
        reason = stderr_payload.get("reason") or stderr_payload.get("error") or "worker tool-contracts failed"
        raise common.TaskBundleError(f"worker {worker.get('id', '<unknown>')} tool contracts unavailable: {reason}")
    common.validate_with_schema(
        stdout_payload,
        "canonical/agent-tool-contract-registry-v1.json",
        "agent tool contract registry",
        validation_point="broker-admission",
        artifact_kind="agent-tool-contract-registry",
    )
    worker["_resolvedToolContracts"] = stdout_payload
    return stdout_payload


def _tool_contract_by_capability(registry: dict[str, Any], capability: str) -> dict[str, Any] | None:
    contracts = registry.get("contracts") if isinstance(registry.get("contracts"), list) else []
    for contract in contracts:
        if isinstance(contract, dict) and contract.get("capabilityId") == capability:
            return contract
    return None


def _node_contract_check(worker_id: str, registry: dict[str, Any], node: dict[str, Any]) -> dict[str, Any]:
    capability = str(node.get("capability") or "")
    contract = _tool_contract_by_capability(registry, capability)
    reasons: list[str] = []
    if not isinstance(contract, dict):
        reasons.append(f"tool contract for capability {capability!r} is missing")
        contract = {}
    elif contract.get("available") is not True:
        reasons.append(f"tool contract for capability {capability!r} is unavailable")
    outputs = node.get("outputs") if isinstance(node.get("outputs"), dict) else {}
    schema = outputs.get("schema")
    output_schemas = contract.get("outputSchemas") if isinstance(contract.get("outputSchemas"), list) else []
    if isinstance(schema, str) and schema and schema not in output_schemas:
        reasons.append(f"tool contract does not produce output schema {schema!r}")
    evidence_role = outputs.get("evidenceRole")
    evidence_roles = contract.get("evidenceRoles") if isinstance(contract.get("evidenceRoles"), list) else []
    if isinstance(evidence_role, str) and evidence_role and evidence_role not in evidence_roles:
        reasons.append(f"tool contract does not produce evidence role {evidence_role!r}")
    permissions = contract.get("permissions") if isinstance(contract.get("permissions"), dict) else {}
    if evidence_role == "deterministic-acceptance" or capability in {"deterministic-verify", "verify"}:
        if contract.get("deterministicAcceptanceAuthority") is not True:
            reasons.append("deterministic acceptance node lacks deterministic acceptance authority")
        if permissions.get("canGateAcceptance") is not True:
            reasons.append("deterministic acceptance node cannot gate acceptance")
    return {
        "workerId": worker_id,
        "nodeId": str(node.get("id") or capability or "node"),
        "capability": capability,
        "status": "PASS" if not reasons else "BLOCKED",
        "reasons": reasons,
        "toolId": contract.get("toolId"),
        "provider": contract.get("provider"),
        "authority": contract.get("authority"),
        "deterministicAcceptanceAuthority": contract.get("deterministicAcceptanceAuthority") is True,
        "contractHash": common.canonical_hash(contract) if contract else "",
    }


def _worker_id(worker: dict[str, Any], status: dict[str, Any]) -> str:
    identity = status.get("detail", {}).get("workerIdentity", {})
    configured = worker.get("id")
    if isinstance(configured, str) and configured:
        return configured
    if isinstance(identity, dict) and isinstance(identity.get("id"), str):
        return identity["id"]
    raise common.TaskBundleError("worker entry has no id and status has no workerIdentity.id")


def _status_last_seen(status: dict[str, Any], worker: dict[str, Any]) -> datetime.datetime | None:
    value = worker.get("lastSeenAt") or status.get("producedAt")
    return _utc_parse(value) if isinstance(value, str) else None


def _trust_satisfies(policy_pack: dict[str, Any], trust_level: str) -> bool:
    policy = common.load_worker_pool_trust_policy()
    allowed = policy.get("riskTrust", {}).get(policy_pack.get("riskClass", "normal"), [])
    return trust_level in allowed


def _placement_policy_satisfies(worker: dict[str, Any], identity: dict[str, Any], policy_pack: dict[str, Any],
                                active_count: int) -> list[str]:
    placement = worker.get("placement") if isinstance(worker.get("placement"), dict) else {}
    reasons: list[str] = []
    allowed_risks = placement.get("allowedRiskClasses")
    if isinstance(allowed_risks, list) and policy_pack.get("riskClass", "normal") not in allowed_risks:
        reasons.append(f"risk class {policy_pack.get('riskClass')} is not allowed by worker placement policy")
    forbidden_kinds = placement.get("forbiddenWorkerKinds")
    if isinstance(forbidden_kinds, list) and identity.get("kind") in forbidden_kinds:
        reasons.append(f"worker kind {identity.get('kind')!r} is forbidden by placement policy")
    required_labels = placement.get("requiredLabels")
    labels = identity.get("labels") if isinstance(identity.get("labels"), list) else []
    if isinstance(required_labels, list):
        missing = sorted(set(required_labels) - set(labels))
        if missing:
            reasons.append(f"worker is missing required labels: {', '.join(missing)}")
    max_active = placement.get("maxActiveLeases")
    if isinstance(max_active, int) and active_count >= max_active:
        reasons.append(f"worker has no free lease capacity ({active_count}/{max_active})")
    return reasons


def _contract_requirements(contract: dict[str, Any]) -> tuple[set[str], int, dict[str, Any]]:
    workflow = contract["workflow"]
    nodes = workflow["nodes"]
    required = {node["capability"] for node in nodes}
    required.update(contract["policyPack"].get("requiredCapabilities", []))
    return required, workflow.get("maxParallel", 1), contract["policyPack"]


def _active_task_lease(worker: dict[str, Any], task_id: str) -> dict[str, Any] | None:
    try:
        code, stdout_payload, _stderr_payload, _stdout, _stderr = _invoke_worker(
            worker, ["task-state", task_id], timeout=30)
    except (subprocess.SubprocessError, common.TaskBundleError):
        return None
    if code != 0 or not stdout_payload:
        return None
    lease = stdout_payload.get("workerLease")
    if isinstance(lease, dict) and lease.get("status") == "ACTIVE":
        return lease
    return None


def _eligibility(worker: dict[str, Any], status: dict[str, Any], contract: dict[str, Any],
                 task_id: str, *, stale_seconds: int, state: dict[str, Any] | None = None) -> tuple[bool, list[str]]:
    reasons: list[str] = []
    quarantine = worker.get("quarantine") if isinstance(worker.get("quarantine"), dict) else {}
    if quarantine.get("active") is True:
        reasons.append(f"worker is quarantined: {quarantine.get('reason', 'operator policy')}")
    detail = status.get("detail") if isinstance(status.get("detail"), dict) else {}
    identity = detail.get("workerIdentity") if isinstance(detail.get("workerIdentity"), dict) else {}
    registry = detail.get("capabilityRegistry") if isinstance(detail.get("capabilityRegistry"), dict) else {}
    protocol = _protocol_tuple(str(detail.get("protocolVersion", "")))
    if protocol < MIN_PROTOCOL:
        reasons.append(f"protocol {detail.get('protocolVersion')} is below 2.10")
    mismatch = _attestation_mismatch(worker, status)
    if mismatch:
        reasons.append(mismatch)
    seen = _status_last_seen(status, worker)
    if seen is None:
        reasons.append("worker status has no parseable lastSeenAt/producedAt")
    elif (datetime.datetime.now(datetime.timezone.utc) - seen).total_seconds() > stale_seconds:
        reasons.append("worker status is stale")
    required_capabilities, max_parallel, policy_pack = _contract_requirements(contract)
    for capability in sorted(required_capabilities):
        entry = registry.get(capability)
        if not isinstance(entry, dict) or entry.get("available") is not True:
            reasons.append(f"capability {capability!r} is unavailable")
    worker_id = _worker_id(worker, status)
    try:
        tool_registry = _tool_contracts_for_worker(worker)
        checks = [
            _node_contract_check(worker_id, tool_registry, node)
            for node in contract["workflow"]["nodes"]
        ]
        worker["_resolvedContractChecks"] = checks
        for check in checks:
            if check["status"] != "PASS":
                reasons.extend(check["reasons"])
    except common.TaskBundleError as exc:
        reasons.append(str(exc))
    limits = identity.get("resourceLimits") if isinstance(identity.get("resourceLimits"), dict) else {}
    if limits.get("maxWorkflowParallel", 0) < max_parallel:
        reasons.append("worker maxWorkflowParallel is below workflow maxParallel")
    trust_level = str(identity.get("trustLevel", "untrusted"))
    if not _trust_satisfies(policy_pack, trust_level):
        reasons.append(f"trust level {trust_level!r} does not satisfy {policy_pack.get('riskClass')} policy")
    reasons.extend(_placement_policy_satisfies(
        worker, identity, policy_pack, _active_leases_by_worker(state).get(worker_id, 0)))
    lease = _active_task_lease(worker, task_id)
    if lease and lease.get("workerId") != worker_id:
        reasons.append(f"task has active lease {lease.get('leaseId')} held by {lease.get('workerId')}")
    return not reasons, reasons


def _worker_health_score(worker: dict[str, Any], status: dict[str, Any],
                         state: dict[str, Any] | None = None) -> int:
    health = worker.get("health") if isinstance(worker.get("health"), dict) else {}
    score = int(health.get("score", 80))
    score -= int(health.get("recentFailures", 0)) * 10
    score -= min(int(health.get("latencyMs", 0)) // 100, 20)
    active = _active_leases_by_worker(state).get(_worker_id(worker, status), 0)
    score -= active * 5
    missing = status.get("missing") if isinstance(status.get("missing"), list) else []
    score -= len(missing) * 10
    if _worker_transport_kind(worker) in {"local", "ssh"}:
        score += 2
    return max(0, min(100, score))


def _node_capability_available(worker: dict[str, Any], status: dict[str, Any], capability: str) -> bool:
    registry = status.get("detail", {}).get("capabilityRegistry", {}) if isinstance(status.get("detail"), dict) else {}
    entry = registry.get(capability) if isinstance(registry, dict) else None
    if not isinstance(entry, dict) or entry.get("available") is not True:
        return False
    try:
        contracts = _tool_contracts_for_worker(worker)
    except common.TaskBundleError:
        return False
    contract = _tool_contract_by_capability(contracts, capability)
    return isinstance(contract, dict) and contract.get("available") is True


def _placement_plan(workers: list[dict[str, Any]], candidates: list[dict[str, Any]],
                    contract: dict[str, Any], task_id: str, contract_hash: str,
                    state: dict[str, Any] | None = None,
                    stale_seconds: int = 300) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    resolved_workers = []
    _required_capabilities, max_parallel, policy_pack = _contract_requirements(contract)
    for worker in workers:
        if not isinstance(worker, dict):
            continue
        try:
            status = _status_for_worker(worker)
            worker_id = _worker_id(worker, status)
            detail = status.get("detail") if isinstance(status.get("detail"), dict) else {}
            identity = detail.get("workerIdentity") if isinstance(detail.get("workerIdentity"), dict) else {}
            reasons: list[str] = []
            quarantine = worker.get("quarantine") if isinstance(worker.get("quarantine"), dict) else {}
            if quarantine.get("active") is True:
                reasons.append("worker is quarantined")
            if _protocol_tuple(str(detail.get("protocolVersion", ""))) < MIN_PROTOCOL:
                reasons.append("protocol is below 2.10")
            mismatch = _attestation_mismatch(worker, status)
            if mismatch:
                reasons.append(mismatch)
            seen = _status_last_seen(status, worker)
            if seen is None or (datetime.datetime.now(datetime.timezone.utc) - seen).total_seconds() > stale_seconds:
                reasons.append("worker status is stale")
            limits = identity.get("resourceLimits") if isinstance(identity.get("resourceLimits"), dict) else {}
            if limits.get("maxWorkflowParallel", 0) < max_parallel:
                reasons.append("worker maxWorkflowParallel is below workflow maxParallel")
            if not _trust_satisfies(policy_pack, str(identity.get("trustLevel", "untrusted"))):
                reasons.append("worker trust does not satisfy policy")
            reasons.extend(_placement_policy_satisfies(
                worker, identity, policy_pack, _active_leases_by_worker(state).get(worker_id, 0)))
        except common.TaskBundleError:
            continue
        if not reasons:
            try:
                contracts = _tool_contracts_for_worker(worker)
            except common.TaskBundleError:
                continue
            resolved_workers.append((worker, status, worker_id, _worker_health_score(worker, status, state), contracts))
    placements = []
    for node in contract["workflow"]["nodes"]:
        eligible = []
        checks_by_worker = {}
        for worker, status, worker_id, score, contracts in resolved_workers:
            check = _node_contract_check(worker_id, contracts, node)
            checks_by_worker[worker_id] = check
            if _node_capability_available(worker, status, node["capability"]) and check["status"] == "PASS":
                eligible.append({"workerId": worker_id, "score": score})
        eligible.sort(key=lambda item: (-item["score"], item["workerId"]))
        selected_worker_id = eligible[0]["workerId"] if eligible else None
        placements.append({
            "nodeId": node["id"],
            "capability": node["capability"],
            "workerId": selected_worker_id,
            "eligibleWorkers": eligible,
            **({"contractCheck": checks_by_worker[selected_worker_id]} if selected_worker_id else {}),
            "selectionReason": (
                f"selected highest scored eligible worker {eligible[0]['workerId']} ({eligible[0]['score']})"
                if eligible else "no worker advertises the required capability under current policy"
            ),
        })
    node_worker = {item["nodeId"]: item.get("workerId") for item in placements}
    transfers = []
    for node in contract["workflow"]["nodes"]:
        to_worker = node_worker.get(node["id"])
        if not to_worker:
            continue
        inputs = node.get("inputs") if isinstance(node.get("inputs"), dict) else {}
        for source in inputs.get("artifactsFrom", []):
            from_worker = node_worker.get(source)
            if from_worker and from_worker != to_worker:
                transfers.append({
                    "fromNodeId": source,
                    "toNodeId": node["id"],
                    "fromWorkerId": from_worker,
                    "toWorkerId": to_worker,
                    "artifactRole": node.get("outputs", {}).get("evidenceRole", ""),
                    "required": True,
                })
    manifest = {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker artifact transfer planner",
        "contractHash": contract_hash,
        "transfers": transfers,
    }
    return placements, manifest


def _read_bundle(input_text: str, task_id: str) -> tuple[dict[str, Any], dict[str, Any], str]:
    bundle = _parse_json(input_text)
    if not bundle:
        raise common.TaskBundleError("broker requires a JSON task bundle on stdin")
    contract = common.validate_workflow_contract(bundle.get("contract"), task_id)
    return bundle, contract, common.canonical_hash(contract)


def _select_worker(pool: dict[str, Any], contract: dict[str, Any], task_id: str,
                   *, stale_seconds: int,
                   state: dict[str, Any] | None = None) -> tuple[dict[str, Any] | None, list[dict[str, Any]]]:
    candidates = []
    eligible_workers = []
    for worker in pool["workers"]:
        if not isinstance(worker, dict):
            continue
        try:
            status = _status_for_worker(worker)
            worker_id = _worker_id(worker, status)
            eligible, reasons = _eligibility(
                worker, status, contract, task_id, stale_seconds=stale_seconds, state=state)
            score = _worker_health_score(worker, status, state) if eligible else 0
        except common.TaskBundleError as exc:
            status = {}
            worker_id = str(worker.get("id") or "<unknown>")
            eligible, reasons, score = False, [str(exc)], 0
        record = {
            "workerId": worker_id,
            "eligible": eligible,
            "reasons": reasons,
            "score": score,
            "transport": _worker_transport_kind(worker),
            "statusClassification": status.get("classification"),
        }
        if isinstance(worker.get("_resolvedContractChecks"), list):
            record["contractChecks"] = worker["_resolvedContractChecks"]
        if isinstance(worker.get("_resolvedToolContracts"), dict):
            record["toolContractCount"] = len(worker["_resolvedToolContracts"].get("contracts", []))
        attestation = worker.get("statusAttestation")
        if isinstance(attestation, dict):
            record["statusAttestation"] = attestation
        identity = status.get("detail", {}).get("workerIdentity", {}) if isinstance(status.get("detail"), dict) else {}
        if isinstance(identity, dict):
            record["workerKind"] = identity.get("kind")
            record["trustLevel"] = identity.get("trustLevel")
        candidates.append(record)
        if eligible:
            eligible_workers.append((score, worker_id, {**worker, "_resolvedStatus": status, "_resolvedWorkerId": worker_id}))
    eligible_workers.sort(key=lambda item: (-item[0], item[1]))
    selected = eligible_workers[0][2] if eligible_workers else None
    return selected, candidates


def _broker_envelope(task_id: str) -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker",
        "brokerVersion": BROKER_VERSION,
        "schemaRegistryHash": common.schema_registry_hash(),
    }


def _workflow_identity(task_id: str, contract: dict[str, Any]) -> tuple[str, str, str]:
    workflow_id = contract["workflow"].get("workflowId") or task_id
    contract_hash = common.canonical_hash(contract)
    run_seed = f"{task_id}|{workflow_id}|{contract_hash}"
    return workflow_id, contract_hash, "wr-" + hashlib.sha256(run_seed.encode()).hexdigest()[:24]


def _workflow_node_policy(node: dict[str, Any]) -> dict[str, Any]:
    policy = node.get("policy") if isinstance(node.get("policy"), dict) else {}
    required = policy.get("required", True)
    blocks_on = policy.get("blocksOn")
    if blocks_on is None:
        blocks_on = ["FAILED", "BLOCKED"] if required else []
    return {
        "required": required,
        "blocksOn": blocks_on,
        "timeoutSeconds": policy.get("timeoutSeconds", 900),
    }


def _workflow_node_contract_hash(node: dict[str, Any]) -> str:
    normalized: dict[str, Any] = {
        "id": node["id"],
        "capability": node["capability"],
        "dependsOn": node["dependsOn"],
        "policy": _workflow_node_policy(node),
    }
    if isinstance(node.get("inputs"), dict):
        normalized["inputs"] = node["inputs"]
    if isinstance(node.get("outputs"), dict):
        normalized["outputs"] = node["outputs"]
    return common.canonical_hash(normalized)


def _workflow_topological_ready(nodes: list[dict[str, Any]], completed: set[str],
                                terminal: set[str]) -> list[dict[str, Any]]:
    return [
        node for node in nodes
        if node["id"] not in terminal and all(dep in completed for dep in node["dependsOn"])
    ]


def _workflow_resolved_inputs(node: dict[str, Any], results: dict[str, dict[str, Any]]) -> dict[str, Any] | None:
    inputs = node.get("inputs")
    if not isinstance(inputs, dict):
        return None
    resolved: dict[str, Any] = {}
    commit_from = inputs.get("commitFrom")
    if commit_from:
        source = results.get(commit_from, {})
        payload = source.get("payload") if isinstance(source.get("payload"), dict) else {}
        provenance = payload.get("provenance") if isinstance(payload.get("provenance"), dict) else {}
        commit = provenance.get("commit")
        resolved["commit"] = {"nodeId": commit_from, **({"commit": commit} if commit else {})}
    artifacts = []
    for node_id in inputs.get("artifactsFrom", []):
        for artifact in results.get(node_id, {}).get("artifacts", []):
            artifacts.append({"nodeId": node_id, **artifact})
    if artifacts:
        resolved["artifacts"] = artifacts
    return resolved


def _attach_imported_local_paths(resolved: dict[str, Any] | None, imports: list[dict[str, Any]]) -> dict[str, Any] | None:
    if not isinstance(resolved, dict) or not imports:
        return resolved
    by_identity = {
        (item.get("sourceNodeId"), item.get("kind"), item.get("sha256")): item.get("path")
        for item in imports
        if item.get("status") == "IMPORTED" and isinstance(item.get("path"), str)
    }
    artifacts = resolved.get("artifacts")
    if not isinstance(artifacts, list):
        return resolved
    for artifact in artifacts:
        if not isinstance(artifact, dict):
            continue
        local_path = by_identity.get((artifact.get("nodeId"), artifact.get("kind"), artifact.get("sha256")))
        if local_path:
            artifact["localPath"] = local_path
    return resolved


def _node_completes_dependency(node: dict[str, Any], record: dict[str, Any]) -> bool:
    status = record.get("status")
    if status == "WAITING":
        return False
    return status not in set(_workflow_node_policy(node).get("blocksOn") or [])


def _distributed_record(record: dict[str, Any] | None, task_id: str | None = None) -> dict[str, Any] | None:
    if record is None:
        return None
    distributed = record.setdefault("distributed", {})
    distributed.setdefault("schemaVersion", 1)
    if task_id is not None:
        distributed["taskId"] = task_id
    distributed.setdefault("producedAt", common.utc_now())
    distributed["producer"] = "present-lease-broker distributed state"
    distributed["updatedAt"] = common.utc_now()
    distributed.setdefault("nodes", {})
    distributed.setdefault("nodeDispatches", [])
    distributed.setdefault("artifactStore", [])
    distributed.setdefault("importedArtifacts", [])
    distributed.setdefault("contextCheckpoints", [])
    distributed.setdefault("attemptLedger", [])
    distributed.setdefault("toolContracts", {})
    distributed.setdefault("contractChecks", [])
    distributed.setdefault("narrativeEvents", [])
    return distributed


def _append_workflow_attempt(distributed: dict[str, Any], attempt_id: str, *,
                             trigger: str = "run-distributed",
                             recovery_idempotency_key: str | None = None) -> dict[str, Any]:
    ledger = distributed.setdefault("attemptLedger", [])
    entry = {
        "attemptId": attempt_id,
        "trigger": trigger,
        "status": "RUNNING",
        "startedAt": common.utc_now(),
        "reusedNodes": [],
        "freshNodes": [],
        "invalidatedNodes": [],
        **({"recoveryIdempotencyKey": recovery_idempotency_key} if recovery_idempotency_key else {}),
    }
    common.validate_with_schema(
        entry,
        "canonical/broker-workflow-attempt-v1.json",
        "broker workflow attempt",
        validation_point="broker-state-write",
        artifact_kind="broker-workflow-attempt",
    )
    ledger.append(entry)
    return entry


def _finish_workflow_attempt(distributed: dict[str, Any] | None, attempt_id: str, *,
                             status: str, reused_nodes: list[str], fresh_nodes: list[str]) -> None:
    if not isinstance(distributed, dict):
        return
    for entry in reversed(distributed.get("attemptLedger", [])):
        if isinstance(entry, dict) and entry.get("attemptId") == attempt_id:
            entry["status"] = status
            entry["finishedAt"] = common.utc_now()
            entry["reusedNodes"] = reused_nodes
            entry["freshNodes"] = fresh_nodes
            common.validate_with_schema(
                entry,
                "canonical/broker-workflow-attempt-v1.json",
                "broker workflow attempt",
                validation_point="broker-state-write",
                artifact_kind="broker-workflow-attempt",
            )
            return


def _distributed_resume_progress(record: dict[str, Any] | None, nodes: list[dict[str, Any]]) -> tuple[
    dict[str, dict[str, Any]], set[str], set[str], list[str], list[dict[str, Any]], list[dict[str, Any]],
    list[dict[str, Any]]
]:
    distributed = record.get("distributed") if isinstance(record, dict) else {}
    stored_nodes = distributed.get("nodes") if isinstance(distributed, dict) else {}
    dispatches = distributed.get("nodeDispatches") if isinstance(distributed, dict) else []
    artifacts = distributed.get("artifactStore") if isinstance(distributed, dict) else []
    imports = distributed.get("importedArtifacts") if isinstance(distributed, dict) else []
    results: dict[str, dict[str, Any]] = {}
    completed: set[str] = set()
    terminal: set[str] = set()
    reused: list[str] = []
    cancelled = set(distributed.get("cancelledNodes", [])) if isinstance(distributed, dict) and isinstance(
        distributed.get("cancelledNodes"), list) else set()
    for node in nodes:
        if node["id"] in cancelled:
            terminal.add(node["id"])
            reused.append(node["id"])
            continue
        entry = stored_nodes.get(node["id"]) if isinstance(stored_nodes, dict) else None
        if not isinstance(entry, dict):
            continue
        node_record = entry.get("record")
        if not isinstance(node_record, dict):
            continue
        if node_record.get("nodeContractHash") != _workflow_node_contract_hash(node):
            continue
        if node_record.get("status") not in {"SUCCEEDED", "WAITING", "FAILED", "BLOCKED"}:
            continue
        results[node["id"]] = node_record
        terminal.add(node["id"])
        reused.append(node["id"])
        if entry.get("completed") is True or _node_completes_dependency(node, node_record):
            completed.add(node["id"])
    return (
        results,
        completed,
        terminal,
        reused,
        list(dispatches) if isinstance(dispatches, list) else [],
        list(artifacts) if isinstance(artifacts, list) else [],
        list(imports) if isinstance(imports, list) else [],
    )


def _persist_distributed_node(state_path: Path | None, state: dict[str, Any] | None,
                              record: dict[str, Any] | None, node: dict[str, Any],
                              item: dict[str, Any], completed: bool) -> None:
    distributed = _distributed_record(record, record.get("taskId") if isinstance(record, dict) else None)
    if distributed is None:
        return
    node_id = node["id"]
    distributed["nodes"][node_id] = {
        "nodeContractHash": _workflow_node_contract_hash(node),
        "completed": completed,
        "record": item["record"],
        "dispatch": item["dispatch"],
        "materialized": item["materialized"],
        "imports": item.get("imports", []),
        "contextCheckpoints": item.get("contextCheckpoints", []),
        "updatedAt": common.utc_now(),
    }
    existing_dispatches = {
        dispatch.get("nodeId"): index
        for index, dispatch in enumerate(distributed["nodeDispatches"])
        if isinstance(dispatch, dict) and isinstance(dispatch.get("nodeId"), str)
    }
    if node_id in existing_dispatches:
        distributed["nodeDispatches"][existing_dispatches[node_id]] = item["dispatch"]
    else:
        distributed["nodeDispatches"].append(item["dispatch"])
    existing_artifacts = {
        (artifact.get("nodeId"), artifact.get("sha256")): index
        for index, artifact in enumerate(distributed["artifactStore"])
        if isinstance(artifact, dict)
    }
    for artifact in item["materialized"]:
        key = (artifact.get("nodeId"), artifact.get("sha256"))
        if key in existing_artifacts:
            distributed["artifactStore"][existing_artifacts[key]] = artifact
        else:
            distributed["artifactStore"].append(artifact)
    distributed["importedArtifacts"].extend(item.get("imports", []))
    existing_checkpoints = {
        (checkpoint.get("nodeId"), checkpoint.get("sha256")): index
        for index, checkpoint in enumerate(distributed.setdefault("contextCheckpoints", []))
        if isinstance(checkpoint, dict)
    }
    for checkpoint in item.get("contextCheckpoints", []):
        key = (checkpoint.get("nodeId"), checkpoint.get("sha256"))
        if key in existing_checkpoints:
            distributed["contextCheckpoints"][existing_checkpoints[key]] = checkpoint
        else:
            distributed["contextCheckpoints"].append(checkpoint)
    dispatch = item.get("dispatch") if isinstance(item.get("dispatch"), dict) else {}
    worker_id = str(dispatch.get("workerId") or "")
    status = str(dispatch.get("status") or item.get("record", {}).get("status") or "UNKNOWN")
    if worker_id:
        _append_distributed_narrative(
            record,
            actor_kind="worker",
            actor_id=worker_id,
            action="run-node",
            target=node_id,
            workerId=worker_id,
            nodeId=node_id,
            human_text=f"Worker {worker_id} finished node {node_id} with status {status}.",
        )
    for imported in item.get("imports", []):
        if not isinstance(imported, dict):
            continue
        _append_distributed_narrative(
            record,
            actor_kind="control-plain",
            actor_id="present-lease-broker",
            action="import-artifact",
            target=node_id,
            workerId=worker_id,
            nodeId=node_id,
            artifactRefs=[
                _narrative_artifact_ref(
                    str(imported.get("kind") or "artifact"),
                    imported.get("path"),
                    imported.get("sha256"),
                )
            ],
            human_text=(
                f"The control plain imported {imported.get('kind', 'artifact')} from node "
                f"{imported.get('sourceNodeId')} into node {node_id}."
            ),
        )
    for artifact in item.get("materialized", []):
        if not isinstance(artifact, dict):
            continue
        _append_distributed_narrative(
            record,
            actor_kind="control-plain",
            actor_id="present-lease-broker",
            action="materialize-artifact",
            target=node_id,
            workerId=worker_id,
            nodeId=node_id,
            artifactRefs=[
                _narrative_artifact_ref(
                    str(artifact.get("kind") or "artifact"),
                    artifact.get("contentAddressedPath"),
                    artifact.get("sha256"),
                )
            ],
            human_text=f"The control plain materialized {artifact.get('kind', 'artifact')} evidence from node {node_id}.",
        )
    for checkpoint in item.get("contextCheckpoints", []):
        if not isinstance(checkpoint, dict):
            continue
        _append_distributed_narrative(
            record,
            actor_kind="worker",
            actor_id=worker_id or "worker",
            action="write-context-checkpoint",
            target=node_id,
            workerId=worker_id,
            nodeId=node_id,
            artifactRefs=[_narrative_artifact_ref("context-checkpoint", checkpoint.get("path"), checkpoint.get("sha256"))],
            human_text=f"Worker {worker_id or 'worker'} wrote a context checkpoint for node {node_id}.",
        )
    _write_state(state_path, state)


def _workflow_evidence_id(task_id: str, workflow_id: str, node_id: str, artifact: dict[str, Any]) -> str:
    identity = "|".join([
        task_id,
        workflow_id,
        node_id,
        str(artifact.get("kind") or artifact.get("artifactKind") or ""),
        str(artifact.get("path") or ""),
        str(artifact.get("sha256") or ""),
    ])
    return "ev-" + hashlib.sha256(identity.encode()).hexdigest()[:24]


def _workflow_evidence_item(task_id: str, workflow_id: str, node: dict[str, Any],
                            artifact: dict[str, Any], *, mocked: bool,
                            accepted_by: list[str] | None = None) -> dict[str, Any]:
    outputs = node.get("outputs") if isinstance(node.get("outputs"), dict) else {}
    payload = node.get("payload") if isinstance(node.get("payload"), dict) else {}
    artifact_kind = str(artifact.get("kind") or artifact.get("artifactKind") or "other")
    gate_eligible = (
        not mocked
        and node.get("verb") == "verify"
        and artifact_kind == "verification"
        and outputs.get("evidenceRole") == "deterministic-acceptance"
        and payload.get("result") == "PASS"
    )
    resolved = node.get("resolvedInputs") if isinstance(node.get("resolvedInputs"), dict) else {}
    upstream = []
    if isinstance(resolved.get("commit"), dict):
        upstream.append(resolved["commit"]["nodeId"])
    upstream += [item["nodeId"] for item in resolved.get("artifacts", []) if isinstance(item, dict)]
    item = {
        "id": _workflow_evidence_id(task_id, workflow_id, node["id"], artifact),
        "nodeId": node["id"],
        "capability": node["capability"],
        "artifactKind": artifact_kind,
        "kind": artifact_kind,
        "path": artifact["path"],
        "sha256": artifact["sha256"],
        "mock": mocked,
        "gateEligible": gate_eligible,
        "producedAt": node.get("finishedAt") or common.utc_now(),
        "upstreamNodeIds": sorted(set(upstream)),
    }
    if outputs.get("schema"):
        item["schema"] = outputs["schema"]
    if outputs.get("evidenceRole"):
        item["evidenceRole"] = outputs["evidenceRole"]
    if accepted_by:
        item["acceptedBy"] = sorted(set(accepted_by))
    return item


def _attach_workflow_accepted_evidence(task_id: str, workflow_id: str, record: dict[str, Any], *,
                                       mocked: bool, spec: dict[str, Any],
                                       results: dict[str, dict[str, Any]]) -> None:
    if record.get("verb") != "verify" or not isinstance(record.get("payload"), dict):
        return
    inputs = spec.get("inputs") if isinstance(spec.get("inputs"), dict) else {}
    accepted = []
    resolved_artifacts = record.get("resolvedInputs", {}).get("artifacts", []) if isinstance(
        record.get("resolvedInputs"), dict) else []
    local_paths = {
        (item.get("nodeId"), item.get("kind"), item.get("sha256")): item.get("localPath")
        for item in resolved_artifacts
        if isinstance(item, dict) and isinstance(item.get("localPath"), str)
    }
    for node_id in inputs.get("artifactsFrom", []):
        source = results.get(node_id)
        if not isinstance(source, dict):
            continue
        for artifact in source.get("artifacts", []):
            if not isinstance(artifact, dict) or not artifact.get("sha256"):
                continue
            item = _workflow_evidence_item(task_id, workflow_id, source, artifact, mocked=mocked)
            accepted.append({
                "id": item["id"],
                "nodeId": item["nodeId"],
                "path": item["path"],
                "sha256": item["sha256"],
                **({"localPath": local_paths[(item["nodeId"], item["kind"], item["sha256"])]}
                   if (item["nodeId"], item["kind"], item["sha256"]) in local_paths else {}),
                **({"schema": item["schema"]} if item.get("schema") else {}),
                **({"evidenceRole": item["evidenceRole"]} if item.get("evidenceRole") else {}),
            })
    if accepted:
        record["payload"]["acceptedEvidence"] = accepted


def _workflow_evidence_items(task_id: str, mocked: bool, contract: dict[str, Any],
                             nodes: list[dict[str, Any]]) -> list[dict[str, Any]]:
    workflow_id = contract["workflow"].get("workflowId") or task_id
    accepted_by: dict[str, list[str]] = {}
    for node in nodes:
        payload = node.get("payload") if isinstance(node.get("payload"), dict) else {}
        if node.get("verb") != "verify" or not isinstance(payload.get("acceptedEvidence"), list):
            continue
        for item in payload["acceptedEvidence"]:
            if isinstance(item, dict) and isinstance(item.get("id"), str):
                accepted_by.setdefault(item["id"], []).append(node["id"])
    evidence = []
    for node in nodes:
        for artifact in node.get("artifacts", []):
            if isinstance(artifact, dict) and artifact.get("sha256"):
                evidence.append(_workflow_evidence_item(
                    task_id, workflow_id, node, artifact, mocked=mocked,
                    accepted_by=accepted_by.get(_workflow_evidence_id(task_id, workflow_id, node["id"], artifact))))
    return evidence


def _workflow_result(task_id: str, mocked: bool, contract: dict[str, Any],
                     nodes: list[dict[str, Any]], status: str,
                     fresh_nodes: list[str], reused_nodes: list[str] | None = None) -> dict[str, Any]:
    workflow = contract["workflow"]
    workflow_id, contract_hash, run_id = _workflow_identity(task_id, contract)
    return {
        **common.canonical_envelope(task_id, "present-lease-broker distributed workflow", mocked=mocked),
        "status": status,
        "workflowId": workflow_id,
        "workflowRunId": run_id,
        "contractHash": contract_hash,
        "maxParallel": workflow.get("maxParallel", 1),
        "freshNodes": fresh_nodes,
        "reusedNodes": reused_nodes or [],
        "nodes": nodes,
        "evidence": _workflow_evidence_items(task_id, mocked, contract, nodes),
        "advisoryNote": (
            "Workflow orchestration is control-plain-authored. Node agents may produce advisory "
            "or candidate artifacts, but only deterministic verify can produce production PASS evidence."
        ),
    }


def _workflow_with_materialized_artifact_paths(task_id: str, mocked: bool, contract: dict[str, Any],
                                               workflow: dict[str, Any],
                                               artifact_store: list[dict[str, Any]]) -> dict[str, Any]:
    materialized_by_node_sha = {
        (item.get("nodeId"), item.get("sha256")): item.get("contentAddressedPath")
        for item in artifact_store
        if (
            isinstance(item, dict)
            and item.get("status") == "MATERIALIZED"
            and isinstance(item.get("nodeId"), str)
            and isinstance(item.get("sha256"), str)
            and isinstance(item.get("contentAddressedPath"), str)
        )
    }
    if not materialized_by_node_sha:
        return workflow
    normalized = copy.deepcopy(workflow)
    changed = False
    for node in normalized.get("nodes", []):
        if not isinstance(node, dict):
            continue
        node_id = node.get("id")
        for artifact in node.get("artifacts", []):
            if not isinstance(artifact, dict) or not isinstance(artifact.get("sha256"), str):
                continue
            path = materialized_by_node_sha.get((node_id, artifact["sha256"]))
            if path and artifact.get("path") != path:
                artifact["path"] = path
                changed = True
    if changed:
        normalized["evidence"] = _workflow_evidence_items(task_id, mocked, contract, normalized["nodes"])
    return normalized


def _workflow_dag(task_id: str, contract: dict[str, Any], placements: list[dict[str, Any]]) -> dict[str, Any]:
    workflow = contract["workflow"]
    placement_by_node = {item.get("nodeId"): item for item in placements if isinstance(item, dict)}
    workflow_id, contract_hash, run_id = _workflow_identity(task_id, contract)
    nodes = []
    edges = []
    for node in workflow["nodes"]:
        placement = placement_by_node.get(node["id"], {})
        nodes.append({
            "nodeId": node["id"],
            "capability": node["capability"],
            "dependsOn": node.get("dependsOn", []),
            "policy": _workflow_node_policy(node),
            "workerId": placement.get("workerId"),
            "nodeContractHash": _workflow_node_contract_hash(node),
        })
        for dep in node.get("dependsOn", []):
            edges.append({"fromNodeId": dep, "toNodeId": node["id"]})
    return {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker workflow DAG",
        "workflowId": workflow_id,
        "workflowRunId": run_id,
        "contractHash": contract_hash,
        "maxParallel": workflow.get("maxParallel", 1),
        "nodes": nodes,
        "edges": edges,
    }


def _replay_report(task_id: str, workflow: dict[str, Any], contract: dict[str, Any],
                   reused_nodes: list[str], fresh_nodes: list[str], distributed: dict[str, Any] | None) -> dict[str, Any]:
    expected = [node["id"] for node in contract["workflow"]["nodes"]]
    executed = set(reused_nodes) | set(fresh_nodes)
    invalidated = []
    if isinstance(distributed, dict) and isinstance(distributed.get("attemptLedger"), list):
        for entry in distributed["attemptLedger"]:
            if isinstance(entry, dict) and isinstance(entry.get("invalidatedNodes"), list):
                invalidated.extend(item for item in entry["invalidatedNodes"] if isinstance(item, str))
    return {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker replay reporter",
        "workflowId": workflow["workflowId"],
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "reusedNodes": reused_nodes,
        "freshNodes": fresh_nodes,
        "invalidatedNodes": sorted(set(invalidated)),
        "skippedNodes": [node_id for node_id in expected if node_id not in executed],
    }


def _artifact_provenance_chain(task_id: str, workflow: dict[str, Any],
                               artifact_store: list[dict[str, Any]],
                               imported_artifacts: list[dict[str, Any]]) -> dict[str, Any]:
    nodes = {node.get("id"): node for node in workflow.get("nodes", []) if isinstance(node, dict)}
    artifacts = []
    for artifact in artifact_store:
        if not isinstance(artifact, dict):
            continue
        node = nodes.get(artifact.get("nodeId"), {})
        artifacts.append({
            "nodeId": artifact.get("nodeId"),
            "workerId": artifact.get("workerId"),
            "kind": artifact.get("kind"),
            "sha256": artifact.get("sha256"),
            "path": artifact.get("contentAddressedPath") or artifact.get("path"),
            "status": artifact.get("status"),
            "schema": node.get("outputs", {}).get("schema") if isinstance(node.get("outputs"), dict) else None,
            "attemptStatus": node.get("status"),
            "inputArtifacts": [
                item for item in imported_artifacts
                if isinstance(item, dict) and item.get("nodeId") == artifact.get("nodeId")
            ],
        })
    return {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker artifact provenance",
        "workflowId": workflow["workflowId"],
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "artifacts": artifacts,
    }


def _evidence_graph_export(task_id: str, workflow: dict[str, Any], evidence_manifest: dict[str, Any],
                           redaction_report: dict[str, Any], handoff: dict[str, Any],
                           policy_evaluation: dict[str, Any] | None = None) -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker evidence graph",
        "workflowId": workflow["workflowId"],
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "nodes": [
            {
                "nodeId": item.get("nodeId"),
                "capability": item.get("capability"),
                "evidenceRole": item.get("evidenceRole"),
                "gateEligible": item.get("gateEligible"),
                "upstreamNodeIds": item.get("upstreamNodeIds", []),
                "sha256": item.get("sha256"),
            }
            for item in evidence_manifest.get("artifacts", [])
            if isinstance(item, dict)
        ],
        "redactionStatus": redaction_report.get("status"),
        "gateDecision": handoff.get("gateDecision"),
        **({"policyEvaluation": policy_evaluation} if isinstance(policy_evaluation, dict) else {}),
    }


def _acceptance_policy_config(policy_pack: dict[str, Any]) -> dict[str, Any]:
    configured = policy_pack.get("acceptancePolicy") if isinstance(policy_pack.get("acceptancePolicy"), dict) else {}
    required_roles = configured.get("requiredEvidenceRoles", policy_pack.get("requiredEvidenceRoles", []))
    min_verifiers = configured.get("minVerifierCount", policy_pack.get("minVerifierCount", 0))
    return {
        "mode": configured.get("mode") or (
            "single-deterministic-verifier" if int(min_verifiers or 0) <= 1 else "quorum"
        ),
        "minVerifierCount": int(min_verifiers or 0),
        "requiredEvidenceRoles": required_roles if isinstance(required_roles, list) else [],
        "allowMockEvidence": bool(configured.get("allowMockEvidence", False)),
    }


def _policy_check(check_id: str, status: str, detail: str, remediation: str = "") -> dict[str, Any]:
    return {
        "id": check_id,
        "status": status,
        "detail": detail,
        **({"remediation": remediation} if remediation else {}),
    }


def _acceptance_policy_decision(checks: list[dict[str, Any]]) -> str:
    if any(check["status"] == "FAIL" for check in checks):
        return "FAIL"
    if all(check["status"] == "PASS" for check in checks):
        return "PASS"
    if any(check["status"] == "BLOCKED" for check in checks):
        return "BLOCKED"
    return "INCONCLUSIVE"


def _acceptance_policy_explanation(decision: str, checks: list[dict[str, Any]]) -> str:
    if decision == "PASS":
        return "acceptance policy satisfied by deterministic evidence"
    blockers = [check for check in checks if check["status"] != "PASS"]
    if blockers:
        return "; ".join(f"{check['id']}: {check['detail']}" for check in blockers[:4])
    return "acceptance policy did not produce a PASS decision"


def _acceptance_policy_remediation(checks: list[dict[str, Any]]) -> list[dict[str, Any]]:
    items = []
    for check in checks:
        if check["status"] == "PASS":
            continue
        remediation = check.get("remediation")
        if remediation:
            items.append({"checkId": check["id"], "action": remediation, "detail": check["detail"]})
    return items


def _evaluate_acceptance_policy(contract: dict[str, Any], workflow: dict[str, Any],
                                evidence_manifest: dict[str, Any],
                                redaction_report: dict[str, Any],
                                artifact_findings: list[dict[str, Any]] | None = None) -> dict[str, Any]:
    policy_pack = contract.get("policyPack") if isinstance(contract.get("policyPack"), dict) else {}
    policy = _acceptance_policy_config(policy_pack)
    artifacts = [item for item in evidence_manifest.get("artifacts", []) if isinstance(item, dict)]
    errors = [item for item in artifact_findings or [] if item.get("severity") == "error"]
    checks = [
        _policy_check(
            "artifact-integrity",
            "PASS" if not errors else "FAIL",
            f"{len(errors)} blocking artifact findings",
            "repair or rematerialize corrupt or missing artifacts",
        ),
        _policy_check(
            "redaction-clean",
            "PASS" if redaction_report.get("status") in {"CLEAN", None} else "FAIL",
            str(redaction_report.get("status") or "UNKNOWN"),
            "redact secrets or remove blocked artifacts and rerun acceptance",
        ),
    ]
    if evidence_manifest.get("containsMock") is True and not policy["allowMockEvidence"]:
        checks.append(_policy_check(
            "mock-evidence",
            "INCONCLUSIVE",
            "mock evidence is present and the policy does not allow it",
            "rerun the workflow without --mock to produce gate-eligible evidence",
        ))
    else:
        checks.append(_policy_check("mock-evidence", "PASS", "mock evidence policy satisfied"))
    roles_present = {
        item.get("evidenceRole")
        for item in artifacts
        if isinstance(item.get("evidenceRole"), str)
        and (policy["allowMockEvidence"] or item.get("mock") is not True)
    }
    missing_roles = sorted(set(policy["requiredEvidenceRoles"]) - roles_present)
    checks.append(_policy_check(
        "required-evidence-roles",
        "PASS" if not missing_roles else "INCONCLUSIVE",
        "all required evidence roles are present" if not missing_roles else
        f"missing evidence roles: {', '.join(missing_roles)}",
        "add workflow nodes that produce and preserve the missing evidence roles",
    ))
    verifier_nodes = [
        node for node in workflow.get("nodes", [])
        if isinstance(node, dict)
        and node.get("verb") == "verify"
        and isinstance(node.get("outputs"), dict)
        and node["outputs"].get("evidenceRole") == "deterministic-acceptance"
        and node.get("policy", {}).get("required", True) is True
    ]
    verifier_failures = [
        node for node in verifier_nodes
        if isinstance(node.get("payload"), dict) and node["payload"].get("result") == "FAIL"
    ]
    accepted_verifiers = [
        item for item in artifacts
        if item.get("evidenceRole") == "deterministic-acceptance" and item.get("gateEligible") is True
    ]
    min_verifiers = max(0, int(policy["minVerifierCount"]))
    verifier_count = len({item.get("nodeId") for item in accepted_verifiers if item.get("nodeId")})
    verifier_status = "PASS"
    verifier_detail = f"{verifier_count} gate-eligible deterministic verifier(s)"
    verifier_remediation = "rerun deterministic verification with non-mock inputs"
    if verifier_failures or workflow.get("status") == "FAILED":
        verifier_status = "FAIL"
        verifier_detail = "a deterministic verifier failed or the workflow failed"
        verifier_remediation = "fix the failed verifier inputs or code, then rerun verification"
    elif workflow.get("status") in {"BLOCKED", "WAITING"}:
        verifier_status = "BLOCKED"
        verifier_detail = f"workflow status is {workflow.get('status')}"
        verifier_remediation = "complete or recover blocked workflow nodes before acceptance"
    elif verifier_count < min_verifiers:
        verifier_status = "INCONCLUSIVE"
        verifier_detail = f"{verifier_count}/{min_verifiers} required gate-eligible verifier(s)"
    elif policy["mode"] == "unanimous" and len(verifier_nodes) != verifier_count:
        verifier_status = "INCONCLUSIVE"
        verifier_detail = f"{verifier_count}/{len(verifier_nodes)} verifier nodes produced gate-eligible PASS evidence"
    checks.append(_policy_check("deterministic-acceptance", verifier_status, verifier_detail, verifier_remediation))
    decision = _acceptance_policy_decision(checks)
    return {
        "policy": policy,
        "decision": decision,
        "reason": _acceptance_policy_explanation(decision, checks),
        "checks": checks,
        "remediation": _acceptance_policy_remediation(checks),
        "acceptedVerifierCount": verifier_count,
        "requiredVerifierCount": min_verifiers,
        "requiredEvidenceRoles": policy["requiredEvidenceRoles"],
    }


def _acceptance_manifest(task_id: str, workflow: dict[str, Any],
                         evidence_manifest: dict[str, Any], handoff: dict[str, Any],
                         policy_evaluation: dict[str, Any]) -> dict[str, Any]:
    accepted = [
        {
            "id": item.get("id"),
            "nodeId": item.get("nodeId"),
            "sha256": item.get("sha256"),
            "evidenceRole": item.get("evidenceRole"),
        }
        for item in evidence_manifest.get("artifacts", [])
        if isinstance(item, dict) and item.get("gateEligible") is True
    ]
    return {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker deterministic acceptance",
        "workflowId": workflow["workflowId"],
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "decision": policy_evaluation["decision"],
        "reason": policy_evaluation["reason"],
        "acceptedEvidence": accepted,
        "acceptancePolicy": policy_evaluation["policy"],
        "policyChecks": policy_evaluation["checks"],
        "remediation": policy_evaluation["remediation"],
    }


def _retention_policy(contract: dict[str, Any]) -> dict[str, Any]:
    policy_pack = contract.get("policyPack") if isinstance(contract.get("policyPack"), dict) else {}
    retention = policy_pack.get("retentionPolicy") if isinstance(policy_pack.get("retentionPolicy"), dict) else {}
    return {
        "class": retention.get("class", "standard"),
        "ttlSeconds": int(retention.get("ttlSeconds", 7 * 86400)),
        "redactionRequired": bool(retention.get("redactionRequired", True)),
        "purgeOnCompletion": bool(retention.get("purgeOnCompletion", False)),
    }


def _artifact_store_kind(args) -> str:
    return str(getattr(args, "artifact_store_kind", "local-filesystem") or "local-filesystem")


def _artifact_store_descriptor(store_root: Path, kind: str = "local-filesystem") -> dict[str, Any]:
    return {
        "kind": kind,
        "adapterVersion": "1",
        "root": str(store_root),
        "contentAddressed": True,
        "writable": True,
        "remote": kind != "local-filesystem",
    }


def _broker_artifact_dir(store_root: Path, task_id: str) -> Path:
    return store_root / "_broker" / task_id


def _write_broker_artifact(store_root: Path, task_id: str, name: str, payload: dict[str, Any],
                           schema_name: str) -> Path:
    _require_schema(payload, schema_name, f"broker artifact {name}")
    path = _broker_artifact_dir(store_root, task_id) / f"{name}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)
    return path


def _artifact_ref(path: Path, *, kind: str, status: str | None = None,
                  gate_eligible: bool | None = None) -> dict[str, Any]:
    ref: dict[str, Any] = {"kind": kind, "path": str(path), "sha256": common.sha256_file(path)}
    if status is not None:
        ref["status"] = status
    if gate_eligible is not None:
        ref["gateEligible"] = gate_eligible
    return ref


SECRET_PATTERNS = [
    ("openai-api-key", re.compile(r"sk-[A-Za-z0-9_-]{20,}")),
    ("aws-access-key", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("github-token", re.compile(r"gh[pousr]_[A-Za-z0-9_]{20,}")),
    ("private-key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    (
        "named-secret",
        re.compile(
            r"(?i)(api[_-]?key|access[_-]?token|auth[_-]?token|secret|password)"
            r"\s*[:=]\s*['\"]?[A-Za-z0-9_./+=-]{12,}"
        ),
    ),
]


def _secret_scan_excerpt(text: str, start: int, end: int) -> str:
    excerpt = text[max(0, start - 12):min(len(text), end + 12)]
    return re.sub(r"[A-Za-z0-9_./+=-]", "*", excerpt)


def _broker_admission_result(task_id: str, mocked: bool, contract: dict[str, Any]) -> dict[str, Any]:
    policy_pack = contract["policyPack"]
    return {
        **common.canonical_envelope(task_id, "present-lease-broker workflow admission", mocked=mocked),
        "status": "ADMITTED",
        "workflowId": contract["workflow"].get("workflowId") or task_id,
        "contractHash": common.canonical_hash(contract),
        "policyPack": {
            "id": policy_pack["id"],
            "version": policy_pack["version"],
            "registryHash": policy_pack["registryHash"],
            "riskClass": policy_pack["riskClass"],
            "status": "SATISFIED",
        },
    }


def _broker_evidence_manifest(task_id: str, mocked: bool, contract: dict[str, Any],
                              workflow: dict[str, Any]) -> dict[str, Any]:
    evidence = workflow.get("evidence") if isinstance(workflow.get("evidence"), list) else []
    contains_mock = mocked or any(item.get("mock") is True for item in evidence if isinstance(item, dict))
    return {
        **common.canonical_envelope(task_id, "present-lease-broker evidence manifest", mocked=mocked),
        "workflowId": workflow["workflowId"],
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "gateEligible": (not contains_mock) and any(item.get("gateEligible") is True for item in evidence),
        "containsMock": contains_mock,
        "artifacts": evidence,
    }


def _broker_redaction_report(task_id: str, mocked: bool, workflow: dict[str, Any],
                             artifacts: list[dict[str, Any]]) -> dict[str, Any]:
    findings = []
    scanned = []
    for artifact in artifacts:
        path_value = artifact.get("path") if isinstance(artifact, dict) else None
        if not isinstance(path_value, str):
            continue
        path = Path(path_value)
        if not path.exists() or not path.is_file():
            continue
        size = path.stat().st_size
        scanned.append({"path": str(path), "sha256": common.sha256_file(path), "sizeBytes": size})
        if size > 1024 * 1024:
            findings.append({
                "path": str(path),
                "pattern": "scan-limit",
                "severity": "REVIEW",
                "excerpt": "artifact exceeded 1MiB scan limit",
            })
            continue
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        for name, pattern in SECRET_PATTERNS:
            for match in pattern.finditer(text):
                findings.append({
                    "path": str(path),
                    "pattern": name,
                    "severity": "BLOCK",
                    "excerpt": _secret_scan_excerpt(text, match.start(), match.end()),
                })
                break
    status = "REDACTION_REQUIRED" if any(item["severity"] == "BLOCK" for item in findings) else (
        "REVIEW_REQUIRED" if findings else "CLEAN")
    return {
        **common.canonical_envelope(task_id, "present-lease-broker redaction scanner", mocked=mocked),
        "status": status,
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "exportable": status == "CLEAN",
        "scannedArtifacts": scanned,
        "findings": findings,
    }


def _workflow_gate_decision(workflow: dict[str, Any], evidence_manifest: dict[str, Any]) -> tuple[str, str]:
    workflow_status = workflow.get("status")
    gate_verify_results = [
        node.get("payload", {}).get("result")
        for node in workflow.get("nodes", [])
        if (
            isinstance(node, dict)
            and node.get("verb") == "verify"
            and isinstance(node.get("payload"), dict)
            and isinstance(node.get("outputs"), dict)
            and node["outputs"].get("evidenceRole") == "deterministic-acceptance"
            and node.get("policy", {}).get("required", True) is True
        )
    ]
    if workflow_status in {"BLOCKED", "WAITING"}:
        return "BLOCKED", f"workflow status is {workflow_status}"
    if any(result == "FAIL" for result in gate_verify_results) or workflow_status == "FAILED":
        return "FAIL", "a deterministic verifier failed or blocked required workflow completion"
    if evidence_manifest.get("gateEligible") is True:
        return "PASS", "gate-eligible deterministic acceptance evidence is present"
    if any(result == "INCONCLUSIVE" for result in gate_verify_results):
        return "INCONCLUSIVE", "a deterministic verifier was inconclusive"
    return "INCONCLUSIVE", "no gate-eligible deterministic acceptance evidence is present"


def _broker_handoff_package(task_id: str, mocked: bool, contract: dict[str, Any], admission: dict[str, Any],
                            workflow: dict[str, Any], evidence_manifest: dict[str, Any],
                            redaction_report: dict[str, Any], refs: dict[str, dict[str, Any]],
                            policy_evaluation: dict[str, Any] | None = None) -> dict[str, Any]:
    policy_pack = contract["policyPack"]
    if isinstance(policy_evaluation, dict):
        gate_decision, gate_reason = policy_evaluation["decision"], policy_evaluation["reason"]
    else:
        gate_decision, gate_reason = _workflow_gate_decision(workflow, evidence_manifest)
    verification_evidence = [
        {
            "id": item["id"],
            "nodeId": item["nodeId"],
            "path": item["path"],
            "sha256": item["sha256"],
            "gateEligible": item["gateEligible"],
            **({"schema": item["schema"]} if item.get("schema") else {}),
            **({"evidenceRole": item["evidenceRole"]} if item.get("evidenceRole") else {}),
        }
        for item in evidence_manifest.get("artifacts", [])
        if item.get("evidenceRole") == "deterministic-acceptance"
    ]
    return {
        **common.canonical_envelope(task_id, "present-lease-broker handoff package", mocked=mocked),
        "workflowId": workflow["workflowId"],
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "policyPack": {
            "id": policy_pack["id"],
            "version": policy_pack["version"],
            "registryHash": policy_pack["registryHash"],
            "riskClass": policy_pack["riskClass"],
            "status": admission["policyPack"]["status"],
        },
        "admissionArtifact": refs["admission"],
        "workflowArtifact": refs["workflow"],
        "evidenceManifest": refs["evidence"],
        "redactionReport": refs["redaction"],
        "exportable": redaction_report.get("exportable") is True,
        "verificationEvidence": verification_evidence,
        "gateDecision": gate_decision,
        "gateReason": gate_reason,
        **({"policyEvaluation": policy_evaluation} if isinstance(policy_evaluation, dict) else {}),
        "persistRecommendations": [
            {"target": "workflow_admissions", "artifact": "admissionArtifact",
             "purpose": "audit admission, scheduling, capability, and policy-pack verdicts"},
            {"target": "workflow_runs", "artifact": "workflowArtifact",
             "purpose": "audit node execution status, payloads, and resolved inputs"},
            {"target": "evidence_index", "artifact": "evidenceManifest",
             "purpose": "index normalized evidence IDs, hashes, upstream links, and verifier acceptance"},
            {"target": "gates", "artifact": "handoff-package",
             "purpose": "persist the deterministic gate decision and reason"},
            {"target": "artifact_exports", "artifact": "redactionReport",
             "purpose": "block export of artifacts that contain secrets or require manual redaction"},
        ],
    }


def _require_handoff_ref_integrity(ref: dict[str, Any], label: str) -> None:
    path_value = ref.get("path") if isinstance(ref, dict) else None
    digest = ref.get("sha256") if isinstance(ref, dict) else None
    if not isinstance(path_value, str) or not Path(path_value).is_file():
        raise common.TaskBundleError(f"{label} does not point to an existing artifact")
    if digest != common.sha256_file(Path(path_value)):
        raise common.TaskBundleError(f"{label} sha256 does not match artifact bytes")


def _validate_distributed_handoff_consistency(payload: dict[str, Any], workflow: dict[str, Any]) -> None:
    expected = {
        "taskId": workflow.get("taskId"),
        "workflowRunId": workflow.get("workflowRunId"),
        "contractHash": workflow.get("contractHash"),
    }
    for label, item in (
        ("distributedArtifacts", payload),
        ("evidenceManifest", payload.get("evidenceManifest", {})),
        ("redactionReport", payload.get("redactionReport", {})),
        ("handoffPackage", payload.get("handoffPackage", {})),
    ):
        if not isinstance(item, dict):
            raise common.TaskBundleError(f"{label} must be an object")
        for key, value in expected.items():
            if item.get(key) != value:
                raise common.TaskBundleError(f"{label} {key} differs from workflow")
    if payload.get("workflowId") != workflow.get("workflowId"):
        raise common.TaskBundleError("distributedArtifacts workflowId differs from workflow")
    if payload["evidenceManifest"].get("workflowId") != workflow.get("workflowId"):
        raise common.TaskBundleError("evidenceManifest workflowId differs from workflow")
    if payload["handoffPackage"].get("workflowId") != workflow.get("workflowId"):
        raise common.TaskBundleError("handoffPackage workflowId differs from workflow")
    if payload.get("handoffSha256") != common.sha256_file(Path(payload.get("handoffPath", ""))):
        raise common.TaskBundleError("distributedArtifacts handoffSha256 differs from disk")
    for key in ("admissionArtifact", "workflowArtifact", "evidenceManifest", "redactionReport"):
        _require_handoff_ref_integrity(payload["handoffPackage"].get(key, {}), f"handoff {key}")
    evidence_ids = {
        item.get("id")
        for item in payload["evidenceManifest"].get("artifacts", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    for item in payload["handoffPackage"].get("verificationEvidence", []):
        if isinstance(item, dict) and item.get("id") not in evidence_ids:
            raise common.TaskBundleError("handoff verificationEvidence references unknown evidence")
    for item in payload["evidenceManifest"].get("artifacts", []):
        if not isinstance(item, dict) or not isinstance(item.get("path"), str):
            continue
        path = Path(item["path"])
        if path.exists() and item.get("sha256") != common.sha256_file(path):
            raise common.TaskBundleError(f"evidence artifact {item.get('id', '<unknown>')} sha256 differs from disk")


def _validate_distributed_execution_consistency(contract: dict[str, Any], workflow: dict[str, Any],
                                                artifact_store: list[dict[str, Any]],
                                                imported_artifacts: list[dict[str, Any]],
                                                distributed_artifacts: dict[str, Any],
                                                integrity_ledger: dict[str, Any]) -> None:
    node_ids = {node["id"] for node in contract["workflow"]["nodes"]}
    workflow_node_ids = {node.get("id") for node in workflow.get("nodes", []) if isinstance(node, dict)}
    for artifact in artifact_store:
        if not isinstance(artifact, dict):
            continue
        if artifact.get("nodeId") not in node_ids:
            raise common.TaskBundleError("materialized artifact belongs to an unknown workflow node")
        if artifact.get("status") == "MATERIALIZED":
            path = Path(str(artifact.get("contentAddressedPath", "")))
            if not path.is_file() or artifact.get("sha256") != common.sha256_file(path):
                raise common.TaskBundleError("materialized artifact sha256 differs from disk")
    for item in imported_artifacts:
        if not isinstance(item, dict):
            continue
        if item.get("nodeId") not in node_ids or item.get("sourceNodeId") not in node_ids:
            raise common.TaskBundleError("imported artifact references an unknown workflow node")
    if workflow_node_ids and not workflow_node_ids <= node_ids:
        raise common.TaskBundleError("workflow result contains an unknown node")
    _validate_distributed_handoff_consistency(distributed_artifacts, workflow)
    _validate_integrity_ledger(artifact_store, imported_artifacts, distributed_artifacts, integrity_ledger)


def _validate_integrity_ledger(artifact_store: list[dict[str, Any]],
                               imported_artifacts: list[dict[str, Any]],
                               distributed_artifacts: dict[str, Any],
                               integrity_ledger: dict[str, Any]) -> None:
    common.validate_with_schema(
        integrity_ledger,
        "canonical/artifact-integrity-ledger-v1.json",
        "artifact integrity ledger",
        validation_point="broker-artifact-write",
        artifact_kind="artifact-integrity-ledger",
        task_id=integrity_ledger.get("taskId") if isinstance(integrity_ledger.get("taskId"), str) else None,
    )
    entries = integrity_ledger.get("entries") if isinstance(integrity_ledger.get("entries"), list) else []
    by_key = {
        (entry.get("operation"), entry.get("nodeId"), entry.get("sha256"), entry.get("status"))
        for entry in entries if isinstance(entry, dict)
    }
    for artifact in artifact_store:
        if not isinstance(artifact, dict):
            continue
        key = (
            "materialize",
            artifact.get("nodeId"),
            artifact.get("sha256"),
            str(artifact.get("status") or "UNKNOWN"),
        )
        if key not in by_key:
            raise common.TaskBundleError("artifact integrity ledger is missing a materialize entry")
    for imported in imported_artifacts:
        if not isinstance(imported, dict):
            continue
        key = (
            "import",
            imported.get("nodeId"),
            imported.get("sha256"),
            str(imported.get("status") or "UNKNOWN"),
        )
        if key not in by_key:
            raise common.TaskBundleError("artifact integrity ledger is missing an import entry")
    handoff_sha = distributed_artifacts.get("handoffSha256")
    handoff_status = str(distributed_artifacts.get("status") or "UNKNOWN")
    if ("handoff", None, handoff_sha, handoff_status) not in by_key:
        raise common.TaskBundleError("artifact integrity ledger is missing the handoff entry")
    redaction = distributed_artifacts.get("redactionReport") if isinstance(distributed_artifacts, dict) else {}
    if isinstance(redaction, dict):
        redaction_status = str(redaction.get("status") or "UNKNOWN")
        if ("redaction", None, handoff_sha, redaction_status) not in by_key:
            raise common.TaskBundleError("artifact integrity ledger is missing the redaction entry")


def _ledger_entry(operation: str, status: str, **fields: Any) -> dict[str, Any]:
    basis = {"operation": operation, "status": status, **fields}
    return {
        "id": "il-" + common.canonical_hash(basis)[:24],
        "operation": operation,
        "status": status,
        "producedAt": common.utc_now(),
        **fields,
    }


def _artifact_integrity_ledger(task_id: str, contract_hash: str, workflow: dict[str, Any],
                               artifact_store: list[dict[str, Any]],
                               imported_artifacts: list[dict[str, Any]],
                               distributed_artifacts: dict[str, Any]) -> dict[str, Any]:
    entries: list[dict[str, Any]] = []
    for artifact in artifact_store:
        if not isinstance(artifact, dict):
            continue
        entries.append(_ledger_entry(
            "materialize",
            str(artifact.get("status") or "UNKNOWN"),
            nodeId=str(artifact.get("nodeId", "")),
            workerId=str(artifact.get("workerId", "")),
            kind=str(artifact.get("kind", "")),
            path=str(artifact.get("contentAddressedPath", "")),
            sha256=str(artifact.get("sha256", "")),
            **({"reason": artifact["reason"]} if isinstance(artifact.get("reason"), str) else {}),
        ))
    for imported in imported_artifacts:
        if not isinstance(imported, dict):
            continue
        entries.append(_ledger_entry(
            "import",
            str(imported.get("status") or "UNKNOWN"),
            nodeId=str(imported.get("nodeId", "")),
            workerId=str(imported.get("workerId", "")),
            kind=str(imported.get("kind", "")),
            path=str(imported.get("path", "")),
            sha256=str(imported.get("sha256", "")),
            **({"reason": imported["reason"]} if isinstance(imported.get("reason"), str) else {}),
        ))
    redaction = distributed_artifacts.get("redactionReport") if isinstance(distributed_artifacts, dict) else {}
    if isinstance(redaction, dict):
        entries.append(_ledger_entry(
            "redaction",
            str(redaction.get("status") or "UNKNOWN"),
            path=str(distributed_artifacts.get("handoffPath", "")),
            sha256=str(distributed_artifacts.get("handoffSha256", "")),
            **({"reason": redaction["reason"]} if isinstance(redaction.get("reason"), str) else {}),
        ))
    entries.append(_ledger_entry(
        "handoff",
        str(distributed_artifacts.get("status") or "UNKNOWN"),
        path=str(distributed_artifacts.get("handoffPath", "")),
        sha256=str(distributed_artifacts.get("handoffSha256", "")),
    ))
    for operation, path_key in (
        ("workflow-dag", "workflowDagPath"),
        ("attempt-replay", "replayReportPath"),
        ("artifact-provenance", "artifactProvenancePath"),
        ("evidence-graph", "evidenceGraphPath"),
        ("acceptance", "acceptanceManifestPath"),
    ):
        path_value = str(distributed_artifacts.get(path_key, ""))
        if path_value:
            entries.append(_ledger_entry(
                operation,
                "READY",
                path=path_value,
                sha256=common.sha256_file(Path(path_value)) if Path(path_value).is_file() else "0" * 64,
            ))
    ledger = {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker artifact integrity",
        "contractHash": contract_hash,
        "workflowRunId": workflow["workflowRunId"],
        "entries": entries,
    }
    common.validate_with_schema(
        ledger,
        "canonical/artifact-integrity-ledger-v1.json",
        "artifact integrity ledger",
        validation_point="broker-artifact-write",
        artifact_kind="artifact-integrity-ledger",
        task_id=task_id,
    )
    return ledger


def _distributed_handoff_artifacts(task_id: str, mocked: bool, contract: dict[str, Any], workflow: dict[str, Any],
                                   artifact_store: list[dict[str, Any]], imported_artifacts: list[dict[str, Any]],
                                   placements: list[dict[str, Any]], reused_nodes: list[str], fresh_nodes: list[str],
                                   distributed: dict[str, Any] | None, store_root: Path) -> dict[str, Any]:
    workflow = _workflow_with_materialized_artifact_paths(task_id, mocked, contract, workflow, artifact_store)
    dag = _workflow_dag(task_id, contract, placements)
    dag_path = _write_broker_artifact(
        store_root, task_id, "workflow-dag", dag,
        "canonical/workflow-dag-v1.json")
    admission = _broker_admission_result(task_id, mocked, contract)
    admission_path = _write_broker_artifact(
        store_root, task_id, "workflow-admission", admission,
        "canonical/broker-workflow-admission-compact-v1.json")
    workflow_path = _write_broker_artifact(
        store_root, task_id, "workflow", workflow, "canonical/workflow-result-v1.json")
    evidence_manifest = _broker_evidence_manifest(task_id, mocked, contract, workflow)
    evidence_path = _write_broker_artifact(
        store_root, task_id, "evidence-manifest", evidence_manifest,
        "canonical/evidence-manifest-v1.json")
    materialized_refs = [
        {"path": item["contentAddressedPath"]}
        for item in artifact_store
        if item.get("status") == "MATERIALIZED" and isinstance(item.get("contentAddressedPath"), str)
    ]
    redaction_inputs = [
        {"path": str(admission_path)},
        {"path": str(workflow_path)},
        {"path": str(evidence_path)},
        *materialized_refs,
    ]
    redaction_report = _broker_redaction_report(task_id, mocked, workflow, redaction_inputs)
    redaction_path = _write_broker_artifact(
        store_root, task_id, "redaction-report", redaction_report,
        "canonical/redaction-report-v1.json")
    policy_evaluation = _evaluate_acceptance_policy(contract, workflow, evidence_manifest, redaction_report)
    replay = _replay_report(task_id, workflow, contract, reused_nodes, fresh_nodes, distributed)
    replay_path = _write_broker_artifact(
        store_root, task_id, "attempt-replay", replay,
        "canonical/distributed-replay-report-v1.json")
    provenance_chain = _artifact_provenance_chain(task_id, workflow, artifact_store, imported_artifacts)
    provenance_path = _write_broker_artifact(
        store_root, task_id, "artifact-provenance", provenance_chain,
        "canonical/artifact-provenance-chain-v1.json")
    refs = {
        "dag": _artifact_ref(dag_path, kind="workflow-dag"),
        "admission": _artifact_ref(admission_path, kind="workflow-admission", status=admission["status"]),
        "workflow": _artifact_ref(workflow_path, kind="workflow", status=workflow["status"]),
        "evidence": _artifact_ref(
            evidence_path, kind="evidence-manifest", gate_eligible=bool(evidence_manifest.get("gateEligible"))),
        "redaction": _artifact_ref(redaction_path, kind="redaction-report", status=redaction_report["status"]),
        "replay": _artifact_ref(replay_path, kind="attempt-replay"),
        "provenance": _artifact_ref(provenance_path, kind="artifact-provenance"),
    }
    handoff = _broker_handoff_package(
        task_id, mocked, contract, admission, workflow, evidence_manifest, redaction_report, refs,
        policy_evaluation)
    handoff_path = _write_broker_artifact(
        store_root, task_id, "handoff-package", handoff, "canonical/handoff-package-v1.json")
    evidence_graph = _evidence_graph_export(
        task_id, workflow, evidence_manifest, redaction_report, handoff, policy_evaluation)
    evidence_graph_path = _write_broker_artifact(
        store_root, task_id, "evidence-graph", evidence_graph,
        "canonical/evidence-graph-v1.json")
    acceptance = _acceptance_manifest(task_id, workflow, evidence_manifest, handoff, policy_evaluation)
    acceptance_path = _write_broker_artifact(
        store_root, task_id, "acceptance-manifest", acceptance,
        "canonical/acceptance-manifest-v1.json")
    payload = {
        **common.canonical_envelope(task_id, "present-lease-broker distributed artifacts", mocked=mocked),
        "status": "READY" if redaction_report.get("exportable") is True else "REDACTION_BLOCKED",
        "workflowId": workflow["workflowId"],
        "workflowRunId": workflow["workflowRunId"],
        "contractHash": workflow["contractHash"],
        "workflowDag": dag,
        "workflowDagPath": str(dag_path),
        "admission": admission,
        "workflowPath": str(workflow_path),
        "evidenceManifest": evidence_manifest,
        "evidenceGraph": evidence_graph,
        "evidenceGraphPath": str(evidence_graph_path),
        "redactionReport": redaction_report,
        "replayReport": replay,
        "replayReportPath": str(replay_path),
        "artifactProvenance": provenance_chain,
        "artifactProvenancePath": str(provenance_path),
        "acceptanceManifest": acceptance,
        "acceptanceManifestPath": str(acceptance_path),
        "retentionPolicy": _retention_policy(contract),
        "handoffPackage": handoff,
        "handoffPath": str(handoff_path),
        "handoffSha256": common.sha256_file(handoff_path),
    }
    _validate_distributed_handoff_consistency(payload, workflow)
    _validate_distributed_artifacts(payload)
    return payload


def _artifact_store_root(args) -> Path:
    if args.artifact_store is not None:
        return args.artifact_store
    if args.state is not None:
        return args.state.parent / "artifact-store"
    return common.WORKER_DIR / "broker-artifacts"


def _export_artifact_bytes(worker: dict[str, Any], task_id: str,
                           artifact: dict[str, Any]) -> tuple[bytes | None, str | None]:
    digest = artifact.get("sha256")
    kind = artifact.get("kind")
    if not isinstance(digest, str) or not isinstance(kind, str):
        return None, "artifact lacks kind or sha256"
    code, exported, error, _stdout, _stderr = _invoke_worker(
        worker, ["artifact-export", task_id, kind, "--sha256", digest], timeout=60)
    if code != 0:
        return None, error.get("reason") or "artifact export failed"
    if exported.get("encoding") != "base64" or exported.get("sha256") != digest:
        return None, "artifact export returned unexpected identity"
    try:
        content = base64.b64decode(exported.get("content", ""), validate=True)
    except ValueError:
        return None, "artifact export returned invalid base64"
    if hashlib.sha256(content).hexdigest() != digest:
        return None, "artifact export content hash mismatch"
    return content, None


def _materialize_artifacts(worker: dict[str, Any], worker_id: str, task_id: str,
                           node: dict[str, Any], store_root: Path) -> list[dict[str, Any]]:
    materialized = []
    for artifact in node.get("artifacts", []):
        if not isinstance(artifact, dict) or not artifact.get("sha256"):
            continue
        digest = artifact["sha256"]
        target = store_root / digest[:2] / digest
        content, reason = _export_artifact_bytes(worker, task_id, artifact)
        item = {
            "nodeId": node["id"],
            "workerId": worker_id,
            "kind": artifact.get("kind", ""),
            "sha256": digest,
            "sourcePath": artifact.get("path", ""),
            "contentAddressedPath": str(target),
        }
        if content is None:
            item["status"] = "UNAVAILABLE"
            item["reason"] = reason or "artifact export failed"
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            tmp = target.with_suffix(".tmp")
            tmp.write_bytes(content)
            tmp.replace(target)
            item["status"] = "MATERIALIZED"
        materialized.append(item)
    return materialized


def _materialized_artifact_for(artifact_store: list[dict[str, Any]], source_node_id: str,
                               digest: str) -> dict[str, Any] | None:
    for item in artifact_store:
        if (
            isinstance(item, dict)
            and item.get("nodeId") == source_node_id
            and item.get("sha256") == digest
            and item.get("status") == "MATERIALIZED"
            and isinstance(item.get("contentAddressedPath"), str)
        ):
            return item
    return None


def _import_upstream_artifacts(worker: dict[str, Any], worker_id: str, task_id: str, node: dict[str, Any],
                               results: dict[str, dict[str, Any]],
                               artifact_store: list[dict[str, Any]]) -> list[dict[str, Any]]:
    inputs = node.get("inputs") if isinstance(node.get("inputs"), dict) else {}
    reports = []
    for source_node_id in inputs.get("artifactsFrom", []):
        source = results.get(source_node_id)
        if not isinstance(source, dict):
            continue
        for artifact in source.get("artifacts", []):
            if not isinstance(artifact, dict):
                continue
            digest = artifact.get("sha256")
            kind = artifact.get("kind")
            if not isinstance(digest, str) or not isinstance(kind, str):
                continue
            materialized = _materialized_artifact_for(artifact_store, source_node_id, digest)
            report = {
                "nodeId": node["id"],
                "sourceNodeId": source_node_id,
                "workerId": worker_id,
                "kind": kind,
                "sha256": digest,
            }
            if materialized is None:
                reports.append({**report, "status": "MISSING", "reason": "artifact is not materialized in broker store"})
                continue
            path = Path(materialized["contentAddressedPath"])
            if not path.exists() or not path.is_file():
                reports.append({**report, "status": "MISSING", "reason": "materialized artifact file is absent"})
                continue
            content = base64.b64encode(path.read_bytes()).decode("ascii")
            code, imported, error, _stdout, _stderr = _invoke_worker(
                worker,
                ["artifact-import", task_id],
                input_text=json.dumps({
                    "taskId": task_id,
                    "sourceNodeId": source_node_id,
                    "sourcePath": artifact.get("path", ""),
                    "kind": kind,
                    "sha256": digest,
                    "encoding": "base64",
                    "content": content,
                }, sort_keys=True),
                timeout=60,
            )
            if code == 0 and imported.get("status") == "IMPORTED":
                reports.append({**report, "status": "IMPORTED", "path": imported.get("path", "")})
            else:
                reports.append({
                    **report,
                    "status": "FAILED",
                    "reason": error.get("reason") or imported.get("reason") or "artifact import failed",
                })
    return reports


def _worker_context_checkpoint_refs(worker: dict[str, Any], worker_id: str, task_id: str,
                                    node_id: str) -> list[dict[str, Any]]:
    code, task_state, _error, _stdout, _stderr = _invoke_worker(worker, ["task-state", task_id], timeout=30)
    if code != 0 or not isinstance(task_state, dict):
        return []
    refs = []
    for artifact in task_state.get("artifacts", []) if isinstance(task_state.get("artifacts"), list) else []:
        if not isinstance(artifact, dict) or artifact.get("kind") != "context-checkpoint":
            continue
        refs.append({
            "nodeId": node_id,
            "workerId": worker_id,
            **{key: artifact[key] for key in ("name", "kind", "path", "sha256", "status") if key in artifact},
        })
    return refs


def _blocked_node_record(node: dict[str, Any], reason: str) -> dict[str, Any]:
    now = common.utc_now()
    record = {
        "id": node["id"],
        "capability": node["capability"],
        "verb": {
            "plan": "plan",
            "build": "build",
            "detached-build": "build",
            "candidate": "fix",
            "candidate-fix": "fix",
            "fix": "fix",
            "code-review": "review",
            "review": "review",
            "security-review": "adversarial",
            "adversarial": "adversarial",
            "deterministic-verify": "verify",
            "verify": "verify",
            "coordination-report": "coordination-report",
        }[node["capability"]],
        "dependsOn": node["dependsOn"],
        "nodeContractHash": _workflow_node_contract_hash(node),
        "policy": _workflow_node_policy(node),
        "status": "BLOCKED",
        "exitCode": EXIT_PROTOCOL_ERROR,
        "startedAt": now,
        "finishedAt": now,
        "payload": {"status": "PROTOCOL_ERROR", "reason": reason, "retryable": True},
    }
    if isinstance(node.get("inputs"), dict):
        record["inputs"] = node["inputs"]
    if isinstance(node.get("outputs"), dict):
        record["outputs"] = node["outputs"]
    return record


def _refresh_pool_workers(pool: dict[str, Any]) -> list[dict[str, Any]]:
    refreshed = []
    for worker in pool["workers"]:
        if not isinstance(worker, dict):
            continue
        code, stdout_payload, stderr_payload, _stdout, _stderr = _invoke_worker(worker, ["status"], timeout=30)
        if code == 0 and stdout_payload:
            worker["status"] = stdout_payload
            worker["lastSeenAt"] = stdout_payload.get("producedAt") or common.utc_now()
            refreshed.append({"workerId": _worker_id(worker, stdout_payload), "status": "REFRESHED"})
        else:
            refreshed.append({
                "workerId": worker.get("id", "<unknown>"),
                "status": "FAILED",
                "reason": stderr_payload.get("reason") or stderr_payload.get("error") or "status failed",
            })
    pool["updatedAt"] = common.utc_now()
    return refreshed


def cmd_refresh(args) -> int:
    pool = _load_pool(args.pool)
    refreshed = _refresh_pool_workers(pool)
    _write_pool(args.pool, pool)
    return _emit({"schemaVersion": 1, "producedAt": common.utc_now(), "producer": "present-lease-broker",
                  **_schema_registry_hash_field(), "status": "REFRESHED", "workers": refreshed})


def cmd_select(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        _bundle, contract, contract_hash = _read_bundle(sys.stdin.read(), args.task_id)
        selected, candidates = _select_worker(
            pool, contract, args.task_id, stale_seconds=args.stale_seconds, state=state)
        placements, transfer_manifest = _placement_plan(
            pool["workers"], candidates, contract, args.task_id, contract_hash, state,
            stale_seconds=args.stale_seconds)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))
    if selected:
        _upsert_task_record(
            state, args.task_id, status="SELECTED", contractHash=contract_hash,
            selectedWorker=selected["_resolvedWorkerId"])
        _append_event(state, args.task_id, "select", workerId=selected["_resolvedWorkerId"])
        _write_state(args.state, state)
    payload = {
        **_broker_envelope(args.task_id),
        "status": "SELECTED" if selected else "NO_ELIGIBLE_WORKER",
        "contractHash": contract_hash,
        "selectedWorker": selected["_resolvedWorkerId"] if selected else None,
        "candidates": candidates,
        "admissionReport": _admission_report(args.task_id, candidates),
        "placementPlan": placements,
        "artifactTransferManifest": transfer_manifest,
    }
    return _emit(payload, exit_code=EXIT_OK if selected else EXIT_PROTOCOL_ERROR)


def cmd_provision(args) -> int:
    bundle_text = sys.stdin.read()
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        _bundle, contract, contract_hash = _read_bundle(bundle_text, args.task_id)
        reports = _run_provisioners(pool, args, args.task_id, contract, contract_hash, state)
        if reports:
            _write_pool(args.pool, pool)
        _write_state(args.state, state)
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "PROVISIONED" if any(report.get("workers") for report in reports) else "NO_WORKERS_PROVISIONED",
            "contractHash": contract_hash,
            "provisioning": reports,
            "workers": [worker.get("id") for worker in pool.get("workers", []) if isinstance(worker, dict)],
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_retire(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        report = _deprovision_worker(
            pool, args, args.task_id, args.worker_id, state, reason=getattr(args, "reason", "manual retire"))
        if report.get("removedFromPool"):
            _write_pool(args.pool, pool)
        _write_state(args.state, state)
        status = "WORKER_RETIRED" if report["status"] in {"DEPROVISIONED", "RETIRED", "REMOVED"} else "WORKER_RETIRE_FAILED"
        return _emit({
            **_broker_envelope(args.task_id),
            "status": status,
            "workerId": args.worker_id,
            "retirement": report,
        }, exit_code=EXIT_OK if status == "WORKER_RETIRED" else EXIT_PROTOCOL_ERROR)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _worker_by_id(pool: dict[str, Any], worker_id: str) -> dict[str, Any] | None:
    for worker in pool["workers"]:
        if isinstance(worker, dict):
            status = worker.get("status") if isinstance(worker.get("status"), dict) else {}
            try:
                if _worker_id(worker, status) == worker_id:
                    return worker
            except common.TaskBundleError:
                if worker.get("id") == worker_id:
                    return worker
    return None


def cmd_renew(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        worker = _worker_by_id(pool, args.worker_id)
        if worker is None:
            raise common.TaskBundleError(f"worker {args.worker_id!r} is not in the pool")
        code, renewed, stderr_payload, _stdout, _stderr = _invoke_worker(
            worker, ["worker-lease", args.task_id, "--renew", "--lease-id", args.lease_id,
                     "--ttl-seconds", str(args.ttl_seconds)], timeout=30)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))
    if code != 0:
        return _emit({"status": "BROKER_BLOCKED", "reason": stderr_payload.get("reason", "lease renew failed"),
                      "retryable": False, "worker": args.worker_id}, exit_code=EXIT_PROTOCOL_ERROR)
    _upsert_task_record(
        state, args.task_id, status="RUNNING", contractHash=renewed["contractHash"],
        selectedWorker=args.worker_id, leaseId=renewed["leaseId"], lastHeartbeatAt=common.utc_now())
    _append_event(state, args.task_id, "renew", workerId=args.worker_id, leaseId=renewed["leaseId"])
    _write_state(args.state, state)
    return _emit({**_broker_envelope(args.task_id), "status": "LEASE_RENEWED",
                  "selectedWorker": args.worker_id, "lease": renewed})


def cmd_release(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        worker = _worker_by_id(pool, args.worker_id)
        if worker is None:
            raise common.TaskBundleError(f"worker {args.worker_id!r} is not in the pool")
        code, released, stderr_payload, _stdout, _stderr = _invoke_worker(
            worker, ["worker-lease", args.task_id, "--release", "--lease-id", args.lease_id], timeout=30)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))
    if code != 0:
        return _emit({"status": "BROKER_BLOCKED", "reason": stderr_payload.get("reason", "lease release failed"),
                      "retryable": False, "worker": args.worker_id}, exit_code=EXIT_PROTOCOL_ERROR)
    record = _task_record(state, args.task_id)
    _upsert_task_record(
        state, args.task_id, status=record.get("status", "COMPLETE") if record else "COMPLETE",
        contractHash=released["contractHash"], selectedWorker=args.worker_id,
        leaseId=released["leaseId"], terminalAt=common.utc_now())
    _append_event(state, args.task_id, "release", workerId=args.worker_id, leaseId=released["leaseId"])
    _write_state(args.state, state)
    return _emit({**_broker_envelope(args.task_id), "status": "LEASE_RELEASED",
                  "selectedWorker": args.worker_id, "lease": released})


def _ready_batch(nodes: list[dict[str, Any]], completed: set[str], terminal: set[str],
                 worker_by_node: dict[str, str], max_parallel: int) -> list[dict[str, Any]]:
    batch = []
    claimed_workers: set[str] = set()
    for node in _workflow_topological_ready(nodes, completed, terminal):
        worker_id = worker_by_node[node["id"]]
        if worker_id in claimed_workers:
            continue
        batch.append(node)
        claimed_workers.add(worker_id)
        if len(batch) >= max_parallel:
            break
    return batch


def _invoke_workflow_node_with_retries(worker: dict[str, Any], node_args: list[str], bundle_text: str,
                                       timeout: int, retries: int, *, task_id: str, lease_id: str,
                                       ttl_seconds: int,
                                       heartbeat_interval_seconds: int) -> tuple[
                                           int, dict[str, Any], dict[str, Any], int, list[dict[str, Any]]
                                       ]:
    last_code = EXIT_PROTOCOL_ERROR
    last_payload: dict[str, Any] = {}
    last_error: dict[str, Any] = {}
    attempts = 0
    renewals: list[dict[str, Any]] = []
    for attempt in range(retries + 1):
        attempts = attempt + 1
        code, payload, error, _stdout, _stderr, attempt_renewals = _invoke_worker_with_heartbeat(
            worker,
            node_args,
            input_text=bundle_text,
            timeout=timeout,
            task_id=task_id,
            lease_id=lease_id,
            ttl_seconds=ttl_seconds,
            heartbeat_interval_seconds=heartbeat_interval_seconds,
        )
        renewals.extend(attempt_renewals)
        last_code, last_payload, last_error = code, payload, error
        retryable = (error.get("retryable") is True or payload.get("retryable") is True)
        if code == 0 or not retryable or attempt == retries:
            break
    return last_code, last_payload, last_error, attempts, renewals


def _execute_distributed_node(args, *, pool: dict[str, Any], task_id: str, contract_hash: str,
                              workflow_id: str, bundle_text: str, node: dict[str, Any],
                              worker_id: str, results: dict[str, dict[str, Any]],
                              artifact_store: list[dict[str, Any]], store_root: Path) -> dict[str, Any]:
    events = []
    total_started = time.monotonic()
    started_at = common.utc_now()

    def dispatch(status: str, **fields: Any) -> dict[str, Any]:
        return {
            "nodeId": node["id"],
            "workerId": worker_id,
            "status": status,
            "startedAt": started_at,
            "finishedAt": common.utc_now(),
            "timingsMs": {"total": _elapsed_ms(total_started), **fields.pop("timingsMs", {})},
            **fields,
        }

    worker = _worker_by_id(pool, worker_id)
    if worker is None:
        record = _blocked_node_record(node, f"worker {worker_id!r} is not in the pool")
        return {
            "nodeId": node["id"],
            "record": record,
            "dispatch": dispatch("WORKER_MISSING"),
            "materialized": [],
            "imports": [],
            "events": events,
        }
    lock_started = time.monotonic()
    lock = _lock_request(args, "acquire", task_id, contract_hash, node["id"], worker_id)
    lock_wait_ms = _elapsed_ms(lock_started)
    if lock.get("status") not in {"NOT_CONFIGURED", "ACQUIRED", "HELD"}:
        reason = lock.get("reason") or "external lock acquire failed"
        record = _blocked_node_record(node, str(reason))
        events.append(("distributed-lock-rejected", {
            "nodeId": node["id"], "workerId": worker_id, "reason": str(reason),
            "timingsMs": {"lockWait": lock_wait_ms, "total": _elapsed_ms(total_started)},
        }))
        return {
            "nodeId": node["id"],
            "record": record,
            "dispatch": dispatch("LOCK_REJECTED", lock=lock, timingsMs={"lockWait": lock_wait_ms}),
            "materialized": [],
            "imports": [],
            "events": events,
        }
    import_started = time.monotonic()
    imports = _import_upstream_artifacts(worker, worker_id, task_id, node, results, artifact_store)
    artifact_import_ms = _elapsed_ms(import_started)
    for item in imports:
        events.append(("artifact-imported", {
            "nodeId": item["nodeId"],
            "sourceNodeId": item["sourceNodeId"],
            "workerId": worker_id,
            "sha256": item["sha256"],
            "status": item["status"],
            "timingsMs": {"artifactImport": artifact_import_ms, "total": _elapsed_ms(total_started)},
        }))
    failed_imports = [item for item in imports if item.get("status") != "IMPORTED"]
    if failed_imports:
        release_started = time.monotonic()
        _lock_request(args, "release", task_id, contract_hash, node["id"], worker_id)
        lock_release_ms = _elapsed_ms(release_started)
        reason = "; ".join(item.get("reason", "artifact import failed") for item in failed_imports)
        record = _blocked_node_record(node, reason)
        return {
            "nodeId": node["id"],
            "record": record,
            "dispatch": dispatch(
                "ARTIFACT_IMPORT_FAILED",
                lock=lock,
                artifactImports=imports,
                timingsMs={
                    "lockWait": lock_wait_ms,
                    "artifactImport": artifact_import_ms,
                    "lockRelease": lock_release_ms,
                }),
            "materialized": [],
            "imports": imports,
            "events": events,
        }
    lease_started = time.monotonic()
    code, lease, lease_error, _stdout, _stderr = _invoke_worker(
        worker, ["worker-lease", task_id, "--acquire", "--contract-hash", contract_hash,
                 "--ttl-seconds", str(args.ttl_seconds)], timeout=30)
    lease_wait_ms = _elapsed_ms(lease_started)
    if code != 0:
        reason = lease_error.get("reason") or "lease acquire failed"
        release_started = time.monotonic()
        _lock_request(args, "release", task_id, contract_hash, node["id"], worker_id)
        lock_release_ms = _elapsed_ms(release_started)
        record = _blocked_node_record(node, reason)
        events.append(("distributed-lease-rejected", {
            "nodeId": node["id"], "workerId": worker_id, "reason": reason,
            "timingsMs": {"leaseWait": lease_wait_ms, "total": _elapsed_ms(total_started)},
        }))
        return {
            "nodeId": node["id"],
            "record": record,
            "dispatch": dispatch(
                "LEASE_REJECTED",
                reason=reason,
                lock=lock,
                artifactImports=imports,
                timingsMs={
                    "lockWait": lock_wait_ms,
                    "artifactImport": artifact_import_ms,
                    "leaseWait": lease_wait_ms,
                    "lockRelease": lock_release_ms,
                }),
            "materialized": [],
            "imports": imports,
            "events": events,
        }
    node_args = ["workflow-node", task_id, node["id"], "--lease-id", lease["leaseId"]]
    if args.mock:
        node_args.append("--mock")
    events.append(("distributed-node-dispatch", {
        "nodeId": node["id"], "workerId": worker_id, "leaseId": lease["leaseId"],
        "timingsMs": {
            "lockWait": lock_wait_ms,
            "artifactImport": artifact_import_ms,
            "leaseWait": lease_wait_ms,
            "total": _elapsed_ms(total_started),
        },
    }))
    execution_started = time.monotonic()
    code, node_payload, node_error, node_attempts, lease_renewals = _invoke_workflow_node_with_retries(
        worker, node_args, bundle_text, int(_workflow_node_policy(node)["timeoutSeconds"]) + 60,
        args.node_retries, task_id=task_id, lease_id=lease["leaseId"], ttl_seconds=args.ttl_seconds,
        heartbeat_interval_seconds=args.heartbeat_interval_seconds)
    execution_ms = _elapsed_ms(execution_started)
    node_record = node_payload if node_payload else node_error
    if not node_record:
        node_record = _blocked_node_record(node, "workflow-node returned no JSON payload")
    resolved = _attach_imported_local_paths(_workflow_resolved_inputs(node, results), imports)
    if resolved:
        node_record["resolvedInputs"] = resolved
    _attach_workflow_accepted_evidence(task_id, workflow_id, node_record, mocked=args.mock, spec=node, results=results)
    release_started = time.monotonic()
    release_code, released, _release_error, _rs, _re = _invoke_worker(
        worker, ["worker-lease", task_id, "--release", "--lease-id", lease["leaseId"]], timeout=30)
    lease_release_ms = _elapsed_ms(release_started)
    lock_release_started = time.monotonic()
    lock_release = _lock_request(args, "release", task_id, contract_hash, node["id"], worker_id, lease["leaseId"])
    lock_release_ms = _elapsed_ms(lock_release_started)
    if release_code == 0:
        events.append(("distributed-node-release", {
            "nodeId": node["id"], "workerId": worker_id, "leaseId": lease["leaseId"],
            "timingsMs": {
                "leaseRelease": lease_release_ms,
                "lockRelease": lock_release_ms,
                "total": _elapsed_ms(total_started),
            },
        }))
    materialize_started = time.monotonic()
    materialized = _materialize_artifacts(worker, worker_id, task_id, node_record, store_root)
    context_checkpoints = _worker_context_checkpoint_refs(worker, worker_id, task_id, node["id"])
    artifact_materialize_ms = _elapsed_ms(materialize_started)
    for item in materialized:
        events.append(("artifact-materialized", {
            "nodeId": item["nodeId"], "workerId": worker_id,
            "sha256": item["sha256"], "status": item["status"],
            "timingsMs": {"artifactMaterialize": artifact_materialize_ms, "total": _elapsed_ms(total_started)},
        }))
    return {
        "nodeId": node["id"],
        "record": node_record,
        "dispatch": dispatch(
            node_record.get("status", "BLOCKED"),
            leaseId=lease["leaseId"],
            attempts=node_attempts,
            leaseRenewals=lease_renewals,
            lock=lock,
            lockRelease=lock_release,
            artifactImports=imports,
            timingsMs={
                "lockWait": lock_wait_ms,
                "artifactImport": artifact_import_ms,
                "leaseWait": lease_wait_ms,
                "execution": execution_ms,
                "leaseRelease": lease_release_ms,
                "lockRelease": lock_release_ms,
                "artifactMaterialize": artifact_materialize_ms,
            },
            **({"releasedLease": released} if release_code == 0 else {}),
        ),
        "materialized": materialized,
        "imports": imports,
        "contextCheckpoints": context_checkpoints,
        "events": events,
    }


def cmd_run_distributed(args) -> int:
    bundle_text = sys.stdin.read()
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        _bundle, contract, contract_hash = _read_bundle(bundle_text, args.task_id)
        provision_reports = _run_provisioners(pool, args, args.task_id, contract, contract_hash, state)
        if provision_reports:
            _write_pool(args.pool, pool)
        existing = _task_record(state, args.task_id)
        if existing and existing.get("contractHash") != contract_hash:
            raise common.TaskBundleError("broker state contractHash differs from the requested workflow contract")
        if existing and existing.get("status") == "CANCELLED" and not getattr(args, "resume_cancelled", False):
            return _emit({
                **_broker_envelope(args.task_id),
                "status": "BROKER_BLOCKED",
                "reason": "cancelled workflow requires --resume-cancelled to run again",
                "retryable": False,
            }, exit_code=EXIT_PROTOCOL_ERROR)
        if existing and existing.get("status") in {"DISTRIBUTED_COMPLETE", "DISTRIBUTED_FAILED"}:
            _append_event(state, args.task_id, "idempotent-replay", status=existing["status"])
            _write_state(args.state, state)
            distributed = existing.get("distributed") if isinstance(existing.get("distributed"), dict) else {}
            return _emit({
                **_broker_envelope(args.task_id),
                "status": "IDEMPOTENT_REPLAY",
                "contractHash": contract_hash,
                "task": existing,
                **({"replayReport": distributed["replayReport"]} if isinstance(distributed.get("replayReport"), dict) else {}),
                **({"acceptanceManifest": distributed["acceptanceManifest"]}
                   if isinstance(distributed.get("acceptanceManifest"), dict) else {}),
            })
        selected, candidates = _select_worker(
            pool, contract, args.task_id, stale_seconds=args.stale_seconds, state=state)
        placements, transfer_manifest = _placement_plan(
            pool["workers"], candidates, contract, args.task_id, contract_hash, state,
            stale_seconds=args.stale_seconds)
        missing = [item for item in placements if not item.get("workerId")]
        if missing:
            return _emit({
                **_broker_envelope(args.task_id),
                "status": "NO_NODE_PLACEMENT",
                "contractHash": contract_hash,
                "candidates": candidates,
                "admissionReport": _admission_report(args.task_id, candidates),
                "placementPlan": placements,
                "artifactTransferManifest": transfer_manifest,
                "provisioning": provision_reports,
            }, exit_code=EXIT_PROTOCOL_ERROR)
        worker_by_node = {item["nodeId"]: item["workerId"] for item in placements}
        workflow_id, _contract_hash, _run_id = _workflow_identity(args.task_id, contract)
        record = _upsert_task_record(
            state, args.task_id, status="DISTRIBUTED_RUNNING", contractHash=contract_hash,
            selectedWorker="distributed")
        attempt_id = f"attempt-{len(record['attempts']) + 1}" if record else "attempt-1"
        if record is not None:
            distributed = _distributed_record(record, args.task_id)
            if distributed is not None:
                distributed["workflowId"] = workflow_id
                distributed["contractHash"] = contract_hash
                distributed["storeRoot"] = str(_artifact_store_root(args))
                distributed["artifactStoreAdapter"] = _artifact_store_descriptor(
                    _artifact_store_root(args), _artifact_store_kind(args))
                distributed["placements"] = placements
                distributed["artifactTransferManifest"] = transfer_manifest
                distributed["workflowDag"] = _workflow_dag(args.task_id, contract, placements)
                distributed["toolContracts"] = {
                    _worker_id(worker, worker.get("_resolvedStatus", worker.get("status", {}))): worker["_resolvedToolContracts"]
                    for worker in pool.get("workers", [])
                    if isinstance(worker, dict) and isinstance(worker.get("_resolvedToolContracts"), dict)
                }
                distributed["contractChecks"] = [
                    placement["contractCheck"]
                    for placement in placements
                    if isinstance(placement.get("contractCheck"), dict)
                ]
                recovery_key = (
                    distributed.pop("pendingRecoveryIdempotencyKey", None)
                    if isinstance(distributed.get("pendingRecoveryIdempotencyKey"), str) else None
                )
                _append_workflow_attempt(distributed, attempt_id, recovery_idempotency_key=recovery_key)
            record["attempts"].append({
                "attemptId": attempt_id,
                "workerId": "distributed",
                "status": "DISTRIBUTED_RUNNING",
                "startedAt": common.utc_now(),
            })
        _append_event(state, args.task_id, "distributed-start", attemptId=attempt_id)
        _append_distributed_narrative(
            record,
            actor_kind="control-plain",
            actor_id="present-lease-broker",
            action="admit-workflow",
            target=args.task_id,
            human_text=f"The control plain admitted workflow {workflow_id} and started attempt {attempt_id}.",
        )
        for placement in placements:
            check = placement.get("contractCheck") if isinstance(placement.get("contractCheck"), dict) else {}
            if placement.get("workerId"):
                detail = (
                    f" after contract check {check.get('status')}"
                    if check.get("status") else ""
                )
                _append_distributed_narrative(
                    record,
                    actor_kind="control-plain",
                    actor_id="present-lease-broker",
                    action="place-node",
                    target=placement["nodeId"],
                    workerId=placement["workerId"],
                    nodeId=placement["nodeId"],
                    toolId=check.get("toolId"),
                    human_text=(
                        f"The control plain placed node {placement['nodeId']} on worker "
                        f"{placement['workerId']}{detail}."
                    ),
                )
        _write_state(args.state, state)

        nodes = contract["workflow"]["nodes"]
        (
            results,
            completed,
            terminal,
            reused_nodes,
            node_dispatches,
            artifact_store,
            imported_artifacts,
        ) = _distributed_resume_progress(record, nodes)
        if reused_nodes:
            _append_event(state, args.task_id, "distributed-resume", reusedNodes=reused_nodes)
        fresh_nodes: list[str] = []
        status = "SUCCEEDED"
        store_root = _artifact_store_root(args)
        max_parallel = max(1, int(contract["workflow"].get("maxParallel", 1)))

        while len(terminal) < len(nodes):
            ready = _ready_batch(nodes, completed, terminal, worker_by_node, max_parallel)
            if not ready:
                status = "BLOCKED"
                break
            _append_event(state, args.task_id, "distributed-batch-dispatch",
                          nodeIds=[node["id"] for node in ready])
            for node in ready:
                worker_id = worker_by_node[node["id"]]
                _append_distributed_narrative(
                    record,
                    actor_kind="control-plain",
                    actor_id="present-lease-broker",
                    action="dispatch-node",
                    target=node["id"],
                    workerId=worker_id,
                    nodeId=node["id"],
                    human_text=f"The control plain dispatched node {node['id']} to worker {worker_id}.",
                )
            _write_state(args.state, state)
            snapshot = dict(results)
            artifact_snapshot = list(artifact_store)
            with concurrent.futures.ThreadPoolExecutor(max_workers=len(ready)) as pool_executor:
                futures = {
                    pool_executor.submit(
                        _execute_distributed_node,
                        args,
                        pool=pool,
                        task_id=args.task_id,
                        contract_hash=contract_hash,
                        workflow_id=workflow_id,
                        bundle_text=bundle_text,
                        node=node,
                        worker_id=worker_by_node[node["id"]],
                        results=snapshot,
                        artifact_store=artifact_snapshot,
                        store_root=store_root,
                    ): node
                    for node in ready
                }
                batch_results = [future.result() for future in concurrent.futures.as_completed(futures)]
            by_node = {item["nodeId"]: item for item in batch_results}
            for node in ready:
                item = by_node[node["id"]]
                for event_type, event_data in item["events"]:
                    _append_event(state, args.task_id, event_type, **event_data)
                node_record = item["record"]
                artifact_store.extend(item["materialized"])
                imported_artifacts.extend(item.get("imports", []))
                node_dispatches.append(item["dispatch"])
                if item["dispatch"].get("status") in {
                    "LOCK_REJECTED",
                    "LEASE_REJECTED",
                    "ARTIFACT_IMPORT_FAILED",
                    "FAILED",
                    "BLOCKED",
                }:
                    _record_worker_fault(
                        pool, state, args.task_id, item["dispatch"].get("workerId", ""),
                        item["dispatch"].get("reason") or node_record.get("reason") or item["dispatch"].get("status"))
                results[node["id"]] = node_record
                terminal.add(node["id"])
                fresh_nodes.append(node["id"])
                policy = _workflow_node_policy(node)
                node_status = node_record.get("status")
                if node_status == "WAITING":
                    status = "WAITING"
                elif node_status in set(policy.get("blocksOn") or []):
                    status = "FAILED" if node_status == "FAILED" else "BLOCKED"
                else:
                    completed.add(node["id"])
                _persist_distributed_node(args.state, state, record, node, item, node["id"] in completed)
            if status != "SUCCEEDED":
                break

        ordered = [results[node["id"]] for node in nodes if node["id"] in results]
        if status == "SUCCEEDED" and len(completed) != len(nodes):
            status = "BLOCKED"
        workflow = _workflow_result(args.task_id, args.mock, contract, ordered, status, fresh_nodes, reused_nodes)
        distributed_for_artifacts = record.get("distributed") if isinstance(record, dict) else None
        distributed_artifacts = _distributed_handoff_artifacts(
            args.task_id, args.mock, contract, workflow, artifact_store, imported_artifacts,
            placements, reused_nodes, fresh_nodes, distributed_for_artifacts, store_root)
        integrity_ledger = _artifact_integrity_ledger(
            args.task_id, contract_hash, workflow, artifact_store, imported_artifacts, distributed_artifacts)
        _write_broker_artifact(
            store_root, args.task_id, "integrity-ledger", integrity_ledger,
            "canonical/artifact-integrity-ledger-v1.json")
        _validate_distributed_execution_consistency(
            contract, workflow, artifact_store, imported_artifacts, distributed_artifacts, integrity_ledger)
        broker_status = "DISTRIBUTED_COMPLETE" if status in {"SUCCEEDED", "WAITING"} else "DISTRIBUTED_FAILED"
        record = _upsert_task_record(
            state, args.task_id, status=broker_status, contractHash=contract_hash,
            selectedWorker="distributed", workflowRunId=workflow["workflowRunId"],
            lastHeartbeatAt=common.utc_now(), terminalAt=common.utc_now())
        if record and record.get("attempts"):
            record["attempts"][-1]["status"] = broker_status
            record["attempts"][-1]["finishedAt"] = common.utc_now()
        _finish_workflow_attempt(record.get("distributed") if isinstance(record, dict) else None, attempt_id,
                                 status=broker_status, reused_nodes=reused_nodes, fresh_nodes=fresh_nodes)
        if record and isinstance(record.get("distributed"), dict):
            record["distributed"]["handoffSha256"] = distributed_artifacts["handoffSha256"]
            record["distributed"]["replayReport"] = distributed_artifacts["replayReport"]
            record["distributed"]["acceptanceManifest"] = distributed_artifacts["acceptanceManifest"]
            _append_distributed_narrative(
                record,
                actor_kind="verifier",
                actor_id="deterministic-acceptance",
                action="decide-acceptance",
                target=args.task_id,
                evidenceRefs=distributed_artifacts["acceptanceManifest"].get("acceptedEvidence", []),
                human_text=(
                    "Deterministic acceptance finished with decision "
                    f"{distributed_artifacts['acceptanceManifest'].get('decision')}: "
                    f"{distributed_artifacts['acceptanceManifest'].get('reason', 'no reason recorded')}."
                ),
            )
        _append_event(state, args.task_id, "distributed-complete", workflowStatus=status)
        _append_event(state, args.task_id, "distributed-handoff",
                      handoffSha256=distributed_artifacts["handoffSha256"],
                      redactionStatus=distributed_artifacts["redactionReport"]["status"])
        provisioned_worker_ids = [
            worker_id
            for report in provision_reports
            for worker_id in report.get("workers", [])
            if isinstance(worker_id, str)
        ]
        temporary_worker_ids = [
            worker.get("id")
            for worker in pool.get("workers", [])
            if (
                isinstance(worker, dict)
                and isinstance(worker.get("id"), str)
                and isinstance(worker.get("lifecycle"), dict)
                and worker["lifecycle"].get("retireAfterTask") is True
            )
        ]
        retire_worker_ids = temporary_worker_ids
        if getattr(args, "deprovision_on_complete", False):
            retire_worker_ids = [*retire_worker_ids, *provisioned_worker_ids]
        deprovision_reports = _deprovision_workers(
            pool, args, args.task_id, retire_worker_ids, state,
            reason="workflow terminal cleanup")
        if deprovision_reports:
            _write_pool(args.pool, pool)
        elif any(isinstance(worker, dict) and isinstance(worker.get("quarantine"), dict)
                 and worker["quarantine"].get("active") is True for worker in pool.get("workers", [])):
            _write_pool(args.pool, pool)
        _write_state(args.state, state)
        _validate_distributed_artifacts(distributed_artifacts)
        payload = {
            **_broker_envelope(args.task_id),
            "status": "DISTRIBUTED_WORKFLOW_DISPATCHED" if broker_status == "DISTRIBUTED_COMPLETE"
            else "DISTRIBUTED_WORKFLOW_FAILED",
            "contractHash": contract_hash,
            "selectedWorker": selected["_resolvedWorkerId"] if selected else None,
            "candidates": candidates,
            "admissionReport": _admission_report(args.task_id, candidates),
            "placementPlan": placements,
            "contractChecks": [
                placement["contractCheck"]
                for placement in placements
                if isinstance(placement.get("contractCheck"), dict)
            ],
            "artifactTransferManifest": transfer_manifest,
            "provisioning": provision_reports,
            "nodeDispatches": node_dispatches,
            "artifactStore": {
                "root": str(store_root),
                "descriptor": _artifact_store_descriptor(store_root, _artifact_store_kind(args)),
                "artifacts": artifact_store,
            },
            "importedArtifacts": imported_artifacts,
            "contextCheckpoints": (
                record.get("distributed", {}).get("contextCheckpoints", [])
                if isinstance(record, dict) and isinstance(record.get("distributed"), dict) else []
            ),
            "workflow": workflow,
            "distributedArtifacts": distributed_artifacts,
            "integrityLedger": integrity_ledger,
            "deprovisioning": deprovision_reports,
        }
        return _emit(payload, exit_code=EXIT_OK if broker_status == "DISTRIBUTED_COMPLETE" else EXIT_PROTOCOL_ERROR)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _classify_worker_state(task_state: dict[str, Any]) -> str:
    status = task_state.get("status")
    lease = task_state.get("workerLease") if isinstance(task_state.get("workerLease"), dict) else {}
    if status == "COMPLETE":
        return "COMPLETE"
    if status == "CANCELLED":
        return "CANCELLED"
    if status == "INCONSISTENT":
        return "INCONSISTENT"
    if lease.get("status") == "EXPIRED":
        return "LEASE_EXPIRED"
    if lease.get("status") == "ACTIVE":
        return "WAITING" if task_state.get("activeBuildJobs") else "RUNNING"
    return "RUNNING" if status in {"PARTIAL", "EMPTY"} else str(status or "INCONSISTENT")


def cmd_reconcile(args) -> int:
    bundle_text = sys.stdin.read()
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        record = _task_record(state, args.task_id)
        if record is None:
            raise common.TaskBundleError("broker state has no record for task")
        worker = _worker_by_id(pool, record["selectedWorker"])
        if worker is None:
            raise common.TaskBundleError(f"worker {record['selectedWorker']!r} is not in the pool")
        try:
            code, task_state, stderr_payload, _stdout, _stderr = _invoke_worker(
                worker, ["task-state", args.task_id], timeout=30)
        except (subprocess.SubprocessError, common.TaskBundleError) as exc:
            _upsert_task_record(state, args.task_id, status="WORKER_UNREACHABLE",
                                contractHash=record["contractHash"], selectedWorker=record["selectedWorker"])
            _append_event(state, args.task_id, "worker-unreachable", reason=str(exc))
            _write_state(args.state, state)
            return _emit({**_broker_envelope(args.task_id), "status": "WORKER_UNREACHABLE",
                          "reason": str(exc), "task": _task_record(state, args.task_id)},
                         exit_code=EXIT_PROTOCOL_ERROR)
        if code != 0:
            _upsert_task_record(state, args.task_id, status="WORKER_UNREACHABLE",
                                contractHash=record["contractHash"], selectedWorker=record["selectedWorker"])
            _append_event(state, args.task_id, "worker-unreachable",
                          reason=stderr_payload.get("reason", "task-state failed"))
            _write_state(args.state, state)
            return _emit({**_broker_envelope(args.task_id), "status": "WORKER_UNREACHABLE",
                          "reason": stderr_payload.get("reason", "task-state failed"),
                          "task": _task_record(state, args.task_id)}, exit_code=EXIT_PROTOCOL_ERROR)
        if task_state.get("contractHash") and task_state["contractHash"] != record["contractHash"]:
            _upsert_task_record(state, args.task_id, status="INCONSISTENT",
                                contractHash=record["contractHash"], selectedWorker=record["selectedWorker"])
            _append_event(state, args.task_id, "inconsistent", reason="worker contractHash differs")
            _write_state(args.state, state)
            return _emit({**_broker_envelope(args.task_id), "status": "INCONSISTENT",
                          "reason": "worker contractHash differs", "taskState": task_state},
                         exit_code=EXIT_PROTOCOL_ERROR)
        classification = _classify_worker_state(task_state)
        lease = task_state.get("workerLease") if isinstance(task_state.get("workerLease"), dict) else {}
        if classification in {"RUNNING", "WAITING"} and lease.get("leaseId"):
            renew_code, renewed, _renew_error, _rs, _re = _invoke_worker(
                worker, ["worker-lease", args.task_id, "--renew", "--lease-id", lease["leaseId"],
                         "--ttl-seconds", str(args.ttl_seconds)], timeout=30)
            if renew_code == 0:
                lease = renewed
                _append_event(state, args.task_id, "renew", workerId=record["selectedWorker"], leaseId=lease["leaseId"])
        elif classification in {"COMPLETE", "CANCELLED"} and lease.get("status") == "ACTIVE":
            _invoke_worker(worker, ["worker-lease", args.task_id, "--release", "--lease-id", lease["leaseId"]], timeout=30)
            _append_event(state, args.task_id, "release", workerId=record["selectedWorker"], leaseId=lease["leaseId"])
        elif classification == "LEASE_EXPIRED" and args.failover:
            if not bundle_text.strip():
                raise common.TaskBundleError("reconcile --failover requires the task bundle on stdin")
            _bundle, contract, contract_hash = _read_bundle(bundle_text, args.task_id)
            if contract_hash != record["contractHash"]:
                raise common.TaskBundleError("failover contract hash differs from broker state")
            selected, candidates = _select_worker(
                pool, contract, args.task_id, stale_seconds=args.stale_seconds, state=state)
            if selected is None:
                _append_event(state, args.task_id, "failover-blocked")
                _write_state(args.state, state)
                return _emit({**_broker_envelope(args.task_id), "status": "LEASE_EXPIRED",
                              "reason": "no eligible failover worker", "candidates": candidates},
                             exit_code=EXIT_PROTOCOL_ERROR)
            code, new_lease, stderr_payload, _stdout, _stderr = _invoke_worker(
                selected, ["worker-lease", args.task_id, "--acquire", "--contract-hash", contract_hash,
                           "--ttl-seconds", str(args.ttl_seconds)], timeout=30)
            if code != 0:
                return _emit({**_broker_envelope(args.task_id), "status": "LEASE_EXPIRED",
                              "reason": stderr_payload.get("reason", "failover lease acquire failed")},
                             exit_code=EXIT_PROTOCOL_ERROR)
            classification = "FAILOVER_LEASED"
            lease = new_lease
            record = _upsert_task_record(
                state, args.task_id, status=classification, contractHash=contract_hash,
                selectedWorker=selected["_resolvedWorkerId"], leaseId=new_lease["leaseId"],
                lastHeartbeatAt=common.utc_now())
            if record is not None:
                record["attempts"].append({
                    "attemptId": f"attempt-{len(record['attempts']) + 1}",
                    "workerId": selected["_resolvedWorkerId"],
                    "status": "FAILOVER_LEASED",
                    "startedAt": common.utc_now(),
                    "leaseId": new_lease["leaseId"],
                })
            _append_event(state, args.task_id, "failover-leased",
                          workerId=selected["_resolvedWorkerId"], leaseId=new_lease["leaseId"])
        terminal = classification in {"COMPLETE", "CANCELLED", "FAILED", "INCONSISTENT"}
        _upsert_task_record(
            state, args.task_id, status=classification, contractHash=record["contractHash"],
            selectedWorker=record["selectedWorker"] if classification != "FAILOVER_LEASED" else record.get("selectedWorker", ""),
            leaseId=lease.get("leaseId"), workflowRunId=task_state.get("workflowRunId"),
            lastHeartbeatAt=common.utc_now(), terminalAt=common.utc_now() if terminal else None)
        _append_event(state, args.task_id, "reconcile", status=classification)
        _write_state(args.state, state)
        return _emit({**_broker_envelope(args.task_id), "status": classification,
                      "task": _task_record(state, args.task_id), "taskState": task_state})
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _first_retryable_distributed_node(record: dict[str, Any]) -> str | None:
    distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    for node_id, node in nodes.items():
        if not isinstance(node, dict):
            continue
        if node.get("status") not in {"SUCCEEDED", "COMPLETE"}:
            return str(node_id)
    return next(iter(nodes), None) if nodes else None


def _recover_actions(pool: dict[str, Any], record: dict[str, Any], *, stale_seconds: int) -> list[dict[str, Any]]:
    actions: list[dict[str, Any]] = []
    worker_ids = {
        worker.get("id")
        for worker in pool.get("workers", [])
        if isinstance(worker, dict) and isinstance(worker.get("id"), str)
    }
    selected = record.get("selectedWorker")
    if isinstance(selected, str) and selected and selected != "distributed" and selected not in worker_ids:
        actions.append({
            "action": "mark-inconsistent",
            "status": "INCONSISTENT",
            "reason": f"selected worker {selected!r} is absent from the pool",
        })
    heartbeat = _utc_parse(record.get("lastHeartbeatAt", ""))
    if record.get("status") in {"RUNNING", "WAITING", "DISTRIBUTED_RUNNING"}:
        if heartbeat is None:
            action = "retry-node" if record.get("status") == "DISTRIBUTED_RUNNING" else "failover-lease"
            actions.append({
                "action": action,
                "status": "RECOVERABLE",
                **({"nodeId": _first_retryable_distributed_node(record)} if action == "retry-node" else {}),
                "reason": "running task has no parseable lastHeartbeatAt",
            })
        elif (datetime.datetime.now(datetime.timezone.utc) - heartbeat).total_seconds() > stale_seconds:
            action = "retry-node" if record.get("status") == "DISTRIBUTED_RUNNING" else "failover-lease"
            actions.append({
                "action": action,
                "status": "RECOVERABLE",
                **({"nodeId": _first_retryable_distributed_node(record)} if action == "retry-node" else {}),
                "reason": "running task heartbeat is stale",
            })
    distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
    dispatches = distributed.get("nodeDispatches") if isinstance(distributed.get("nodeDispatches"), list) else []
    for dispatch in dispatches:
        if not isinstance(dispatch, dict) or not isinstance(dispatch.get("leaseId"), str):
            continue
        if dispatch.get("status") in {"RUNNING", "DISPATCHED"}:
            started = _utc_parse(str(dispatch.get("startedAt", "")))
            if started is None or (datetime.datetime.now(datetime.timezone.utc) - started).total_seconds() > stale_seconds:
                actions.append({
                    "action": "recover-node-lease",
                    "status": "RECOVERABLE",
                    "nodeId": dispatch.get("nodeId"),
                    "workerId": dispatch.get("workerId"),
                    "leaseId": dispatch.get("leaseId"),
                    "reason": "distributed node lease is stale",
                })
    for artifact in distributed.get("artifactStore", []) if isinstance(distributed.get("artifactStore"), list) else []:
        if not isinstance(artifact, dict) or artifact.get("status") != "MATERIALIZED":
            continue
        path = Path(str(artifact.get("contentAddressedPath", "")))
        if not path.is_file():
            actions.append({
                "action": "rematerialize-artifact",
                "status": "RECOVERABLE",
                "nodeId": artifact.get("nodeId"),
                "sha256": artifact.get("sha256"),
                "reason": "materialized artifact file is absent",
            })
        elif artifact.get("sha256") != common.sha256_file(path):
            actions.append({
                "action": "rematerialize-artifact",
                "status": "RECOVERABLE",
                "nodeId": artifact.get("nodeId"),
                "sha256": artifact.get("sha256"),
                "reason": "materialized artifact sha256 differs from disk",
            })
    return [_validate_recovery_action(action) for action in actions]


def _validate_recovery_action(action: dict[str, Any]) -> dict[str, Any]:
    common.validate_with_schema(
        action,
        "canonical/broker-recovery-action-v1.json",
        "broker recovery action",
        validation_point="broker-recovery-plan",
        artifact_kind="broker-recovery-action",
    )
    return action


def _recovery_scope_key(args, actions: list[dict[str, Any]]) -> str:
    if getattr(args, "idempotency_key", None):
        return str(args.idempotency_key)
    basis = {
        "taskId": args.task_id,
        "action": getattr(args, "action", None),
        "nodeId": getattr(args, "node_id", None),
        "workerId": getattr(args, "worker_id", None),
        "reason": getattr(args, "reason", ""),
        "forceCancelled": getattr(args, "force_cancelled", False),
        "operatorRole": getattr(args, "operator_role", "operator"),
        "actions": actions,
    }
    return "rk-" + common.canonical_hash(basis)[:24]


def _recovery_application_by_key(state: dict[str, Any], _record: dict[str, Any], key: str) -> dict[str, Any] | None:
    applications = state.get("recoveryLedger")
    if not isinstance(applications, list):
        applications = []
    for item in applications:
        if isinstance(item, dict) and item.get("idempotencyKey") == key:
            return item
    return None


def _record_recovery_application(state: dict[str, Any], task_id: str, key: str,
                                 payload: dict[str, Any]) -> None:
    applications = state.setdefault("recoveryLedger", [])
    applications.append({
        "taskId": task_id,
        "idempotencyKey": key,
        "status": payload["status"],
        "producedAt": common.utc_now(),
        "appliedActions": payload.get("appliedActions", []),
    })


def _recovery_authorization_error(args, action: dict[str, Any]) -> str | None:
    role = getattr(args, "operator_role", "operator")
    required = _load_recovery_authorization().get(str(action.get("action")), "operator")
    if required == "admin" and role != "admin":
        return f"recovery action {action.get('action')} requires admin authorization"
    return None


def _recovery_selected_actions(actions: list[dict[str, Any]], args) -> list[dict[str, Any]]:
    selected = []
    for action in actions:
        if args.action and action.get("action") != args.action:
            continue
        if args.node_id and action.get("nodeId") != args.node_id:
            continue
        if args.worker_id and action.get("workerId") != args.worker_id:
            continue
        selected.append(action)
    if selected or not args.action:
        return selected
    if args.action in {
        "retry-node",
        "reimport-artifact",
        "rematerialize-artifact",
        "recover-node-lease",
        "cancel-subgraph",
    } and not args.node_id:
        raise common.TaskBundleError(f"{args.action} requires --node-id")
    if args.action == "retire-worker" and not args.worker_id:
        raise common.TaskBundleError("retire-worker requires --worker-id")
    return [_validate_recovery_action({
        "action": args.action,
        "status": "REQUESTED",
        "reason": args.reason or "operator requested recovery action",
        **({"nodeId": args.node_id} if args.node_id else {}),
        **({"workerId": args.worker_id} if args.worker_id else {}),
    })]


def _distributed_dependency_map(distributed: dict[str, Any]) -> dict[str, set[str]]:
    dependencies: dict[str, set[str]] = {}
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    for node_id, entry in nodes.items():
        if not isinstance(entry, dict):
            continue
        record = entry.get("record") if isinstance(entry.get("record"), dict) else {}
        deps = record.get("dependsOn") if isinstance(record.get("dependsOn"), list) else []
        dependencies[str(node_id)] = {str(dep) for dep in deps if isinstance(dep, str)}
    return dependencies


def _distributed_invalidation_closure(distributed: dict[str, Any], node_ids: set[str]) -> set[str]:
    invalidated = set(node_ids)
    dependencies = _distributed_dependency_map(distributed)
    changed = True
    while changed:
        changed = False
        for node_id, deps in dependencies.items():
            if node_id not in invalidated and deps & invalidated:
                invalidated.add(node_id)
                changed = True
    return invalidated


def _distributed_known_node_ids(distributed: dict[str, Any]) -> set[str]:
    known: set[str] = set()
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    known.update(str(node_id) for node_id in nodes if isinstance(node_id, str))
    for placement in distributed.get("placements", []) if isinstance(distributed.get("placements"), list) else []:
        if isinstance(placement, dict) and isinstance(placement.get("nodeId"), str):
            known.add(placement["nodeId"])
    return known


def _invalidate_distributed_nodes(distributed: dict[str, Any], node_ids: set[str]) -> list[str]:
    invalidated = _distributed_invalidation_closure(distributed, node_ids)
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    for node_id in invalidated:
        nodes.pop(node_id, None)
    distributed["nodes"] = nodes
    distributed["nodeDispatches"] = [
        item for item in distributed.get("nodeDispatches", [])
        if not (isinstance(item, dict) and item.get("nodeId") in invalidated)
    ]
    distributed["artifactStore"] = [
        item for item in distributed.get("artifactStore", [])
        if not (isinstance(item, dict) and item.get("nodeId") in invalidated)
    ]
    distributed["importedArtifacts"] = [
        item for item in distributed.get("importedArtifacts", [])
        if not (
            isinstance(item, dict)
            and (item.get("nodeId") in invalidated or item.get("sourceNodeId") in invalidated)
        )
    ]
    distributed["updatedAt"] = common.utc_now()
    return sorted(invalidated)


def _cancel_distributed_subgraph(distributed: dict[str, Any], node_ids: set[str]) -> list[str]:
    cancelled = _distributed_invalidation_closure(distributed, node_ids)
    if not cancelled:
        cancelled = node_ids
    existing = set(distributed.get("cancelledNodes", [])) if isinstance(distributed.get("cancelledNodes"), list) else set()
    distributed["cancelledNodes"] = sorted(existing | cancelled)
    _invalidate_distributed_nodes(distributed, cancelled)
    distributed["updatedAt"] = common.utc_now()
    return sorted(cancelled)


def _mark_distributed_resumable(state: dict[str, Any], task_id: str, record: dict[str, Any]) -> None:
    updated = _upsert_task_record(
        state, task_id, status="DISTRIBUTED_RUNNING", contractHash=record["contractHash"],
        selectedWorker="distributed", lastHeartbeatAt=common.utc_now())
    if updated is not None:
        updated.pop("terminalAt", None)


def _replace_materialized_artifacts(distributed: dict[str, Any], replacements: list[dict[str, Any]]) -> None:
    by_key = {
        (item.get("nodeId"), item.get("sha256")): item
        for item in replacements if isinstance(item, dict)
    }
    kept = [
        item for item in distributed.get("artifactStore", [])
        if not (isinstance(item, dict) and (item.get("nodeId"), item.get("sha256")) in by_key)
    ]
    distributed["artifactStore"] = [*kept, *replacements]
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    for node_id, entry in nodes.items():
        if not isinstance(entry, dict):
            continue
        current = entry.get("materialized") if isinstance(entry.get("materialized"), list) else []
        entry["materialized"] = [
            item for item in current
            if not (isinstance(item, dict) and (item.get("nodeId"), item.get("sha256")) in by_key)
        ] + [item for item in replacements if item.get("nodeId") == node_id]
        entry["updatedAt"] = common.utc_now()
    distributed["updatedAt"] = common.utc_now()


def _recover_materialize_artifact(pool: dict[str, Any], args, record: dict[str, Any],
                                  distributed: dict[str, Any], action: dict[str, Any],
                                  state: dict[str, Any]) -> dict[str, Any]:
    node_id = action.get("nodeId") or args.node_id
    digest = action.get("sha256")
    if not node_id:
        return {**action, "applyStatus": "BLOCKED", "reason": "rematerialize-artifact requires a nodeId"}
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    node_entry = nodes.get(node_id)
    if not isinstance(node_entry, dict) or not isinstance(node_entry.get("record"), dict):
        invalidated = _invalidate_distributed_nodes(distributed, {str(node_id)})
        _mark_distributed_resumable(state, args.task_id, record)
        _append_event(state, args.task_id, "recovery-action-applied",
                      action="rematerialize-artifact", nodeId=str(node_id),
                      status="REDISPATCH_REQUIRED")
        return {
            **action,
            "applyStatus": "APPLIED",
            "resumeRequired": True,
            "invalidatedNodes": invalidated,
            "reason": "node record unavailable; redispatch required",
        }
    worker_id = action.get("workerId")
    if not isinstance(worker_id, str):
        for artifact in distributed.get("artifactStore", []):
            if isinstance(artifact, dict) and artifact.get("nodeId") == node_id:
                worker_id = artifact.get("workerId")
                break
    if not isinstance(worker_id, str) or not worker_id:
        dispatch = node_entry.get("dispatch") if isinstance(node_entry.get("dispatch"), dict) else {}
        worker_id = dispatch.get("workerId")
    worker = _worker_by_id(pool, str(worker_id)) if isinstance(worker_id, str) else None
    if worker is None:
        invalidated = _invalidate_distributed_nodes(distributed, {str(node_id)})
        _mark_distributed_resumable(state, args.task_id, record)
        _append_event(state, args.task_id, "recovery-action-applied",
                      action="rematerialize-artifact", nodeId=str(node_id),
                      status="REDISPATCH_REQUIRED")
        return {
            **action,
            "applyStatus": "APPLIED",
            "resumeRequired": True,
            "invalidatedNodes": invalidated,
            "reason": "source worker unavailable; redispatch required",
        }
    store_root = Path(str(distributed.get("storeRoot") or _artifact_store_root(args)))
    materialized = _materialize_artifacts(worker, str(worker_id), args.task_id, node_entry["record"], store_root)
    if digest:
        materialized = [item for item in materialized if item.get("sha256") == digest]
    if materialized and all(item.get("status") == "MATERIALIZED" for item in materialized):
        _replace_materialized_artifacts(distributed, materialized)
        _append_event(state, args.task_id, "recovery-action-applied",
                      action="rematerialize-artifact", nodeId=str(node_id), status="MATERIALIZED")
        return {
            **action,
            "applyStatus": "APPLIED",
            "resumeRequired": False,
            "artifactsMaterialized": len(materialized),
        }
    invalidated = _invalidate_distributed_nodes(distributed, {str(node_id)})
    _mark_distributed_resumable(state, args.task_id, record)
    _append_event(state, args.task_id, "recovery-action-applied",
                  action="rematerialize-artifact", nodeId=str(node_id), status="REDISPATCH_REQUIRED")
    return {
        **action,
        "applyStatus": "APPLIED",
        "resumeRequired": True,
        "invalidatedNodes": invalidated,
        "reason": "artifact rematerialization failed; redispatch required",
    }


def _apply_recovery_action(pool: dict[str, Any], args, record: dict[str, Any],
                           action: dict[str, Any], state: dict[str, Any]) -> dict[str, Any]:
    action_name = str(action.get("action") or "")
    if action_name not in RECOVERY_ACTIONS:
        return {**action, "applyStatus": "BLOCKED", "reason": "recovery action is not supported"}
    authorization_error = _recovery_authorization_error(args, action)
    if authorization_error:
        return {**action, "applyStatus": "BLOCKED", "reason": authorization_error}
    if (
        record.get("status") == "CANCELLED"
        and action_name in RECOVERY_REOPEN_ACTIONS
        and not getattr(args, "force_cancelled", False)
    ):
        return {
            **action,
            "applyStatus": "BLOCKED",
            "reason": "cancelled workflow requires --force-cancelled before recovery can reopen it",
        }
    distributed = _distributed_record(record, args.task_id) if action_name in {
        "retry-node", "reimport-artifact", "rematerialize-artifact", "recover-node-lease", "cancel-subgraph"
    } else record.get("distributed")
    if action_name == "retry-node":
        node_id = action.get("nodeId") or args.node_id
        if not node_id or not isinstance(distributed, dict):
            return {**action, "applyStatus": "BLOCKED", "reason": "retry-node requires a distributed nodeId"}
        invalidated = _invalidate_distributed_nodes(distributed, {str(node_id)})
        _mark_distributed_resumable(state, args.task_id, record)
        _append_event(state, args.task_id, "recovery-action-applied",
                      action=action_name, nodeId=str(node_id), status="DISTRIBUTED_RUNNING")
        return {**action, "applyStatus": "APPLIED", "resumeRequired": True, "invalidatedNodes": invalidated}
    if action_name == "rematerialize-artifact":
        if not isinstance(distributed, dict):
            return {**action, "applyStatus": "BLOCKED", "reason": "rematerialize-artifact requires distributed state"}
        return _recover_materialize_artifact(pool, args, record, distributed, action, state)
    if action_name == "reimport-artifact":
        node_id = action.get("nodeId") or args.node_id
        if not node_id or not isinstance(distributed, dict):
            return {**action, "applyStatus": "BLOCKED", "reason": "reimport-artifact requires a distributed nodeId"}
        invalidated = _invalidate_distributed_nodes(distributed, {str(node_id)})
        _mark_distributed_resumable(state, args.task_id, record)
        _append_event(state, args.task_id, "recovery-action-applied",
                      action=action_name, nodeId=str(node_id), status="DISTRIBUTED_RUNNING")
        return {**action, "applyStatus": "APPLIED", "resumeRequired": True, "invalidatedNodes": invalidated}
    if action_name == "recover-node-lease":
        node_id = action.get("nodeId") or args.node_id
        if not node_id or not isinstance(distributed, dict):
            return {**action, "applyStatus": "BLOCKED", "reason": "recover-node-lease requires a distributed nodeId"}
        worker_id = action.get("workerId") or args.worker_id
        lease_id = action.get("leaseId")
        if isinstance(worker_id, str) and isinstance(lease_id, str):
            worker = _worker_by_id(pool, worker_id)
            if worker is not None:
                _invoke_worker(worker, ["worker-lease", args.task_id, "--release", "--lease-id", lease_id], timeout=30)
        invalidated = _invalidate_distributed_nodes(distributed, {str(node_id)})
        _mark_distributed_resumable(state, args.task_id, record)
        _append_event(state, args.task_id, "recovery-action-applied",
                      action=action_name, nodeId=str(node_id), status="DISTRIBUTED_RUNNING")
        return {**action, "applyStatus": "APPLIED", "resumeRequired": True, "invalidatedNodes": invalidated}
    if action_name == "cancel-subgraph":
        node_id = action.get("nodeId") or args.node_id
        if not node_id or not isinstance(distributed, dict):
            return {**action, "applyStatus": "BLOCKED", "reason": "cancel-subgraph requires a distributed nodeId"}
        cancelled = _cancel_distributed_subgraph(distributed, {str(node_id)})
        _mark_distributed_resumable(state, args.task_id, record)
        _append_event(state, args.task_id, "recovery-action-applied",
                      action=action_name, nodeId=str(node_id), status="SUBGRAPH_CANCELLED")
        return {**action, "applyStatus": "APPLIED", "resumeRequired": True, "cancelledNodes": cancelled}
    if action_name == "failover-lease":
        _upsert_task_record(
            state, args.task_id, status="LEASE_EXPIRED", contractHash=record["contractHash"],
            selectedWorker=record.get("selectedWorker", ""), lastHeartbeatAt=record.get("lastHeartbeatAt"))
        _append_event(state, args.task_id, "recovery-action-applied",
                      action=action_name, status="LEASE_EXPIRED")
        return {**action, "applyStatus": "APPLIED"}
    if action_name == "cancel-workflow":
        _upsert_task_record(
            state, args.task_id, status="CANCELLED", contractHash=record["contractHash"],
            selectedWorker=record.get("selectedWorker", ""), terminalAt=common.utc_now())
        _append_event(state, args.task_id, "recovery-action-applied",
                      action=action_name, status="CANCELLED")
        return {**action, "applyStatus": "APPLIED"}
    if action_name == "retire-worker":
        worker_id = action.get("workerId") or args.worker_id or record.get("selectedWorker")
        if not isinstance(worker_id, str) or not worker_id or worker_id == "distributed":
            return {**action, "applyStatus": "BLOCKED", "reason": "retire-worker requires a concrete workerId"}
        report = _deprovision_worker(
            pool, args, args.task_id, worker_id, state, reason=args.reason or action.get("reason") or "recovery retire")
        status = "APPLIED" if report.get("removedFromPool") else "BLOCKED"
        _append_event(state, args.task_id, "recovery-action-applied",
                      action=action_name, workerId=worker_id, status=report.get("status", status))
        return {**action, "applyStatus": status, "retirement": report}
    _upsert_task_record(
        state, args.task_id, status="INCONSISTENT", contractHash=record["contractHash"],
        selectedWorker=record.get("selectedWorker", ""), terminalAt=common.utc_now())
    _append_event(state, args.task_id, "recovery-action-applied",
                  action="mark-inconsistent", status="INCONSISTENT")
    return {**action, "applyStatus": "APPLIED"}


def _execute_recovery(pool: dict[str, Any], state: dict[str, Any], args) -> dict[str, Any]:
    record = _task_record(state, args.task_id)
    if record is None:
        return {
            **_broker_envelope(args.task_id),
            "status": "RECOVERY_BLOCKED",
            "reason": "broker state has no record for task",
            "actions": [],
            "appliedActions": [],
        }
    actions = _recover_actions(pool, record, stale_seconds=args.stale_seconds)
    applied_actions: list[dict[str, Any]] = []
    status = "RECOVERY_PLAN"
    if args.apply and (actions or args.action):
        selected_actions = _recovery_selected_actions(actions, args)
        idempotency_key = _recovery_scope_key(args, selected_actions)
        replay = _recovery_application_by_key(state, record, idempotency_key)
        if replay is not None:
            return {
                **_broker_envelope(args.task_id),
                "status": str(replay.get("status") or "RECOVERY_APPLIED"),
                "actions": actions,
                "appliedActions": replay.get("appliedActions", []),
                "task": _task_record(state, args.task_id),
                "idempotencyKey": idempotency_key,
                "idempotentReplay": True,
            }
        if not selected_actions:
            return {
                **_broker_envelope(args.task_id),
                "status": "RECOVERY_BLOCKED",
                "reason": "no recovery actions matched requested filters",
                "actions": actions,
                "appliedActions": [],
                "task": _task_record(state, args.task_id),
            }
        for action in selected_actions:
            applied_actions.append(_apply_recovery_action(pool, args, record, action, state))
        if any(item.get("applyStatus") == "APPLIED" for item in applied_actions):
            _append_event(state, args.task_id, "recover-applied",
                          actionCount=len(applied_actions), status="RECOVERY_APPLIED")
            _append_operator_audit(
                state,
                args.task_id,
                "recover",
                operator_role=getattr(args, "operator_role", "operator"),
                appliedActions=applied_actions,
            )
            status = "RECOVERY_APPLIED"
        else:
            _append_event(state, args.task_id, "recovery-action-blocked",
                          actionCount=len(applied_actions), status="RECOVERY_BLOCKED")
            status = "RECOVERY_BLOCKED"
        payload = {
            **_broker_envelope(args.task_id),
            "status": status,
            "actions": actions,
            "appliedActions": applied_actions,
            "task": _task_record(state, args.task_id),
            "idempotencyKey": idempotency_key,
            "idempotentReplay": False,
        }
        _record_recovery_application(state, args.task_id, idempotency_key, payload)
        return payload
    elif actions:
        _append_event(state, args.task_id, "recover-plan", actionCount=len(actions))
    return {
        **_broker_envelope(args.task_id),
        "status": status,
        "actions": actions,
        "appliedActions": applied_actions,
        "task": _task_record(state, args.task_id),
    }


def cmd_recover(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        if state is None:
            raise common.TaskBundleError("recover requires broker state")
        payload = _execute_recovery(pool, state, args)
        if payload["status"] in {"RECOVERY_PLAN", "RECOVERY_APPLIED", "RECOVERY_BLOCKED"}:
            _write_state(args.state, state)
        return _emit(payload, exit_code=EXIT_OK if payload["status"] != "RECOVERY_BLOCKED" else EXIT_PROTOCOL_ERROR)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _append_cli_option(argv: list[str], name: str, value: Any) -> None:
    if value is not None:
        argv.extend([name, str(value)])


def _recover_run_argv(args) -> list[str]:
    argv = [
        sys.executable,
        str(Path(__file__).resolve()),
        "run-distributed",
        args.task_id,
        "--pool",
        str(args.pool),
        "--state",
        str(args.state),
    ]
    _append_cli_option(argv, "--artifact-store", args.artifact_store)
    _append_cli_option(argv, "--artifact-store-kind", getattr(args, "artifact_store_kind", None))
    _append_cli_option(argv, "--ttl-seconds", args.ttl_seconds)
    _append_cli_option(argv, "--stale-seconds", args.stale_seconds)
    _append_cli_option(argv, "--node-retries", args.node_retries)
    _append_cli_option(argv, "--heartbeat-interval-seconds", args.heartbeat_interval_seconds)
    _append_cli_option(argv, "--lock-timeout-seconds", args.lock_timeout_seconds)
    _append_cli_option(argv, "--provision-timeout-seconds", args.provision_timeout_seconds)
    _append_cli_option(argv, "--deprovision-timeout-seconds", args.deprovision_timeout_seconds)
    if getattr(args, "lock_command", None):
        argv.extend(["--lock-command", *args.lock_command])
    for command in getattr(args, "provision_command", []) or []:
        argv.extend(["--provision-command", *command])
    _append_cli_option(argv, "--provisioner-registry", getattr(args, "provisioner_registry", None))
    if getattr(args, "deprovision_on_complete", False):
        argv.append("--deprovision-on-complete")
    if getattr(args, "provision_all", False):
        argv.append("--provision-all")
    if getattr(args, "mock", False):
        argv.append("--mock")
    if getattr(args, "force_cancelled", False):
        argv.append("--resume-cancelled")
    return argv


def cmd_recover_run(args) -> int:
    bundle_text = sys.stdin.read()
    try:
        pool = _load_pool(args.pool)
        state = _load_state(args.state)
        if state is None:
            raise common.TaskBundleError("recover-run requires broker state")
        args.apply = True
        recovery = _execute_recovery(pool, state, args)
        if recovery["status"] != "RECOVERY_APPLIED":
            _write_state(args.state, state)
            return _emit({
                **_broker_envelope(args.task_id),
                "status": "RECOVERY_RUN_BLOCKED",
                "recovery": recovery,
                "run": {},
                "reason": recovery.get("reason", "recovery did not apply"),
            }, exit_code=EXIT_PROTOCOL_ERROR)
        record = _task_record(state, args.task_id)
        recovery_key = recovery.get("idempotencyKey")
        if record is not None and isinstance(recovery_key, str) and recovery_key:
            distributed = _distributed_record(record, args.task_id)
            if distributed is not None:
                distributed["pendingRecoveryIdempotencyKey"] = recovery_key
        _write_state(args.state, state)
        result = subprocess.run(
            _recover_run_argv(args),
            input=bundle_text,
            capture_output=True,
            text=True,
            timeout=max(120, int(args.provision_timeout_seconds) + 3600),
        )
        run_payload = _parse_json(result.stdout) or _parse_json(result.stderr)
        status = "RECOVERY_RUN_COMPLETE" if result.returncode == 0 else "RECOVERY_RUN_FAILED"
        return _emit({
            **_broker_envelope(args.task_id),
            "status": status,
            "recovery": recovery,
            "run": run_payload,
            **({"reason": run_payload.get("reason", "distributed recovery run failed")} if result.returncode != 0 else {}),
        }, exit_code=EXIT_OK if result.returncode == 0 else EXIT_PROTOCOL_ERROR)
    except (subprocess.SubprocessError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _artifact_audit_findings(state: dict[str, Any], task_id: str, artifact_store: Path) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    record = _task_record(state, task_id)
    if record is None:
        return [{"severity": "error", "kind": "state", "reason": "broker state has no record for task"}]
    distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
    referenced_paths: set[Path] = set()
    for artifact in distributed.get("artifactStore", []) if isinstance(distributed.get("artifactStore"), list) else []:
        if not isinstance(artifact, dict):
            continue
        path = Path(str(artifact.get("contentAddressedPath", "")))
        referenced_paths.add(path.resolve())
        if artifact.get("status") != "MATERIALIZED":
            findings.append({
                "severity": "warning",
                "kind": "materialized-artifact",
                "nodeId": artifact.get("nodeId", ""),
                "path": str(path),
                "reason": str(artifact.get("reason") or "artifact is not materialized"),
            })
            continue
        if not path.is_file():
            findings.append({
                "severity": "error",
                "kind": "materialized-artifact",
                "nodeId": artifact.get("nodeId", ""),
                "sha256": artifact.get("sha256", ""),
                "path": str(path),
                "reason": "materialized artifact file is absent",
            })
        elif artifact.get("sha256") != common.sha256_file(path):
            findings.append({
                "severity": "error",
                "kind": "materialized-artifact",
                "nodeId": artifact.get("nodeId", ""),
                "sha256": artifact.get("sha256", ""),
                "path": str(path),
                "reason": "materialized artifact sha256 differs from disk",
            })
    task_dir = artifact_store / "_broker" / task_id
    broker_artifact_schemas = {
        "workflow-dag": "canonical/workflow-dag-v1.json",
        "workflow-admission": "canonical/broker-workflow-admission-compact-v1.json",
        "workflow": "canonical/workflow-result-v1.json",
        "evidence-manifest": "canonical/evidence-manifest-v1.json",
        "evidence-graph": "canonical/evidence-graph-v1.json",
        "redaction-report": "canonical/redaction-report-v1.json",
        "attempt-replay": "canonical/distributed-replay-report-v1.json",
        "artifact-provenance": "canonical/artifact-provenance-chain-v1.json",
        "acceptance-manifest": "canonical/acceptance-manifest-v1.json",
        "handoff-package": "canonical/handoff-package-v1.json",
        "integrity-ledger": "canonical/artifact-integrity-ledger-v1.json",
    }
    for name, schema_name in broker_artifact_schemas.items():
        path = task_dir / f"{name}.json"
        if not path.exists():
            findings.append({
                "severity": "error" if name == "handoff-package" else "warning",
                "kind": "broker-artifact",
                "path": str(path),
                "reason": f"{name} artifact is absent",
            })
        else:
            referenced_paths.add(path.resolve())
            try:
                payload = json.loads(path.read_text())
            except (OSError, json.JSONDecodeError) as exc:
                findings.append({
                    "severity": "error",
                    "kind": "broker-artifact",
                    "path": str(path),
                    "reason": str(exc),
                })
                continue
            try:
                common.validate_with_schema(
                    payload,
                    schema_name,
                    f"broker artifact {name}",
                    validation_point="broker-artifact-audit",
                    artifact_kind=name,
                    task_id=task_id,
                )
            except common.SchemaValidationError as exc:
                findings.append({
                    "severity": "error",
                    "kind": "broker-artifact",
                    "path": str(path),
                    "reason": exc.report.get("reason", "schema validation failed"),
                })
            if name == "handoff-package" and isinstance(distributed.get("handoffSha256"), str):
                actual = common.sha256_file(path)
                if actual != distributed["handoffSha256"]:
                    findings.append({
                        "severity": "error",
                        "kind": "broker-artifact",
                        "path": str(path),
                        "sha256": actual,
                        "reason": "handoff artifact sha256 differs from broker state",
                    })
    if artifact_store.exists():
        for path in sorted(artifact_store.rglob("*")):
            if path.is_file() and path.resolve() not in referenced_paths and task_id in path.parts:
                findings.append({
                    "severity": "info",
                    "kind": "orphan-artifact",
                    "path": str(path),
                    "reason": "artifact file is not referenced by current broker state",
                })
    return findings


def _repair_actions_from_findings(findings: list[dict[str, Any]]) -> list[dict[str, Any]]:
    actions: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()
    for finding in findings:
        if finding.get("kind") != "materialized-artifact" or finding.get("severity") != "error":
            continue
        node_id = finding.get("nodeId")
        if not isinstance(node_id, str) or not node_id:
            continue
        key = ("rematerialize-artifact", node_id)
        if key in seen:
            continue
        seen.add(key)
        action = {
            "action": "rematerialize-artifact",
            "status": "RECOVERABLE",
            "nodeId": node_id,
            "reason": str(finding.get("reason") or "artifact audit repair"),
            **({"sha256": finding["sha256"]} if isinstance(finding.get("sha256"), str) and finding.get("sha256") else {}),
        }
        actions.append(_validate_recovery_action(action))
    return actions


def cmd_artifact_audit(args) -> int:
    try:
        state = _load_state(args.state)
        if state is None:
            raise common.TaskBundleError("artifact-audit requires broker state")
        findings = _artifact_audit_findings(state, args.task_id, args.artifact_store)
        summary = {
            "errors": sum(1 for item in findings if item.get("severity") == "error"),
            "warnings": sum(1 for item in findings if item.get("severity") == "warning"),
            "info": sum(1 for item in findings if item.get("severity") == "info"),
        }
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "ARTIFACT_AUDIT_COMPLETE",
            "artifactStore": str(args.artifact_store),
            "summary": summary,
            "findings": findings,
            "repairActions": _repair_actions_from_findings(findings) if getattr(args, "repair", False) else [],
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _distributed_counts(distributed: dict[str, Any]) -> dict[str, int]:
    nodes = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    dispatches = distributed.get("nodeDispatches") if isinstance(distributed.get("nodeDispatches"), list) else []
    artifacts = distributed.get("artifactStore") if isinstance(distributed.get("artifactStore"), list) else []
    imports = distributed.get("importedArtifacts") if isinstance(distributed.get("importedArtifacts"), list) else []
    return {
        "nodes": len(nodes),
        "dispatches": len(dispatches),
        "materializedArtifacts": len(artifacts),
        "importedArtifacts": len(imports),
    }


def _workflow_query_summary(task_id: str, record: dict[str, Any]) -> dict[str, Any]:
    distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
    acceptance = distributed.get("acceptanceManifest") if isinstance(distributed.get("acceptanceManifest"), dict) else {}
    replay = distributed.get("replayReport") if isinstance(distributed.get("replayReport"), dict) else {}
    dag = distributed.get("workflowDag") if isinstance(distributed.get("workflowDag"), dict) else {}
    return {
        "taskId": task_id,
        "status": record.get("status"),
        "contractHash": record.get("contractHash"),
        "selectedWorker": record.get("selectedWorker"),
        "workflowId": distributed.get("workflowId"),
        "workflowRunId": record.get("workflowRunId") or dag.get("workflowRunId"),
        "updatedAt": record.get("updatedAt"),
        "terminalAt": record.get("terminalAt"),
        "counts": _distributed_counts(distributed),
        "freshNodes": replay.get("freshNodes", []),
        "reusedNodes": replay.get("reusedNodes", []),
        "cancelledNodes": distributed.get("cancelledNodes", []),
        "acceptanceDecision": acceptance.get("decision"),
        "handoffSha256": distributed.get("handoffSha256"),
        "storeRoot": distributed.get("storeRoot"),
        "artifactStoreAdapter": distributed.get("artifactStoreAdapter"),
        "compacted": isinstance(distributed.get("compactionSummary"), dict),
    }


def _query_events(state: dict[str, Any], task_id: str | None = None) -> list[dict[str, Any]]:
    events = [
        item for item in state.get("events", [])
        if isinstance(item, dict) and (task_id is None or item.get("taskId") == task_id)
    ]
    return sorted(events, key=lambda item: str(item.get("producedAt", "")))


def cmd_state_location(args) -> int:
    path = args.state or CANONICAL_BROKER_STATE_PATH
    state = _load_state(path) if path.exists() else _empty_state()
    return _emit({
        "schemaVersion": 1,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker",
        **_schema_registry_hash_field(),
        "status": "STATE_LOCATION",
        "path": str(path),
        "exists": path.exists(),
        "taskCount": len(state.get("tasks", {})) if isinstance(state, dict) else 0,
    })


def cmd_workflow_status(args) -> int:
    try:
        state = _load_query_state(args.state)
        records = state.get("tasks", {}) if isinstance(state.get("tasks"), dict) else {}
        if args.task_id:
            record = records.get(args.task_id)
            workflows = [_workflow_query_summary(args.task_id, record)] if isinstance(record, dict) else []
        else:
            workflows = [
                _workflow_query_summary(task_id, record)
                for task_id, record in sorted(records.items())
                if isinstance(record, dict)
            ]
        limit = max(1, args.limit)
        workflows = workflows[-limit:]
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "WORKFLOW_STATUS",
            "statePath": str(args.state or CANONICAL_BROKER_STATE_PATH),
            "workflows": workflows,
            **({"taskId": args.task_id} if args.task_id else {}),
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_workflow_history(args) -> int:
    try:
        state = _load_query_state(args.state)
        record = _task_record(state, args.task_id)
        distributed = record.get("distributed") if isinstance(record, dict) and isinstance(record.get("distributed"), dict) else {}
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "WORKFLOW_HISTORY",
            "taskId": args.task_id,
            "statePath": str(args.state or CANONICAL_BROKER_STATE_PATH),
            "summary": _workflow_query_summary(args.task_id, record) if isinstance(record, dict) else {},
            "events": _query_events(state, args.task_id)[-max(1, args.limit):],
            "attemptLedger": (
                distributed.get("attemptLedger", [])[-max(1, args.limit):]
                if isinstance(distributed.get("attemptLedger"), list) else []
            ),
            "nodeDispatches": (
                distributed.get("nodeDispatches", [])[-max(1, args.limit):]
                if isinstance(distributed.get("nodeDispatches"), list) else []
            ),
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _narrative_artifact_ref(kind: str, path: Any = None, sha256: Any = None) -> dict[str, Any]:
    ref = {"kind": str(kind or "artifact")}
    if isinstance(path, str) and path:
        ref["path"] = path
    if isinstance(sha256, str) and SHA256_RE.fullmatch(sha256):
        ref["sha256"] = sha256
    return ref


def _narrative_event(events: list[dict[str, Any]], *, at: str | None, actor_kind: str, actor_id: str,
                     action: str, target: str, human_text: str, **fields: Any) -> None:
    event = {
        "sequence": len(events) + 1,
        "at": at or common.utc_now(),
        "actor": {"kind": actor_kind, "id": actor_id},
        "action": action,
        "target": target,
        "humanText": human_text,
    }
    for key, value in fields.items():
        if value not in (None, "", [], {}):
            event[key] = value
    events.append(event)


def _job_narrative(state: dict[str, Any], task_id: str) -> dict[str, Any]:
    record = _task_record(state, task_id)
    if record is None:
        raise common.TaskBundleError(f"broker state has no record for {task_id}")
    distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
    dag = distributed.get("workflowDag") if isinstance(distributed.get("workflowDag"), dict) else {}
    workflow_id = str(distributed.get("workflowId") or dag.get("workflowId") or task_id)
    workflow_run_id = str(record.get("workflowRunId") or dag.get("workflowRunId") or "wr-unknown")
    events: list[dict[str, Any]] = []
    stored_events = distributed.get("narrativeEvents") if isinstance(distributed.get("narrativeEvents"), list) else []
    for stored in stored_events:
        if not isinstance(stored, dict):
            continue
        event = {**stored, "sequence": len(events) + 1}
        events.append(event)
    if events:
        narrative = {
            "schemaVersion": 1,
            "taskId": task_id,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker job narrative",
            "workflowId": workflow_id,
            "workflowRunId": workflow_run_id,
            "status": str(record.get("status") or "UNKNOWN"),
            "summary": f"{task_id}: {len(events)} live recorded steps, status {record.get('status') or 'UNKNOWN'}.",
            "events": events,
            "plainText": "\n".join(f"{event['sequence']}. {event['humanText']}" for event in events),
        }
        _require_schema(narrative, "canonical/job-narrative-v1.json", "job narrative")
        return narrative
    _narrative_event(
        events,
        at=record.get("startedAt") or record.get("updatedAt"),
        actor_kind="control-plain",
        actor_id="present-lease-broker",
        action="admit-workflow",
        target=task_id,
        human_text=f"The control plain admitted workflow {workflow_id} for task {task_id}.",
    )
    for placement in distributed.get("placements", []) if isinstance(distributed.get("placements"), list) else []:
        if not isinstance(placement, dict):
            continue
        node_id = str(placement.get("nodeId") or "")
        worker_id = str(placement.get("workerId") or "")
        _narrative_event(
            events,
            at=record.get("updatedAt"),
            actor_kind="control-plain",
            actor_id="present-lease-broker",
            action="place-node",
            target=node_id or "workflow-node",
            workerId=worker_id,
            nodeId=node_id,
            human_text=f"The control plain placed node {node_id} on worker {worker_id}.",
        )
    for dispatch in distributed.get("nodeDispatches", []) if isinstance(distributed.get("nodeDispatches"), list) else []:
        if not isinstance(dispatch, dict):
            continue
        node_id = str(dispatch.get("nodeId") or "")
        worker_id = str(dispatch.get("workerId") or "")
        status = str(dispatch.get("status") or "UNKNOWN")
        _narrative_event(
            events,
            at=dispatch.get("startedAt") or record.get("updatedAt"),
            actor_kind="worker",
            actor_id=worker_id or "worker",
            action="run-node",
            target=node_id or "workflow-node",
            workerId=worker_id,
            nodeId=node_id,
            human_text=f"Worker {worker_id} ran node {node_id} and reported {status}.",
        )
    for imported in distributed.get("importedArtifacts", []) if isinstance(distributed.get("importedArtifacts"), list) else []:
        if not isinstance(imported, dict):
            continue
        node_id = str(imported.get("nodeId") or "")
        worker_id = str(imported.get("workerId") or "")
        source = str(imported.get("sourceNodeId") or "")
        _narrative_event(
            events,
            at=record.get("updatedAt"),
            actor_kind="control-plain",
            actor_id="present-lease-broker",
            action="import-artifact",
            target=node_id or "workflow-node",
            workerId=worker_id,
            nodeId=node_id,
            artifactRefs=[_narrative_artifact_ref(str(imported.get("kind") or "artifact"), imported.get("path"), imported.get("sha256"))],
            human_text=f"The control plain imported {imported.get('kind', 'artifact')} from node {source} into node {node_id} on worker {worker_id}.",
        )
    for artifact in distributed.get("artifactStore", []) if isinstance(distributed.get("artifactStore"), list) else []:
        if not isinstance(artifact, dict):
            continue
        node_id = str(artifact.get("nodeId") or "")
        worker_id = str(artifact.get("workerId") or "")
        _narrative_event(
            events,
            at=record.get("updatedAt"),
            actor_kind="control-plain",
            actor_id="present-lease-broker",
            action="materialize-artifact",
            target=node_id or "workflow-node",
            workerId=worker_id,
            nodeId=node_id,
            artifactRefs=[
                _narrative_artifact_ref(
                    str(artifact.get("kind") or "artifact"),
                    artifact.get("contentAddressedPath"),
                    artifact.get("sha256"),
                )
            ],
            human_text=f"The control plain materialized {artifact.get('kind', 'artifact')} evidence from node {node_id} into the artifact store.",
        )
    for checkpoint in distributed.get("contextCheckpoints", []) if isinstance(distributed.get("contextCheckpoints"), list) else []:
        if not isinstance(checkpoint, dict):
            continue
        node_id = str(checkpoint.get("nodeId") or "")
        worker_id = str(checkpoint.get("workerId") or "")
        _narrative_event(
            events,
            at=record.get("updatedAt"),
            actor_kind="worker",
            actor_id=worker_id or "worker",
            action="write-context-checkpoint",
            target=node_id or "workflow-node",
            workerId=worker_id,
            nodeId=node_id,
            artifactRefs=[_narrative_artifact_ref("context-checkpoint", checkpoint.get("path"), checkpoint.get("sha256"))],
            human_text=f"Worker {worker_id} wrote a context checkpoint for node {node_id}.",
        )
    acceptance = distributed.get("acceptanceManifest") if isinstance(distributed.get("acceptanceManifest"), dict) else {}
    if acceptance:
        decision = str(acceptance.get("decision") or "UNKNOWN")
        _narrative_event(
            events,
            at=record.get("terminalAt") or record.get("updatedAt"),
            actor_kind="verifier",
            actor_id="deterministic-acceptance",
            action="decide-acceptance",
            target=task_id,
            evidenceRefs=acceptance.get("acceptedEvidence", []) if isinstance(acceptance.get("acceptedEvidence"), list) else [],
            human_text=f"Deterministic acceptance finished with decision {decision}: {acceptance.get('reason', 'no reason recorded')}.",
        )
    if not events:
        _narrative_event(
            events,
            at=common.utc_now(),
            actor_kind="control-plain",
            actor_id="present-lease-broker",
            action="inspect-state",
            target=task_id,
            human_text=f"The control plain found a broker record for {task_id}, but no workflow events are available yet.",
        )
    plain_lines = [f"{event['sequence']}. {event['humanText']}" for event in events]
    narrative = {
        "schemaVersion": 1,
        "taskId": task_id,
        "producedAt": common.utc_now(),
        "producer": "present-lease-broker job narrative",
        "workflowId": workflow_id,
        "workflowRunId": workflow_run_id,
        "status": str(record.get("status") or "UNKNOWN"),
        "summary": f"{task_id}: {len(events)} recorded steps, status {record.get('status') or 'UNKNOWN'}.",
        "events": events,
        "plainText": "\n".join(plain_lines),
    }
    _require_schema(narrative, "canonical/job-narrative-v1.json", "job narrative")
    return narrative


def cmd_job_narrative(args) -> int:
    try:
        state = _load_query_state(args.state)
        narrative = _job_narrative(state, args.task_id)
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "JOB_NARRATIVE",
            "taskId": args.task_id,
            "narrative": narrative,
            "plainText": narrative["plainText"],
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_evidence_query(args) -> int:
    try:
        state = _load_query_state(args.state)
        distributed = _task_distributed(state, args.task_id)
        store_root = args.artifact_store or Path(str(distributed.get("storeRoot") or _artifact_store_root(args)))
        task_dir = store_root / "_broker" / args.task_id
        artifacts = {}
        for name in ("evidence-graph", "evidence-manifest", "acceptance-manifest", "artifact-provenance", "integrity-ledger"):
            path = task_dir / f"{name}.json"
            if path.exists():
                artifacts[name] = json.loads(path.read_text())
        manifest = artifacts.get("evidence-manifest", {})
        graph = artifacts.get("evidence-graph", {})
        acceptance = artifacts.get("acceptance-manifest", {})
        evidence_items = manifest.get("artifacts", []) if isinstance(manifest.get("artifacts"), list) else []
        filtered = []
        for item in evidence_items:
            if not isinstance(item, dict):
                continue
            if args.node_id and item.get("nodeId") != args.node_id:
                continue
            if args.evidence_role and item.get("evidenceRole") != args.evidence_role:
                continue
            if args.worker_id:
                provenance = artifacts.get("artifact-provenance", {})
                artifact_workers = {
                    artifact.get("nodeId"): artifact.get("workerId")
                    for artifact in provenance.get("artifacts", [])
                    if isinstance(artifact, dict)
                } if isinstance(provenance.get("artifacts"), list) else {}
                if artifact_workers.get(item.get("nodeId")) != args.worker_id:
                    continue
            if args.gate_eligible is not None and item.get("gateEligible") is not args.gate_eligible:
                continue
            filtered.append(item)
        if args.decision and str(acceptance.get("decision") or graph.get("gateDecision")) != args.decision:
            filtered = []
        summary = {
            "evidenceCount": len(manifest.get("artifacts", [])) if isinstance(manifest.get("artifacts"), list) else 0,
            "filteredEvidenceCount": len(filtered),
            "gateEligible": bool(manifest.get("gateEligible")),
            "containsMock": bool(manifest.get("containsMock")),
            "gateDecision": graph.get("gateDecision") or acceptance.get("decision"),
            "redactionStatus": graph.get("redactionStatus"),
            "policyDecision": acceptance.get("decision"),
            "policyReason": acceptance.get("reason"),
        }
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "EVIDENCE_QUERY",
            "taskId": args.task_id,
            "artifactStore": str(store_root),
            "evidenceSummary": summary,
            "filteredEvidence": filtered,
            "policyChecks": acceptance.get("policyChecks", []),
            "remediation": acceptance.get("remediation", []),
            "artifacts": artifacts,
        })
    except (OSError, json.JSONDecodeError, common.TaskBundleError) as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_worker_status(args) -> int:
    try:
        pool = _load_pool(args.pool)
        state = _load_query_state(args.state)
        active = _active_leases_by_worker(state)
        workers = []
        for worker in pool.get("workers", []):
            if not isinstance(worker, dict):
                continue
            status = worker.get("status") if isinstance(worker.get("status"), dict) else {}
            detail = status.get("detail") if isinstance(status.get("detail"), dict) else {}
            identity = detail.get("workerIdentity") if isinstance(detail.get("workerIdentity"), dict) else {}
            worker_id = str(worker.get("id") or identity.get("id") or "<unknown>")
            quarantine = worker.get("quarantine") if isinstance(worker.get("quarantine"), dict) else {}
            workers.append({
                "workerId": worker_id,
                "transport": _worker_transport_kind(worker),
                "kind": identity.get("kind"),
                "trustLevel": identity.get("trustLevel"),
                "protocolVersion": detail.get("protocolVersion"),
                "activeLeases": active.get(worker_id, 0),
                "lastSeenAt": worker.get("lastSeenAt") or status.get("producedAt"),
                "health": worker.get("health", {}),
                "quarantine": quarantine,
                "attested": not bool(_attestation_mismatch(worker, status)) if status else False,
                "capabilities": sorted(
                    key for key, value in (
                        detail.get("capabilityRegistry", {}) if isinstance(detail.get("capabilityRegistry"), dict) else {}
                    ).items()
                    if isinstance(value, dict) and value.get("available") is True
                ),
            })
        if args.worker_id:
            workers = [worker for worker in workers if worker.get("workerId") == args.worker_id]
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "WORKER_STATUS",
            "workers": workers,
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


