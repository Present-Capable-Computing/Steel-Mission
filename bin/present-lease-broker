        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def cmd_acceptance_status(args) -> int:
    try:
        state = _load_query_state(args.state)
        record = _task_record(state, args.task_id)
        if record is None:
            raise common.TaskBundleError(f"broker state has no record for {args.task_id}")
        distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
        store_root = args.artifact_store or Path(str(distributed.get("storeRoot") or _artifact_store_root(args)))
        findings = _artifact_audit_findings(state, args.task_id, store_root)
        acceptance = distributed.get("acceptanceManifest") if isinstance(distributed.get("acceptanceManifest"), dict) else {}
        redaction_status = "UNKNOWN"
        redaction_path = store_root / "_broker" / args.task_id / "redaction-report.json"
        if redaction_path.exists():
            try:
                redaction = json.loads(redaction_path.read_text())
                redaction_status = str(redaction.get("status") or redaction_status)
            except (OSError, json.JSONDecodeError):
                redaction_status = "UNREADABLE"
        summary = {
            "errors": sum(1 for item in findings if item.get("severity") == "error"),
            "warnings": sum(1 for item in findings if item.get("severity") == "warning"),
            "info": sum(1 for item in findings if item.get("severity") == "info"),
        }
        ready = bool(acceptance) and summary["errors"] == 0 and redaction_status in {"CLEAN", "UNKNOWN"}
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "ACCEPTANCE_STATUS",
            "taskId": args.task_id,
            "ready": ready,
            "decision": acceptance.get("decision"),
            "reason": acceptance.get("reason"),
            "redactionStatus": redaction_status,
            "artifactStore": str(store_root),
            "summary": summary,
            "findings": findings,
            "acceptedEvidence": acceptance.get("acceptedEvidence", []),
            "policyChecks": acceptance.get("policyChecks", []),
            "remediation": acceptance.get("remediation", []),
            "acceptancePolicy": acceptance.get("acceptancePolicy", {}),
        }, exit_code=EXIT_OK if ready or not args.require_ready else EXIT_PROTOCOL_ERROR)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _task_distributed(state: dict[str, Any], task_id: str) -> dict[str, Any]:
    record = _task_record(state, task_id)
    if record is None:
        raise common.TaskBundleError(f"broker state has no record for {task_id}")
    distributed = record.get("distributed")
    if not isinstance(distributed, dict):
        raise common.TaskBundleError(f"broker state has no distributed record for {task_id}")
    return distributed


def _workflow_dag_view(state: dict[str, Any], task_id: str) -> dict[str, Any]:
    distributed = _task_distributed(state, task_id)
    dag = distributed.get("workflowDag") if isinstance(distributed.get("workflowDag"), dict) else {}
    nodes_by_id = distributed.get("nodes") if isinstance(distributed.get("nodes"), dict) else {}
    dispatch_by_node = {
        item.get("nodeId"): item
        for item in distributed.get("nodeDispatches", [])
        if isinstance(item, dict) and isinstance(item.get("nodeId"), str)
    }
    artifacts_by_node: dict[str, int] = {}
    for artifact in distributed.get("artifactStore", []) if isinstance(distributed.get("artifactStore"), list) else []:
        if isinstance(artifact, dict) and isinstance(artifact.get("nodeId"), str):
            artifacts_by_node[artifact["nodeId"]] = artifacts_by_node.get(artifact["nodeId"], 0) + 1
    nodes = []
    for item in dag.get("nodes", []) if isinstance(dag.get("nodes"), list) else []:
        if not isinstance(item, dict):
            continue
        node_id = item.get("nodeId")
        node_record = nodes_by_id.get(node_id) if isinstance(node_id, str) else {}
        dispatch = dispatch_by_node.get(node_id) if isinstance(node_id, str) else {}
        nodes.append({
            **item,
            "status": node_record.get("status") or dispatch.get("status") or "UNKNOWN",
            "workerId": item.get("workerId") or dispatch.get("workerId"),
            "artifactCount": artifacts_by_node.get(str(node_id), 0),
            "attempts": dispatch.get("attempts", 0),
        })
    return {
        "workflowId": distributed.get("workflowId") or dag.get("workflowId"),
        "workflowRunId": dag.get("workflowRunId"),
        "contractHash": distributed.get("contractHash"),
        "maxParallel": dag.get("maxParallel"),
        "nodes": nodes,
        "edges": dag.get("edges", []) if isinstance(dag.get("edges"), list) else [],
    }


def cmd_workflow_dag(args) -> int:
    try:
        state = _load_query_state(args.state)
        return _emit({
            "schemaVersion": 1,
            "producedAt": common.utc_now(),
            "producer": "present-lease-broker",
            **_schema_registry_hash_field(),
            "status": "WORKFLOW_DAG",
            "taskId": args.task_id,
            "dag": _workflow_dag_view(state, args.task_id),
        })
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


def _acceptance_policy_evaluation(state: dict[str, Any], task_id: str, artifact_store: Path) -> dict[str, Any]:
    record = _task_record(state, task_id)
    if record is None:
        raise common.TaskBundleError(f"broker state has no record for {task_id}")
    distributed = record.get("distributed") if isinstance(record.get("distributed"), dict) else {}
    findings = _artifact_audit_findings(state, task_id, artifact_store)
    acceptance = distributed.get("acceptanceManifest") if isinstance(distributed.get("acceptanceManifest"), dict) else {}
    if not acceptance:
        manifest_path = artifact_store / "_broker" / task_id / "acceptance-manifest.json"
        if manifest_path.exists():
            try:
                acceptance = json.loads(manifest_path.read_text())
            except (OSError, json.JSONDecodeError):
                acceptance = {}
    redaction_path = artifact_store / "_broker" / task_id / "redaction-report.json"
    redaction = {}
    if redaction_path.exists():
        try:
            redaction = json.loads(redaction_path.read_text())
        except (OSError, json.JSONDecodeError):
            redaction = {"status": "UNREADABLE", "exportable": False}
    errors = [item for item in findings if item.get("severity") == "error"]
    if isinstance(acceptance.get("policyChecks"), list):
        policy_checks = [dict(check) for check in acceptance["policyChecks"] if isinstance(check, dict)]
        for check in policy_checks:
            if check.get("id") == "artifact-integrity" and errors:
                check["status"] = "FAIL"
                check["detail"] = f"{len(errors)} blocking artifact findings"
                check["remediation"] = "repair or rematerialize corrupt or missing artifacts"
            if check.get("id") == "redaction-clean" and redaction.get("status") not in {"CLEAN", None}:
                check["status"] = "FAIL"
                check["detail"] = str(redaction.get("status") or "UNKNOWN")
                check["remediation"] = "redact secrets or remove blocked artifacts and rerun acceptance"
    else:
        policy_checks = [
            {
                "id": "artifact-integrity",
                "status": "PASS" if not errors else "FAIL",
                "detail": f"{len(errors)} blocking artifact findings",
            },
            {
                "id": "redaction-clean",
                "status": "PASS" if redaction.get("status") in {"CLEAN", None} else "FAIL",
                "detail": str(redaction.get("status") or "UNKNOWN"),
            },
            {
                "id": "deterministic-acceptance",
                "status": "PASS" if acceptance.get("decision") == "PASS" else "INCONCLUSIVE",
                "detail": str(acceptance.get("reason") or "no PASS decision"),
            },
        ]
    decision = _acceptance_policy_decision(policy_checks)
    remediation = _acceptance_policy_remediation(policy_checks) or acceptance.get("remediation", [])
    return {
        "decision": decision,
        "checks": policy_checks,
        "acceptanceManifest": acceptance,
        "artifactFindings": findings,
        "redactionStatus": redaction.get("status", "UNKNOWN"),
        "remediation": remediation,
        "acceptancePolicy": acceptance.get("acceptancePolicy", {}),
    }


def cmd_acceptance_gate(args) -> int:
    try:
        state = _load_query_state(args.state)
        distributed = _task_distributed(state, args.task_id)
        store_root = args.artifact_store or Path(str(distributed.get("storeRoot") or _artifact_store_root(args)))
        evaluation = _acceptance_policy_evaluation(state, args.task_id, store_root)
        blocked = args.require_pass and evaluation["decision"] != "PASS"
        return _emit({
            **_broker_envelope(args.task_id),
            "status": "ACCEPTANCE_GATE",
            "artifactStore": str(store_root),
            **evaluation,
        }, exit_code=EXIT_PROTOCOL_ERROR if blocked else EXIT_OK)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))


