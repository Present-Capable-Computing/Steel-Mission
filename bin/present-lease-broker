def main() -> int:
    args = build_parser().parse_args()
    try:
        if hasattr(args, "task_id") and args.task_id is not None and not TASK_ID_RE.fullmatch(args.task_id):
            raise common.TaskBundleError("task id must match DEV-NNNNNN")
        if hasattr(args, "lease_id") and not LEASE_ID_RE.fullmatch(args.lease_id):
            raise common.TaskBundleError("lease id must match wl-<24 hex chars>")
        if hasattr(args, "ttl_seconds") and not 30 <= args.ttl_seconds <= 86400:
            raise common.TaskBundleError("lease ttl must be 30..86400 seconds")
        if hasattr(args, "stale_seconds") and args.stale_seconds < 0:
            raise common.TaskBundleError("stale seconds must be non-negative")
        if hasattr(args, "node_retries") and not 0 <= args.node_retries <= 8:
            raise common.TaskBundleError("node retries must be 0..8")
        if hasattr(args, "heartbeat_interval_seconds") and not 0 <= args.heartbeat_interval_seconds <= 86400:
            raise common.TaskBundleError("heartbeat interval must be 0..86400 seconds")
        if hasattr(args, "lock_timeout_seconds") and not 1 <= args.lock_timeout_seconds <= 86400:
            raise common.TaskBundleError("lock timeout must be 1..86400 seconds")
        if hasattr(args, "provision_timeout_seconds") and not 1 <= args.provision_timeout_seconds <= 86400:
            raise common.TaskBundleError("provision timeout must be 1..86400 seconds")
        if hasattr(args, "deprovision_timeout_seconds") and not 1 <= args.deprovision_timeout_seconds <= 86400:
            raise common.TaskBundleError("deprovision timeout must be 1..86400 seconds")
        if hasattr(args, "older_than_seconds") and args.older_than_seconds < 0:
            raise common.TaskBundleError("older-than seconds must be non-negative")
        if hasattr(args, "limit") and args.limit < 1:
            raise common.TaskBundleError("limit must be positive")
        if hasattr(args, "iterations") and not 1 <= args.iterations <= 1024:
            raise common.TaskBundleError("iterations must be 1..1024")
        if hasattr(args, "interval_seconds") and args.interval_seconds < 0:
            raise common.TaskBundleError("interval seconds must be non-negative")
        if hasattr(args, "timeout_seconds") and not 1 <= args.timeout_seconds <= 86400:
            raise common.TaskBundleError("timeout seconds must be 1..86400")
        if hasattr(args, "min_quarantine_seconds") and args.min_quarantine_seconds < 0:
            raise common.TaskBundleError("min quarantine seconds must be non-negative")
        if hasattr(args, "port") and not 1 <= args.port <= 65535:
            raise common.TaskBundleError("port must be 1..65535")
        if hasattr(args, "width") and not 1 <= args.width <= 64:
            raise common.TaskBundleError("width must be 1..64")
        if hasattr(args, "max_parallel") and not 1 <= args.max_parallel <= 64:
            raise common.TaskBundleError("max parallel must be 1..64")
        return args.func(args)
    except common.TaskBundleError as exc:
        return _error(str(exc), validation_error=getattr(exc, "report", None))
    except Exception as exc:  # noqa: BLE001
        return _error(f"unhandled broker error: {exc}", retryable=True)


if __name__ == "__main__":
    sys.exit(main())
