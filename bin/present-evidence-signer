#!/usr/bin/env python3
"""External evidence signer for Present control-plane integrity records."""
from __future__ import annotations

import argparse
import hashlib
import hmac
import json
import os
import secrets
import sys
from pathlib import Path


DEFAULT_KEY_FILE = Path("~/.present/control-plane/evidence-signing-key").expanduser()


def load_key(path: Path) -> bytes:
    configured = os.environ.get("PRESENT_EXTERNAL_SIGNING_KEY")
    if configured:
        return configured.encode("utf-8")
    key_file = path.expanduser()
    if key_file.exists():
        return key_file.read_bytes()
    key_file.parent.mkdir(parents=True, exist_ok=True)
    key = secrets.token_bytes(32)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    descriptor = os.open(key_file, flags, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(key)
    return key


def canonical(payload: object) -> bytes:
    return json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")


def command_sign(args: argparse.Namespace) -> int:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError as exc:
        print(f"invalid signer payload: {exc}", file=sys.stderr)
        return 2
    if not isinstance(payload, dict) or not payload.get("recordHash"):
        print("signer payload must include recordHash", file=sys.stderr)
        return 2
    key = load_key(Path(args.key_file))
    signature = hmac.new(key, canonical(payload), hashlib.sha256).hexdigest()
    print(f"present-external-hmac-sha256:{signature}")
    return 0


def command_health(args: argparse.Namespace) -> int:
    key = load_key(Path(args.key_file))
    print(json.dumps({
        "ok": True,
        "schemaVersion": 1,
        "signerId": args.signer_id,
        "signatureScheme": "present-external-hmac-sha256",
        "keyFingerprint": hashlib.sha256(key).hexdigest()[:16],
    }, sort_keys=True))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="present-evidence-signer")
    parser.add_argument("--key-file", default=str(DEFAULT_KEY_FILE))
    parser.add_argument("--signer-id", default="present-external-signer")
    subparsers = parser.add_subparsers(dest="command", required=True)
    sign = subparsers.add_parser("sign", help="Sign one integrity payload from stdin.")
    sign.set_defaults(func=command_sign)
    health = subparsers.add_parser("health", help="Check that the signer key is available.")
    health.set_defaults(func=command_health)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
