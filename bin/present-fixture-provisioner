#!/usr/bin/env python3
"""Deterministic local fixture provisioner for Control Plane broker tests."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any


def read_request() -> dict[str, Any]:
    try:
        payload = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def emit(payload: dict[str, Any]) -> int:
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Run a deterministic fixture provisioner.")
    parser.add_argument("--worker-id", default="cloud-ephemeral:fixture")
    parser.add_argument("--root", type=Path, required=True)
    parser.add_argument("--command", required=True)
    parser.add_argument("--kind", choices=["container", "cloud", "secure-enterprise"], default="cloud")
    parser.add_argument("--trust-level", default="local-user-trusted")
    parser.add_argument("--retire-after-task", action="store_true", default=False)
    args = parser.parse_args()
    request = read_request()
    action = request.get("action")
    if action == "discover":
        return emit({
            "schemaVersion": 1,
            "status": "DISCOVERED",
            "canProvision": True,
            "workerKinds": [args.worker_id.split(":", 1)[0]],
            "trustLevels": [args.trust_level],
            "supportedProviders": ["fixture"],
            "estimatedStartupSeconds": 1,
            "costClass": "test",
        })
    if action == "reserve":
        return emit({
            "schemaVersion": 1,
            "status": "RESERVED",
            "reservationId": f"fixture-{request.get('taskId', 'task')}",
            "ttlSeconds": 300,
        })
    if action == "release-reservation":
        return emit({
            "schemaVersion": 1,
            "status": "RELEASED",
            "reservationId": request.get("reservationId", ""),
        })
    root = args.root / args.worker_id.replace(":", "_")
    env = {
        "PRESENT_WORKER_ID": args.worker_id,
        "PRESENT_WORKER_KIND": args.worker_id.split(":", 1)[0],
        "PRESENT_WORKER_SURFACE": args.kind,
        "PRESENT_TASKS_DIR": str(root / "tasks"),
        "PRESENT_LOGS_DIR": str(root / "logs"),
        "PRESENT_TEST_RESULTS_DIR": str(root / "test-results"),
        "PRESENT_JOBS_DIR": str(root / "jobs"),
        "PRESENT_WORKTREES_DIR": str(root / "worktrees"),
    }
    return emit({
        "schemaVersion": 1,
        "status": "PROVISIONED",
        "workers": [{
            "id": args.worker_id,
            "command": [args.command],
            "transport": {
                "kind": args.kind if args.kind != "secure-enterprise" else "cloud",
                "command": [args.command],
                "timeoutSeconds": 30,
                "env": env,
            },
            "lifecycle": {"retireAfterTask": args.retire_after_task},
            "health": {"score": 100},
        }],
    })


if __name__ == "__main__":
    raise SystemExit(main())
