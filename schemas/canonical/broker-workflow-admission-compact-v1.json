{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-workflow-admission-compact-v1.json",
  "title": "Broker compact workflow admission v1",
  "description": "Compact broker-authored admission artifact for distributed workflow handoff packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "producedAt",
    "producer",
    "mock",
    "provenance",
    "status",
    "workflowId",
    "contractHash",
    "policyPack"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "mock": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"enum": ["worker", "mock-adapter"]},
        "host": {"type": "string"},
        "commit": {"type": "string"}
      }
    },
    "status": {"const": "ADMITTED"},
    "workflowId": {"type": "string", "minLength": 1},
    "contractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policyPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "registryHash", "riskClass", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "version": {"type": "integer", "minimum": 1},
        "registryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "riskClass": {"enum": ["low", "normal", "high", "critical"]},
        "status": {"const": "SATISFIED"}
      }
    }
  }
}
