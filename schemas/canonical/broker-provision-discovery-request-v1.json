{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-provision-discovery-request-v1.json",
  "title": "Broker provision discovery request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "taskId",
    "contractHash",
    "requiredCapabilities",
    "maxParallel",
    "policyPack",
    "existingWorkers"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "action": {"const": "discover"},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "contractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requiredCapabilities": {"type": "array", "items": {"type": "string"}},
    "maxParallel": {"type": "integer", "minimum": 1, "maximum": 8},
    "policyPack": {"type": "object"},
    "existingWorkers": {"type": "array", "items": {"type": "object"}}
  }
}
