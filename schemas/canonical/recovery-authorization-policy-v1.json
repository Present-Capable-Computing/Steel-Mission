{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/recovery-authorization-policy-v1.json",
  "title": "Recovery authorization policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "rules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-recovery-authorization-policy"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "minimumRole"],
        "properties": {
          "action": {
            "enum": [
              "cancel-workflow",
              "failover-lease",
              "mark-inconsistent",
              "recover-node-lease",
              "reimport-artifact",
              "rematerialize-artifact",
              "retry-node",
              "cancel-subgraph",
              "retire-worker"
            ]
          },
          "minimumRole": {"enum": ["operator", "admin"]}
        }
      }
    }
  }
}
