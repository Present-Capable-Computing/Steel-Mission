{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/worker-artifact-export-v1.json",
  "title": "Worker artifact export response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "producedAt", "producer", "mock", "provenance", "status", "kind", "sha256", "encoding", "content"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-worker artifact export"},
    "mock": {"type": "boolean"},
    "provenance": {"type": "object"},
    "status": {"const": "EXPORTED"},
    "kind": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "encoding": {"const": "base64"},
    "content": {"type": "string"}
  }
}
