{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-response-gc-v1.json",
  "title": "Broker garbage collection response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "status", "removedTasks", "removedEvents"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-lease-broker"},
    "schemaRegistryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "GC_COMPLETE"},
    "removedTasks": {"type": "array", "items": {"type": "string", "pattern": "^DEV-[0-9]{6}$"}},
    "removedEvents": {"type": "integer", "minimum": 0}
  }
}
