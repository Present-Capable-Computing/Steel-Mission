{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/task-state-v1.json",
  "title": "Task state v1",
  "description": "Worker-side reconciliation snapshot for one task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "producedAt",
    "producer",
    "mock",
    "provenance",
    "status",
    "contractPresent",
    "artifacts",
    "nodes",
    "activeBuildJobs",
    "lastStageLog",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "mock": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"enum": ["worker", "mock-adapter"]},
        "host": {"type": "string"},
        "commit": {"type": "string"}
      }
    },
    "status": {"enum": ["EMPTY", "PARTIAL", "COMPLETE", "INCONSISTENT", "CANCELLED"]},
    "contractPresent": {"type": "boolean"},
    "contractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workflowId": {"type": "string", "minLength": 1},
    "workflowRunId": {"type": "string", "pattern": "^wr-[a-f0-9]{24}$"},
    "workerLease": {"$ref": "#/$defs/leaseRef"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "status": {"type": "string", "minLength": 1},
          "gateEligible": {"type": "boolean"},
          "workflowRunId": {"type": "string", "pattern": "^wr-[a-f0-9]{24}$"},
          "contractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "status", "reusable"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "capability": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "nodeContractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reusable": {"type": "boolean"}
        }
      }
    },
    "activeBuildJobs": {"type": "array", "items": {"type": "object"}},
    "lastStageLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "timestamp"],
        "properties": {
          "stage": {"type": "string"},
          "timestamp": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "gateDecision": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED"]},
    "gateReason": {"type": "string", "minLength": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "leaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseId", "workerId", "workerKind", "status", "contractHash", "acquiredAt", "expiresAt", "ttlSeconds"],
      "properties": {
        "leaseId": {"type": "string", "pattern": "^wl-[a-f0-9]{24}$"},
        "workerId": {"type": "string", "minLength": 1},
        "workerKind": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "RELEASED", "EXPIRED"]},
        "contractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "acquiredAt": {"type": "string", "minLength": 1},
        "expiresAt": {"type": "string", "minLength": 1},
        "ttlSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}
      }
    }
  }
}
