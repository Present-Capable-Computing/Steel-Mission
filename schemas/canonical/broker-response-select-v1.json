{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-response-select-v1.json",
  "title": "Broker select response v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "taskId",
    "producedAt",
    "producer",
    "brokerVersion",
    "status",
    "contractHash",
    "candidates",
    "placementPlan",
    "artifactTransferManifest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-lease-broker"},
    "brokerVersion": {"type": "string", "minLength": 1},
    "schemaRegistryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["SELECTED", "NO_ELIGIBLE_WORKER", "NO_NODE_PLACEMENT"]},
    "contractHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selectedWorker": {},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "placementPlan": {"type": "array", "items": {"type": "object"}},
    "artifactTransferManifest": {"type": "object"}
  }
}
