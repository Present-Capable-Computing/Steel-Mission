{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/imported-artifact-index-v1.json",
  "title": "Imported artifact index v1",
  "description": "Worker-local index of artifacts imported for workflow node execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "producedAt", "producer", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256", "path", "localPath", "importedAt"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "path": {"type": "string", "minLength": 1},
          "localPath": {"type": "string", "minLength": 1},
          "sourceNodeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "sourcePath": {"type": "string", "minLength": 1},
          "importedAt": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
