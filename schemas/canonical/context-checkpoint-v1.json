{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/context-checkpoint-v1.json",
  "title": "Context checkpoint v1",
  "description": "Durable compact context retained during long-running jobs so continuation and operator views do not depend on a live model prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "producedAt",
    "producer",
    "mock",
    "provenance",
    "checkpointId",
    "reason",
    "stage",
    "currentState",
    "retainedFacts",
    "droppedDetails",
    "evidenceRefs",
    "contextBudget",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "mock": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"enum": ["worker", "mock-adapter"]},
        "host": {"type": "string"},
        "commit": {"type": "string"}
      }
    },
    "checkpointId": {"type": "string", "pattern": "^cc-[a-f0-9]{24}$"},
    "reason": {
      "enum": [
        "snapshot-prepared",
        "stream-progress",
        "context-budget",
        "manual",
        "resume"
      ]
    },
    "stage": {"type": "string", "minLength": 1},
    "currentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": {"type": "string", "minLength": 1},
        "elapsedSeconds": {"type": "number", "minimum": 0},
        "thinkingTokens": {"type": "integer", "minimum": 0},
        "eventCount": {"type": "integer", "minimum": 0},
        "latestEventType": {"type": "string", "minLength": 1},
        "latestEventSubtype": {"type": "string", "minLength": 1}
      }
    },
    "retainedFacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "droppedDetails": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reason"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
          "workflowRunId": {"type": "string", "pattern": "^wr-[a-f0-9]{24}$"}
        }
      }
    },
    "contextBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChars", "usedChars", "truncated"],
      "properties": {
        "maxChars": {"type": "integer", "minimum": 1},
        "usedChars": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "maxArtifactExcerptChars": {"type": "integer", "minimum": 1}
      }
    },
    "nextAction": {"type": "string", "minLength": 1},
    "resumeFromCheckpointId": {"type": "string", "pattern": "^cc-[a-f0-9]{24}$"}
  }
}
