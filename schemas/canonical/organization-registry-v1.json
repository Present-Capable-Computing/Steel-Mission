{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/organization-registry-v1.json",
  "title": "Organization registry v1",
  "description": "Authority-owned contract for Steel Mission organizations, capability visibility, and bounded knowledge sources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "activeOrganizationId", "organizations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1, "maxLength": 64},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "activeOrganizationId": {"type": "string", "minLength": 1, "maxLength": 80},
    "organizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/organization"}
    }
  },
  "$defs": {
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legalName", "domain", "country", "environment", "dataClassification"],
      "properties": {
        "legalName": {"type": "string", "maxLength": 160},
        "domain": {"type": "string", "maxLength": 160},
        "country": {"type": "string", "maxLength": 80},
        "environment": {"type": "string", "maxLength": 80},
        "dataClassification": {"type": "string", "maxLength": 120}
      }
    },
    "knowledgeDomainKeys": {
      "type": "array",
      "maxItems": 80,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^KD[0-9]{2}$"}
    },
    "domainCapabilityKeys": {
      "type": "array",
      "maxItems": 120,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DC[0-9]{2}$"}
    },
    "sourceMetadata": {
      "type": "object",
      "properties": {
        "owner": {"type": "string", "minLength": 1, "maxLength": 160},
        "lastReviewedAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "expiresAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "maxAgeDays": {"type": "integer", "minimum": 1, "maximum": 3650},
        "required": {"type": "boolean"},
        "authoritative": {"type": "boolean"},
        "provenance": {"type": "object"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "required", "authoritative"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "exists": {"type": "boolean"},
        "sourceKind": {"const": "repository"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 160},
        "lastReviewedAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "expiresAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "maxAgeDays": {"type": "integer", "minimum": 1, "maximum": 3650},
        "required": {"type": "boolean"},
        "authoritative": {"type": "boolean"},
        "provenance": {"type": "object"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "path", "required", "authoritative"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "exists": {"type": "boolean"},
        "sourceKind": {"const": "document"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 160},
        "lastReviewedAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "expiresAt": {"type": "string", "minLength": 1, "maxLength": 64},
        "maxAgeDays": {"type": "integer", "minimum": 1, "maximum": 3650},
        "required": {"type": "boolean"},
        "authoritative": {"type": "boolean"},
        "provenance": {"type": "object"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "knowledgeSources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "documents"],
      "properties": {
        "repositories": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/repository"}
        },
        "documents": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/document"}
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "slug",
        "identifiers",
        "knowledgeDomainKeys",
        "domainCapabilityKeys",
        "knowledgeSources",
        "notes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "slug": {"type": "string", "minLength": 1, "maxLength": 80},
        "identifiers": {"$ref": "#/$defs/identifiers"},
        "knowledgeDomainKeys": {"$ref": "#/$defs/knowledgeDomainKeys"},
        "domainCapabilityKeys": {"$ref": "#/$defs/domainCapabilityKeys"},
        "knowledgeSources": {"$ref": "#/$defs/knowledgeSources"},
        "notes": {"type": "string", "maxLength": 800}
      }
    }
  }
}
