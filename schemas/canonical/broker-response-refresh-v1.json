{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-response-refresh-v1.json",
  "title": "Broker maintenance response v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "producedAt", "producer", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-lease-broker"},
    "brokerVersion": {"type": "string", "minLength": 1},
    "schemaRegistryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {
      "enum": [
        "REFRESHED",
        "PROVISIONED",
        "NO_WORKERS_PROVISIONED",
        "WORKER_RETIRED",
        "WORKER_RETIRE_FAILED",
        "PROVISION_CLEANUP_COMPLETE",
        "WORKER_QUARANTINED",
        "WORKER_UNQUARANTINED",
        "REFRESH_SCHEDULER_COMPLETE",
        "SCHEMA_GATE_COMPLETE",
        "STATE_LOCATION",
        "WORKFLOW_STATUS",
        "WORKFLOW_HISTORY",
        "WORKER_STATUS",
        "AUDIT_LOG",
        "ACCEPTANCE_STATUS",
        "DEMO_DISTRIBUTED_COMPLETE",
        "DEMO_DISTRIBUTED_FAILED",
        "WORKFLOW_DAG",
        "JOB_NARRATIVE",
        "EVIDENCE_QUERY",
        "ACCEPTANCE_GATE",
        "PROVISIONER_STATUS",
        "PROVISIONER_REPLAY",
        "CAPABILITY_DRIFT",
        "LEASE_TIMELINE",
        "STATE_EXPORTED",
        "STATE_IMPORT_VALIDATED",
        "COMPACTION_REPLAY",
        "CHAOS_MATRIX",
        "STRESS_DISTRIBUTED_COMPLETE",
        "STRESS_DISTRIBUTED_FAILED",
        "RUNBOOK_GENERATED",
        "BROKER_WINDOW_CREATED"
      ]
    },
    "workers": {"type": "array"},
    "workerId": {"type": "string"},
    "provisioning": {"type": "array", "items": {"type": "object"}},
    "retirement": {"type": "object"},
    "dryRun": {"type": "boolean"},
    "terminalTasks": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"},
    "missingRegistryEntries": {"type": "array", "items": {"type": "string"}},
    "fixtureFailures": {"type": "array", "items": {"type": "object"}},
    "ok": {"type": "boolean"},
    "statePath": {"type": "string"},
    "path": {"type": "string"},
    "exists": {"type": "boolean"},
    "taskCount": {"type": "integer", "minimum": 0},
    "workflows": {"type": "array", "items": {"type": "object"}},
    "entries": {"type": "array", "items": {"type": "object"}},
    "iterations": {"type": "array", "items": {"type": "object"}},
    "ready": {"type": "boolean"},
    "decision": {"type": "string"},
    "redactionStatus": {"type": "string"},
    "artifactStore": {"type": "string"},
    "summary": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "run": {"type": "object"},
    "workflowStatus": {"type": "object"},
    "acceptanceManifest": {"type": "object"},
    "dag": {"type": "object"},
    "narrative": {"type": "object"},
    "plainText": {"type": "string"},
    "evidenceSummary": {"type": "object"},
    "filteredEvidence": {"type": "array", "items": {"type": "object"}},
    "policyChecks": {"type": "array", "items": {"type": "object"}},
    "remediation": {"type": "array", "items": {"type": "object"}},
    "acceptancePolicy": {"type": "object"},
    "checks": {"type": "array", "items": {"type": "object"}},
    "artifactFindings": {"type": "array", "items": {"type": "object"}},
    "cases": {"type": "array", "items": {"type": "object"}},
    "command": {"type": "string"},
    "width": {"type": "integer", "minimum": 0},
    "maxParallel": {"type": "integer", "minimum": 0},
    "markdown": {"type": "string"},
    "window": {"type": "object"},
    "snapshot": {"type": "object"},
    "poolErrors": {"type": "array", "items": {"type": "object"}},
    "restoredArtifacts": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object"},
    "registryPath": {"type": "string"}
  }
}
