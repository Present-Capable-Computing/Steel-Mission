{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/worker-cleanup-v1.json",
  "title": "Worker cleanup response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "dryRun"],
  "allOf": [
    {
      "if": {"properties": {"dryRun": {"const": true}}, "required": ["dryRun"]},
      "then": {"required": ["candidates"]},
      "else": {"required": ["removed"]}
    }
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-worker cleanup"},
    "dryRun": {"type": "boolean"},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "removed": {"type": "array", "items": {"type": "object"}}
  }
}
