{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-response-reconcile-v1.json",
  "title": "Broker reconcile response v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "taskId", "producedAt", "producer", "brokerVersion", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-lease-broker"},
    "brokerVersion": {"type": "string", "minLength": 1},
    "schemaRegistryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {
      "enum": [
        "RUNNING",
        "WAITING",
        "COMPLETE",
        "CANCELLED",
        "FAILED",
        "INCONSISTENT",
        "WORKER_UNREACHABLE",
        "LEASE_EXPIRED",
        "FAILOVER_LEASED"
      ]
    },
    "task": {"type": "object"},
    "taskState": {"type": "object"},
    "reason": {"type": "string"},
    "candidates": {"type": "array", "items": {"type": "object"}}
  }
}
