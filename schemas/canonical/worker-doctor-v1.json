{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/worker-doctor-v1.json",
  "title": "Worker doctor response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "schemaAuthority", "schemaRegistryHash", "ok", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-worker doctor"},
    "schemaAuthority": {"type": "string", "minLength": 1},
    "schemaRegistryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ok": {"type": "boolean"},
    "checks": {"type": "object"}
  }
}
