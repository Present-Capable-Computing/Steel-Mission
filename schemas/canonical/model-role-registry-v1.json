{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/model-role-registry-v1.json",
  "title": "Model binding registry v1",
  "description": "Worker-local registry of model transports and advisory runtime bindings. Provider choice creates a model instance of the selected role; it does not create a new organizational role.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "models", "roles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1, "maxLength": 64},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "transport", "roles", "nativeCapabilities", "requiresNetwork", "local"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "provider": {"enum": ["claude", "codex", "glimmer"]},
          "transport": {"enum": ["claude-code", "codex-cli", "ollama"]},
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "nativeCapabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "requiresNetwork": {"type": "boolean"},
          "local": {"type": "boolean"}
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "primaryModel", "fallbackModels", "governanceCapabilities", "snapshotProfile"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "title": {"type": "string", "minLength": 1, "maxLength": 128},
          "primaryModel": {"type": "string", "minLength": 1, "maxLength": 128},
          "fallbackModels": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "governanceCapabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "snapshotProfile": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
