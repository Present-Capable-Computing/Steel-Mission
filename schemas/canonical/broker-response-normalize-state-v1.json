{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-response-normalize-state-v1.json",
  "title": "Broker normalize state response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "schemaRegistryHash", "status", "dryRun", "changes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-lease-broker"},
    "schemaRegistryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "STATE_NORMALIZED"},
    "dryRun": {"type": "boolean"},
    "changes": {"type": "array", "items": {"type": "string"}}
  }
}
