{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/worker-pool-registry-v1.json",
  "title": "Worker pool registry v1",
  "description": "Control-plain registry of logical worker commands, provisioners, and recent status snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "workers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "updatedAt": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "provisioners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["container", "cloud"]},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
        }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "env": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "transport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "command"],
            "properties": {
              "kind": {"enum": ["local", "ssh", "container", "cloud"]},
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "env": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              },
              "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
              "endpoint": {"type": "string"}
            }
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxActiveLeases": {"type": "integer", "minimum": 1, "maximum": 128},
              "allowedRiskClasses": {
                "type": "array",
                "items": {"enum": ["low", "normal", "high", "critical"]}
              },
              "requiredLabels": {"type": "array", "items": {"type": "string"}},
              "forbiddenWorkerKinds": {"type": "array", "items": {"type": "string"}}
            }
          },
          "health": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "score": {"type": "integer", "minimum": 0, "maximum": 100},
              "recentFailures": {"type": "integer", "minimum": 0},
              "latencyMs": {"type": "integer", "minimum": 0}
            }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "retireAfterTask": {"type": "boolean"},
              "deprovisionCommand": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
            }
          },
          "quarantine": {
            "type": "object",
            "additionalProperties": false,
            "required": ["active", "reason", "producedAt"],
            "properties": {
              "active": {"type": "boolean"},
              "reason": {"type": "string", "minLength": 1},
              "failureCount": {"type": "integer", "minimum": 0},
              "producedAt": {"type": "string", "minLength": 1},
              "releasedAt": {"type": "string", "minLength": 1}
            }
          },
          "statusAttestation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "producedAt", "algorithm", "hash"],
            "properties": {
              "schemaVersion": {"const": 1},
              "producedAt": {"type": "string", "minLength": 1},
              "algorithm": {"const": "sha256"},
              "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          },
          "lastSeenAt": {"type": "string", "minLength": 1},
          "status": {"type": "object"}
        }
      }
    }
  }
}
