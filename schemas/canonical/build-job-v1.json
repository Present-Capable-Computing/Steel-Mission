{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/build-job-v1.json",
  "title": "Build job receipt v1",
  "description": "Receipt returned while a detached worker build is queued or running.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "producedAt", "producer", "mock", "provenance", "jobId", "state", "pollAfterSeconds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "mock": {"const": false},
    "provenance": {"type": "object", "required": ["source"], "properties": {"source": {"const": "worker"}, "host": {"type": "string"}, "commit": {"type": "string"}}},
    "jobId": {"type": "string", "pattern": "^DEV-[0-9]{6}-build$"},
    "state": {"enum": ["QUEUED", "RUNNING"]},
    "pollAfterSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "pid": {"type": "integer", "minimum": 1},
    "startedAt": {"type": "string", "format": "date-time"}
  }
}
