{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/private-runner-request-v1.json",
  "title": "Private runner request v1",
  "description": "One bounded execution request admitted by the Steel Mission guarded control plane.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "missionId", "taskId", "phase", "workspacePath", "argv", "timeoutSeconds", "environment", "attestation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "pattern": "^pre-[a-f0-9]{24}$"},
    "missionId": {"type": "string", "pattern": "^ms-[a-f0-9]{24}$"},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "phase": {"enum": ["modify", "build", "test", "inspect", "repair", "pr", "deploy"]},
    "workspacePath": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 1800},
    "environment": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]{0,79}$"},
      "additionalProperties": {"type": "string"}
    },
    "stdin": {"type": "string", "maxLength": 262144},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signerId", "payloadHash", "signature"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "signerId": {"const": "steel-mission-control-plane"},
        "payloadHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
