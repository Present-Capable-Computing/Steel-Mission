{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/domain-capability-registry-v1.json",
  "title": "Domain capability registry v1",
  "description": "Authority-owned contract for assigning users and publishers to Steel Mission domain capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1, "maxLength": 64},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "userAssignments": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/userAssignment"}
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/capabilityAssignment"}
    }
  },
  "anyOf": [
    {"required": ["userAssignments"]},
    {"required": ["assignments"]}
  ],
  "$defs": {
    "userIds": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DC[0-9]{2}$"}
    },
    "userAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "role", "assignedCapabilities"],
      "properties": {
        "userId": {"type": "string", "minLength": 1, "maxLength": 200},
        "role": {"enum": ["owner", "admin", "publisher", "user"]},
        "assignedCapabilities": {"$ref": "#/$defs/capabilities"}
      }
    },
    "capabilityAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleKey", "fNumber", "displayName", "publishers", "users"],
      "properties": {
        "roleKey": {"type": "string", "pattern": "^DC[0-9]{2}$"},
        "fNumber": {"type": "string", "pattern": "^DC[0-9]{2}$"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 200},
        "publishers": {"$ref": "#/$defs/userIds"},
        "users": {"$ref": "#/$defs/userIds"}
      }
    }
  }
}
