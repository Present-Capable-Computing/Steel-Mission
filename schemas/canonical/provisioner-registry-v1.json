{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/provisioner-registry-v1.json",
  "title": "Provisioner registry v1",
  "description": "Control-plain registry of external worker provisioners addressable by execution surface and trust policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "provisioners"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "updatedAt": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "provisioners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["container", "cloud", "local", "secure-enterprise"]},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "providers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "trustLevels": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resourceLimits": {"type": "object"}
        }
      }
    }
  }
}
