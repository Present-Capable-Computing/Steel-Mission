{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/user-registry-v1.json",
  "title": "User registry v1",
  "description": "Authority-owned contract for Steel Mission users, organizational membership, capability assignments, and identity bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "users"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1, "maxLength": 64},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/user"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "capabilityList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DC[0-9]{2}$"}
    },
    "externalIdentities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": {"$ref": "#/$defs/stringList"},
        "slack": {"$ref": "#/$defs/stringList"},
        "jira": {"$ref": "#/$defs/stringList"}
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "email",
        "role",
        "status",
        "assignedCapabilities",
        "organizationIds",
        "identitySubjects",
        "externalIdentities"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "name": {"type": "string", "minLength": 1, "maxLength": 300},
        "email": {"type": "string", "maxLength": 320},
        "role": {"enum": ["owner", "admin", "publisher", "user"]},
        "status": {"enum": ["active", "disabled"]},
        "assignedCapabilities": {"$ref": "#/$defs/capabilityList"},
        "organizationIds": {"$ref": "#/$defs/stringList"},
        "identitySubjects": {"$ref": "#/$defs/stringList"},
        "externalIdentities": {"$ref": "#/$defs/externalIdentities"}
      }
    }
  }
}
