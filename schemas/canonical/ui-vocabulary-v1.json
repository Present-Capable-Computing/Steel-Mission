{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/ui-vocabulary-v1.json",
  "title": "Steel Mission UI vocabulary v1",
  "description": "Canonical presentation terms and registry-derived Domain Capability labels served to the Steel Mission UI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ok", "terms", "capabilities"],
  "properties": {
    "schemaVersion": {"const": 1},
    "ok": {"type": "boolean"},
    "terms": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/term"}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptKey", "label", "wireNames", "description"],
      "properties": {
        "conceptKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "wireNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityKey", "displayName"],
      "properties": {
        "capabilityKey": {"type": "string", "pattern": "^DC[0-9]{2}$"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
