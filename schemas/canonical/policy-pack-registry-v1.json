{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/policy-pack-registry-v1.json",
  "title": "Policy pack registry v1",
  "description": "Control-plain registry of versioned workflow policy packs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "producedAt", "producer", "packs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/policyPack"}
    }
  },
  "$defs": {
    "policyPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "riskClass",
        "requiredCapabilities",
        "requiredEvidenceRoles",
        "forbiddenCapabilities",
        "minVerifierCount"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "version": {"type": "integer", "minimum": 1},
        "riskClass": {"enum": ["low", "normal", "high", "critical"]},
        "requiredCapabilities": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "requiredEvidenceRoles": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "forbiddenCapabilities": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "minVerifierCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "acceptancePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minVerifierCount"],
          "properties": {
            "mode": {"enum": ["single-deterministic-verifier", "quorum", "unanimous"]},
            "minVerifierCount": {"type": "integer", "minimum": 0, "maximum": 8},
            "requiredEvidenceRoles": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
            "allowMockEvidence": {"type": "boolean"}
          }
        },
        "retentionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "ttlSeconds"],
          "properties": {
            "class": {"enum": ["ephemeral", "standard", "audit", "regulated"]},
            "ttlSeconds": {"type": "integer", "minimum": 0},
            "redactionRequired": {"type": "boolean"},
            "purgeOnCompletion": {"type": "boolean"}
          }
        }
      }
    }
  }
}
