{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://present.dev/schemas/broker-response-artifact-audit-v1.json",
  "title": "Broker artifact audit response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "producedAt",
    "producer",
    "brokerVersion",
    "schemaRegistryHash",
    "status",
    "artifactStore",
    "summary",
    "findings",
    "repairActions"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^DEV-[0-9]{6}$"},
    "producedAt": {"type": "string", "minLength": 1},
    "producer": {"const": "present-lease-broker"},
    "brokerVersion": {"type": "string", "minLength": 1},
    "schemaRegistryHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "ARTIFACT_AUDIT_COMPLETE"},
    "artifactStore": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "info"],
      "properties": {
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "kind", "reason"],
        "properties": {
          "severity": {"enum": ["error", "warning", "info"]},
          "kind": {"type": "string", "minLength": 1},
          "nodeId": {"type": "string"},
          "sha256": {"type": "string"},
          "path": {"type": "string"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "repairActions": {"type": "array", "items": {"type": "object"}}
  }
}
