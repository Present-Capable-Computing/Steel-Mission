FROM python:3.12-slim-bookworm

COPY requirements.txt /tmp/steel-mission-requirements.txt
COPY --chmod=0755 bin/private-runner-entrypoint /usr/local/bin/private-runner-entrypoint

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gh git openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r /tmp/steel-mission-requirements.txt \
    && rm -f /tmp/steel-mission-requirements.txt \
    && addgroup --system --gid 65532 steelmission \
    && adduser --system --uid 65532 --gid 65532 --home /tmp --no-create-home steelmission

WORKDIR /workspace
USER 65532:65532

ENTRYPOINT ["/usr/local/bin/private-runner-entrypoint"]
CMD ["python3", "--version"]
